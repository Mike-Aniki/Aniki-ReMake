    <Style x:Key="TopBarIndicatorButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="Transparent">

                        <!-- ombre/glow focus -->
                        <Border x:Name="FocusShadow"
                                Margin="-4"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{DynamicResource GlowFocusBrush}"
                                Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="14" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>

                        <!-- fond focus -->
                        <Border x:Name="FocusBg"
                                Margin="-2"
                                CornerRadius="{DynamicResource Corner}"
                                Background="#33FFFFFF"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="2"
                                Opacity="0"/>

                        <!-- content -->
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Opacity="0.95"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="FocusShadow" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="OverlayButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">

                        <!-- ombre/glow focus -->
                        <Border x:Name="FocusShadow"
                                Margin="-4"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{DynamicResource GlowFocusBrush}"
                                Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="14" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>

                        <!-- fond focus -->
                        <Border x:Name="FocusBg"
                                Margin="-2"
                                CornerRadius="{DynamicResource Corner}"
                                Background="#33FFFFFF"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="2"
                                Opacity="0"/>

                        <!-- image circulaire -->
                        <Border x:Name="AvatarBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="999"
                                ClipToBounds="True"
                                BorderThickness="1"
                                BorderBrush="#40FFFFFF"
                                Background="Transparent">

                            <Image Source="{ThemeFile 'Images/OverlayButton.png'}"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Stretch="UniformToFill"
                                   Height="34"
                                   Width="34"
                                   SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusBg" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="FocusShadow" Property="Opacity" Value="0.5"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="AvatarBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="AvatarBorder" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="AvatarBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

