    <!-- Style pour les boutons du menu principal -->
    <Style x:Key="MainMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Height" Value="68"/>
        <Setter Property="Margin" Value="18,0,18,2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid Background="{TemplateBinding Background}"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True">

                        <Border x:Name="MainBackground"
                                Margin="0"
                                CornerRadius="4"
                                Background="{DynamicResource ButtonBackgroundFocus}"
                                Visibility="Collapsed"/>

                        <Border x:Name="MainBorder"
                                Margin="0"
                                BorderThickness="2"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                Visibility="Collapsed"/>

                        <Border x:Name="FlashMenuBorder"
                                Margin="0"
                                CornerRadius="4"
                                Style="{DynamicResource AnimatedFlashMenu}"
                                Tag="False"
                                Visibility="Collapsed"/>

                        <ContentPresenter Margin="24,0,26,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"
                                          TextElement.FontFamily="{DynamicResource FontMain}"
                                          TextElement.FontSize="22"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Name" Value="PART_ButtonKofi">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Name" Value="PART_ButtonPatreon">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Name" Value="PART_ButtonFeedback">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Modèle de l'en-tête du menu principal -->
    <DataTemplate x:Key="MainMenuHeaderTemplate">
        <Grid Height="82"
              Margin="0,0,0,14">

            <StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch">

                <TextBlock Text="{DynamicResource LOCMainMenuSettings}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="30"
                           Style="{DynamicResource TextBlockBaseStyle}"
                           Foreground="{DynamicResource TextHighlightBrush}"
                           FontWeight="SemiBold"
                           Opacity="0.92" />

                <Grid Height="10"
                      Margin="34,10,34,0">
                    <Border Height="1"
                            VerticalAlignment="Center"
                            Opacity="0.90"
                            Background="{DynamicResource SeparatorBrush}" />
                </Grid>

            </StackPanel>
        </Grid>
    </DataTemplate>

