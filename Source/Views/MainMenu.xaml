    <!-- Style pour le cadre du menu principal -->
    <Style x:Key="MainMenuBorder" TargetType="Border">
        <Setter Property="Tag" Value="{DynamicResource BackgroundImageIndex}" />
        <Setter Property="Height" Value="1080" />
        <Setter Property="Width" Value="500" />
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource OverlayMenu}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,2,0"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                    <TranslateTransform X="-540"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- ✅ placement DROITE (état) -->
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Grid.ColumnSpan" Value="2"/>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                <!-- état initial offscreen côté droit -->
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                            <TranslateTransform X="540"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <!-- ✅ anim entrée GAUCHE -->
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SB_MenuIn_Left">
                        <Storyboard FillBehavior="HoldEnd">
                            <!-- colonne gauche -->
                            <Int32Animation Storyboard.TargetProperty="(Grid.Column)"
                                            Duration="0:0:0" To="0"/>

                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             Duration="0:0:0.24"/>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             From="-540" To="0"
                                             Duration="0:0:0.36">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>

            <!-- ✅ anim entrée DROITE -->
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SB_MenuIn_Right">
                        <Storyboard FillBehavior="HoldEnd">

                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             Duration="0:0:0.24"/>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             From="540" To="0"
                                             Duration="0:0:0.36">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
