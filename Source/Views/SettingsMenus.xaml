    <!-- Style pour du menu de réglages -->
    <Style x:Key="SettingsMenuBorder" TargetType="Border">
        <Setter Property="Tag" Value="{DynamicResource BackgroundImageIndex}" />
        <Setter Property="Height" Value="1080" />
        <Setter Property="Width" Value="500" />
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource OverlayMenu}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,2,0"/>
        <Setter Property="Opacity" Value="0.95"/>
        <!-- RenderTransform UNIQUE -->
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                    <!-- ✅ valeur neutre, on force le start dans le storyboard -->
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Width" Value="750" />
                <Setter Property="Margin" Value="40,30,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="True">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="Margin" Value="0,30,40,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>

        <Style.Triggers>

            <!-- ✅ DROITE -->
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Grid.ColumnSpan" Value="2"/>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SB_SettingsIn_Right">
                        <Storyboard FillBehavior="HoldEnd">

                            <!-- 1) force position de départ instantanée -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             To="540" Duration="0:0:0"/>

                            <!-- 2) fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             Duration="0:0:0.24"/>

                            <!-- 3) slide vers 0 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             To="0"
                                             BeginTime="0:0:0"
                                             Duration="0:0:0.36">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- 4) scale -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.26"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>

            <!-- ✅ GAUCHE -->
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="False">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Grid.ColumnSpan" Value="1"/>
                <Setter Property="BorderThickness" Value="0,0,2,0"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ChangeMenuPlacement]}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SB_SettingsIn_Left">
                        <Storyboard FillBehavior="HoldEnd">

                            <Int32Animation Storyboard.TargetProperty="(Grid.Column)" Duration="0:0:0" To="0"/>

                            <!-- 1) force position de départ instantanée -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             To="-540" Duration="0:0:0"/>

                            <!-- 2) fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             Duration="0:0:0.24"/>

                            <!-- 3) slide vers 0 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             To="0"
                                             BeginTime="0:0:0"
                                             Duration="0:0:0.36">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- 4) scale -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
