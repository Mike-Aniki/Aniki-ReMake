                                                            <DataTrigger Binding="{Binding ElementName=UpdatePanelToggle, Path=IsChecked}" Value="True">
                                                                <Setter Property="Focusable" Value="True"/>
                                                                <Setter Property="IsTabStop" Value="True"/>
                                                            </DataTrigger>

                                                            <!-- Quand il se ferme (immédiat) -->
                                                            <DataTrigger Binding="{Binding ElementName=UpdatePanelToggle, Path=IsChecked}" Value="False">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="IsTabStop" Value="False"/>
