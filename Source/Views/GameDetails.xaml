                                                  CommandParameter="{Binding}">
                                            <ButtonEx.Template>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ButtonEx.Template>
                                        </ButtonEx>
                                    </Grid>




                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsGoal}" Value="True">
