<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">

                    <Grid Background="#00000000"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          Focusable="True"
                          ClipToBounds="True"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle" >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition x:Name="DetailsRow" Height="*" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_ButtonContext}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:0" From="0" To="1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" From="1" To="0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameStatus, Path=Visibility}" Value="Visible">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=OpenPlayniteButton}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameStatus, Path=Visibility}" Value="Collapsed">
                                        <Setter Property="Focusable" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}" Value="True">
                                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=NowPlayingButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>


                        <Border x:Name="Overlay" Grid.RowSpan="3" Grid.ColumnSpan="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Panel.ZIndex" Value="-48"/>
                                    <Setter Property="Background" Value="{DynamicResource ShadeBackgroundDetails}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" Duration="0:0:1" To="0.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid x:Name="SourceNoBar"
                              Panel.ZIndex="-45"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="60,18,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoSource]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ContentControl Content="{Binding}"
                                            Focusable="False"
                                            FocusVisualStyle="{x:Null}"
                                            ContentTemplate="{StaticResource AnikiSourceIconFallbackTemplate}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                        </Grid>



                        <!-- Avatar and PlayniteAchievements when the interface bar is hidden -->
                        <Grid x:Name="AvatarTrophiesNoBar"
                              Panel.ZIndex="-44"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,18,60,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAvatarDetails]}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAchievementsDetails]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ContentControl x:Name="TrophiesNoBar"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource AnikiPlayniteAchievementsSummaryTemplate}"
                                                Tag="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAchievementsDetails]}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <ContentControl x:Name="AvatarNoBar"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource AnikiUserAvatarTemplate}"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAvatarDetails]}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </Grid>

                        <!-- Interface Bar -->

                        <Grid x:Name="InterfaceBar" Panel.ZIndex="-45">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Grid.Style>

                            <!-- BAR -->
                            <Border x:Name="TopBar" Height="80" >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible" />
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopButtonAlwaysVisible]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0" Duration="0:0:0"
                                                                             From="0" To="0"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.5" Duration="0:0:0.2"
                                                                             From="0" To="1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                BeginTime="0:0:0.5" Duration="0:0:0.6"
                                                                From="-90" To="0"
                                                                AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible" />
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                </MultiDataTrigger.Setters>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0" Duration="0:0:0"
                                                                             From="0" To="0"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.5" Duration="0:0:0.2"
                                                                             From="0" To="1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                BeginTime="0:0:0.5" Duration="0:0:0.6"
                                                                From="80" To="0"
                                                                AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="Stop">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                Duration="0:0:0.25"
                                                                From="0" To="80"
                                                                AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                Duration="0:0:0.25"
                                                                From="1" To="0.98"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.05" Duration="0:0:0.2"
                                                                             From="1" To="0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid x:Name="BottomGlass" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80">

                                    <!-- Fond verre -->
                                    <Border CornerRadius="0"
                                            Opacity="{DynamicResource OpacityBarDetail}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Par défaut -->
                                                <Setter Property="Background" Value="{DynamicResource TopBar}" />

                                                <Style.Triggers>
                                                    <!-- Si l’option est True => BottomBar -->
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BottomBar}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Reflet vertical discret -->
                                    <Border CornerRadius="0" IsHitTestVisible="False" Background="{DynamicResource GlassMainBrush}" Opacity="{DynamicResource OpacityBarDetail}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                    <!-- Liseré interne -->
                                    <Border CornerRadius="0"
                                            Opacity="{DynamicResource OpacityBarDetail}"
                                            Margin="1"
                                            BorderBrush="{DynamicResource GlassInnerLineBrush}"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Hairline -->
                                    <Border HorizontalAlignment="Stretch" Height="1.5"
                                            Background="{DynamicResource MenuBorderBrush}" Opacity="{DynamicResource OpacityBarDetail}"
                                            CornerRadius="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Height="80">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="900"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- Avatar / PlayniteAchievements -->
                                        <Grid HorizontalAlignment="Right" Grid.Column="2" Margin="0,0,20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ContentControl x:Name="Avatar"
                                                            Grid.Column="2"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource AnikiUserAvatarTemplate}"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            IsTabStop="False">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAvatarDetails]}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl x:Name="Trophee_PA"
                                                            Grid.Column="1"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource AnikiPlayniteAchievementsSummaryTemplate}"
                                                            Tag="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            IsTabStop="False">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoAchievementsDetails]}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>

                                        <!-- Image de Source -->
                                        <Border x:Name="SourceIconBorder"
                                                HorizontalAlignment="Left"
                                                Margin="20,0,0,0"
                                                Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoSource]}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <ContentControl Content="{Binding}"
                                                            Focusable="False"
                                                            FocusVisualStyle="{x:Null}"
                                                            ContentTemplate="{StaticResource AnikiSourceIconFallbackTemplate}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,40,0"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>


                        <!-- Grid Panel Details -->

                        <Grid x:Name="GameDetailsStack"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              RenderTransformOrigin="0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.Resources>

                                <Style x:Key="ClassicPremiumCardStyle" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundAHBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBottomBarBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="14"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                    <Setter Property="MinWidth" Value="132"/>
                                    <Setter Property="Height" Value="64"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                </Style>

                                <Style x:Key="ClassicPremiumChipStyle" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundAHBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBottomBarBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="10"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                </Style>

                                <Style x:Key="ClassicPremiumCardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextAltBrush}"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="Opacity" Value="0.78"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>

                                <Style x:Key="ClassicPremiumCardValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="FontSize" Value="20"/>
                                    <Setter Property="FontWeight" Value="Regular"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>

                            </Grid.Resources>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <TranslateTransform X="0" Y="0"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="False">
                                            <Setter Property="Grid.RowSpan" Value="3"/>
                                            <Setter Property="Margin" Value="0,0,0,50"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True">
                                            <Setter Property="Grid.RowSpan" Value="3"/>
                                            <Setter Property="Margin" Value="0,0,0,50"/>
                                        </DataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1"
                                                                         Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationPanel]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1"
                                                                         Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationPanel]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <RemoveStoryboard BeginStoryboardName="SB_Out"/>
                                                <BeginStoryboard x:Name="SB_In" HandoffBehavior="SnapshotAndReplace">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                         From="-400"
                                                                         BeginTime="0:0:1"
                                                                         Duration="0:0:1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0"
                                                                         To="1"
                                                                         BeginTime="0:0:1"
                                                                         Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                            <DataTrigger.EnterActions>
                                                <RemoveStoryboard BeginStoryboardName="SB_In"/>
                                                <BeginStoryboard x:Name="SB_Out" HandoffBehavior="SnapshotAndReplace">
                                                    <Storyboard FillBehavior="Stop">
                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                         To="-400"
                                                                         Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1"
                                                                         To="0"
                                                                         Duration="0:0:0.20"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=LogoTrigger, Path=Opacity}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel Orientation="Vertical"
                                        MinWidth="700"
                                        MaxWidth="950"
                                        Margin="50,0,0,0"
                                        HorizontalAlignment="Left">


                                <!-- Logo -->
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,40">

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowNoTittleAndLogo]}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="MaxWidth" Value="600"/>
                                                <Setter Property="MaxHeight" Value="250"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoLogo]}" Value="True">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,0"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoLogo]}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginStatus Plugin=ExtraMetadataLoader_705fdbca-e1fc-4004-b839-1d040b8b4429, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid MinWidth="100" ClipToBounds="False">

                                    <!-- Shadow layer -->
                                    <Border CornerRadius="22"
                                            Opacity="0.44"
                                            Background="{DynamicResource BackgroundItem}"
                                            Width="{Binding ElementName=PanelCard, Path=ActualWidth}"
                                            Height="{Binding ElementName=PanelCard, Path=ActualHeight}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="0,0,0,0"
                                            Panel.ZIndex="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20"
                                                              ShadowDepth="6"
                                                              Direction="315"
                                                              Opacity="0.28"
                                                              RenderingBias="Performance"
                                                              Color="#FF000000"/>
                                        </Border.Effect>
                                    </Border>


                                    <!-- info panel -->
                                    <Border x:Name="PanelCard"
                                            CornerRadius="22"
                                            Padding="16"
                                            Background="{DynamicResource GlassSignatureBrush}"
                                            BorderBrush="{DynamicResource GlassInnerLineBrush}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True"
                                            Panel.ZIndex="1">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Cover -->
                                            <Grid Grid.Column="0"
                                                  Width="{Binding ElementName=CoverImgBox, Path=ActualWidth}"
                                                  Height="{Binding ElementName=CoverImgBox, Path=ActualHeight}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">

                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowCoverDetails]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Cover clipped -->
                                                <Grid>
                                                    <Grid.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=CoverMask}"
                                                                     Stretch="UniformToFill"
                                                                     RenderOptions.BitmapScalingMode="LowQuality"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Grid.OpacityMask>

                                                    <Border x:Name="CoverMask"
                                                            Width="{Binding ElementName=CoverImgBox, Path=ActualWidth}"
                                                            Height="{Binding ElementName=CoverImgBox, Path=ActualHeight}"
                                                            CornerRadius="{DynamicResource Corner}"
                                                            Background="Black"/>

                                                    <Viewbox x:Name="CoverImgBox"
                                                             MaxWidth="300"
                                                             MaxHeight="350"
                                                             Stretch="Uniform">

                                                        <Grid Width="{Settings GridItemWidth}"
                                                              Height="{Settings GridItemHeight}">

                                                            <Image x:Name="CoverImg"
                                                                   Source="{Binding CoverImageObject}"
                                                                   Stretch="{Settings CoverArtStretch}"
                                                                   StretchDirection="Both"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>

                                                        </Grid>
                                                    </Viewbox>
                                                </Grid>

                                                <!-- Scores overlay -->
                                                <Grid VerticalAlignment="Bottom"
                                                      Height="46"
                                                      IsHitTestVisible="False"
                                                      Width="{Binding ElementName=CoverImgBox, Path=ActualWidth}"
                                                      HorizontalAlignment="Center">

                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CriticScore}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding CommunityScore}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding UserScore}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </MultiDataTrigger>

                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoStar]}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <Border Background="#BF000000"
                                                            CornerRadius="0,0,8,8"/>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,8,0">

                                                        <!-- Critic -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,18,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CriticScore}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <TextBlock Text="&#xec7c;"
                                                                       FontFamily="{DynamicResource FontIcoFont}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontSize="18"
                                                                       Opacity="0.9"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Text="{Binding CriticScore}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontWeight="Bold"
                                                                       FontSize="20"
                                                                       MinWidth="22"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Community -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,18,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CommunityScore}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <TextBlock Text="&#xed0d;"
                                                                       FontFamily="{DynamicResource FontIcoFont}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontSize="18"
                                                                       Opacity="0.9"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Text="{Binding CommunityScore}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontWeight="Bold"
                                                                       FontSize="20"
                                                                       MinWidth="22"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- User -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UserScore}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <TextBlock Text="&#xed05;"
                                                                       FontFamily="{DynamicResource FontIcoFont}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontSize="18"
                                                                       Opacity="0.9"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Text="{Binding UserScore}"
                                                                       Style="{StaticResource InfoValueStyle}"
                                                                       FontWeight="Bold"
                                                                       FontSize="20"
                                                                       MinWidth="22"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Grid>
                                            </Grid>



                                            <!-- Right content -->
                                            <StackPanel Grid.Column="2" Orientation="Vertical">

                                                <!-- Developer / Year -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,8"
                                                            HorizontalAlignment="Left"
                                                            SnapsToDevicePixels="True">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReleaseYear}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoYear]}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                               Opacity="0.82"
                                                               FontSize="20"
                                                               Text="{Binding Developers[0], Converter={StaticResource ListToStringConverter}}"/>

                                                    <TextBlock Style="{StaticResource TextBlockAltDetailStyle}"
                                                               FontSize="20"
                                                               Margin="6,0,0,0"
                                                               Text="{Binding ReleaseYear, Converter={StaticResource ListToStringConverter}}"/>
                                                </StackPanel>

                                                <!-- Buttons -->
                                                <Grid x:Name="GameButtons" IsEnabled="True" Margin="0,0,0,12">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left">

                                                        <Grid x:Name="MainButton"
                                                              MinWidth="120"
                                                              Width="Auto"
                                                              Height="52"
                                                              Margin="0,0,8,8"
                                                              ClipToBounds="False"
                                                              VerticalAlignment="Top">

                                                            <ButtonEx x:Name="PART_ButtonContext"
                                                                      MinWidth="120"
                                                                      Height="48"
                                                                      Margin="0,3,0,0"
                                                                      VerticalAlignment="Top"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Center">
                                                                <ButtonEx.Style>
                                                                    <Style BasedOn="{StaticResource ButtonContext}" TargetType="ButtonEx">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                            </ButtonEx>


                                                            <ButtonEx x:Name="NowPlayingButton"
                                                                      MinWidth="120"
                                                                      Height="48"
                                                                      Margin="0,3,0,0"
                                                                      VerticalAlignment="Top"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Center"
                                                                      Command="{PluginSettings Plugin=NowPlaying, Path=InstallOrPlayOrOpenDialog}">
                                                                <ButtonEx.Style>
                                                                    <Style BasedOn="{StaticResource GameDetailsNowPlayingButtonInGameOptions}" TargetType="ButtonEx">
                                                                        <Setter Property="Content" Value="{DynamicResource LOCPlayGame}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                                                                                <Setter Property="Content" Value="{DynamicResource LOCInstallGame}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.IsInstalling}" Value="True">
                                                                                <Setter Property="Content" Value="{DynamicResource LOCSetupRunning}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.IsLaunching}" Value="True">
                                                                                <Setter Property="Content" Value="{DynamicResource LOCGameLaunching}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.IsRunning}" Value="True">
                                                                                <Setter Property="Content" Value="Now Playing"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.IsUninstalling}" Value="True">
                                                                                <Setter Property="Content" Value="{DynamicResource LOCUninstalling}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                            </ButtonEx>

                                                        </Grid>



                                                        <WrapPanel HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center">

                                                            <ButtonEx x:Name="DuplicateHiderVersionsButton"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8"
                                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenDuplicateHiderVersionsWindowCommand}"
                                                                      FocusVisualStyle="{x:Null}">

                                                                <ButtonEx.Style>
                                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=felixkmh_DuplicateHider_Plugin, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HasDuplicateHiderVersions}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>

                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>

                                                                <TextBlock Text="&#xF1CB;" FontSize="21" FontFamily="{DynamicResource FontIcons}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            </ButtonEx>



                                                            <ButtonEx x:Name="PlayniteAchievementButton"
                                                                      Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenGameAchievementWindow}"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8"
                                                                      Tag="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}">
                                                                <ButtonEx.Style>
                                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                                <TextBlock Text="&#xedd7;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ButtonEx>

                                                            <ButtonEx x:Name="DlcButton"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8"
                                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[CheckDLCWindowStyle]}"
                                                                      Tag="{PluginSettings Plugin=CheckDlc, Path=HasData, FallbackValue=False}">
                                                                <ButtonEx.Style>
                                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                                <TextBlock Text="&#xefe7;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ButtonEx>

                                                            <ButtonEx x:Name="ScreenshotsButton"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8"
                                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenScreenshotsWindowCommand}">
                                                                <ButtonEx.Style>
                                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=False}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{PluginStatus Plugin=ScreenshotUtilitiesLocalProvider_a049eff8-fd41-4dbc-9e35-01acc6b1a0cb, Status=Installed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                                <TextBlock Text="&#xef4b;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ButtonEx>

                                                            <CheckBoxEx x:Name="TrailerMute"
                                                                        Width="48"
                                                                        Height="48"
                                                                        Margin="0,0,8,8"
                                                                        Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoMuteCommand}">
                                                                <CheckBoxEx.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource TrailerMuteToggleScaleStyle}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnDetailsView]}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBoxEx.Style>
                                                            </CheckBoxEx>

                                                            <CheckBoxEx x:Name="DescPanelToggle"
                                                                        Height="48"
                                                                        Width="48"
                                                                        Margin="0,0,8,8"
                                                                        FocusVisualStyle="{x:Null}">
                                                                <TextBlock Text="&#xef4e;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <CheckBoxEx.Style>
                                                                    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource DescPanelToggleScale}">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[DescVisible]}" Value="False"/>
                                                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="IsChecked" Value="False"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBoxEx.Style>
                                                            </CheckBoxEx>

                                                            <CheckBoxEx x:Name="ScreenshotUtilitiesToggle"
                                                                        Height="48"
                                                                        Width="48"
                                                                        Margin="0,0,8,8"
                                                                        FocusVisualStyle="{x:Null}">
                                                                <TextBlock Text="&#xec5f;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <CheckBoxEx.Style>
                                                                    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource DescPanelToggleScale}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="IsChecked" Value="False"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginSettings Plugin=ScreenshotUtilities, Path=CurrentScreenshotGroups.ScreenshotCount}" Value="0"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                            <DataTrigger Binding="{PluginStatus Plugin=ScreenshotUtilities_485d682f-73e9-4d54-b16f-b8dd49e88f90, Status=Installed}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBoxEx.Style>
                                                            </CheckBoxEx>

                                                            <ButtonEx x:Name="UpdatePanelToggle"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamGameNewsWindowCommand}"
                                                                      Margin="0,0,8,8"
                                                                      Style="{StaticResource GameOptionScaleStyle}"
                                                                      FocusVisualStyle="{x:Null}">
                                                                <TextBlock Text="&#xefa6;" FontSize="21" FontFamily="{DynamicResource FontIcoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ButtonEx>

                                                            <ButtonEx x:Name="GameLinksButton"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8"
                                                                      Style="{DynamicResource GameOptionScaleStyle}"
                                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenGameLinksWindowCommand}"
                                                                      ToolTip="{DynamicResource GameLinks_ButtonTooltip}"
                                                                      FocusVisualStyle="{x:Null}">
                                                                <TextBlock Text="&#xef71;"
                                                                           FontSize="21"
                                                                           FontFamily="{DynamicResource FontIcoFont}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </ButtonEx>

                                                            <ButtonEx x:Name="PART_ButtonOptions"
                                                                      Height="48"
                                                                      Width="48"
                                                                      Margin="0,0,8,8">
                                                                <ButtonEx.Style>
