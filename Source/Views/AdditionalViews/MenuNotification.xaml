<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Vue ControlCenter -->
    <Style x:Key="NotificationMenuWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=NotificationList}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          Opacity="0">

                        <Grid.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.20"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         From="-60" To="0"
                                                         Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid.Resources>

                            <!-- ==========================================================
                            NOTIFICATION ITEM STYLE
                            ========================================================== -->
                            <Style x:Key="NotificationListBoxItemStyle" TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="86"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <!-- NORMAL BACKGROUND -->
                                                <Border x:Name="NormalBackground"
                                                        CornerRadius="7"
                                                        Background="#14000000"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"/>

                                                <!-- FOCUS BACKGROUND -->
                                                <Border x:Name="MainBackground"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <!-- FOCUS BORDER -->
                                                <Border x:Name="MainBorder"
                                                        BorderThickness="2"
                                                        CornerRadius="7"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <!-- FLASH FX -->
                                                <Border x:Name="FlashMenuBorder"
                                                        CornerRadius="7"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <ContentPresenter Margin="14,10"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="NormalBackground" Property="Background" Value="#22000000"/>
                                                    <Setter TargetName="NormalBackground" Property="BorderBrush" Value="#26FFFFFF"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Grid.Resources>


                        <!-- FULLSCREEN DARK BACKDROP -->
                        <Border Background="#99000000"
                                Opacity="0"/>


                        <!-- MAIN PANEL -->
                        <Grid x:Name="QuickAccessPanel"
                              Width="562"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              RenderTransformOrigin="0.5,0.5"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained">

                            <!-- PANEL BACKGROUND -->
                            <Border Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="0,0,1,0">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"
                                                      Color="#000000"/>
                                </Border.Effect>
                            </Border>


                            <!-- INNER CONTENT -->
                            <Grid Margin="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Background="#33000000" Grid.Row="0" />
                                <Border Background="#33000000" Grid.Row="4" />

                                <!-- USER HEADER -->
                                <Grid Grid.Row="0"
                                      Height="80"
                                      Margin="22,10,22,10">

                                    <!-- TITLE -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCAnikiNotifications}"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{DynamicResource LOCRecentthemenotificationshistory}"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.75"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </Grid>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- NOTIFICATIONS LIST -->
                                <Grid Grid.Row="2"
                                      Margin="16,14,16,14">

                                    <ListBox x:Name="NotificationList"
                                             pbeh:FocusBahaviors.FocusBinding="True"
                                             ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=LastNotifications}"
                                             ItemContainerStyle="{StaticResource NotificationListBoxItemStyle}"
                                             Background="Transparent"
                                             BorderBrush="Transparent"
                                             BorderThickness="0"
                                             Focusable="True"
                                             IsTabStop="True"
                                             SelectedIndex="0"
                                             ScrollViewer.CanContentScroll="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             KeyboardNavigation.TabNavigation="Cycle"
                                             KeyboardNavigation.DirectionalNavigation="Contained"
                                             KeyboardNavigation.ControlTabNavigation="Contained"
                                             FocusVisualStyle="{x:Null}">

                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid FocusVisualStyle="{x:Null}" MinHeight="66">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- TEXTS -->
                                                    <Grid Grid.Column="0" FocusVisualStyle="{x:Null}"
                                                          VerticalAlignment="Center">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       FontSize="20"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DateString}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.45"
                                                                       Margin="10,2,0,0"
                                                                       VerticalAlignment="Top"/>

                                                        </Grid>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Message}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="18"
                                                                   Opacity="0.72"
                                                                   Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="38"/>

                                                        <TextBlock Grid.Row="2"
                                                                   x:Name="NotificationTypeText"
                                                                   Text="{Binding Type}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Opacity="0.38"
                                                                   Margin="0,6,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                    </Grid>

                                                </Grid>

                                                <DataTemplate.Triggers>

                                                    <DataTrigger Binding="{Binding Type}" Value="gameEnded">
                                                        <Setter TargetName="NotificationTypeText" Property="Text" Value="{DynamicResource LOCGAMESESSION}"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Type}" Value="steamUpdate">
                                                        <Setter TargetName="NotificationTypeText" Property="Text" Value="{DynamicResource LOCGAMEUPDATE}"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Type}" Value="playniteNews">
                                                        <Setter TargetName="NotificationTypeText" Property="Text" Value="{DynamicResource LOCPLUGINUPDATE}"/>
                                                    </DataTrigger>

                                                </DataTemplate.Triggers>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>


                                    <!-- EMPTY STATE -->
                                    <Grid x:Name="EmptyNotificationState"
                                          IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=NotificationList, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="28">

                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="42"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Opacity="0.35"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="{DynamicResource LOCNonotificationsyet}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.8"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,18,0,0"/>

                                            <TextBlock Text="{DynamicResource LOCRecentAnikinotifications}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="14"
                                                       Opacity="0.45"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Grid>

                                </Grid>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="3"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- FOOTER -->
                                <Grid Grid.Row="4"
                                      Height="58"
                                      Margin="22,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{DynamicResource LOCLASTANIKINOTIFICATIONS}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="B" Command="{Binding CloseCommand}"
                                                  Content="{DynamicResource LOCBackLabel}" />

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>
