<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Friend Achievements Global View -->
    <Style x:Key="FriendAchievementsGlobalWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid x:Name="FriendAchievementsGlobalRoot"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.FocusedElement="{Binding ElementName=FriendGamesList}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource SecondaryViewBackground}">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <!-- Background -->
                        <Grid>
                            <Border>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.12"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.88"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Setter Property="Tag" Value="{DynamicResource BackgroundImageIndex}" />
                                        <Setter Property="Background" Value="{DynamicResource FriendsImageDefault}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="100">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage100}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="101">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage101}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="102">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage102}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="103">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage103}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="104">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage104}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="105">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage105}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="149">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage149}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="151">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage151}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="152">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage152}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="153">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage153}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>

                                            <!-- Rare / Lucky Mode background override -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource FriendsViewImage150}"/>
                                                <Setter Property="Opacity" Value="0.25"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <!-- Top title -->
                        <Grid VerticalAlignment="Top"
                              Height="112"
                              IsHitTestVisible="False">

                            <Border HorizontalAlignment="Stretch"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource SeparatorTopBarBrush}"
                                    Opacity="0.35"/>

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{DynamicResource LOCFriendTrophies}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Typography.Capitals="AllSmallCaps"
                                           TextAlignment="Center"
                                           Opacity="0.96">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0.24"
                                                          Color="#000000"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="{DynamicResource LOCFriendTrophiesDescription}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Opacity="0.68"
                                           Margin="0,6,0,0"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sort / options button -->
                        <CheckBoxEx x:Name="FriendAchievementsGlobalSortButton"
                                    Margin="80,200,0,0"
                                    Width="60"
                                    Height="60"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Content="&#xE8CB;"
                                    Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendAchievementsGlobalOptionsWindow]}"
                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                    FontFamily="{DynamicResource FontIcons}"
                                    FontSize="22">
                            <CheckBoxEx.Style>
                                <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}"/>
                            </CheckBoxEx.Style>
                        </CheckBoxEx>

                        <!-- Main frame -->
                        <Border Width="1550"
                                Height="760"
                                Margin="0,150,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="24"
                                Background="{DynamicResource FriendsBannerBackgroundBrush}"
                                BorderBrush="{DynamicResource FriendsBannerBorder}"
                                BorderThickness="1"
                                Padding="20"
                                ClipToBounds="True">

                            <Grid KeyboardNavigation.DirectionalNavigation="Cycle"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  KeyboardNavigation.ControlTabNavigation="Cycle">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT : Friend selector -->
                                <Border Grid.Column="0"
                                        CornerRadius="22"
                                        Background="{DynamicResource SuccessMainCardBackground}"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1.5"
                                        Padding="14"
                                        ClipToBounds="True">

                                    <Grid>
                                        <Border CornerRadius="22"
                                                Opacity="0.92"
                                                Background="{DynamicResource BackgroundItem}" />

                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Orientation="Vertical"
                                                        Margin="4,0,4,0">

                                                <TextBlock Text="{DynamicResource LOCFriendsAchievementsFriends}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"/>

                                                <TextBlock Text="{DynamicResource LOCSelectAProfile}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                           FontSize="16"
                                                           Opacity="0.62"
                                                           Margin="0,4,0,0"
                                                           HorizontalAlignment="Left"/>
                                            </StackPanel>

                                            <ListBox x:Name="FriendGlobalScopeList"
                                                     Grid.Row="2"
                                                     ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeUserOptions}"
                                                     SelectedValuePath="Key"
                                                     SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeUserKey, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FocusVisualStyle="{x:Null}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     KeyboardNavigation.DirectionalNavigation="Continue"
                                                     KeyboardNavigation.TabNavigation="Continue"
                                                     KeyboardNavigation.ControlTabNavigation="Continue">

                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Focusable" Value="True"/>
                                                        <Setter Property="IsTabStop" Value="True"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="FriendCard"
                                                                            Height="72"
                                                                            CornerRadius="16"
                                                                            Background="{DynamicResource SuccessFriendsBackgroundBrush}"
                                                                            BorderBrush="#18FFFFFF"
                                                                            BorderThickness="1"
                                                                            Padding="10,8">

                                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Stretch"/>
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="FriendCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            <Setter TargetName="FriendCard" Property="BorderThickness" Value="2.5"/>
                                                                        </Trigger>

                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="FriendCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            <Setter TargetName="FriendCard" Property="BorderThickness" Value="2.5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicFriendScopeUserCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch"
                                                                  Padding="0"
                                                                  IsTabStop="True"
                                                                  Focusable="True">

                                                            <!-- ListBoxItem owns the only visible focus border. -->
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Stretch"/>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>

                                                            <ButtonEx.Content>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="52"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Friend avatar / fallback -->
                                                                    <Grid Grid.Column="0"
                                                                          Width="42"
                                                                          Height="42"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left">

                                                                        <Border Width="42"
                                                                                Height="42"
                                                                                CornerRadius="21"
                                                                                Background="#26000000"
                                                                                BorderBrush="#22FFFFFF"
                                                                                BorderThickness="1"/>

                                                                        <TextBlock Text="?"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Opacity="0.65"/>

                                                                        <!-- Replace AvatarPath when jdd confirms the exact binding -->
                                                                        <Border Width="42"
                                                                                Height="42"
                                                                                CornerRadius="21"
                                                                                ClipToBounds="True">
                                                                            <Image Source="{Binding AvatarPath}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                                        </Border>
                                                                    </Grid>

                                                                    <StackPanel Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="8,0,12,0">

                                                                        <TextBlock Text="{Binding Label}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="205"/>

                                                                        <TextBlock Text="{DynamicResource LOCAchievementProfile}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="12"
                                                                                   Opacity="0.42"
                                                                                   Margin="0,3,0,0"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="205"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="2"
                                                                            Background="{DynamicResource SeparatorSuccessBrush}"
                                                                            CornerRadius="10"
                                                                            Padding="9,5"
                                                                            VerticalAlignment="Center"
                                                                            MinWidth="58">

                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding CollectionLevel, StringFormat=Lv {0}, FallbackValue=Lv --, TargetNullValue=Lv --}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding CollectionScore, StringFormat=Score {0}, FallbackValue=Score --, TargetNullValue=Score --}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="10"
                                                                                       Opacity="0.62"
                                                                                       Margin="0,1,0,0"
                                                                                       HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </ButtonEx.Content>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- RIGHT : Game achievement summaries -->
                                <Border Grid.Column="2"
                                        CornerRadius="22"
                                        Background="{DynamicResource SuccessMainCardBackground}"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1.5"
                                        Padding="14"
                                        ClipToBounds="True">

                                    <Grid>
                                        <Border CornerRadius="22"
                                                Opacity="0.92"
                                                Background="{DynamicResource BackgroundItem}" />

                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0"
                                                  Margin="4,0,4,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Orientation="Vertical">

                                                    <TextBlock Text="{Binding SelectedItem.Label, ElementName=FriendGlobalScopeList, FallbackValue=Selected Friend}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                               FontSize="30"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="760"/>

                                                    <TextBlock Text="{DynamicResource LOCFriendsAchievementsGamesWithAchievements}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                               FontSize="16"
                                                               Opacity="0.62"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource SeparatorSuccessBrush}"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="14,7"
                                                        VerticalAlignment="Center">

                                                    <!-- Keep friend trophy bindings separate for PA compatibility. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">

                                                        <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>

                                                        <TextBlock Text="{Binding DynamicFriendScopeSummary.TotalUltraRare, FallbackValue=0, TargetNullValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <Image Source="{ThemeFile 'Images/Or.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{Binding DynamicFriendScopeSummary.TotalRareAndUltraRare.Unlocked, FallbackValue=0, TargetNullValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{Binding DynamicFriendScopeSummary.TotalUncommon.Unlocked, FallbackValue=0, TargetNullValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{Binding DynamicFriendScopeSummary.TotalCommon.Unlocked, FallbackValue=0, TargetNullValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <ListView x:Name="FriendGamesList"
                                                      Grid.Row="2"
                                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummaries}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      FocusVisualStyle="{x:Null}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                      ScrollViewer.CanContentScroll="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      VirtualizingPanel.ScrollUnit="Item"
                                                      VirtualizingPanel.CacheLength="1"
                                                      VirtualizingPanel.CacheLengthUnit="Item"
                                                      KeyboardNavigation.DirectionalNavigation="Continue"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.ControlTabNavigation="Continue">

                                                <ListView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListView.ItemsPanel>

                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListViewItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListView.ItemContainerStyle>

                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- TODO: open friend achievements after setting PA game scope. -->
                                                        <ButtonEx Command="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicFriendScopeGameCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Height="148"
                                                                  Margin="0,0,0,0"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch"
                                                                  Padding="0"
                                                                  IsTabStop="True"
                                                                  Focusable="True">

                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Grid>
                                                                        <Border x:Name="Shadow"
                                                                                CornerRadius="18"
                                                                                Background="Transparent"
                                                                                Opacity="0">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect BlurRadius="18"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.40"/>
                                                                            </Border.Effect>
                                                                        </Border>

                                                                        <Border x:Name="ItemRoot"
                                                                                CornerRadius="18"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1.2"
                                                                                SnapsToDevicePixels="True">

                                                                            <Grid>
                                                                                <Border x:Name="FocusOverlay"
                                                                                        CornerRadius="18"
                                                                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                                        Opacity="0"
                                                                                        IsHitTestVisible="False"/>

                                                                                <Border x:Name="CardGradient"
                                                                                        CornerRadius="18"
                                                                                        Opacity="0.92"
                                                                                        Background="{DynamicResource BackgroundItem}" />

                                                                                <Border CornerRadius="18"
                                                                                        Opacity="0.14"
                                                                                        IsHitTestVisible="False">
                                                                                    <Border.Background>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                                                                                            <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Border.Background>
                                                                                </Border>

                                                                                <Border x:Name="FocusFill"
                                                                                        CornerRadius="18"
                                                                                        Background="{DynamicResource FocusFriendsCardBackgroundBrush}"
                                                                                        Opacity="0"
                                                                                        IsHitTestVisible="False"/>

                                                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                                                  VerticalAlignment="Stretch"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource FocusFriendsCardBorder}"/>
                                                                            <Setter TargetName="ItemRoot" Property="BorderThickness" Value="2.2"/>
                                                                            <Setter TargetName="FocusFill" Property="Opacity" Value="0.20"/>
                                                                            <Setter TargetName="Shadow" Property="Opacity" Value="1"/>
                                                                            <Setter TargetName="CardGradient" Property="Opacity" Value="1"/>
                                                                            <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>

                                                            <ButtonEx.Content>
                                                                <Grid Margin="14,10,18,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="420"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- COVER / FALLBACK -->
                                                                    <Grid Grid.Column="0"
                                                                          Margin="0,0,8,0"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left">

                                                                        <Border Width="92"
                                                                                Height="92"
                                                                                CornerRadius="16"
                                                                                Background="#22000000"
                                                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                BorderThickness="1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                ClipToBounds="True">

                                                                            <Grid>
                                                                                <TextBlock Text="&#xE7FC;"
                                                                                           FontFamily="{DynamicResource FontIcons}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           FontSize="30"
                                                                                           Opacity="0.45"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>

                                                                                <!-- Keep PA cover test binding. -->
                                                                                <Image Source="{Binding CoverImagePath}"
                                                                                       Stretch="UniformToFill"
                                                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- INFOS -->
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="8,0,28,0"
                                                                                VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding GameName}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   Opacity="0.92"
                                                                                   FontSize="26"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxWidth="760"/>

                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Margin="0,10,0,0"
                                                                                    VerticalAlignment="Center">

                                                                            <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                                                    Padding="14,4"
                                                                                    CornerRadius="13"
                                                                                    HorizontalAlignment="Left"
                                                                                    BorderBrush="#18FFFFFF"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Text="{Binding ProviderKey}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="16"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                            </Border>

                                                                            <TextBlock Text="{Binding LastFriendUnlockLocal, StringFormat='  Last unlock: {0}'}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="15"
                                                                                       Opacity="0.65"
                                                                                       Margin="14,4,0,0"
                                                                                       VerticalAlignment="Center"/>


                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- PROGRESSION + TROPHIES -->
                                                                    <Grid Grid.Column="2"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right">

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="155"/>
                                                                            <ColumnDefinition Width="14"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- progression -->
                                                                        <StackPanel Grid.Column="0"
                                                                                    VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Right">

                                                                            <StackPanel Orientation="Horizontal"
                                                                                        HorizontalAlignment="Right">

                                                                                <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                                                       RenderOptions.BitmapScalingMode="Fant"
                                                                                       Margin="0,0,8,0"
                                                                                       Width="30"
                                                                                       Height="30"
                                                                                       VerticalAlignment="Center">
                                                                                    <Image.Style>
                                                                                        <Style TargetType="Image">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Image.Style>
                                                                                </Image>

                                                                                <TextBlock Text="{Binding ProgressionText}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           FontSize="24"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Right"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>



                                                                            <TextBlock Text="{Binding UnlockedAchievements, StringFormat='{}{0} unlocked'}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="13"
                                                                                       Opacity="0.65"
                                                                                       Margin="0,2,0,0"
                                                                                       HorizontalAlignment="Right"/>
                                                                        </StackPanel>

                                                                        <!-- completed / platinum style -->
                                                                        <StackPanel Grid.Column="2"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="0,0,0,0">

                                                                            <Image Source="{ThemeFile 'Images/Or.png'}"
                                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                                   Width="32"
                                                                                   Height="32"
                                                                                   VerticalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding Points}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="21"
                                                                                       Margin="6,0,0,0"
                                                                                       MinWidth="24"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <!-- silver / unique unlocked -->
                                                                        <StackPanel Grid.Column="3"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="20,0,0,0">

                                                                            <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                                   Width="32"
                                                                                   Height="32"
                                                                                   VerticalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding UniqueFriendUnlockedAchievementsCount}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="21"
                                                                                       Margin="6,0,0,0"
                                                                                       MinWidth="24"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <!-- bronze / unlocked only -->
                                                                        <StackPanel Grid.Column="4"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="20,0,0,0">

                                                                            <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                                   Width="32"
                                                                                   Height="32"
                                                                                   VerticalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding UnlockedAchievements}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="21"
                                                                                       Margin="6,0,0,0"
                                                                                       MinWidth="24"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </ButtonEx.Content>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom prompt -->
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Height="80"
                              Margin="0,0,0,0">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Effect="{DynamicResource SoftTextShadow}"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,20,10">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="ConfirmAction"
                                          Content="{DynamicResource LOCButtonPrompt_Select}" />

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="CancelAction"
                                          Command="{Binding CloseCommand}"
                                          Content="{DynamicResource LOCBackLabel}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Friend Achievements Global Options - Games view -->
    <Style x:Key="FriendAchievementsGlobalOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">

                        <Border x:Name="FriendTrophiesMenu"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource OverlayMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource HeaderMenu}">

                                    <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <TextBlock Text="{DynamicResource LOCFriendTrophiesOptions}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <TextBlock Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ButtonEx Content="{DynamicResource LOCLast10Achievements}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendsActivityWindow]}"
                                                  Height="56"
                                                  Margin="0,0,0,10"
                                                  Focusable="True"
                                                  IsTabStop="True"/>

                                        <ButtonEx Content="{DynamicResource LOCFriendGames}"
                                                  Height="56"
                                                  Margin="0,0,0,18"
                                                  Focusable="True"
                                                  IsTabStop="True"/>

                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,16"/>

                                        <TextBlock Text="{DynamicResource LOCFriendsAchievementsGamesSorting}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <TextBlock Text="{DynamicResource LOCFilter}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesFilterOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesFilterKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCDirection}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortDirectionOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortDirectionKey, Mode=TwoWay}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Opacity="0.75">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="A"
                                                  Content="{DynamicResource LOCButtonPrompt_Select}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
