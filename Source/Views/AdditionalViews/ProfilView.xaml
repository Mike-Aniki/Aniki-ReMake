                                                <Setter Property="Background" Value="{DynamicResource StatViewImage103}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="104">
