                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource LOCProfile}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextTitleStatViewBrush}"
                                               FontSize="40"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource LOCPlayerIdentity}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextTitleStatViewBrush}"
                                               FontSize="20"
                                               Opacity="0.80"
                                               Margin="0,4,0,0"/>
                                </StackPanel>


                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            Margin="0,30,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PlayerProfileRoot, Path=Tag}" Value="Page4">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="{DynamicResource LOCHubLatestCapturesTitle}"
                                               HorizontalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardTitleBrush}"
                                               FontSize="36"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{DynamicResource LOCHubLatestCapturesSubtitle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardTitleBrush}"
                                               FontSize="18"
                                               Opacity="0.72"/>
                                </StackPanel>

                                <Image Grid.Column="2"
                                       Source="{ThemeFile 'Images/Aniki.png'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Height="110"
                                       Opacity="0.60"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="Fant"/>
                            </Grid>

                            <!-- PAGES -->
                            <Grid Grid.Row="1">
                                <Grid x:Name="PlayerProfileViewport"
                                      Height="5000"
                                      VerticalAlignment="Top"
                                      ClipToBounds="True"
                                      KeyboardNavigation.TabNavigation="Continue"
                                      KeyboardNavigation.DirectionalNavigation="Continue">

                                    <Grid x:Name="PlayerProfilePagesContainer"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="PlayerProfilePagesTranslate" Y="0"/>
                                        </Grid.RenderTransform>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                        </Grid.RowDefinitions>

                                        <!-- PAGE 1 -->
                                        <Grid x:Name="PlayerProfilePage1"
                                              Grid.Row="0"
                                              Height="1000"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="GotKeyboardFocus">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayerProfileRoot"
                                                                                           Storyboard.TargetProperty="Tag">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Page1"/>
                                                            </ObjectAnimationUsingKeyFrames>

                                                            <DoubleAnimation Storyboard.TargetName="PlayerProfilePagesTranslate"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="0"
                                                                             Duration="0:0:0.30">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="750"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="750"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="500"/>
                                            </Grid.RowDefinitions>

                                            <!-- HERO -->
                                            <Grid x:Name="PlayerHeroHeader"
                                                  Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="5"
                                                  Margin="0,0,0,0"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- TOP CONTENT -->
                                                <Grid Grid.Row="0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>



                                                    <!-- AVATAR -->
                                                    <Grid Grid.Column="0"
                                                          Width="150"
                                                          Height="150"
                                                          VerticalAlignment="Top"
                                                          HorizontalAlignment="Left"
                                                          Margin="0,8,24,0">

                                                        <!-- masque rond -->
                                                        <Border x:Name="AvatarMask"
                                                                Width="150"
                                                                Height="150"
                                                                Background="Black"
                                                                CornerRadius="75"/>



                                                        <!-- image user masquée en rond -->
                                                        <Grid Width="150"
                                                              Height="150"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                            <Grid.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=AvatarMask}" />
                                                            </Grid.OpacityMask>

                                                            <TextBlock x:Name="ProfilePicturePath"
                                                                       Tag="{Api Paths.ConfigurationPath}"
                                                                       Visibility="Collapsed">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text">
                                                                            <Setter.Value>
                                                                                <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                                    <Binding Path="Tag"
                                                                                             RelativeSource="{RelativeSource Self}" />
                                                                                </MultiBinding>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Control x:Name="UserAvatar"
                                                                     Tag="{Binding ElementName=ProfilePicturePath, Path=Text}"
                                                                     Width="150"
                                                                     Height="150"
                                                                     Template="{StaticResource SteamSelfAvatarTemplate}"
                                                                     Focusable="False"
                                                                     IsTabStop="False"
                                                                     IsHitTestVisible="False"/>
                                                        </Grid>

                                                        <!-- contour rond -->
                                                        <Border Width="150"
                                                                Height="150"
                                                                CornerRadius="75"
                                                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                                                BorderThickness="2"
                                                                Background="#23000000"
                                                                IsHitTestVisible="False"
                                                                Panel.ZIndex="5"/>
                                                    </Grid>

                                                    <!-- INFOS -->
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                Margin="-15,0,0,0">

                                                        <TextBlock Text="{DynamicResource UserName}"
                                                                   Margin="0,0,0,0"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource TextTitleStatViewBrush}"
                                                                   FontSize="48"
                                                                   FontWeight="Bold"
                                                                   TextAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="620"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=ProfileGenreLabel}"
                                                                   Margin="0,10,0,0"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="620"
                                                                   Opacity="0.96"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,10,0,0"
                                                                    VerticalAlignment="Center">

                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>

                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                                <Condition Binding="{PluginStatus Plugin=SuccessStoryFullscreenHelper, Status=Installed}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <!-- LEVEL / GAMERSCORE RANK IMAGE : PA / SSHELPER -->
                                                            <Grid Width="34"
                                                                  Height="34"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center">

                                                                <!-- PLAYNITE ACHIEVEMENTS -->
                                                                <Border Width="34"
                                                                        Height="34"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        RenderOptions.BitmapScalingMode="Fant">

                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource PA_UserLevelBorderStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>

                                                                <!-- SSHELPER FALLBACK -->
                                                                <Border Width="34"
                                                                        Height="34"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        RenderOptions.BitmapScalingMode="Fant">

                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource SSHelper_UserLevelBorderStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                                        <Condition Binding="{PluginStatus Plugin=SuccessStoryFullscreenHelper, Status=Installed}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Margin="2,1,0,0"
                                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel}"
                                                                       Foreground="{DynamicResource TextTitleStatViewBrush}"
                                                                       FontSize="24"
                                                                       Opacity="0.82"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Margin="2,0,0,1"
                                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorScore}"
                                                                       Foreground="{DynamicResource TextTitleStatViewBrush}"
                                                                       FontSize="24"
                                                                       Opacity="0.82"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Margin="10,1,0,0"
                                                                       Text="{PluginSettings Plugin=SSHelper, Path=GSLevel}"
                                                                       Foreground="{DynamicResource TextTitleStatViewBrush}"
                                                                       FontSize="24"
                                                                       Opacity="0.82"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                                    <Condition Binding="{PluginStatus Plugin=SuccessStoryFullscreenHelper, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Margin="8,0,0,1"
                                                                       Text="{PluginSettings Plugin=SSHelper, Path=GSScore}"
                                                                       Foreground="{DynamicResource TextTitleStatViewBrush}"
                                                                       FontSize="24"
                                                                       Opacity="0.82"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                                    <Condition Binding="{PluginStatus Plugin=SuccessStoryFullscreenHelper, Status=Installed}" Value="True"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- LIBRARY CHIPS -->
                                                <UniformGrid Grid.Row="1"
                                                             Rows="2"
                                                             Columns="5"
                                                             Width="1500"
                                                             Height="190"
                                                             Margin="0,26,0,0"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top">

                                                    <!-- TOTAL GAMES -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCAllGames}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=TotalCount}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- INSTALLED -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCGameIsInstalledTitle}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=InstalledCount}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- FAVORITE -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCGameFavoriteTitle}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FavoriteCount}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- HIDDEN -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCGameHiddenTitle}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=HiddenCount}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- TOTAL PLAYTIME -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCStatsTotalPlayTime}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=TotalPlaytimeString}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- MONTHLY PLAYTIME -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCStatsMonthPlayTime}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=ThisMonthPlayedTotalString}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- PLAYED THIS MONTH -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCPlayedThisMonth}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=ThisMonthPlayedCount}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- AVERAGE PLAYTIME -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCStatsAveragePlaytime}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=AveragePlaytimeString}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- TOTAL TROPHIES -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Top">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>

                                                                <TextBlock Text="{DynamicResource LOCStatsTotalTrophiesUnlocked}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=GSTotal}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                            </StackPanel>

                                                            <StackPanel VerticalAlignment="Top">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                                    <Condition Binding="{PluginStatus Plugin=SuccessStoryFullscreenHelper, Status=Installed}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>

                                                                <TextBlock Text="{DynamicResource LOCStatsTotalTrophiesUnlocked}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                                <TextBlock Text="{PluginSettings Plugin=SSHelper, Path=GSTotal}" Style="{StaticResource ProfileStatValueStyle}" FontSize="22"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- TOP FRANCHISE -->
                                                    <Border Margin="6" Padding="14,12" CornerRadius="14" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{DynamicResource LOCTopFranchise}" Style="{StaticResource ProfileStatLabelStyle}"/>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=ProfileTopFranchiseName}"
                                                                       Style="{StaticResource ProfileStatValueStyle}"
                                                                       FontSize="22"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                </UniformGrid>
                                            </Grid>

                                            <!-- MOST PLAYED -->
                                            <Grid x:Name="ProfileMostPlayedYear"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Width="750"
                                                  Height="470"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top"
                                                  Margin="0,20,0,0">


                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="750"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{DynamicResource LOCMostPlayedThisYear}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextHubBannerCardTitleBrush}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,0"/>

                                                <ButtonEx x:Name="MostPlayedCard"
                                                          Grid.Row="1"
                                                          Grid.Column="1"
                                                          Focusable="True"
                                                          IsTabStop="True"
                                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                          pbeh:FocusBahaviors.FocusBinding="True"
                                                          Height="400"
                                                          FocusVisualStyle="{x:Null}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenGameDetailsCommand}"
                                                          CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameId}"
                                                          Style="{StaticResource HubCardFocusButtonStyle}">


                                                    <Border CornerRadius="20"
                                                            Style="{DynamicResource HubCardBorderStyle}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- IMAGE + FALLBACK -->
                                                            <Border Grid.Row="0"
                                                                    CornerRadius="20,20,0,0">
                                                                <Border.OpacityMask>
                                                                    <VisualBrush Visual="{Binding ElementName=CoverMask}"
                                                                                 Stretch="Fill"
                                                                                 RenderOptions.BitmapScalingMode="Fant"
                                                                                 RenderOptions.CachingHint="Cache" />
                                                                </Border.OpacityMask>

                                                                <Grid>
                                                                    <Border x:Name="CoverMask"
                                                                            CornerRadius="20,20,0,0"
                                                                            Background="{DynamicResource HubCardMaskImageBrush}" />

                                                                    <TextBlock x:Name="ThisYearTopGameBackgroundPathText"
                                                                               Text="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameBackgroundPath}"
                                                                               Visibility="Collapsed"/>

                                                                    <Image x:Name="BgReal"
                                                                           RenderOptions.BitmapScalingMode="Fant"
                                                                           Height="346"
                                                                           Stretch="UniformToFill">
                                                                        <Image.Source>
                                                                            <Binding ElementName="ThisYearTopGameBackgroundPathText"
                                                                                     Path="Text"
                                                                                     IsAsync="True"/>
                                                                        </Image.Source>
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameBackgroundPath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameBackgroundPath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Grid Panel.ZIndex="2">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameBackgroundPath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>

                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameBackgroundPath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>

                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameName}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>

                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ThisYearTopGameName}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>

                                                                        <Border x:Name="FallbackImageMask_MostPlayedYear"
                                                                                Background="Black"
                                                                                CornerRadius="20,20,0,0"/>

