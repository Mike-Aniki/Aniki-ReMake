                                                        <UniformGrid Grid.Row="1"
                                                                     Rows="2"
                                                                     Columns="4">

                                                            <!-- TOTAL GAMES -->
                                                            <Border Margin="6"
                                                                    Padding="14,12"
                                                                    CornerRadius="14"
                                                                    Background="#18FFFFFF"
                                                                    BorderBrush="#22FFFFFF"
