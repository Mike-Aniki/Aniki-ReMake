                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="133">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage133}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="134">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage134}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="135">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage135}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="136">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage136}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="137">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage137}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="138">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage138}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="139">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage139}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="140">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage140}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <Grid Margin="60,30,60,40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid Grid.Row="0" Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource LOCProfile}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextTitleStatViewBrush}"
                                               FontSize="40"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Player identity and highlights"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextTitleStatViewBrush}"
                                               FontSize="20"
                                               Opacity="0.80"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Image Grid.Column="2"
                                       Source="{ThemeFile 'Images/Aniki.png'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Height="110"
                                       Opacity="0.60"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="Fant"/>
                            </Grid>

                            <!-- PAGES -->
                            <Grid Grid.Row="1">
                                <Grid x:Name="PlayerProfileViewport"
                                      Height="3000"
                                      VerticalAlignment="Top"
                                      ClipToBounds="True"
                                      KeyboardNavigation.TabNavigation="Continue"
                                      KeyboardNavigation.DirectionalNavigation="Continue">

                                    <Grid x:Name="PlayerProfilePagesContainer"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="PlayerProfilePagesTranslate" Y="0"/>
                                        </Grid.RenderTransform>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                            <RowDefinition Height="1000"/>
                                        </Grid.RowDefinitions>

                                        <!-- PAGE 1 -->
                                        <Grid x:Name="PlayerProfilePage1"
                                              Grid.Row="0"
                                              Height="1000"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="GotKeyboardFocus">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayerProfileRoot"
                                                                                           Storyboard.TargetProperty="Tag">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Page1"/>
                                                            </ObjectAnimationUsingKeyFrames>

                                                            <DoubleAnimation Storyboard.TargetName="PlayerProfilePagesTranslate"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="0"
                                                                             Duration="0:0:0.30">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- HERO -->
                                            <Grid x:Name="PlayerHeroHeader"
                                                  Grid.Row="0"
                                                  Margin="0,26,0,60"
                                                  Height="270"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- TOP CONTENT -->
                                                <Grid Grid.Row="0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- AVATAR -->
                                                    <Grid Grid.Column="0"
                                                          Width="150"
                                                          Height="150"
                                                          VerticalAlignment="Top"
                                                          HorizontalAlignment="Left"
                                                          Margin="0,8,24,0">

                                                        <!-- masque rond -->
                                                        <Border x:Name="AvatarMask"
                                                                Width="150"
                                                                Height="150"
                                                                Background="Black"
                                                                CornerRadius="75"/>

                                                        <!-- fallback avatar rond -->
                                                        <Border Width="150"
                                                                Height="150"
                                                                CornerRadius="75"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource Avatar0}"/>
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=UserAvatarLogin, Path=Source}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[AvatarImageIndex]}"
                                                                                     Value="1">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Avatar0}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[AvatarImageIndex]}"
                                                                                     Value="2">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Avatar2}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[AvatarImageIndex]}"
                                                                                     Value="3">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Avatar3}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[AvatarImageIndex]}"
                                                                                     Value="4">
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Avatar4}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[AvatarImageIndex]}"
                                                                                     Value="5">
