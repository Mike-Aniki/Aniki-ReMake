                                                <Setter Property="Background" Value="{DynamicResource StatViewImage107}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="108">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage108}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="109">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage109}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="110">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage110}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="111">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage111}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="112">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage112}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="113">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage113}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="114">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage114}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="115">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage115}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="116">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage116}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="117">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage117}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="118">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage118}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="119">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage119}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="120">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage120}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="121">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage121}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="122">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage122}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="123">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage123}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="124">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage124}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="125">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage125}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="126">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage126}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="127">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage127}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="128">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage128}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
