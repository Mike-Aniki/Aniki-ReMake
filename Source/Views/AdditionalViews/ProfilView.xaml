                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayerProfileRoot"
                                                                                           Storyboard.TargetProperty="Tag">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Page2"/>
                                                            </ObjectAnimationUsingKeyFrames>

                                                            <DoubleAnimation Storyboard.TargetName="PlayerProfilePagesTranslate"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="-1000"
                                                                             Duration="0:0:0.30">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
