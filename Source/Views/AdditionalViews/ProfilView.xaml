                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="130">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage130}"/>
                                                <Setter Property="Opacity" Value="0.1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="131">
                                                <Setter Property="Background" Value="{DynamicResource StatViewImage131}"/>
