                                                                    Padding="14,12"
                                                                    CornerRadius="14"
                                                                    Background="#18FFFFFF"
                                                                    BorderBrush="#22FFFFFF"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="34"/>
                                                                        <RowDefinition Height="*"/>
