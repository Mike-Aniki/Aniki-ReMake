                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LIBRARY STATUS -->
                                                <ButtonEx x:Name="PlayerLibraryStatusCard"
                                                          FocusVisualStyle="{x:Null}"
