<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="{ThemeFile 'DerivedStyles/WelcomeHubResources.xaml'}" />
    </ResourceDictionary.MergedDictionaries>

    <!--Vue Profil-->
    <Style x:Key="PlayerProfileWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>

                        <DropShadowEffect x:Key="ProfileCardShadow"
                                          Color="#000000"
                                          ShadowDepth="0"
                                          Opacity="0.30"/>

                        <Style x:Key="ProfileChip" TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>

                        <Style x:Key="ProfileCardTitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                        </Style>

                        <Style x:Key="ProfileCardBodyText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                        </Style>

                        <Style x:Key="ProfileStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Opacity" Value="0.80"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>

                        <Style x:Key="ProfileStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="28"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                        </Style>

                        <Style x:Key="PlayerProfileCardStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                            <Setter Property="Padding" Value="18"/>
                            <Setter Property="Background" Value="{DynamicResource BannerStatsBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Effect" Value="{StaticResource ProfileCardShadow}"/>
                        </Style>

                        <Style x:Key="PlayerProfileFocusableCardStyle"
                               TargetType="Border"
                               BasedOn="{StaticResource PlayerProfileCardStyle}">
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="{DynamicResource BackgroundItem}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="2.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="PlayerProfileFocusableCardButtonStyle"
                               TargetType="ButtonEx">
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="{DynamicResource BackgroundItem}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="18"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardBorder"
                                                Margin="10"
                                                CornerRadius="22"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True"
                                                Effect="{StaticResource ProfileCardShadow}"
                                                RenderTransformOrigin="0.5,0.5">

                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                                <Setter TargetName="CardBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource FocusGameBorderBrush}"/>

                                                <Setter TargetName="CardBorder"
                                                        Property="BorderThickness"
                                                        Value="3"/>

                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.018"
                                                                             Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.018"
                                                                             Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>

                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1"
                                                                             Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>

                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="ProfileMiniTileStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="Background" Value="#18FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>

                        <Style x:Key="ProfileMiniValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                        </Style>

                        <DataTemplate x:Key="PlayerProfileTopPlayedTemplate">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding PercentageString}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ProfileCardBodyText}"
                                           Opacity="0.85"/>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,10,0"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource ProfileCardBodyText}"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PlaytimeString}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ProfileCardBodyText}"/>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="PlayerProfileThreeColTemplate">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding PercentageString}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ProfileCardBodyText}"
                                           Opacity="0.85"/>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,10,0"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource ProfileCardBodyText}"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ProfileCardBodyText}"/>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="PlayerProfileTwoColTemplate">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource ProfileCardBodyText}"/>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Text="{Binding Value}"
                                           Style="{StaticResource ProfileCardBodyText}"
                                           Opacity="0.85"/>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="PlayerProfileOneColTemplate">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="6"
                                         Height="6"
                                         Fill="#90FFFFFF"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource ProfileCardBodyText}"/>
                            </Grid>
                        </DataTemplate>

