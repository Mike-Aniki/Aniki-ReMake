                                                <ButtonEx x:Name="PlayerRecentPlayedCard"
                                                          FocusVisualStyle="{x:Null}"
                                                          Grid.Column="0"
                                                          Padding="0"
                                                          Style="{StaticResource PlayerProfileFocusableCardButtonStyle}"
                                                          Height="300">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- BACKGROUND -->
                                                        <Border Grid.RowSpan="2"
                                                                CornerRadius="22">
                                                            <Border.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=PlayerRecentPlayedMask}"
                                                                             Stretch="Fill"
                                                                             RenderOptions.BitmapScalingMode="Fant"
                                                                             RenderOptions.CachingHint="Cache" />
                                                            </Border.OpacityMask>

                                                            <Grid>
                                                                <!-- mask -->
                                                                <Border x:Name="PlayerRecentPlayedMask"
                                                                        CornerRadius="22"
                                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                                <!-- base -->
                                                                <Border CornerRadius="22"
                                                                        Background="{DynamicResource BannerStatsBackgroundBrush}" />

                                                                <!-- image -->
                                                                <Grid ClipToBounds="True">
                                                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayedBackgroundPath}"
                                                                           Stretch="UniformToFill"
                                                                           VerticalAlignment="Center"
                                                                           Opacity="0.95"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayedBackgroundPath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayedBackgroundPath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- fallback -->
                                                                    <Image Source="{ThemeFile 'Images/NoBackground.png'}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayedBackgroundPath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayedBackgroundPath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>

                                                                <!-- voile -->
                                                                <Border CornerRadius="22" Opacity="0.92" Background="{DynamicResource BackgroundItem}" />


                                                                <!-- highlight -->
                                                                <Border CornerRadius="22"
                                                                        Opacity="0.14"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                                            <GradientStop Color="#00FFFFFF" Offset="0.40"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- CONTENT -->
                                                        <Grid Margin="18">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{DynamicResource LOCStatsRecentPlayed}"
                                                                       Style="{StaticResource ProfileCardTitleText}"
                                                                       Margin="0,0,0,12"/>

                                                            <ItemsControl Grid.Row="1"
                                                                          Focusable="False"
                                                                          ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=RecentPlayed}"
                                                                          ItemTemplate="{StaticResource PlayerProfileTwoColTemplate}">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Margin" Value="0,3"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </ButtonEx>

                                                <!-- NEVER PLAYED -->
                                                <ButtonEx x:Name="PlayerNeverPlayedCard"
                                                          FocusVisualStyle="{x:Null}"
                                                          Grid.Column="2"
                                                          Style="{StaticResource PlayerProfileFocusableCardButtonStyle}"
                                                          Padding="0"
                                                          Height="300">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- BACKGROUND -->
                                                        <Border Grid.RowSpan="2"
                                                                CornerRadius="22">
                                                            <Border.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=PlayerNeverPlayedMask}"
                                                                             Stretch="Fill"
                                                                             RenderOptions.BitmapScalingMode="Fant"
                                                                             RenderOptions.CachingHint="Cache" />
                                                            </Border.OpacityMask>

                                                            <Grid>
                                                                <!-- mask -->
                                                                <Border x:Name="PlayerNeverPlayedMask"
                                                                        CornerRadius="22"
                                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                                <!-- base -->
                                                                <Border CornerRadius="22"
                                                                        Background="{DynamicResource BannerStatsBackgroundBrush}" />

                                                                <!-- image -->
                                                                <Grid ClipToBounds="True">
                                                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=HubNeverPlayedBackgroundPath}"
                                                                           Stretch="UniformToFill"
                                                                           VerticalAlignment="Center"
                                                                           Opacity="1"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubNeverPlayedBackgroundPath}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubNeverPlayedBackgroundPath}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>

                                                                <!-- dark readable overlay -->
                                                                <Border CornerRadius="22" Opacity="0.92" Background="{DynamicResource BackgroundItem}" />


                                                                <!-- soft top highlight -->
                                                                <Border CornerRadius="22"
                                                                        Opacity="0.14"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                                            <GradientStop Color="#00FFFFFF" Offset="0.40"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- CONTENT -->
                                                        <Grid Margin="18">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{DynamicResource LOCStatsNeverPlayed}"
                                                                       Style="{StaticResource ProfileCardTitleText}"
                                                                       Margin="0,0,0,12"/>

                                                            <ItemsControl Grid.Row="1"
                                                                          Focusable="False"
                                                                          ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=NeverPlayed}"
                                                                          ItemTemplate="{StaticResource PlayerProfileOneColTemplate}">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Margin" Value="0,3"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </ButtonEx>
                                            </Grid>
                                        </Grid>

                                        <!-- PAGE 3 -->
                                        <Grid x:Name="PlayerProfilePage3"
                                              Grid.Row="2"
                                              Height="1000"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="GotKeyboardFocus">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayerProfileRoot"
                                                                                           Storyboard.TargetProperty="Tag">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Page3"/>
                                                            </ObjectAnimationUsingKeyFrames>

                                                            <DoubleAnimation Storyboard.TargetName="PlayerProfilePagesTranslate"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="-1960"
                                                                             Duration="0:0:0.30">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- TOP ROW -->
                                            <Grid Grid.Row="0" Margin="0,50,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- GAME PROVIDERS -->
                                                <ButtonEx x:Name="PlayerProvidersCard"
                                                          FocusVisualStyle="{x:Null}"
                                                          Grid.Column="0"
                                                          Style="{StaticResource PlayerProfileFocusableCardButtonStyle}"
                                                          Padding="18"
                                                          Height="360">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{DynamicResource LOCGameProviderTitle}"
                                                                   Style="{StaticResource ProfileCardTitleText}"
                                                                   Margin="0,0,0,12"/>

                                                        <ItemsControl Grid.Row="1"
                                                                      Focusable="False"
                                                                      ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=GameProviders}"
                                                                      ItemTemplate="{StaticResource PlayerProfileThreeColTemplate}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="2"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </Grid>
                                                </ButtonEx>

                                                <!-- TOP PLAY TIME -->
                                                <ButtonEx x:Name="PlayerTopPlayedCard"
                                                          FocusVisualStyle="{x:Null}"
                                                          Grid.Column="2"
                                                          Style="{StaticResource PlayerProfileFocusableCardButtonStyle}"
                                                          Padding="18"
                                                          Height="360">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{DynamicResource LOCStatsTopPlayTime}"
                                                                   Style="{StaticResource ProfileCardTitleText}"
                                                                   Margin="0,0,0,12"/>

                                                        <ItemsControl Grid.Row="1"
                                                                      Focusable="False"
                                                                      ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=TopPlayed}"
                                                                      ItemTemplate="{StaticResource PlayerProfileTopPlayedTemplate}"/>
                                                    </Grid>
                                                </ButtonEx>
                                            </Grid>


                                            <!-- STORAGE -->
                                            <ButtonEx x:Name="PlayerStorageCard"
                                                      FocusVisualStyle="{x:Null}"
                                                      Grid.Row="1"
                                                      Margin="0,100,0,0"
                                                      Style="{StaticResource PlayerProfileFocusableCardButtonStyle}"
                                                      Padding="18"
                                                      Height="280">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{DynamicResource LocStorage}"
                                                               Style="{StaticResource ProfileCardTitleText}"
                                                               Margin="0,0,0,12"/>

                                                    <ItemsControl Grid.Row="1"
                                                                  Focusable="False"
                                                                  ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=DiskUsages}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="10"
                                                                        Padding="10,8"
                                                                        Margin="4"
                                                                        Background="#16FFFFFF"
                                                                        BorderBrush="#25FFFFFF"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <Grid Grid.Row="0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0"
                                                                                       Style="{StaticResource ProfileCardBodyText}">
                                                                                <Run Text="{Binding Label}" FontWeight="SemiBold"/>
                                                                                <Run Text="  "/>
                                                                                <Run Text="{Binding UsedPercentage, StringFormat={}{0:0}%}"/>
                                                                            </TextBlock>

                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding FreeSpaceString}"
                                                                                       Style="{StaticResource ProfileCardBodyText}"
                                                                                       FontWeight="SemiBold"
                                                                                       Margin="8,0,0,0"/>
                                                                        </Grid>

                                                                        <ProgressBar Grid.Row="1"
                                                                                     Value="{Binding UsedPercentage}"
                                                                                     Maximum="100"
                                                                                     Height="10"
                                                                                     Margin="0,8,0,0"
                                                                                     Background="#33000000">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Foreground" Value="#0078D7"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding UsedTenthsInt}" Value="8">
                                                                                            <Setter Property="Foreground" Value="DarkOrange"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding UsedTenthsInt}" Value="9">
                                                                                            <Setter Property="Foreground" Value="DarkRed"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding UsedTenthsInt}" Value="10">
                                                                                            <Setter Property="Foreground" Value="DarkRed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </ButtonEx>
                                        </Grid>
                                    </Grid>
                                </Grid>


                            </Grid>


                        </Grid>

                        <!-- PAGE DOTS -->
                        <Grid HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,24,0"
                              Panel.ZIndex="50"
                              IsHitTestVisible="False">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">

                                <Border Width="10" Height="10" Margin="0,6,0,6" CornerRadius="5" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PageDotsBackgroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PlayerProfileRoot, Path=Tag}" Value="Page1">
                                                    <Setter Property="Background" Value="{DynamicResource PageDotsFocusBrush}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border Width="10" Height="10" Margin="0,6,0,6" CornerRadius="5" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PageDotsBackgroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PlayerProfileRoot, Path=Tag}" Value="Page2">
                                                    <Setter Property="Background" Value="{DynamicResource PageDotsFocusBrush}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border Width="10" Height="10" Margin="0,6,0,6" CornerRadius="5" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PageDotsBackgroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PlayerProfileRoot, Path=Tag}" Value="Page3">
                                                    <Setter Property="Background" Value="{DynamicResource PageDotsFocusBrush}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                            </StackPanel>
                        </Grid>

                        <!-- FOOTER -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}" />
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="B"
                                          Content="{DynamicResource LOCBackLabel}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
