                        <!-- LOADING / ERROR STORE -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Panel.ZIndex="999">

                            <Border Width="520"
                                    Padding="34,30"
                                    CornerRadius="24"
                                    Background="{DynamicResource BackgroundMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"
                                                      Color="#FF000000"/>
                                </Border.Effect>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <!-- Show loading only during the first load, when no Store data is available yet.
                                            Section changes and background refreshes must not hide the Store. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <!-- Show error / no data -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Center">

                                    <!-- LOADING CONTENT -->
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>



                                        <!-- Loading text -->
                                        <TextBlock Text="{DynamicResource LOCLoading}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="30"
                                                   Margin="0,10,0,10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Effect="{DynamicResource SoftTextShadow}"/>


                                        <!-- Animated -->

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,15,0,15">

                                            <!-- Dot 1 -->
                                            <Ellipse x:Name="SteamStoreLoadingDot1"
                                                     Width="13"
                                                     Height="13"
                                                     Margin="0,0,10,0"
                                                     Fill="{DynamicResource TextHighlightBrush}"
                                                     Opacity="0.30"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>

                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot1"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.30"
                                                                                 To="1"
                                                                                 Duration="0:0:0.45"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot1"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot1"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>

                                            <!-- Dot 2 -->
                                            <Ellipse x:Name="SteamStoreLoadingDot2"
                                                     Width="13"
                                                     Height="13"
                                                     Margin="0,0,10,0"
                                                     Fill="{DynamicResource TextHighlightBrush}"
                                                     Opacity="0.30"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>

                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot2"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.30"
                                                                                 To="1"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.15"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot2"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.15"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot2"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.15"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>

                                            <!-- Dot 3 -->
                                            <Ellipse x:Name="SteamStoreLoadingDot3"
                                                     Width="13"
                                                     Height="13"
                                                     Fill="{DynamicResource TextHighlightBrush}"
                                                     Opacity="0.30"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>

                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot3"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.30"
                                                                                 To="1"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.30"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot3"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.30"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>

                                                                <DoubleAnimation Storyboard.TargetName="SteamStoreLoadingDot3"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                                 From="0.85"
                                                                                 To="1.25"
                                                                                 Duration="0:0:0.45"
                                                                                 BeginTime="0:0:0.30"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </StackPanel>

                                        <!-- Small reassuring text -->
                                        <TextBlock Text="{DynamicResource LOCPreparingSteamStoredata}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   Opacity="0.88"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="{DynamicResource LOCPleaseWait}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextDetailAltBrush}"
                                                   Opacity="0.70"
                                                   Margin="0,6,0,0"/>

                                        <!-- Progress bar -->
                                        <ProgressBar Width="390"
                                                     Height="7"
                                                     Margin="0,25,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoadingProgress}"
                                                     IsIndeterminate="False"/>

                                        <!-- Percent -->
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoadingProgress, StringFormat={}{0}%}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                   Margin="0,12,0,0"
                                                   Effect="{DynamicResource SoftTextShadow}"/>

                                    </StackPanel>

                                    <!-- ERROR / NO DATA CONTENT -->
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreError}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="22"
                                               Foreground="{DynamicResource TextBrush}"
                                               Opacity="0.85"
                                               TextWrapping="Wrap"
                                               MaxWidth="450">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="False"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- MAIN CONTENT -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- Hide content only for the first load when no Store data exists yet.
                                        Do not collapse content on section change or background refresh. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <!-- Hide content if no Store data is available -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- ===================================================== -->
                            <!-- TOP BAR                                                -->
                            <!-- ===================================================== -->
                            <Grid Grid.Row="0"
                                  Height="86"
                                  Margin="0,0,0,0"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Continue">

                                <!-- Top bar background -->
                                <Border Background="{DynamicResource TopBar}"
                                        Opacity="{DynamicResource OpacityBar}"/>

                                <Border Opacity="{DynamicResource OpacityBar}"
                                        Background="{DynamicResource GlassMainBrush}"
                                        IsHitTestVisible="False"/>

                                <Border Height="1.5"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SeparatorTopBarBrush}"
                                        Opacity="{DynamicResource OpacityBar}"/>

                                <Grid Margin="36,0,36,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Store title -->
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Effect="{DynamicResource SoftTextShadow}">

                                        <TextBlock Text="&#xE719;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>

                                        <TextBlock Text="{DynamicResource LOCSteamStoreTitle}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Category tabs -->
                                    <StackPanel Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                KeyboardNavigation.DirectionalNavigation="Continue"
                                                KeyboardNavigation.TabNavigation="Continue">
                                        <!-- DEALS -->
                                        <ButtonEx x:Name="SteamStoreTabDealsButton"
                                                  Content="{DynamicResource LOCSteamDeals}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="Deals">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="Deals">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- RECOMMENDED FOR YOU -->
                                        <ButtonEx x:Name="SteamStoreTabRecommendedButton"
                                                  Content="{DynamicResource LOCSteamForYou}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="Recommended">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="Recommended">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- MY WISHLIST -->
                                        <ButtonEx x:Name="SteamStoreTabMyWishlistButton"
                                                  Content="{DynamicResource LOCSteamMyWishlist}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="MyWishlist">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="MyWishlist">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- NEW RELEASES -->
                                        <ButtonEx x:Name="SteamStoreTabNewButton"
                                                  Content="{DynamicResource LOCSteamNew}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="New">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="New">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- POPULAR -->
                                        <ButtonEx x:Name="SteamStoreTabPopularButton"
                                                  Content="{DynamicResource LOCSteamPopular}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="Popular">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="Popular">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- WISHLISTED -->
                                        <ButtonEx x:Name="SteamStoreTabWishlistedButton"
                                                  Content="{DynamicResource LOCSteamMostWishlisted}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="Wishlisted">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="Wishlisted">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <!-- UPCOMING -->
                                        <ButtonEx x:Name="SteamStoreTabUpcomingButton"
                                                  Content="{DynamicResource LOCSteamUpcoming}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetSteamStoreSectionCommand}"
                                                  CommandParameter="Upcoming">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSection}" Value="Upcoming">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>


                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <!-- ===================================================== -->
                            <!-- STORE CONTENT                                 -->
                            <!-- ===================================================== -->
                            <Grid Grid.Row="1"
                                  Margin="54,54,0,54"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Continue">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="400"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- HERO / CATEGORY ITEM -->
                                <ButtonEx x:Name="SteamStoreHeroButton"
                                          pbeh:FocusBahaviors.FocusBinding="True"
                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                          Grid.Row="0"
                                          Width="1600"
                                          Style="{StaticResource SteamStoreHeroButtonStyle}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreHeroDetailsCommand}">

                                    <Grid>
                                        <!-- Rounded hero mask -->
                                        <Border x:Name="HeroCardOuterMask"
                                                CornerRadius="24"
                                                Background="{DynamicResource HubCardMaskImageBrush}"/>

                                        <!-- Main hero frame -->
                                        <Border CornerRadius="24"
                                                SnapsToDevicePixels="True">
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=HeroCardOuterMask}"
                                                             Stretch="Fill"
                                                             RenderOptions.BitmapScalingMode="Fant"
                                                             RenderOptions.CachingHint="Cache"/>
                                            </Border.OpacityMask>

                                            <Grid ClipToBounds="True">

                                                <!-- Transparent preset layer: keeps the selected color identity without hiding the artwork -->
                                                <Border Background="{DynamicResource OverlayMenu}"
                                                        Opacity="1"
                                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="24"
                                                        IsHitTestVisible="False"/>

                                                <!-- Full hero artwork on the right, faded into the text area -->
                                                <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroImage}"
                                                       Stretch="Uniform"
                                                       Height="400"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Stretch"
                                                       Opacity="1"
                                                       RenderOptions.BitmapScalingMode="Fant">
                                                    <Image.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="Transparent" Offset="0"/>
                                                            <GradientStop Color="#22000000" Offset="0.15"/>
                                                            <GradientStop Color="#AA000000" Offset="0.36"/>
                                                            <GradientStop Color="Black" Offset="0.56"/>
                                                            <GradientStop Color="Black" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Image.OpacityMask>
                                                </Image>

                                                <!-- Transparent preset layer: keeps the selected color identity without hiding the artwork -->
                                                <Border BorderBrush="{DynamicResource MenuBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="24"
                                                        IsHitTestVisible="False"/>

                                                <!-- Readability overlays -->
                                                <Border Background="{DynamicResource ShadeLeft}"
                                                        Opacity="0.96"
                                                        IsHitTestVisible="False"/>

                                                <Border Background="{DynamicResource ShadeBottom}"
                                                        Opacity="0.60"
                                                        IsHitTestVisible="False"/>

                                                <!-- Hero Wishlist / Library badges -->
                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,28,34,0"
                                                            IsHitTestVisible="False">

                                                    <Border Background="{DynamicResource ButtonBackgroundFocus}"
                                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="12,5"
                                                            Margin="0,0,0,7"
                                                            HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroItem.IsInLibrary}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{DynamicResource LOCInLibrary}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </Border>

                                                    <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="12,5"
                                                            HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroItem.IsInWishlist}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroItem.IsInLibrary}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{DynamicResource LOCWishlist}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <Border Background="{DynamicResource GlassMainBrush}"
                                                        Opacity="0.10"
                                                        IsHitTestVisible="False"/>

                                                <!-- Hero content -->
                                                <Grid Margin="46,38,46,38">
                                                    <StackPanel VerticalAlignment="Center"
                                                                Width="800"
                                                                HorizontalAlignment="Left"
                                                                Effect="{DynamicResource SoftTextShadow}">

                                                        <Border HorizontalAlignment="Left"
                                                                Background="{DynamicResource BackgroundMenu}"
                                                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="12,5"
                                                                Margin="0,0,0,13">
                                                            <TextBlock Text="{DynamicResource LOCSteamSpotlight}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextHighlightBrush}"/>
                                                        </Border>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroName}"
                                                                   FontFamily="{DynamicResource FontMain}"
                                                                   FontSize="50"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,13"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroDescription}"
                                                                   FontFamily="{DynamicResource FontMain}"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="82"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,25"/>

                                                        <!-- Price / date row -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">

                                                            <Border x:Name="HeroDiscountBadge"
                                                                    Background="{DynamicResource BadgeTrophéeBrush}"
                                                                    CornerRadius="8"
                                                                    Padding="11,5"
                                                                    Margin="0,0,12,0">

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>

                                                                        <Style.Triggers>
                                                                            <!-- Empty text -->
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroDiscount}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <!-- Null text -->
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroDiscount}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroDiscount}"
                                                                           FontSize="17"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>

                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroPrice}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="25"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0"/>

                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroOriginalPrice}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="18"
                                                                       Foreground="{DynamicResource TextDetailAltBrush}"
                                                                       TextDecorations="Strikethrough"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,14,0"/>

                                                            <Border Background="{DynamicResource BackgroundMenu}"
                                                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                                                    BorderThickness="0.5"
                                                                    CornerRadius="8"
                                                                    Padding="11,5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroReleaseDate}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreHeroReleaseDate}"
                                                                           FontSize="16"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- Steam auth required message displayed inside the Spotlight / hero card -->
                                                    <Grid Panel.ZIndex="80"
                                                          Margin="-46,-38,-46,-38"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          IsHitTestVisible="False">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <!-- Preferred trigger from Aniki Helper -->
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSectionRequiresSteamAuth}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>

                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <Border CornerRadius="24"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Background="{DynamicResource BackgroundMenu}"
                                                                Opacity="1"/>


                                                        <StackPanel Width="920"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Effect="{DynamicResource SoftTextShadow}">

                                                            <TextBlock Text="&#xE897;"
                                                                       FontFamily="{DynamicResource FontIcons}"
                                                                       FontSize="54"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                                       Margin="0,0,0,16"/>

                                                            <TextBlock Text="{DynamicResource LOCSteamStoreAuthRequiredTitle}"
                                                                       Style="{StaticResource TextBlockBaseStyle}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="38"
                                                                       FontWeight="Bold"
                                                                       TextAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource TextBrush}"/>

                                                            <TextBlock Text="{DynamicResource LOCSteamStoreAuthRequiredMessage}"
                                                                       Style="{StaticResource TextBlockBaseStyle}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="22"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       MaxWidth="860"
                                                                       Margin="0,14,0,0"
                                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                                       Opacity="0.9"/>
                                                        </StackPanel>
                                                    </Grid>

                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ButtonEx>

                                <Grid Grid.Row="1"
                                      Margin="0,80,0,0"
                                      KeyboardNavigation.DirectionalNavigation="Continue"
                                      KeyboardNavigation.TabNavigation="Continue">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSectionTitle}"
                                               FontFamily="{DynamicResource FontMain}"
                                               FontSize="30"
                                               Grid.Row="0"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextHighlightBrush}"
                                               Effect="{DynamicResource SoftTextShadow}"/>


                                    <!-- Active category list -->
                                    <ListBox Grid.Row="1"
                                             x:Name="StoreItemsList"
                                             ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreCurrentListItems}"
                                             Height="290"
                                             Margin="-14,8,0,0"
                                             VerticalAlignment="Top"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionMode="Single"
                                             Focusable="False"
                                             KeyboardNavigation.DirectionalNavigation="Continue"
                                             KeyboardNavigation.TabNavigation="Continue">

                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSelectedSectionRequiresSteamAuth}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>

                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="14,12,0,12"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <ButtonEx Style="{StaticResource SteamStoreCardButtonStyle}"
                                                          Tag="{Binding AppId}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Grid>
                            </Grid>
                            <!-- ===================================================== -->
                            <!-- BOTTOM PROMPTS                                          -->
                            <!-- ===================================================== -->
                            <Grid Grid.Row="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Height="60"
                                  Margin="0,8,24,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,8"
                                            Effect="{DynamicResource SoftTextShadow}">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuShoulders}"
                                              Content="{DynamicResource LOCSwitchSection}" />

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="A"
                                              Content="{DynamicResource LOCButtonPrompt_Select}" />

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="B"
                                              Content="{DynamicResource LOCBackLabel}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DETAILS SECTIONS -->
    <Style x:Key="SteamStoreDetailsStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <ControlTemplate.Resources>
                        <Style x:Key="SteamStoreScreenshotButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>

                                            <ContentPresenter/>

                                            <!-- Focus shade -->
                                            <Border x:Name="ScreenshotFocusShade"
                                                    CornerRadius="22"
                                                    Background="{DynamicResource ButtonBackgroundFocus}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>

                                            <!-- Focus border -->
                                            <Border x:Name="ScreenshotFocusBorder"
                                                    CornerRadius="22"
                                                    BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                    BorderThickness="3"
                                                    Margin="-2"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ScreenshotFocusBorder" Property="Opacity" Value="1"/>
                                                <Setter TargetName="ScreenshotFocusShade" Property="Opacity" Value="0.12"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ScreenshotFocusBorder" Property="Opacity" Value="1"/>
                                                <Setter TargetName="ScreenshotFocusShade" Property="Opacity" Value="0.12"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.90"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>

                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="999"
                          Opacity="0"
                          FocusManager.FocusedElement="{Binding ElementName=ViewSteamButton}"
                          Background="{DynamicResource SecondaryViewBackground}">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid>

                            <!-- BACKGROUND IMAGE -->
                            <Grid IsHitTestVisible="False">
                                <Border Opacity="0.15">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#FFFFFFFF" Offset="0.2"/>
                                            <GradientStop Color="#FFFFFFFF" Offset="0.8"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>

                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsBackgroundImage}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="Fant"/>
                                </Border>
                            </Grid>

                            <!-- LOADING CENTER -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical">

                                <TextBlock Text="{DynamicResource LOCLoading}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <ProgressBar Width="360"
                                             Height="6"
                                             Margin="0,18,0,0"
                                             IsIndeterminate="True"/>

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- TOP HEADER -->
                                <Grid Margin="42,26,42,0"
                                      VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCSteamStoreTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="44"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="110"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LOCLoading}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Top"
                                               Margin="0,12,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- CENTER DETAILS CONTENT -->
                                <Grid Width="1390"
                                      Height="740"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,70,0,108">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="700"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="620"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- FLOATING INFO CARD -->
                                    <Border Grid.Column="0"
                                            Width="700"
                                            Height="740"
                                            CornerRadius="24"
                                            Background="{DynamicResource BackgroundMenu}"
                                            BorderBrush="{DynamicResource StaticBorderBrush}"
                                            BorderThickness="1"
                                            Padding="26">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12"
                                                              ShadowDepth="0"
                                                              Opacity="0.38"
                                                              Color="#FF000000"/>
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Preorder badge inside card -->
                                            <Border Grid.Row="0"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource BackgroundMenu}"
                                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="12,5"
                                                    Margin="0,0,0,14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsIsPreorder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{DynamicResource LOCSteamStorePreOrder}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextHighlightBrush}"/>
                                            </Border>

                                            <!-- Header image -->
                                            <Grid Grid.Row="1"
                                                  Height="285"
                                                  ClipToBounds="True">

                                                <Border x:Name="SteamStoreHeaderImageMask"
                                                        CornerRadius="18"
                                                        Background="Black"/>

                                                <Border CornerRadius="18"
                                                        Background="#22000000">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreHeaderImageMask}"/>
                                                    </Border.OpacityMask>

                                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsImage}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border>

                                                <!-- Image bottom shade -->
                                                <Border CornerRadius="18"
                                                        IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#22000000" Offset="0.55"/>
                                                            <GradientStop Color="#A8000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Border CornerRadius="18"
                                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                                        BorderThickness="1"/>
                                            </Grid>

                                            <!-- Quick stats -->
                                            <StackPanel Grid.Row="2"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal"
                                                        Margin="0,14,0,0">

                                                <!-- Metacritic -->
                                                <Border Padding="10,5"
                                                        CornerRadius="8"
                                                        Background="#33000000"
                                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Metacritic : "
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Achievements -->
                                                <Border Margin="10,0,0,0"
                                                        Padding="10,5"
                                                        CornerRadius="8"
                                                        Background="#33000000"
                                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{DynamicResource LOCAchievements}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"/>
                                                        <TextBlock Text=" : "
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- DLC -->
                                                <Border Margin="10,0,0,0"
                                                        Padding="10,5"
                                                        CornerRadius="8"
                                                        Background="#33000000"
                                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="DLC : "
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- developer -->
                                            <TextBlock Grid.Row="3"
                                                       Margin="0,16,0,0"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDevelopers}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- description area -->
                                            <TextBlock Grid.Row="4"
                                                       Margin="0,12,0,0"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDescription}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="17"
                                                       LineHeight="26"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="175"
                                                       VerticalAlignment="Top"/>

                                            <!-- purchase area pinned to bottom -->
                                            <Grid Grid.Row="5"
                                                  Margin="0,22,0,0"
                                                  VerticalAlignment="Bottom">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Height="1"
                                                        Background="{DynamicResource StaticBorderBrush}"
                                                        Opacity="0.45"
                                                        Margin="0,0,0,18"/>

                                                <StackPanel Grid.Row="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                            CornerRadius="7"
                                                            Padding="9,4"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsPrice}"
                                                               Margin="12,0,0,0"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="34"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}"
                                                               Margin="12,0,0,0"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource TextDetailAltBrush}"
                                                               VerticalAlignment="Center"
                                                               TextDecorations="Strikethrough">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <ButtonEx x:Name="ViewSteamButton"
                                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                          Grid.Row="2"
                                                          MinWidth="270"
                                                          Height="56"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,24,0,0"
                                                          Content="{DynamicResource LOCSteamStoreOpenOnSteam}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStorePageExternalCommand}" >
                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource MenuButtonAniki}">
                                                            <Setter Property="Visibility" Value="Visible"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreScreenshotViewerVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                    <!-- SCREENSHOT GALLERY -->
                                    <Grid Grid.Column="2"
                                          Width="620"
                                          Height="740"
                                          VerticalAlignment="Center">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="360"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="170"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="170"/>
                                        </Grid.RowDefinitions>

                                        <!-- Main screenshot -->
                                        <ButtonEx Grid.Row="0"
                                                  Style="{StaticResource SteamStoreScreenshotButtonStyle}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreScreenshotViewerCommand}"
                                                  CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot1}">
                                            <Grid Width="620"
                                                  Height="360">
                                                <Border x:Name="SteamStoreScreenshotMask1"
                                                        CornerRadius="22"
                                                        Background="Black"/>

                                                <Border CornerRadius="22"
                                                        Background="#22000000">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask1}"/>
                                                    </Border.OpacityMask>

                                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot1}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border>

                                                <Border CornerRadius="22"
                                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                                        BorderThickness="1"/>
                                            </Grid>
                                        </ButtonEx>

                                        <!-- Row 1 small screenshots -->
                                        <Grid Grid.Row="2"
                                              Width="620"
                                              Height="170">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Screenshot 2 -->
                                            <ButtonEx Grid.Column="0"
                                                      Style="{StaticResource SteamStoreScreenshotButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreScreenshotViewerCommand}"
                                                      CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot2}">
                                                <Grid Width="300" Height="170">
                                                    <Border x:Name="SteamStoreScreenshotMask2"
                                                            CornerRadius="18"
                                                            Background="Black"/>

                                                    <Border CornerRadius="18"
                                                            Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask2}"/>
                                                        </Border.OpacityMask>

                                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot2}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Border>

                                                    <Border CornerRadius="18"
                                                            BorderBrush="{DynamicResource StaticBorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </ButtonEx>

                                            <!-- Screenshot 3 -->
                                            <ButtonEx Grid.Column="2"
                                                      Style="{StaticResource SteamStoreScreenshotButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreScreenshotViewerCommand}"
                                                      CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot3}">
                                                <Grid Width="300" Height="170">
                                                    <Border x:Name="SteamStoreScreenshotMask3"
                                                            CornerRadius="18"
                                                            Background="Black"/>

                                                    <Border CornerRadius="18"
                                                            Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask3}"/>
                                                        </Border.OpacityMask>

                                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot3}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Border>

                                                    <Border CornerRadius="18"
                                                            BorderBrush="{DynamicResource StaticBorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </ButtonEx>
                                        </Grid>

                                        <!-- Row 2 small screenshots -->
                                        <Grid Grid.Row="4"
                                              Width="620"
                                              Height="170">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Screenshot 4 -->
                                            <ButtonEx Grid.Column="0"
                                                      Style="{StaticResource SteamStoreScreenshotButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreScreenshotViewerCommand}"
                                                      CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot4}">
                                                <Grid Width="300" Height="170">
                                                    <Border x:Name="SteamStoreScreenshotMask4"
                                                            CornerRadius="18"
                                                            Background="Black"/>

                                                    <Border CornerRadius="18"
                                                            Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask4}"/>
                                                        </Border.OpacityMask>

                                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot4}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Border>

                                                    <Border CornerRadius="18"
                                                            BorderBrush="{DynamicResource StaticBorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </ButtonEx>

                                            <!-- Screenshot 5 -->
                                            <ButtonEx Grid.Column="2"
                                                      Style="{StaticResource SteamStoreScreenshotButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreScreenshotViewerCommand}"
                                                      CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot5}">
                                                <Grid Width="300" Height="170">
                                                    <Border x:Name="SteamStoreScreenshotMask5"
                                                            CornerRadius="18"
                                                            Background="Black"/>

                                                    <Border CornerRadius="18"
                                                            Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask5}"/>
                                                        </Border.OpacityMask>

                                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot5}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Border>

                                                    <Border CornerRadius="18"
                                                            BorderBrush="{DynamicResource StaticBorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </ButtonEx>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- BOTTOM INFO BAR -->
                                <Border VerticalAlignment="Bottom"
                                        Height="108"
                                        Background="{DynamicResource BottomBar}"
                                        BorderBrush="{DynamicResource SeparatorBottomBarBrush}"
                                        BorderThickness="0,1,0,0">

                                    <Grid Margin="42,0,42,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="3.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreGenres}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsGenres}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreReleaseDate}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsReleaseDate}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStorePublisher}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsPublishers}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreCategories}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsCategories}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- SCREENSHOT FULLSCREEN VIEWER -->
                                <Grid Panel.ZIndex="5000"
                                      Background="#E8000000">

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreScreenshotViewerVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- Big screenshot -->
                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreScreenshotViewerImage}"
                                           Stretch="Uniform"
                                           Margin="80,70,80,100"
                                           RenderOptions.BitmapScalingMode="Fant"/>

                                    <!-- Bottom prompt bar -->
                                    <Border VerticalAlignment="Bottom"
                                            Height="76"
                                            Background="{DynamicResource BottomBar}"
                                            BorderBrush="{DynamicResource SeparatorBottomBarBrush}"
                                            BorderThickness="0,1,0,0">

                                        <Grid>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,42,0"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        KeyboardNavigation.TabNavigation="Contained">

                                                <ButtonEx x:Name="CloseSteamStoreScreenshotViewerButton"
                                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                          MinWidth="210"
                                                          Height="52"
                                                          Content="{DynamicResource LOCBackLabel}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=CloseSteamStoreScreenshotViewerCommand}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,0,8"
                                                        Effect="{DynamicResource SoftTextShadow}">

                                                <ButtonEx Style="{DynamicResource ButtonBottomMenuShoulders}"
                                                          Content="{DynamicResource LOCPreviousNext}" />

                                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                          Tag="B"
                                                          Content="{DynamicResource LOCBackLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
