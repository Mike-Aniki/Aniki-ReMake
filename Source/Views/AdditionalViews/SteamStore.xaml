<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- SteamStore -->
    <Style x:Key="SteamStoreStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>

                        <!-- Store cards focus zoom animation -->
                        <Style x:Key="SteamStoreFocusZoomButtonBaseStyle" TargetType="ButtonEx">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                 To="1.040"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                 To="1.040"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                 To="1"
                                                                 Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                 To="1"
                                                                 Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>


                        <!-- ========================================================= -->
                        <!-- CARD BUTTON STYLE                                          -->
                        <!-- ========================================================= -->
                        <Style x:Key="SteamStoreCardButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource SteamStoreFocusZoomButtonBaseStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,22,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="525"
                                                Height="245"
                                                CornerRadius="20"
                                                BorderBrush="{DynamicResource HubCardBorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource BackgroundItem}"
                                                ClipToBounds="True"
                                                SnapsToDevicePixels="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <Grid>
                                                <!-- MASK -->
                                                <Border x:Name="SteamStoreCardImageMask"
                                                        CornerRadius="20"
                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                <!-- IMAGE -->
                                                <Border CornerRadius="20">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreCardImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid>
                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <Binding Path="StoreCardImage" IsAsync="True"/>
                                                            </Image.Source>
                                                        </Image>

                                                        <Border IsHitTestVisible="False"
                                                                Background="{DynamicResource ShadeBottom}"
                                                                Opacity="0.68"/>

                                                        <!-- Wishlist / Library badges -->
                                                        <StackPanel Orientation="Vertical"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,14,14,0"
                                                                    IsHitTestVisible="False">

                                                            <Border Background="{DynamicResource BackgroundMenu}"
                                                                    BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="10,4"
                                                                    Margin="0,0,0,6"
                                                                    HorizontalAlignment="Right">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInLibrary}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{DynamicResource LOCInLibrary}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>

                                                            <Border Background="{DynamicResource BackgroundMenu}"
                                                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Right">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInWishlist}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsInLibrary}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{DynamicResource LOCWishlist}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- PRICE AREA -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="16,0,16,16">

                                                            <!-- Discount badge -->
                                                            <Border x:Name="DiscountBadge"
                                                                    Background="{DynamicResource BadgeTrophéeBrush}"
                                                                    CornerRadius="7"
                                                                    Padding="9,4"
                                                                    VerticalAlignment="Center">

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{Binding DiscountDisplay}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Final price -->
                                                            <TextBlock x:Name="FinalPriceText"
                                                                       Text="{Binding FinalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       FontSize="23"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Original price -->
                                                            <TextBlock x:Name="OriginalPriceText"
                                                                       Text="{Binding OriginalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextDetailAltBrush}"
                                                                       FontSize="17"
                                                                       VerticalAlignment="Center"
                                                                       TextDecorations="Strikethrough"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                            </Trigger>

                                            <!-- Hide empty discount badge -->
                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                <Setter TargetName="DiscountBadge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty original price -->
                                            <DataTrigger Binding="{Binding OriginalPriceDisplay}" Value="">
                                                <Setter TargetName="OriginalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty final price -->
                                            <DataTrigger Binding="{Binding FinalPriceDisplay}" Value="">
                                                <Setter TargetName="FinalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Upcoming cards use Steam header ratio -->
                                            <DataTrigger Binding="{Binding ComingSoon}" Value="True">
                                                <Setter TargetName="CardRoot" Property="Width" Value="525"/>
                                                <Setter TargetName="CardRoot" Property="Height" Value="245"/>
                                            </DataTrigger>

                                            <!-- New Releases cards use Steam header ratio -->
                                            <DataTrigger Binding="{Binding Source}" Value="Steam Popular New Releases">
                                                <Setter TargetName="CardRoot" Property="Width" Value="525"/>
                                                <Setter TargetName="CardRoot" Property="Height" Value="245"/>
                                            </DataTrigger>

                                            <!-- Wishlisted cards use Steam header ratio -->
                                            <DataTrigger Binding="{Binding Source}" Value="Steam Most Wishlisted">
                                                <Setter TargetName="CardRoot" Property="Width" Value="525"/>
                                                <Setter TargetName="CardRoot" Property="Height" Value="245"/>
                                            </DataTrigger>

                                            <!-- User Wishlist cards use Steam header ratio -->
                                            <DataTrigger Binding="{Binding Source}" Value="Steam User Wishlist">
                                                <Setter TargetName="CardRoot" Property="Width" Value="525"/>
                                                <Setter TargetName="CardRoot" Property="Height" Value="245"/>
                                            </DataTrigger>

                                            <!-- Search upcoming cards fallback -->
                                            <DataTrigger Binding="{Binding Source}" Value="Steam Popular Coming Soon">
                                                <Setter TargetName="CardRoot" Property="Width" Value="525"/>
                                                <Setter TargetName="CardRoot" Property="Height" Value="245"/>
                                            </DataTrigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreSpotlightCardButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource SteamStoreFocusZoomButtonBaseStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,22,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Grid Width="525"
                                              Height="245"
                                              RenderTransformOrigin="0.5,0.5"
                                              SnapsToDevicePixels="True">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>

                                            <!-- OUTER SHADOW / FRAME -->
                                            <Border x:Name="CardRoot"
                                                    Width="525"
                                                    Height="245"
                                                    CornerRadius="18"
                                                    BorderBrush="#22FFFFFF"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource BackgroundItem}"
                                                    ClipToBounds="True"
                                                    SnapsToDevicePixels="True"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.18"
                                                                      Color="#FF000000"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- IMAGE AREA -->
                                            <Grid Margin="0"
                                                  ClipToBounds="True">
                                                <Border x:Name="SpotlightImageMask"
                                                        CornerRadius="24"
                                                        Background="{DynamicResource HubCardMaskImageBrush}"/>

                                                <Border CornerRadius="24"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SpotlightImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid Width="525"
                                                          Height="245"
                                                          ClipToBounds="True">

                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <Binding Path="StoreCardImage" IsAsync="True"/>
                                                            </Image.Source>
                                                        </Image>

                                                        <!-- Global shading -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="24">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#08000000" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.30"/>
                                                                    <GradientStop Color="#00000000" Offset="0.58"/>
                                                                    <GradientStop Color="#AA000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Top soft light -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="24">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.45"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Rank badge -->
                                                <Border x:Name="RankBadge"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="12"
                                                        Width="44"
                                                        Height="44"
                                                        CornerRadius="22"
                                                        Background="#D9000000"
                                                        BorderBrush="#35FFFFFF"
                                                        BorderThickness="1.5"
                                                        Panel.ZIndex="10">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.22"
                                                                          Color="#FF000000"/>
                                                    </Border.Effect>

                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="19"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <!-- Bottom text overlay -->
                                                <Border x:Name="TitleOverlay"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom"
                                                        Margin="12,0,12,12"
                                                        Padding="12,10,12,10"
                                                        CornerRadius="14"
                                                        Background="#B0101318"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1.5"
                                                        Panel.ZIndex="10">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="46"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                                <Setter TargetName="CardRoot" Property="Background" Value="#14000000"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.34"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="RankBadge" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="TitleOverlay" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="RankBadge" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreTopSellersCardButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource SteamStoreFocusZoomButtonBaseStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,18,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="550"
                                                Height="257"
                                                CornerRadius="18"
                                                ClipToBounds="True"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Background="{DynamicResource BackgroundItem}"
                                                SnapsToDevicePixels="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <Grid>
                                                <!-- MASK -->
                                                <Border x:Name="SteamStoreCardImageMask"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                <!-- IMAGE -->
                                                <Border CornerRadius="18">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreCardImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid>
                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <Binding Path="StoreCardImage" IsAsync="True"/>
                                                            </Image.Source>
                                                        </Image>

                                                        <!-- overall soft shade -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="18">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#10000000" Offset="0.0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.28"/>
                                                                    <GradientStop Color="#00000000" Offset="0.60"/>
                                                                    <GradientStop Color="#A8000000" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- bottom cinematic fade -->
                                                        <Border VerticalAlignment="Bottom"
                                                                Height="84"
                                                                CornerRadius="0,0,18,18"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                    <GradientStop Color="#66000000" Offset="0.35"/>
                                                                    <GradientStop Color="#D8000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- PRICE AREA -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="14,0,14,14">

                                                            <!-- Discount badge -->
                                                            <Border x:Name="DiscountBadge"
                                                                    Background="{DynamicResource FocusGameBorderBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DiscountDisplay}"
                                                                           Foreground="White"
                                                                           FontSize="15"
                                                                           FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Final price -->
                                                            <TextBlock x:Name="FinalPriceText"
                                                                       Text="{Binding FinalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Original price -->
                                                            <TextBlock x:Name="OriginalPriceText"
                                                                       Text="{Binding OriginalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="#B8FFFFFF"
                                                                       FontSize="17"
                                                                       VerticalAlignment="Center"
                                                                       TextDecorations="Strikethrough"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.30"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsKeyboardFocused" Value="False">
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.16"
                                                                          Color="#FF000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                            </Trigger>

                                            <!-- Hide empty discount badge -->
                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                <Setter TargetName="DiscountBadge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty original price -->
                                            <DataTrigger Binding="{Binding OriginalPriceDisplay}" Value="">
                                                <Setter TargetName="OriginalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty final price -->
                                            <DataTrigger Binding="{Binding FinalPriceDisplay}" Value="">
                                                <Setter TargetName="FinalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreUpcomingCardButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource SteamStoreFocusZoomButtonBaseStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,22,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="620"
                                                Height="290"
                                                CornerRadius="18"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Background="{DynamicResource BackgroundItem}"
                                                SnapsToDevicePixels="True"
                                                RenderTransformOrigin="0.5,0.5">

                                            <Grid>
                                                <Border x:Name="SteamStoreCardImageMask"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                <Border CornerRadius="18">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreCardImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid>
                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <Binding Path="StoreCardImage" IsAsync="True"/>
                                                            </Image.Source>
                                                        </Image>

                                                        <Border IsHitTestVisible="False" CornerRadius="18">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#08000000" Offset="0"/>
