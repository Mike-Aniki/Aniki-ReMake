<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- SteamStore -->
    <Style x:Key="SteamStoreStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>

                        <!-- ========================================================= -->
                        <!-- CARD BUTTON STYLE                                          -->
                        <!-- ========================================================= -->
                        <Style x:Key="SteamStoreCardButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,18,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="400"
                                                Height="230"
                                                CornerRadius="18"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Background="{DynamicResource BackgroundItem}"
                                                SnapsToDevicePixels="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <Grid>
                                                <!-- MASK -->
                                                <Border x:Name="SteamStoreCardImageMask"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                <!-- IMAGE -->
                                                <Border CornerRadius="18">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreCardImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid>
                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill"
                                                               Source="{Binding CapsuleImageLocalPath}" />

                                                        <!-- overall soft shade -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="18">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#10000000" Offset="0.0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.28"/>
                                                                    <GradientStop Color="#00000000" Offset="0.60"/>
                                                                    <GradientStop Color="#A8000000" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- bottom cinematic fade -->
                                                        <Border VerticalAlignment="Bottom"
                                                                Height="84"
                                                                CornerRadius="0,0,18,18"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                    <GradientStop Color="#66000000" Offset="0.35"/>
                                                                    <GradientStop Color="#D8000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- PRICE AREA -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="14,0,14,14">

                                                            <!-- Discount badge -->
                                                            <Border x:Name="DiscountBadge"
                                                                    Background="{DynamicResource FocusGameBorderBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DiscountDisplay}"
                                                                           Foreground="White"
                                                                           FontSize="15"
                                                                           FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Final price -->
                                                            <TextBlock x:Name="FinalPriceText"
                                                                       Text="{Binding FinalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       FontSize="22"
                                                                       Foreground="White"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Original price -->
                                                            <TextBlock x:Name="OriginalPriceText"
                                                                       Text="{Binding OriginalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="#B8FFFFFF"
                                                                       FontSize="17"
                                                                       VerticalAlignment="Center"
                                                                       TextDecorations="Strikethrough"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.30"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsKeyboardFocused" Value="False">
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="18"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.16"
                                                                          Color="#FF000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                            </Trigger>

                                            <!-- Hide empty discount badge -->
                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                <Setter TargetName="DiscountBadge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty original price -->
                                            <DataTrigger Binding="{Binding OriginalPriceDisplay}" Value="">
                                                <Setter TargetName="OriginalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty final price -->
                                            <DataTrigger Binding="{Binding FinalPriceDisplay}" Value="">
                                                <Setter TargetName="FinalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreSpotlightCardButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,22,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Grid Width="306"
                                              Height="260"
                                              RenderTransformOrigin="0.5,0.5"
                                              SnapsToDevicePixels="True">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>

                                            <!-- OUTER SHADOW / FRAME -->
                                            <Border x:Name="CardRoot"
                                                    CornerRadius="24"
                                                    Background="#08000000"
                                                    BorderBrush="#18FFFFFF"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.18"
                                                                      Color="#FF000000"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- IMAGE AREA -->
                                            <Grid Margin="0"
                                                  ClipToBounds="True">
                                                <Border x:Name="SpotlightImageMask"
                                                        CornerRadius="24"
                                                        Background="{DynamicResource HubCardMaskImageBrush}"/>

                                                <Border CornerRadius="24"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SpotlightImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid Width="306"
                                                          Height="260"
                                                          ClipToBounds="True">
                                                        <Image Source="{Binding CapsuleImageLocalPath}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>

                                                        <!-- Global shading -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="24">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#08000000" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.30"/>
                                                                    <GradientStop Color="#00000000" Offset="0.58"/>
                                                                    <GradientStop Color="#AA000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Top soft light -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="24">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.45"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Rank badge -->
                                                <Border x:Name="RankBadge"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="12"
                                                        Width="44"
                                                        Height="44"
                                                        CornerRadius="22"
                                                        Background="#D9000000"
                                                        BorderBrush="#35FFFFFF"
                                                        BorderThickness="1.5"
                                                        Panel.ZIndex="10">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.22"
                                                                          Color="#FF000000"/>
                                                    </Border.Effect>

                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="19"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <!-- Bottom text overlay -->
                                                <Border x:Name="TitleOverlay"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom"
                                                        Margin="12,0,12,12"
                                                        Padding="12,10,12,10"
                                                        CornerRadius="14"
                                                        Background="#B0101318"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1.5"
                                                        Panel.ZIndex="10">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="46"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                                <Setter TargetName="CardRoot" Property="Background" Value="#14000000"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.34"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="RankBadge" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="TitleOverlay" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="RankBadge" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreTopSellersCardButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,18,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="550"
                                                Height="300"
                                                CornerRadius="18"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                Background="{DynamicResource BackgroundItem}"
                                                SnapsToDevicePixels="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>

                                            <Grid>
                                                <!-- MASK -->
                                                <Border x:Name="SteamStoreCardImageMask"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource HubCardMaskImageBrush}" />

                                                <!-- IMAGE -->
                                                <Border CornerRadius="18">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=SteamStoreCardImageMask}"
                                                                     Stretch="Fill"
                                                                     RenderOptions.BitmapScalingMode="Fant"
                                                                     RenderOptions.CachingHint="Cache"/>
                                                    </Border.OpacityMask>

                                                    <Grid>
                                                        <Image RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="UniformToFill"
                                                               Source="{Binding CapsuleImageLocalPath}" />

                                                        <!-- overall soft shade -->
                                                        <Border IsHitTestVisible="False"
                                                                CornerRadius="18">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#10000000" Offset="0.0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.28"/>
                                                                    <GradientStop Color="#00000000" Offset="0.60"/>
                                                                    <GradientStop Color="#A8000000" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- bottom cinematic fade -->
                                                        <Border VerticalAlignment="Bottom"
                                                                Height="84"
                                                                CornerRadius="0,0,18,18"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                    <GradientStop Color="#66000000" Offset="0.35"/>
                                                                    <GradientStop Color="#D8000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- PRICE AREA -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="14,0,14,14">

                                                            <!-- Discount badge -->
                                                            <Border x:Name="DiscountBadge"
                                                                    Background="{DynamicResource FocusGameBorderBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DiscountDisplay}"
                                                                           Foreground="White"
                                                                           FontSize="15"
                                                                           FontWeight="Bold"/>
                                                            </Border>

                                                            <!-- Final price -->
                                                            <TextBlock x:Name="FinalPriceText"
                                                                       Text="{Binding FinalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Original price -->
                                                            <TextBlock x:Name="OriginalPriceText"
                                                                       Text="{Binding OriginalPriceDisplay}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="#B8FFFFFF"
                                                                       FontSize="17"
                                                                       VerticalAlignment="Center"
                                                                       TextDecorations="Strikethrough"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.30"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsKeyboardFocused" Value="False">
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="18"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.16"
                                                                          Color="#FF000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2"/>
                                            </Trigger>

                                            <!-- Hide empty discount badge -->
                                            <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                <Setter TargetName="DiscountBadge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty original price -->
                                            <DataTrigger Binding="{Binding OriginalPriceDisplay}" Value="">
                                                <Setter TargetName="OriginalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <!-- Hide empty final price -->
                                            <DataTrigger Binding="{Binding FinalPriceDisplay}" Value="">
                                                <Setter TargetName="FinalPriceText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="SteamStoreSectionButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,18"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="SectionFocusBar"
                                                    Width="6"
                                                    Height="30"
                                                    Margin="0,0,14,0"
                                                    CornerRadius="3"
                                                    Background="Transparent"
                                                    VerticalAlignment="Center"/>

                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="SectionFocusBar" Property="Background" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SectionFocusBar" Property="Background" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- ========================================================= -->
                        <!-- SECTION TITLE STYLE                                        -->
                        <!-- ========================================================= -->
                        <Style x:Key="SteamStoreSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="FontSize" Value="34"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,0,0,18"/>
                        </Style>

                        <Style x:Key="SteamStoreSectionSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                        </Style>

                    </ControlTemplate.Resources>

                    <Grid x:Name="SteamStoreOverlay"
                          Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          RenderTransformOrigin="0.5,0.5"
                          FocusManager.FocusedElement="{Binding ElementName=PopularCard}">

                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>



                        <!-- BACKGROUND / SHADE -->
                        <Grid>

                            <Border Background="{DynamicResource WelcomeImage1}" Opacity="0.4">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.10"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.90"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <Border Opacity="0.50"
                                    Background="{DynamicResource SecondaryViewBackground}"/>

                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0AFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.35"/>
                                        <GradientStop Color="#18000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- LOADING / ERROR STORE -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">

                            <!-- Loading text -->
                            <TextBlock Text="{DynamicResource LOCLoading}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Foreground="{DynamicResource TextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Progress bar -->
                            <ProgressBar Width="360"
                                         Height="6"
                                         Margin="0,18,0,0"
                                         IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <!-- Error / no data -->
                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreError}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextBrush}"
                                       Opacity="0.75"
                                       Margin="0,18,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreLoading}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreAvailable}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>

                        <!-- MAIN CONTENT -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDeals.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>


                            <!-- ===================================================== -->
                            <!-- HEADER                                                 -->
                            <!-- ===================================================== -->
                            <Grid Grid.Row="0"
                                  Margin="54,24,30,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="62"
                                        Height="62"
                                        Grid.Column="0"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE719;"
                                               FontFamily="{DynamicResource FontIcons}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LOCSteamStoreTitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="38"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{DynamicResource LOCSteamStoreSubtitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="18"
                                               Opacity="0.8"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ===================================================== -->
                            <!-- STORE SECTIONS                                          -->
                            <!-- ===================================================== -->
                            <ScrollViewer Grid.Row="1" Focusable="False" KeyboardNavigation.DirectionalNavigation="Continue" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.IsTabStop="False" CanContentScroll="True" Padding="0,4,0,0">

                                <StackPanel Margin="54,0,0,20">


                                    <!-- ===================================================== -->
                                    <!-- SPOTLIGHT -->
                                    <!-- ===================================================== -->
                                    <StackPanel Margin="0,45,0,45">

                                        <TextBlock Text="{DynamicResource LOCSteamStoreSpotlight}"
                                                   Style="{StaticResource SteamStoreSectionTitleStyle}"
                                                   Margin="0,0,0,18"/>

                                        <ListBox ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreSpotlight}"
                                                 AlternationCount="20"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 Background="Transparent"
                                                 pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                 pbeh:FocusBahaviors.FocusBinding="True"
                                                 BorderThickness="0"
                                                 SelectionMode="Single"
                                                 Focusable="True"
                                                 KeyboardNavigation.DirectionalNavigation="Continue"
                                                 KeyboardNavigation.TabNavigation="Continue">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="IsTabStop" Value="True"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource SteamStoreSpotlightCardButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}"
                                                              CommandParameter="{Binding}"
                                                              Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </StackPanel>

                                    <!-- ===================================================== -->
                                    <!-- TOP SELLERS -->
                                    <!-- ===================================================== -->
                                    <StackPanel Margin="0,45,0,45">

                                        <TextBlock Text="{DynamicResource LOCSteamStoreTopSellers}"
                                                   Style="{StaticResource SteamStoreSectionTitleStyle}"
                                                   Margin="0,0,0,18"/>

                                        <ListBox ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreTopSellers}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 SelectionMode="Single"
                                                 Focusable="True"
                                                 KeyboardNavigation.DirectionalNavigation="Continue"
                                                 KeyboardNavigation.TabNavigation="Continue">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="IsTabStop" Value="True"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource SteamStoreTopSellersCardButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}"
                                                              CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </StackPanel>

                                    <!-- ===================================================== -->
                                    <!-- NEW RELEASES -->
                                    <!-- ===================================================== -->
                                    <StackPanel Margin="0,45,0,45">

                                        <TextBlock Text="{DynamicResource LOCSteamStoreNewReleases}"
                                                   Style="{StaticResource SteamStoreSectionTitleStyle}"
                                                   Margin="0,0,0,18"/>

                                        <ListBox ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreNewReleases}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 SelectionMode="Single"
                                                 Focusable="True"
                                                 KeyboardNavigation.DirectionalNavigation="Continue"
                                                 KeyboardNavigation.TabNavigation="Continue">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="IsTabStop" Value="True"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource SteamStoreCardButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}"
                                                              CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </StackPanel>

                                    <!-- ===================================================== -->
                                    <!-- DEALS -->
                                    <!-- ===================================================== -->
                                    <StackPanel Margin="0,45,0,45">

                                        <TextBlock Text="{DynamicResource LOCSteamStoreDeals}"
                                                   Style="{StaticResource SteamStoreSectionTitleStyle}"
                                                   Margin="0,0,0,18"/>

                                        <ListBox ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDeals}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 SelectionMode="Single"
                                                 Focusable="True"
                                                 KeyboardNavigation.DirectionalNavigation="Continue"
                                                 KeyboardNavigation.TabNavigation="Continue">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="IsTabStop" Value="True"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource SteamStoreCardButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}"
                                                              CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>

                            <!-- ===================================================== -->
                            <!-- BOTTOM PROMPTS                                          -->
                            <!-- ===================================================== -->
                            <Grid Grid.Row="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Height="60"
                                  Margin="0,8,24,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,8"
                                            Effect="{DynamicResource SoftTextShadow}">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="Dpad"
                                              Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="A"
                                              Content="{DynamicResource LOCButtonPrompt_Select}" />

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="B"
                                              Content="{DynamicResource LOCBackLabel}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DETAILS SECTIONS -->
    <Style x:Key="SteamStoreDetailsStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="999"
                          FocusManager.FocusedElement="{Binding ElementName=PopularCard}"
                          Background="#CC000000">

                        <Grid>

                            <!-- BACKGROUND IMAGE -->
                            <Grid>
                                <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsBackgroundImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="Fant"/>

                                <!-- dark cinematic overlay -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#E8101116" Offset="0"/>
                                            <GradientStop Color="#B0101116" Offset="0.25"/>
                                            <GradientStop Color="#40000000" Offset="0.62"/>
                                            <GradientStop Color="#B0101116" Offset="0.85"/>
                                            <GradientStop Color="#E8101116" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- top fade -->
                                <Border VerticalAlignment="Top" Height="180" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#95000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- bottom fade -->
                                <Border VerticalAlignment="Bottom" Height="300" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#95000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- LOADING CENTER -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical">

                                <TextBlock Text="{DynamicResource LOCLoading}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <ProgressBar Width="360"
                                             Height="6"
                                             Margin="0,18,0,0"
                                             IsIndeterminate="True"/>

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- PREORDER -->
                                <Border Grid.Column="1"
                                        Margin="-20,180,0,0"
                                        Padding="20,8,54,8"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        MinWidth="300"
                                        CornerRadius="0,12,12,0"
                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        Background="{DynamicResource TopBar}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsIsPreorder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="#FF000000"/>
                                    </Border.Effect>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,-20,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCSteamStorePreOrder}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- TOP HEADER -->
                                <Grid Margin="42,26,42,0"
                                      VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCSteamStoreTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="44"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="110"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LOCLoading}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Top"
                                               Margin="0,12,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- FLOATING INFO CARD -->
                                <Border Width="620"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="42,0,42,138"
                                        CornerRadius="22"
                                        Background="{DynamicResource OverlayMenu}"
                                        BorderBrush="{DynamicResource StaticBorderBrush}"
                                        BorderThickness="1"
                                        Padding="26">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28"
                                                          ShadowDepth="0"
                                                          Opacity="0.32"
                                                          Color="#FF000000"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header image -->
                                        <Grid Grid.Row="0" MaxHeight="300">
                                            <Border x:Name="SteamStoreHeaderImageMask"
                                                    CornerRadius="18"
                                                    Background="Black"/>

                                            <Border CornerRadius="18"
                                                    Background="#22000000">
                                                <Border.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=SteamStoreHeaderImageMask}"/>
                                                </Border.OpacityMask>

                                                <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsImage}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                            </Border>

                                            <Border CornerRadius="18"
                                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                                    BorderThickness="1"/>
                                        </Grid>

                                        <!-- Quick stats -->
                                        <StackPanel Grid.Row="1"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Margin="0,16,0,0">

                                            <!-- Metacritic -->
                                            <Border Padding="10,5"
                                                    CornerRadius="8"
                                                    Background="#22000000"
                                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Metacritic : "
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               Margin="0,0,0,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsMetacriticScore}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Achievements -->
                                            <Border Margin="10,0,0,0"
                                                    Padding="10,5"
                                                    CornerRadius="8"
                                                    Background="#22000000"
                                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Achievements : "
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               Margin="0,0,0,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsAchievementsTotal}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- DLC -->
                                            <Border Margin="10,0,0,0"
                                                    Padding="10,5"
                                                    CornerRadius="8"
                                                    Background="#22000000"
                                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="DLC : "
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               Margin="0,0,0,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDlcCount}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- developer -->
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,14,0,0"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDevelopers}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- description -->
                                        <TextBlock Grid.Row="3"
                                                   Margin="0,14,0,0"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDescription}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="17"
                                                   LineHeight="26"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="120"/>

                                        <!-- price -->
                                        <StackPanel Grid.Row="4"
                                                    Orientation="Horizontal"
                                                    Margin="0,22,0,0"
                                                    VerticalAlignment="Center">

                                            <Border Background="{DynamicResource FocusGameBorderBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsDiscount}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           FontWeight="Bold"/>
                                            </Border>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsPrice}"
                                                       Margin="10,0,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}"
                                                       Margin="10,0,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       VerticalAlignment="Center"
                                                       TextDecorations="Strikethrough">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsOriginalPrice}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- buttons -->
                                        <StackPanel Grid.Row="5"
                                                    HorizontalAlignment="Center"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    pbeh:FocusBahaviors.FocusBinding="True"
                                                    Orientation="Horizontal"
                                                    Margin="0,22,0,0">
                                            <ButtonEx MinWidth="250"
                                                      Height="54"
                                                      Content="{DynamicResource LOCSteamStoreOpenOnSteam}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStorePageExternalCommand}" />

                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- SCREENSHOT GALLERY -->
                                <StackPanel Width="430"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,90,42,108">

                                    <Grid Width="430" Height="242">
                                        <Border x:Name="SteamStoreScreenshotMask1"
                                                CornerRadius="18"
                                                Background="Black"/>

                                        <Border CornerRadius="18"
                                                Background="#22000000">
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask1}"/>
                                            </Border.OpacityMask>

                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot1}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                        </Border>

                                        <Border CornerRadius="18"
                                                BorderBrush="{DynamicResource StaticBorderBrush}"
                                                BorderThickness="1"/>
                                    </Grid>

                                    <Grid Width="430" Height="242" Margin="0,25,0,0">
                                        <Border x:Name="SteamStoreScreenshotMask2"
                                                CornerRadius="18"
                                                Background="Black"/>

                                        <Border CornerRadius="18"
                                                Background="#22000000">
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask2}"/>
                                            </Border.OpacityMask>

                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot2}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                        </Border>

                                        <Border CornerRadius="18"
                                                BorderBrush="{DynamicResource StaticBorderBrush}"
                                                BorderThickness="1"/>
                                    </Grid>

                                    <Grid Width="430" Height="242" Margin="0,25,0,0">



                                        <Border x:Name="SteamStoreScreenshotMask3"
                                                CornerRadius="18"
                                                Background="Black"/>

                                        <Border CornerRadius="18"
                                                Background="#22000000">
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=SteamStoreScreenshotMask3}"/>
                                            </Border.OpacityMask>

                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsScreenshot3}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                        </Border>

                                        <Border CornerRadius="18"
                                                BorderBrush="{DynamicResource StaticBorderBrush}"
                                                BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>

                                <!-- BOTTOM INFO BAR -->
                                <Border VerticalAlignment="Bottom"
                                        Height="108"
                                        Background="{DynamicResource BottomBar}"
                                        BorderBrush="{DynamicResource SeparatorBottomBarBrush}"
                                        BorderThickness="0,1,0,0">

                                    <Grid Margin="42,0,42,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="3.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreGenres}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsGenres}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreReleaseDate}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsReleaseDate}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{DynamicResource LOCSteamStorePublisher}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsPublishers}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCSteamStoreCategories}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreDetailsCategories}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="44"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Grid>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
