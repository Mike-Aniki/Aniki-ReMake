<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="ScreenShotsThumbsWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <ControlTemplate.Resources>

                        <DropShadowEffect x:Key="ScreenshotThumbShadow"
                                          Color="#000000"
                                          ShadowDepth="0"
                                          BlurRadius="8"
                                          Opacity="0.22"/>

                        <Style x:Key="ScreenshotThumbToggleStyle" TargetType="ToggleButtonEx">
                            <Setter Property="Width" Value="460"/>
                            <Setter Property="Height" Value="259"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButtonEx">

                                        <Grid Width="460"
                                              Height="259"
                                              SnapsToDevicePixels="True">

                                            <!-- SHAPE USED AS MASK -->
                                            <Border x:Name="CardMask"
                                                    Width="460"
                                                    Height="259"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource HubCardBorderBrush}"
                                                    CornerRadius="14"
                                                    Background="Black"/>

                                            <!-- BACKGROUND ONLY -->
                                            <Border x:Name="CardBackground"
                                                    Width="460"
                                                    Height="259"
                                                    CornerRadius="14"
                                                    Background="#22000000"
                                                    SnapsToDevicePixels="True"/>

                                            <!-- CLIPPED CONTENT -->
                                            <Grid x:Name="ClippedContent"
                                                  Width="460"
                                                  Height="259"
                                                  ClipToBounds="True">

                                                <Grid.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CardMask}"
                                                                 Stretch="Fill"
                                                                 RenderOptions.BitmapScalingMode="Fant"
                                                                 RenderOptions.CachingHint="Cache"/>
                                                </Grid.OpacityMask>

                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                                            </Grid>

                                            <!-- NORMAL BORDER ABOVE IMAGE -->
                                            <Border x:Name="Card"
                                                    Width="460"
                                                    Height="259"
                                                    CornerRadius="14"
                                                    Background="Transparent"
                                                    IsHitTestVisible="False"
                                                    SnapsToDevicePixels="True"/>

                                            <!-- voile focus léger -->
                                            <Border x:Name="FocusOverlay"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>

                                            <!-- contour focus -->
                                            <Border x:Name="FocusStroke"
                                                    CornerRadius="14"
                                                    BorderThickness="3"
                                                    BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>

                                        </Grid>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                                <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.18"/>
                                            </Trigger>

                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                                <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.18"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                                <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.25"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </ControlTemplate.Resources>

                    <Grid x:Name="RootGrid"
                          Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.DirectionalNavigation="Once"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.ControlTabNavigation="Once"
                          FocusManager.FocusedElement="{Binding ElementName=ThumbGrid}"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True"
                          Opacity="0">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <!-- BACKGROUND -->
                        <Grid IsHitTestVisible="False">
                            <Border Background="{DynamicResource SecondaryViewBackground}"/>

                            <Border Background="{DynamicResource WelcomeImage1}" Opacity="0.4">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.10"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.90"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <!-- LOADING -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Panel.ZIndex="20">

                            <TextBlock Text="{DynamicResource LOCLoading}"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=CurrentGameMediaLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ProgressBar Width="360"
                                         Height="6"
                                         Margin="0,18,0,0"
                                         IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=CurrentGameMediaLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                        </StackPanel>


                        <!-- MAIN CONTENT -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="120"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=CurrentGameMediaLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- HEADER -->
                            <Grid Grid.Row="0"
                                  VerticalAlignment="Center"
                                  Margin="72,20,72,0"
                                  Panel.ZIndex="5">

                                <StackPanel VerticalAlignment="Top">

                                    <TextBlock Text="{DynamicResource LOCScreenshots}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="40"
                                               FontWeight="SemiBold"
                                               Effect="{DynamicResource SoftTextShadow}"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,12,0,0"
                                                Effect="{DynamicResource SoftTextShadow}">

                                        <!-- Selected file name -->
                                        <TextBlock Text="{Binding ElementName=ThumbGrid, Path=SelectedItem.FileName}"
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.78"
                                                   MaxWidth="900"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="  •  "
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.42"/>

                                        <!-- Selected file size -->
                                        <TextBlock Text="{Binding ElementName=ThumbGrid, Path=SelectedItem.FileSizeString}"
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.78"/>

                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- GRID -->
                            <Grid Margin="0,20,0,0"
                                  Grid.Row="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Panel.ZIndex="10">

                                <ListBox x:Name="ThumbGrid"
                                         Width="1540"
                                         Height="760"
                                         ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VisibleCurrentGameMediaItems}"
                                         SelectedIndex="0"
                                         SelectionMode="Single"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FocusVisualStyle="{x:Null}"
                                         AlternationCount="10000"
                                         pbeh:FocusBahaviors.FocusBinding="True"
                                         pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                         KeyboardNavigation.DirectionalNavigation="Contained"
                                         KeyboardNavigation.TabNavigation="Contained"
                                         KeyboardNavigation.ControlTabNavigation="Contained"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.Tag>
                                        <sys:Boolean>False</sys:Boolean>
                                    </ListBox.Tag>

                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=Tag}" Value="True">
                                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Width" Value="460"/>
                                            <Setter Property="Height" Value="259"/>
                                            <Setter Property="Margin" Value="20"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Stretch"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True"/>
                                                </Trigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <ToggleButtonEx x:Name="CardToggle"
                                                            Style="{StaticResource ScreenshotThumbToggleStyle}"
                                                            Width="460"
                                                            Height="259"
                                                            IsChecked="{Binding ElementName=ThumbGrid, Path=Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                                <Grid Width="460"
                                                      Height="259"
                                                      ClipToBounds="True"
                                                      FocusVisualStyle="{x:Null}">

                                                    <!-- IMAGE / THUMB -->
                                                    <Image x:Name="ThumbImage"
                                                           Width="460"
                                                           Height="259"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           RenderOptions.BitmapScalingMode="LowQuality"
                                                           SnapsToDevicePixels="True"
                                                           Source="{Binding ThumbnailOrFilePath, IsAsync=True}"/>

                                                    <!-- Dégradé haut -->
                                                    <Border VerticalAlignment="Top"
                                                            Height="52"
                                                            IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#B8000000" Offset="0"/>
                                                                <GradientStop Color="#52000000" Offset="0.55"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Numéro -->
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="9,8,0,0"
                                                            Padding="7,2"
                                                            Background="#C8000000"
                                                            CornerRadius="8"
                                                            Panel.ZIndex="5">
                                                        <TextBlock Foreground="White"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding MediaIndexString}"
                                                                   Style="{StaticResource TextBlockDetailStyle}"/>

                                                    </Border>

                                                    <!-- VIDEO OVERLAY -->
                                                    <Rectangle x:Name="VideoDim"
                                                               Fill="#5A000000"
                                                               Visibility="Collapsed"
                                                               IsHitTestVisible="False"
                                                               Panel.ZIndex="3"/>

                                                    <Image x:Name="PlayBadge"
                                                           Source="{ThemeFile 'Images/VideoLogo.png'}"
                                                           Width="64"
                                                           Height="64"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           RenderOptions.BitmapScalingMode="Fant"
                                                           Panel.ZIndex="4"/>

                                                    <Border x:Name="VideoDurationBadge"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Margin="9,0,0,8"
                                                            Padding="7,2"
                                                            Background="#C8000000"
                                                            CornerRadius="8"
                                                            Visibility="Collapsed"
                                                            Panel.ZIndex="5">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock Text="{DynamicResource LOCMediaDuration}"
                                                                       Foreground="White"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Style="{StaticResource TextBlockDetailStyle}"/>

                                                            <TextBlock Text="{Binding DisplayDurationString}"
                                                                       Margin="5,0,0,0"
                                                                       Foreground="White"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Style="{StaticResource TextBlockDetailStyle}"/>
                                                        </StackPanel>

                                                    </Border>

                                                </Grid>
                                            </ToggleButtonEx>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                    <Setter TargetName="VideoDim" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="PlayBadge" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="VideoDurationBadge" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- EMPTY STATE - No screenshots / media available -->
                                <Grid x:Name="NoScreenshotState"
                                      Width="1540"
                                      Height="760"
                                      Panel.ZIndex="50"
                                      IsHitTestVisible="False">

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Border Width="760"
                                            MinHeight="260"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="46,34"
                                            CornerRadius="22"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource HubCardBorderBrush}"
                                            Background="#66000000"
                                            Effect="{DynamicResource SoftTextShadow}">

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="&#xEB9F;"
                                                       FontFamily="{StaticResource FontIcons}"
                                                       FontSize="54"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,18"/>

                                            <TextBlock Text="{DynamicResource LOCNoscreenshots}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="32"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="{DynamicResource LOCNoscreenshotsSubtitle}"
                                                       Style="{DynamicResource TextBlockDetailStyle}"
                                                       FontSize="20"
                                                       Opacity="0.72"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="620"/>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- BOTTOM BUTTONS -->
                            <Grid HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Grid.Row="2"
                                  Height="80"
                                  Panel.ZIndex="20">

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,24,13"
                                            Effect="{DynamicResource SoftTextShadow}">

                                    <ButtonEx
                                        Tag="A"
                                        Content="{DynamicResource LOCOpen}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx"
                                                   BasedOn="{StaticResource ButtonBottomMenuDark}">
                                                <Setter Property="Visibility" Value="Visible"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                    </ButtonEx>

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="B"
                                              Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- FULLSCREEN VIEWER GLOBAL -->
                        <Grid x:Name="ScreenshotFullscreenOverlay"
                              Panel.ZIndex="999"
                              Background="Black"
                              IsHitTestVisible="False">

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=Tag}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- IMAGE FULLSCREEN -->
                            <Image x:Name="FullscreenImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="Fant">
                                <Image.Source>
                                    <Binding ElementName="ThumbGrid"
                                             Path="SelectedItem.FilePath"
                                             IsAsync="True"/>
                                </Image.Source>
                            </Image>

                            <!-- VIDEO FULLSCREEN -->
                            <MediaElement x:Name="FullscreenVideo"
                                          Visibility="Collapsed"
                                          Volume="{Settings Fullscreen.BackgroundVolume}"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          LoadedBehavior="Play"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="False"
                                          MediaElementBehaviors.Repeat="True"
                                          Source="{x:Null}"/>

                            <!-- Vignettage -->
                            <Rectangle IsHitTestVisible="False" Opacity="0.35">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="#000000"/>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush Center="0.5,0.55"
                                                         GradientOrigin="0.5,0.55"
                                                         RadiusX="0.95"
                                                         RadiusY="0.82">
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#70FFFFFF" Offset="0.82"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <!-- Prompt bas droite -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,28,20"
                                        Effect="{DynamicResource SoftTextShadow}">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}"/>

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="A"
                                          Content="{DynamicResource LOCBackLabel}"/>

                            </StackPanel>
                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=SelectedItem.IsVideo}" Value="True">
                            <Setter TargetName="FullscreenImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="FullscreenVideo" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FullscreenVideo" Property="Source" Value="{Binding ElementName=ThumbGrid, Path=SelectedItem.FilePath}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=SelectedItem.IsVideo}" Value="False">
                            <Setter TargetName="FullscreenVideo" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="FullscreenVideo" Property="Source" Value="{x:Null}"/>
                            <Setter TargetName="FullscreenImage" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=Tag}" Value="{x:Null}">
                            <Setter TargetName="FullscreenVideo" Property="Source" Value="{x:Null}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=ThumbGrid, Path=Tag}" Value="False">
                            <Setter TargetName="FullscreenVideo" Property="Source" Value="{x:Null}"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
