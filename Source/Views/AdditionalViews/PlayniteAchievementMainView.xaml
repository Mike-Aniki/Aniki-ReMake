                              Height="120"
                              Margin="36,0,36,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
