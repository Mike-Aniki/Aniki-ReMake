                        <!-- Header -->
                        <Grid x:Name="HeaderRoot"
                              Height="120"
                              Margin="36,0,36,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- AVATAR ROND -->
                            <Grid Grid.Column="0"
                                  Width="96"
                                  Height="96"
                                  Margin="12,12,24,12"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">

                                <!-- masque rond -->
                                <Border x:Name="AvatarMask"
                                        Width="96"
                                        Height="96"
                                        Background="Black"
                                        CornerRadius="48"/>



                                <TextBlock x:Name="ProfilePicturePath"
                                           Tag="{Api Paths.ConfigurationPath}"
                                           Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- image user masque en rond -->
                                <Grid Width="96"
                                      Height="96"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=AvatarMask}" />
                                    </Grid.OpacityMask>

                                    <Control x:Name="UserAvatar"
                                             Tag="{Binding ElementName=ProfilePicturePath, Path=Text}"
                                             Width="96"
                                             Height="96"
                                             Template="{StaticResource SteamSelfAvatarTemplate}"
                                             Focusable="False"
                                             IsTabStop="False"
                                             IsHitTestVisible="False"/>
                                </Grid>

                                <!-- contour rond -->
                                <Border Width="96"
                                        Height="96"
                                        CornerRadius="48"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="2"
                                        Background="#12000000"
                                        IsHitTestVisible="False"/>
                            </Grid>

                            <!-- TITRE / SOUS-TITRE -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,0">

                                <TextBlock FontSize="34"
                                           FontWeight="SemiBold"
                                           Typography.Capitals="AllSmallCaps"
                                           TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="#000000"/>
                                    </TextBlock.Effect>

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAchievementsTitle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumNewest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCCompletedGamesTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumOldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCCompletedGamesTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="SteamGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PSNGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCPSNGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="XboxGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCXboxGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="GOGGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCGOGGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="EpicGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCEpicGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="RetroAchievementsGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCRetroAchievementsGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="ManualGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCManualGames}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Opacity="0.72"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubRecentActivity}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="GamesOldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubOldestActivity}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumNewest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubRecentCompletions}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumOldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubOldestCompletions}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="SteamGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="PSNGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="XboxGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="GOGGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="EpicGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="RetroAchievementsGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainTrophySort]}"
                                                             Value="ManualGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubPlateform}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- LEVEL A DROITE -->
                            <Border Grid.Column="2" Margin="24,18,28,18" Padding="18,10" CornerRadius="18" Background="{DynamicResource SeparatorSuccessBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="46" Height="46" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PA_UserLevelBorderStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#66000000" BorderBrush="#88FFFFFF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="G" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource LOCLevel}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGamerscoreInsteadOfLevel]}" Value="True">
