                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Bottom"
                                                                              Margin="0,0,-2,-2">

                                                                            <!-- masque rond -->
                                                                            <Border x:Name="FriendGameIconMask"
                                                                                    Width="30"
                                                                                    Height="30"
                                                                                    Background="Black"
                                                                                    CornerRadius="15"/>

                                                                            <!-- contenu masqué -->
                                                                            <Grid Width="30"
                                                                                  Height="30">
                                                                                <Grid.OpacityMask>
                                                                                    <VisualBrush Visual="{Binding ElementName=FriendGameIconMask}" />
                                                                                </Grid.OpacityMask>

                                                                                <Border Background="#CC000000"/>
                                                                                <Image Source="{Binding GameIcon}"
                                                                                       Stretch="UniformToFill"
                                                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                                            </Grid>

                                                                            <!-- contour -->
                                                                            <Border Width="30"
                                                                                    Height="30"
                                                                                    CornerRadius="15"
                                                                                    BorderBrush="#66FFFFFF"
                                                                                    BorderThickness="1.5"
                                                                                    Background="#06000000"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Grid>
                                                                    </Grid>

                                                                    <!-- TEXT -->
                                                                    <Grid Grid.Column="1"
                                                                          VerticalAlignment="Center"
                                                                          Margin="16,0,24,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="{Binding FriendPersonaName}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   HorizontalAlignment="Left"
                                                                                   FontSize="28"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="820"/>

                                                                        <StackPanel Grid.Row="1"
                                                                                    Orientation="Horizontal"
                                                                                    Margin="0,10,0,0"
                                                                                    VerticalAlignment="Center">

                                                                            <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                                                    Padding="14,4"
                                                                                    CornerRadius="13"
                                                                                    BorderBrush="#18FFFFFF"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Text="{Binding GameName}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="18"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="360"/>
                                                                            </Border>

                                                                            <TextBlock Text="  •  "
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="18"
                                                                                       Opacity="0.60"
                                                                                       Margin="8,0"/>

                                                                            <TextBlock Text="{Binding HeaderSubtitle}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="18"
                                                                                       Opacity="0.78"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="300"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- RIGHT -->
                                                                    <Grid Grid.Column="2"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right">
                                                                        <Border Background="{DynamicResource SeparatorSuccessBrush}"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1"
                                                                                CornerRadius="14"
                                                                                Padding="12,10">
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">

                                                                                <TextBlock x:Name="HeaderActionText"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="16"
                                                                                           FontWeight="SemiBold"
                                                                                           Opacity="0.78"
                                                                                           Margin="0,0,10,0">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                            <Setter Property="Text" Value="{StaticResource LOCOpen}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                    <Setter Property="Text" Value="{StaticResource LOCClose}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>

                                                                                <Border Background="#26000000"
                                                                                        CornerRadius="8"
                                                                                        Padding="6,2"
                                                                                        Margin="0,0,10,0">
                                                                                    <TextBlock Text="{Binding Items.Count}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"/>
                                                                                </Border>

                                                                                <TextBlock x:Name="Chevron"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="18"
                                                                                           FontWeight="SemiBold"
                                                                                           Opacity="0.90">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                            <Setter Property="Text" Value="▼"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                    <Setter Property="Text" Value="▲"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </CheckBoxEx>

                                                <!-- ITEMS -->
                                                <ListBox x:Name="ItemsPanel"
                                                         ItemsSource="{Binding Items}"
                                                         Margin="0,14,0,0"
                                                         Visibility="Collapsed"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         HorizontalAlignment="Center"
                                                         MaxHeight="260"
                                                         AlternationCount="2"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.CanContentScroll="False"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         KeyboardNavigation.DirectionalNavigation="Continue"
                                                         KeyboardNavigation.TabNavigation="Continue"
                                                         KeyboardNavigation.ControlTabNavigation="Continue"
                                                         SelectionMode="Single">

                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Focusable" Value="False"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>

                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Style="{DynamicResource ButtonTrophyviewitem}"
                                                                      HorizontalAlignment="Center"
                                                                      Focusable="True"
                                                                      IsTabStop="True"
                                                                      Margin="0,0,0,8"
                                                                      Padding="0"
                                                                      KeyboardNavigation.DirectionalNavigation="Continue">

                                                                <Grid Width="1440"
                                                                      Height="96"
                                                                      HorizontalAlignment="Center">

                                                                    <Border x:Name="ItemMainBorder"
                                                                            CornerRadius="14"
                                                                            BorderThickness="1"
                                                                            BorderBrush="#18FFFFFF"
                                                                            Padding="12,10"
                                                                            Background="{DynamicResource SuccessFriendsBackgroundBrush}"
                                                                            ClipToBounds="True">

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="84"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="90"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- ICON -->
                                                                            <Grid Grid.Column="0"
                                                                                  VerticalAlignment="Center">
                                                                                <Border Width="64"
                                                                                        Height="64"
                                                                                        CornerRadius="12"
                                                                                        ClipToBounds="True"
                                                                                        Background="#22000000"
                                                                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                        BorderThickness="1">
                                                                                    <Image Source="{Binding FriendAchievementIcon}"
                                                                                           Stretch="UniformToFill"
                                                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                                                </Border>
                                                                            </Grid>

                                                                            <!-- TEXT -->
                                                                            <StackPanel Grid.Column="1"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="12,0,12,0">
                                                                                <TextBlock Text="{Binding AchievementDisplayName}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           FontSize="22"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="960"/>

                                                                                <TextBlock Text="{Binding AchievementDescription}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           Opacity="0.72"
                                                                                           FontSize="16"
                                                                                           Margin="0,4,0,0"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="960"/>
                                                                            </StackPanel>

                                                                            <!-- TIME -->
                                                                            <Grid Grid.Column="2"
                                                                                  VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding UnlockTimeLocal, StringFormat='{}{0:HH:mm}'}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           Opacity="0.78"
                                                                                           FontSize="18"
                                                                                           HorizontalAlignment="Right"
                                                                                           VerticalAlignment="Center"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="ItemsPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Chevron" Property="Text" Value="▲"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ButtonBottom -->

                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="Dpad"
                                      Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="A"
                                      Content="{DynamicResource LOCButtonPrompt_Select}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="B"
                                      Content="{DynamicResource LOCBackLabel}" />

                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AchievementsOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">

                        <Border x:Name="TrophiesMenu"
                                Grid.RowSpan="2"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource OverlayMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="0"
                                                  ShadowDepth="2"
                                                  BlurRadius="10"
                                                  Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER  -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource HeaderMenu}">


                                    <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>



                                            <!-- TITRE -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">

                                                <TextBlock Text="{DynamicResource LOCTrophiesOptions}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>

                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- separator -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="{DynamicResource SeparatorBrush}"/>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <!-- SECTION: Show -->
                                        <TextBlock Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx SelectedValuePath="Tag" Margin="0,10,0,15"
                                                    SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophyFilter], Mode=TwoWay, TargetNullValue=MyAchievements}"
                                                    Height="46">
                                            <ComboBoxItem Content="{DynamicResource LOCMyAchievements}"      Tag="MyAchievements"/>
                                            <ComboBoxItem Content="{DynamicResource LOCFriendsAchievements}" Tag="FriendsAchievements"/>
                                        </ComboBoxEx>

                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,16"/>

                                        <!-- SECTION: Sorting -->
                                        <TextBlock Text="{DynamicResource LOCFilter}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBoxEx pbeh:FocusBahaviors.FocusBinding="True"
                                                        pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                        SelectedValuePath="Tag"
                                                        SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort], Mode=TwoWay, TargetNullValue=GamesNewest}"
                                                        Margin="0,10,0,15"
                                                        Height="56">
                                                <ComboBoxItem Content="{DynamicResource LOCGamesWithAchievementsDesc}" Tag="GamesNewest"/>
                                                <ComboBoxItem Content="{DynamicResource LOCGamesWithAchievementsAsc}"  Tag="GamesOldest"/>
                                                <ComboBoxItem Content="{DynamicResource LOCCompletedGamesDesc}"       Tag="PlatinumNewest"/>
                                                <ComboBoxItem Content="{DynamicResource LOCCompletedGamesAsc}"        Tag="PlatinumOldest"/>
                                                <ComboBoxItem Content="{DynamicResource LOCSteamGames}" Tag="SteamGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCPSNGames}" Tag="PSNGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCXboxGames}" Tag="XboxGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCGOGGames}" Tag="GOGGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCEpicGames}" Tag="EpicGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCRetroAchievementsGames}" Tag="RetroAchievementsGames"/>
                                                <ComboBoxItem Content="{DynamicResource LOCManualGames}" Tag="ManualGames"/>
                                            </ComboBoxEx>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,16"/>

                                        <!-- SECTION: Actions -->
                                        <TextBlock Text="{DynamicResource LOCRefreshTrophies}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,20,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx x:Name="ButtonPA1"
                                                          Content="{DynamicResource LOCRecentlyPlayed}"
                                                          HorizontalContentAlignment="Stretch"
                                                          Command="{PluginSettings Plugin=PlayniteAchievements, Path=RecentRefreshCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCInstalledGames}"
                                                          Command="{PluginSettings Plugin=PlayniteAchievements, Path=InstalledRefreshCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCFavoriteGames}"
                                                          Command="{PluginSettings Plugin=PlayniteAchievements, Path=FavoritesRefreshCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCFullLibrary}"
                                                          Command="{PluginSettings Plugin=PlayniteAchievements, Path=FullRefreshCommand}"/>
                                            </Grid>



                                        </StackPanel>

                                    </StackPanel>

                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Grid.Column="0"
                                                  Tag="Dpad"
                                                  Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                      Tag="A"
                                                      Content="{DynamicResource LOCButtonPrompt_Select}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
