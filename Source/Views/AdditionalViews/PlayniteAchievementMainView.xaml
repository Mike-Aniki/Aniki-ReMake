                                        <VisualBrush Visual="{Binding ElementName=HeaderAvatarMask}" />
                                    </Grid.OpacityMask>

                                    <Image x:Name="UserAvatar"
                                           Source="{Binding ElementName=ProfilePicturePath, Path=Text}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="Fant"
                                           Width="96"
                                           Height="96"/>
                                </Grid>

                                <!-- contour rond -->
                                <Border Width="96"
                                        Height="96"
                                        CornerRadius="48"
                                        BorderBrush="{DynamicResource AvatarBorderBrush}"
                                        BorderThickness="2"
                                        Background="#12000000"
                                        IsHitTestVisible="False"/>
                            </Grid>

                            <!-- TITRE / SOUS-TITRE -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,0">

                                <TextBlock FontSize="34"
                                           FontWeight="SemiBold"
                                           Typography.Capitals="AllSmallCaps"
                                           TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="#000000"/>
                                    </TextBlock.Effect>

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAchievementsTitle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophyFilter]}"
                                                             Value="FriendsAchievements">
                                                    <Setter Property="Text" Value="{DynamicResource LOCFriendsActivityTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumNewest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCCompletedGamesTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="PlatinumOldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCCompletedGamesTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="SteamGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCSteamGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="PSNGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCPSNGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="XboxGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCXboxGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="GOGGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCGOGGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
                                                             Value="EpicGames">
                                                    <Setter Property="Text" Value="{DynamicResource LOCEpicGames}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MainTrophySort]}"
