                                <Style x:Key="GamesWithAchievementsListBaseStyle" TargetType="ListView">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="UseLayoutRounding" Value="True"/>
                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                                    <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Continue"/>
                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    <Setter Property="VirtualizingPanel.CacheLength" Value="2"/>
                                    <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
                                    <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>


                            </Grid.Resources>


                            <ListView x:Name="DynamicGameSummaries"
                                      ItemContainerStyle="{StaticResource GamesWithAchievementsItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummaries}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource GamesWithAchievementsListBaseStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                        </Grid>

                        <!-- Button Hidden -->

                        <ButtonEx x:Name="HiddenRecentRefreshButton"
                                  Width="1"
                                  Height="1"
                                  Opacity="0"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Command="{PluginSettings Plugin=PlayniteAchievements, Path=RecentRefreshCommand}" />

                        <ButtonEx x:Name="HiddenInstalledRefreshButton"
                                  Width="1"
                                  Height="1"
                                  Opacity="0"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Command="{PluginSettings Plugin=PlayniteAchievements, Path=InstalledRefreshCommand}" />

                        <ButtonEx x:Name="HiddenFavoritesRefreshButton"
                                  Width="1"
                                  Height="1"
                                  Opacity="0"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Command="{PluginSettings Plugin=PlayniteAchievements, Path=FavoritesRefreshCommand}" />

                        <ButtonEx x:Name="HiddenFullRefreshButton"
                                  Width="1"
                                  Height="1"
                                  Opacity="0"
                                  Focusable="False"
                                  IsHitTestVisible="False"
                                  Command="{PluginSettings Plugin=PlayniteAchievements, Path=FullRefreshCommand}" />


                        <!-- ButtonBottom -->

                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="Dpad"
                                      Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="A"
                                      Content="{DynamicResource LOCButtonPrompt_Select}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="B"
                                      Content="{DynamicResource LOCBackLabel}" />

                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AchievementsOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">

                        <Border x:Name="TrophiesMenu"
                                Grid.RowSpan="2"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource OverlayMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="0"
                                                  ShadowDepth="2"
                                                  BlurRadius="10"
                                                  Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource HeaderMenu}">


                                    <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>



                                            <!-- TITRE -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">

                                                <TextBlock Text="{DynamicResource LOCTrophiesOptions}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>

                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- separator -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="{DynamicResource SeparatorBrush}"/>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <!-- SECTION: Sorting -->
                                        <TextBlock Text="{DynamicResource LOCFilter}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>


                                        <StackPanel Orientation="Vertical">

                                            <TextBlock Text="{DynamicResource LOCProvider}"
                                                       Style="{StaticResource TextBlockDetailStyle}"
                                                       FontSize="20"
                                                       Margin="0,0,0,4"/>

                                            <ComboBoxEx Margin="0,0,0,10"
                                                        Height="56"
                                                        pbeh:FocusBahaviors.FocusBinding="True"
                                                        pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                        ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesProviderOptions}"
                                                        DisplayMemberPath="Label"
                                                        SelectedValuePath="Key"
                                                        SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesProviderKey, Mode=TwoWay}" />

                                            <TextBlock Text="{DynamicResource LOCFilter}"
                                                       Style="{StaticResource TextBlockDetailStyle}"
                                                       FontSize="20"
                                                       Margin="0,0,0,4"/>

                                            <ComboBoxEx Margin="0,0,0,10"
                                                        Height="56"
                                                        ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesFilterOptions}"
                                                        DisplayMemberPath="Label"
                                                        SelectedValuePath="Key"
                                                        SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesFilterKey, Mode=TwoWay}" />

                                            <TextBlock Text="{DynamicResource LOCSortby}"
                                                       Style="{StaticResource TextBlockDetailStyle}"
                                                       FontSize="20"
                                                       Margin="0,0,0,4"/>

                                            <ComboBoxEx Margin="0,0,0,10"
                                                        Height="56"
                                                        ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesSortOptions}"
                                                        DisplayMemberPath="Label"
                                                        SelectedValuePath="Key"
                                                        SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesSortKey, Mode=TwoWay}" />

                                            <TextBlock Text="{DynamicResource LOCDirection}"
                                                       Style="{StaticResource TextBlockDetailStyle}"
                                                       FontSize="20"
                                                       Margin="0,0,0,4"/>

                                            <ComboBoxEx Margin="0,0,0,15"
                                                        Height="56"
                                                        ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesSortDirectionOptions}"
                                                        DisplayMemberPath="Label"
                                                        SelectedValuePath="Key"
                                                        SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicGameSummariesSortDirectionKey, Mode=TwoWay}" />

                                        </StackPanel>

                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,16"/>

                                        <!-- SECTION: Actions -->
                                        <TextBlock Text="{DynamicResource LOCRefreshTrophies}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,20,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx x:Name="ButtonPA1"
                                                          Content="{DynamicResource LOCRecentlyPlayed}"
                                                          HorizontalContentAlignment="Stretch"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshRecentAchievementsCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCInstalledGames}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshInstalledAchievementsCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCFavoriteGames}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshFavoritesAchievementsCommand}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <ButtonEx Height="50"
                                                          HorizontalContentAlignment="Stretch"
                                                          Content="{DynamicResource LOCFullLibrary}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshFullAchievementsCommand}"/>
                                            </Grid>



                                        </StackPanel>

                                    </StackPanel>

                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Grid.Column="0"
                                                  Tag="Dpad"
                                                  Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                      Tag="A"
                                                      Content="{DynamicResource LOCButtonPrompt_Select}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
