                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="142">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage142}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="143">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage143}"/>
