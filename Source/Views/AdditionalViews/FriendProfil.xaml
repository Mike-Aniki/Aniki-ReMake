                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="144">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage144}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="145">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage145}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="146">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage146}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="147">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage147}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="148">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage148}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>

                                                <!-- Rare / Lucky Mode background override -->
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage150}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <Grid VerticalAlignment="Top"
                                  Height="80"
                                  IsHitTestVisible="False">

                                <Border HorizontalAlignment="Stretch"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SeparatorTopBarBrush}"
                                        Opacity="0.35"/>

                                <Grid Margin="20,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCSteamFriendsTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Typography.Capitals="AllSmallCaps"
                                                   Opacity="0.96">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="10"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.24"
                                                                  Color="#000000"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                            </Grid>

                            <!-- Friend Profile-->
                            <Grid x:Name="FriendProfilePage" Width="1300" Height="930" VerticalAlignment="Center" Margin="20,30,20,30" FocusManager.FocusedElement="{Binding ElementName=FriendProfileBackButton}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFriendProfileOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border CornerRadius="24"
                                        Background="{DynamicResource FriendsBannerBackgroundBrush}"
                                        BorderBrush="{DynamicResource FriendsBannerBorder}"
                                        BorderThickness="1"
                                        Padding="22">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Border Grid.Row="0"
                                                CornerRadius="20"
                                                Background="{DynamicResource TopBar}"
                                                BorderBrush="#18FFFFFF"
                                                BorderThickness="1"
                                                Padding="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="72"
                                                        Height="72"
                                                        CornerRadius="16"
                                                        ClipToBounds="True"
                                                        BorderBrush="#30FFFFFF"
                                                        BorderThickness="1"
                                                        Background="#18000000">
                                                    <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.avatar}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>

                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.name}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="28"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <Border Margin="14,4,0,0"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="14"
                                                                Padding="10,5"
                                                                BorderBrush="#18FFFFFF"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BadgeStatusFriendsBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.state}" Value="online">
                                                                            <Setter Property="Background" Value="#604CD964"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.state}" Value="ingame">
                                                                            <Setter Property="Background" Value="#703DFF7A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.state}" Value="away">
                                                                            <Setter Property="Background" Value="#60FF9800"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.state}" Value="busy">
                                                                            <Setter Property="Background" Value="#60B00020"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.state}" Value="offline">
                                                                            <Setter Property="Background" Value="#55B0B0B0"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.stateLoc}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.game}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="18"
                                                               Opacity="0.76"
                                                               Margin="0,6,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>



                                            </Grid>
                                        </Border>

                                        <!-- Body -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="290"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left info -->
                                            <Grid Grid.Column="0">

                                                <Border CornerRadius="20"
                                                        Opacity="0.7"
                                                        Background="{DynamicResource HubCardBottomBackgroundBrush}"
                                                        BorderBrush="{DynamicResource FriendsBannerBorder}"
                                                        BorderThickness="1" />

                                                <Border CornerRadius="20"
                                                        Padding="18">
                                                    <StackPanel>

                                                        <!-- Title -->
                                                        <TextBlock Text="{DynamicResource LOCFriendProfile}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="22"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,20"/>

                                                        <!-- Friend since -->
                                                        <TextBlock Text="{DynamicResource LOCFriendSince}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="16"
                                                                   Opacity="0.62"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.friendSinceUtc, StringFormat={}{0:dd/MM/yyyy}}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,6,0,18"/>

                                                        <!-- Last online -->
                                                        <TextBlock Text="{DynamicResource LOCLastOnline}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="16"
                                                                   Opacity="0.62"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.lastLogoffUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,6,0,18"/>

                                                        <!-- Steam level -->
                                                        <TextBlock Text="{DynamicResource LOCSteamLevel}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="16"
                                                                   Opacity="0.62"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.steamLevel}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,6,0,18"/>

                                                        <!-- Badges -->
                                                        <TextBlock Text="{DynamicResource LOCBadges}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="16"
                                                                   Opacity="0.62"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.badgesCount}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,6,0,18"/>

                                                        <!-- Last 15 days -->
                                                        <TextBlock Text="{DynamicResource LOCLast15Days}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="16"
                                                                   Opacity="0.62"/>

                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.recentPlaytime2WeeksDisplay}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="21"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,6,0,18"/>

                                                        <!-- Error -->
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FriendProfileError}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="Orange"
                                                                   FontSize="15"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FriendProfileError}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FriendProfileError}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                    </StackPanel>
                                                </Border>

                                            </Grid>

                                            <!-- Right panel : recent games + recent achievements -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="20"
                                                    Padding="18,0,18,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Recent games title -->
                                                    <TextBlock Grid.Row="0"
                                                               Text="{DynamicResource LOCFriendRecentGames}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,16"/>

                                                    <!-- Recent games list -->
                                                    <ItemsControl Grid.Row="1"
                                                                  ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.recentGames}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,5"
                                                                        CornerRadius="16"
                                                                        Background="{DynamicResource BackgroundItem}"
                                                                        BorderBrush="{DynamicResource FriendsCardBorderBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="16,14">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="180"/>
                                                                            <ColumnDefinition Width="16"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Width="180"
                                                                                Height="84"
                                                                                CornerRadius="12"
                                                                                ClipToBounds="True"
                                                                                Background="#22000000"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1"
                                                                                VerticalAlignment="Center">
                                                                            <Image Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="Fant">
                                                                                <Image.Source>
                                                                                    <Binding Path="headerImageUrl"
                                                                                             IsAsync="True"/>
                                                                                </Image.Source>
                                                                            </Image>

                                                                        </Border>

                                                                        <StackPanel Grid.Column="2"
                                                                                    VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding name}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="21"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>

                                                                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="15"
                                                                                       FontWeight="SemiBold"
                                                                                       Opacity="0.70"
                                                                                       Margin="0,5,0,0">
                                                                                <Run Text="{Binding playtime2WeeksDisplay}" />
                                                                                <Run Text=" " />
                                                                                <Run Text="{DynamicResource LOCLast14Days}" />
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <Border Grid.Column="3"
                                                                                CornerRadius="14"
                                                                                Padding="12,7"
                                                                                Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="15"
                                                                                       FontWeight="SemiBold"
                                                                                       Opacity="0.90">
                                                                                <Run Text="{Binding playtimeForeverDisplay}" />
                                                                                <Run Text=" " />
                                                                                <Run Text="{DynamicResource LOCTotalLabel}" />
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Recent achievements title -->
                                                    <TextBlock Grid.Row="3"
                                                               Text="{DynamicResource LOCStatsRecentAchievements}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,16">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.recentAchievements.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Recent achievements list -->
                                                    <ItemsControl Grid.Row="4"
                                                                  ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.recentAchievements}">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedFriendProfile.recentAchievements.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,12"
                                                                        CornerRadius="16"
                                                                        Background="{DynamicResource HubCardBottomBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="14,12">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="64"/>
                                                                            <ColumnDefinition Width="14"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Width="64"
                                                                                Height="64"
                                                                                CornerRadius="14"
                                                                                ClipToBounds="True"
                                                                                Background="#22000000"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1"
                                                                                VerticalAlignment="Top">
                                                                            <Image Source="{Binding icon}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                                        </Border>

                                                                        <StackPanel Grid.Column="2"
                                                                                    VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding achievementDisplayName}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="18"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>

                                                                            <TextBlock Text="{Binding gameName}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="15"
                                                                                       Opacity="0.72"
                                                                                       Margin="0,3,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>

                                                                            <TextBlock Text="{Binding unlockTimeDisplay}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="13"
                                                                                       Opacity="0.55"
                                                                                       Margin="0,5,0,0"/>

                                                                            <TextBlock Text="{Binding achievementDescription}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       FontSize="13"
                                                                                       Opacity="0.50"
                                                                                       Margin="0,5,0,0"
                                                                                       TextWrapping="Wrap"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxHeight="34">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding achievementDescription}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding achievementDescription}" Value="">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Loading -->
                                                    <TextBlock Grid.RowSpan="5"
                                                               Text="{DynamicResource LOCFriendProfileLoading}"
                                                               FontSize="28"
                                                               Opacity="0.90"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFriendProfileLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="CancelAction" Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}" />

                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>


                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>



</ResourceDictionary>
