                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="132">
                                                    <Setter Property="Background" Value="{DynamicResource FriendsViewImage132}"/>
                                                    <Setter Property="Opacity" Value="0.15"/>
                                                </DataTrigger>
