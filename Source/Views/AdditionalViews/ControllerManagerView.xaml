<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Controller Manager compact Fullscreen panel. -->
    <Style x:Key="ControllerManagerWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid Background="Transparent"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=ControllerManagerTesterButton}">

                        <Grid.Resources>
                            <Style x:Key="ControllerManagerActionButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="MinWidth" Value="150"/>
                                <Setter Property="Padding" Value="18,0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid Background="Transparent">
                                                <Border x:Name="ButtonBackground"
                                                        Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Opacity="0.85"/>

                                                <Border x:Name="ButtonFlash"
                                                        CornerRadius="10"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <Border x:Name="ButtonFocus"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                    <Setter TargetName="ButtonFocus" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ButtonFlash" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ButtonFlash" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                    <Setter TargetName="ButtonFocus" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <Border Background="#96000000"/>

                        <Grid x:Name="ControllerManagerPanel"
                              Width="540"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,86,28,0"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0">

                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform X="28" Y="-12"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ControllerManagerPanel"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ControllerManagerPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             From="0.96" To="1" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ControllerManagerPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="0.96" To="1" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ControllerManagerPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="28" To="0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ControllerManagerPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="-12" To="0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Border Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <Grid Margin="24,20,24,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Grid Grid.Row="0" Margin="2,0,2,17">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="42" Height="42"
                                            CornerRadius="10"
                                            Background="{DynamicResource ButtonBackgroundNoFocus}"
                                            Margin="0,0,13,0">
                                        <TextBlock Text=""
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Controller Manager"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Connected controllers"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   Opacity="0.82"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            MinWidth="42" Height="30"
                                            Padding="10,0"
                                            CornerRadius="15"
                                            Background="{DynamicResource ButtonBackgroundNoFocus}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{PluginSettings Plugin=ControllerSessionManager, Path=ConnectedCount}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.7"/>

                                <!-- PRIMARY CONTROLLER CARD -->
                                <Border Grid.Row="2"
                                        Margin="0,18,0,14"
                                        Padding="18,16"
                                        Background="{DynamicResource BackgroundMenu}"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ControllerSessionManager, Path=HasConnectedControllers}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text=""
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="23"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{PluginSettings Plugin=ControllerSessionManager, Path=PrimaryControllerName}"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Primary controller"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextDetailBrush}"
                                                           Opacity="0.8"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=ControllerSessionManager, Path=PrimaryControllerBatteryLabel}"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{PluginSettings Plugin=ControllerSessionManager, Path=PrimaryControllerBatteryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Battery state is semantic; no fake percentage. -->
                                        <Border Grid.Row="1"
                                                Height="4"
                                                Margin="0,14,0,0"
                                                CornerRadius="2"
                                                Background="{PluginSettings Plugin=ControllerSessionManager, Path=PrimaryControllerBatteryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ControllerSessionManager, Path=HasPrimaryControllerBattery}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock Grid.Row="2"
                                                   Text="{PluginSettings Plugin=ControllerSessionManager, Path=StatusText}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   Opacity="0.84"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- EMPTY STATE -->
                                <Border Grid.Row="2"
                                        Margin="0,18,0,14"
                                        Padding="18,18"
                                        Background="{DynamicResource BackgroundMenu}"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ControllerSessionManager, Path=HasConnectedControllers}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="" FontFamily="{DynamicResource FontIcons}" FontSize="22" Foreground="{DynamicResource TextDetailBrush}" Opacity="0.72" Margin="0,0,12,0"/>
                                        <TextBlock Text="No controller connected" FontFamily="{DynamicResource FontMain}" FontSize="16" Foreground="{DynamicResource TextDetailBrush}" Opacity="0.82" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="3" Height="6"/>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ButtonEx x:Name="ControllerManagerTesterButton"
                                              Grid.Column="0"
                                              Style="{StaticResource ControllerManagerActionButtonStyle}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[GamepadTesterWindowStyle|GamepadTester_ButtonMap|NoDim]}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="" FontFamily="{DynamicResource FontIcons}" FontSize="19" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Controller Tester" FontFamily="{DynamicResource FontMain}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </ButtonEx>

                                    <ButtonEx Grid.Column="2"
                                              Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="B"
                                              Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

