<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Overlay child window for Apps. -->
    <Style x:Key="AppsWindowStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="1920"
                          Height="1080"
                          Background="Transparent"
                          Focusable="False">

                        <Rectangle IsHitTestVisible="False" Fill="#96000000"/>


                        <Border Width="980"
                                Height="720"
                                Padding="38,30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="28"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1"
                                Effect="{DynamicResource SoftTextShadow}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <Border Width="62"
                                            Height="62"
                                            CornerRadius="31"
                                            Background="#18000000"
                                            BorderBrush="#80D0B06A"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xECAA;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="28"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{DynamicResource LOCApps}"
                                               Margin="0,14,0,0"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="42"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{DynamicResource LOCAppsSubtitle}"
                                               Margin="0,6,0,0"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="16"
                                               Opacity="0.88"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Width="260"
                                            Height="1"
                                            Margin="0,16,0,0"
                                            Background="#55D0B06A"/>
                                </StackPanel>

                                <!-- Apps list -->
                                <Grid Grid.Row="2">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Focusable="False"
                                                  CanContentScroll="True">
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=OverlayAppItems}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HasOverlayApps}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Height="88"
                                                              Margin="0,0,0,12"
                                                              Padding="0"
                                                              HorizontalAlignment="Stretch"
                                                              FocusVisualStyle="{x:Null}"
                                                              Focusable="True"
                                                              IsTabStop="True"
                                                              KeyboardNavigation.IsTabStop="True"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenOverlayAppCommand}"
                                                              CommandParameter="{Binding}">
                                                        <ButtonEx.Style>
                                                            <Style TargetType="ButtonEx">
                                                                <Setter Property="Background" Value="#0B000000"/>
                                                                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ButtonEx">
                                                                            <Border x:Name="AppCard"
                                                                                    CornerRadius="20"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="AppCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AppCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsFocused" Value="True">
                                                                                    <Setter TargetName="AppCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AppCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                    <Setter TargetName="AppCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AppCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ButtonEx.Style>

                                                        <Grid Margin="18,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="46"
                                                                    Height="46"
                                                                    CornerRadius="14"
                                                                    Background="#16000000"
                                                                    BorderBrush="#30FFFFFF"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <Grid ClipToBounds="True">
                                                                    <TextBlock Text="&#xECAA;"
                                                                               FontFamily="{DynamicResource FontIcons}"
                                                                               FontSize="22"
                                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                                               Opacity="0.75"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding IconPath}"
                                                                           Stretch="Uniform"
                                                                           Margin="8"
                                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="16,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty state -->
                                    <Border Width="650"
                                            Height="230"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="22"
                                            Background="#10000000"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            Padding="28">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HasOverlayApps}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xECAA;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="42"
                                                       Opacity="0.85"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource NoApps}"
                                                       Margin="0,14,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayAppsEmptyText}"
                                                       Margin="0,8,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="16"
                                                       Opacity="0.65"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Footer -->
                                <Grid Grid.Row="3" Margin="0,22,0,0">
                                    <TextBlock Text="{DynamicResource NoAppsSubtitle}"
                                               FontSize="15"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Opacity="0.62"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"/>

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="CancelAction"
                                              Content="{DynamicResource LOCBackLabel}"
                                              HorizontalAlignment="Right"
                                              Focusable="False"
                                              IsTabStop="False"
                                              IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
