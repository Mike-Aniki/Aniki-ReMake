                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCNoTrophyDetails}"
                                                    IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[NoTrophyDetails], Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCNoPlayerDetails}"
                                                    IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[NoPlayerDetails], Mode=TwoWay}" />

                                    </StackPanel>
                                </Grid>

                                <!-- SYSTEM PAGE -->
                                <Grid x:Name="SystemPage">
                                    <Grid.Style>
                                        <Style TargetType="Grid" BasedOn="{StaticResource QuickSettingsPageStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ModeSystemInternal, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <StackPanel Margin="50,20,50,40" Orientation="Vertical">

                                        <CheckBoxEx x:Name="Batt"
                                                    Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsShowBatteryStatus}"
                                                    IsChecked="{Settings Fullscreen.ShowBattery, Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsShowBatteryPercentage}"
                                                    IsChecked="{Settings Fullscreen.ShowBatteryPercentage, Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsShowClock}"
                                                    IsChecked="{Settings Fullscreen.ShowClock, Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCShowMoData}"
                                                    IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowMoData], Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsMinimizeAfterStartingGame}"
                                                    IsChecked="{Settings Fullscreen.MinimizeAfterGameStartup, Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsHideMouseCursor}"
                                                    IsChecked="{Settings Fullscreen.HideMouserCursor, Mode=TwoWay}" />

                                        <CheckBoxEx Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource SettingsSectionCheckbox}"
                                                    Content="{DynamicResource LOCSettingsRefocusOnGuidButton}"
                                                    IsChecked="{Settings Fullscreen.GuideButtonFocus, Mode=TwoWay}" />

                                    </StackPanel>
                                </Grid>

                                <!-- Audio ControlCenter -->
                                <Grid x:Name="Volume">
                                    <Grid.Style>
                                        <Style TargetType="Grid" BasedOn="{StaticResource QuickSettingsPageStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ModeAudioInternal, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>


                                    <StackPanel Margin="50,20,50,40" Orientation="Vertical">

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="40,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCSettingsInterfaceVolume}" />
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{Settings Fullscreen.InterfaceVolume}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">


                                                <SliderEx x:Name="SliderElement"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          Width="300"
                                                          LargeChange="0.1"
                                                          Maximum="1"
                                                          Minimum="0"
                                                          SmallChange="0.1"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          TickFrequency="0.1"
                                                          Value="{Settings Fullscreen.InterfaceVolume, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="40,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCSettingsMusiVolume}" />
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{Settings Fullscreen.BackgroundVolume}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <SliderEx HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          Width="300"
                                                          LargeChange="0.10"
                                                          Maximum="1"
                                                          Minimum="0"
                                                          SmallChange="0.10"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          TickFrequency="0.10"
                                                          Value="{Settings Fullscreen.BackgroundVolume, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Grid>

                                <!-- Layout ControlCenter -->
                                <Grid x:Name="LayoutOption">
                                    <Grid.Style>
                                        <Style TargetType="Grid" BasedOn="{StaticResource QuickSettingsPageStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ModeLayoutInternal, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>


                                    <StackPanel Margin="50,20,50,40" Orientation="Vertical">

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="40,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCColumns}" />
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{Settings Fullscreen.Columns}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <SliderEx x:Name="ButtonLayout1"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          Width="300"
                                                          LargeChange="1"
                                                          Maximum="10"
                                                          Minimum="1"
                                                          SmallChange="1"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          TickFrequency="1"
                                                          Value="{Settings Fullscreen.Columns, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="40,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCSettingsGridItemSpacing}" />
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{Settings FullscreenItemSpacing}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <SliderEx HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          Width="300"
                                                          LargeChange="5"
                                                          Maximum="200"
                                                          Minimum="0"
                                                          SmallChange="5"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          TickFrequency="5"
                                                          Value="{Settings FullscreenItemSpacing, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="40,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCRows}" />
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,20,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="24"
                                                           Text="{Settings Fullscreen.Rows}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <SliderEx HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          Width="300"
                                                          LargeChange="1"
                                                          Maximum="10"
                                                          Minimum="1"
                                                          SmallChange="1"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          TickFrequency="1"
                                                          Value="{Settings Fullscreen.Rows, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Grid>

                            </Grid>


                            <!-- FOOTER -->
                            <Border Grid.Row="3" BorderBrush="{DynamicResource SeparatorTopBarBrush}" BorderThickness="0,1,0,0"
                                    Padding="26,12,26,12"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Grid.Column="0"
                                              Tag="Dpad"
                                              Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Opacity="0.75">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="A"
                                                  Content="{DynamicResource LOCButtonPrompt_Select}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>


                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
