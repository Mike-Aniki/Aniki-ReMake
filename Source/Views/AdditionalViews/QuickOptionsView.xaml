<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Vue ControlCenter - Quick Options compact v3 -->
    <Style x:Key="ControlCenterWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=ButtonSystem}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained">
                        <Grid.InputBindings>
                            <pin:GameControllerInputBinding Button="LeftShoulder"
                                                            Command="{Binding Command, ElementName=QuickOptionsPreviousSectionShortcutButton}" />

                            <pin:GameControllerInputBinding Button="RightShoulder"
                                                            Command="{Binding Command, ElementName=QuickOptionsNextSectionShortcutButton}" />
                        </Grid.InputBindings>
                        <Grid.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.30"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         From="100" To="0"
                                                         Duration="0:0:0.40">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>


                        <!-- TOP BUTTON -->
                        <Grid.Resources>

                            <Style x:Key="QuickSettingsPageStyle" TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                                <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Continue"/>
                                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                            </Style>

                            <!-- BASE STYLE : version ButtonEx de ton ancien OptionButtonMain -->
                            <Style x:Key="ControlCenterTopTabBaseStyle" TargetType="ButtonEx">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Height" Value="60" />
                                <Setter Property="Width" Value="60" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Tag" Value="{x:Null}" />

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid x:Name="MainGrid" Background="Transparent">

                                                <!-- Fond -->
                                                <Border x:Name="MainBackground"
                                                        Background="Transparent"
                                                        Opacity="0.20"
                                                        CornerRadius="{DynamicResource Corner}"/>

                                                <!-- Reflet -->
                                                <Border x:Name="Glass"
                                                        Background="{DynamicResource GlassMainBrush}"
                                                        Opacity="0"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        IsHitTestVisible="False"/>

                                                <!-- Flash -->
                                                <Border x:Name="FlashMenuBorder"
                                                        Margin="-4"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <!-- Bord focus / actif -->
                                                <Border x:Name="MainBorder"
                                                        Margin="-4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="3"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <!-- Bord focus / actif -->
                                                <Border x:Name="MainBorderactif"
                                                        Margin="-4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="3"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <!-- Contenu -->
                                                <ContentPresenter x:Name="Content"
                                                                  Opacity="0.8"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <!-- Onglet actif -->
                                                <Trigger Property="Tag" Value="Selected">
                                                    <Setter TargetName="MainBorderactif" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorderactif" Property="Opacity" Value="0.35"/>
                                                    <Setter TargetName="MainBackground" Property="Opacity" Value="0.35"/>
                                                    <Setter TargetName="Glass" Property="Opacity" Value="0.55"/>
                                                </Trigger>

                                                <!-- Focus clavier / manette -->
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBackground" Property="Opacity" Value="0.35"/>
                                                    <Setter TargetName="Glass" Property="Opacity" Value="0.55"/>
                                                    <Setter TargetName="Content" Property="Opacity" Value="1"/>
                                                </Trigger>

                                                <!-- Hover souris -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBackground" Property="Opacity" Value="0.35"/>
                                                    <Setter TargetName="Glass" Property="Opacity" Value="0.55"/>
                                                </Trigger>

                                                <!-- Désactivé -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                                    <Setter TargetName="MainBackground" Property="Opacity" Value="0.10"/>
                                                    <Setter TargetName="Glass" Property="Opacity" Value="0.15"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Styles sélectionnés -->

                            <Style x:Key="ControlCenterTabThemeStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeThemeInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabDetailsStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeDetailsInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabTrailerStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeTrailerInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabSystemStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeSystemInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabVisualStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeVisualInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabAchievementsStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModePlayniteAchievementInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabDataStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeDataInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabAudioStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeAudioInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="ControlCenterTabLayoutStyle"
                                   TargetType="ButtonEx"
                                   BasedOn="{StaticResource ControlCenterTopTabBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ModeLayoutInternal}" Value="True">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                        </Grid.Resources>

                        <Rectangle x:Name="QuickSettingsDim"
                                   Fill="#22000000"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                        <Grid x:Name="QuickSettingsPanelHost"
                              Width="720"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              RenderTransformOrigin="0.5,0.5"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="QuickSettingsPanelTranslate" X="0"/>
                            </Grid.RenderTransform>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="95"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="65"/>
                            </Grid.RowDefinitions>

                            <!-- glass shell -->
                            <Border Grid.RowSpan="4" Background="{DynamicResource OverlayMenu}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1,0,0,0"
                                    Opacity="1"/>

                            <!-- TOGGLES INTERNES -->
                            <ToggleButtonEx x:Name="ModeSystemInternal" Visibility="Collapsed" IsChecked="True" />
                            <ToggleButtonEx x:Name="ModeThemeInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeDetailsInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeTrailerInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeVisualInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModePlayniteAchievementInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeDataInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeAudioInternal" Visibility="Collapsed" IsChecked="False" />
                            <ToggleButtonEx x:Name="ModeLayoutInternal" Visibility="Collapsed" IsChecked="False" />

                            <ButtonEx x:Name="QuickOptionsPreviousSectionShortcutButton"
                                      Visibility="Collapsed"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Command="{PluginSettings Plugin=AnikiHelper, Path=QuickOptionsPreviousSectionCommand}" />

                            <ButtonEx x:Name="QuickOptionsNextSectionShortcutButton"
                                      Visibility="Collapsed"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Command="{PluginSettings Plugin=AnikiHelper, Path=QuickOptionsNextSectionCommand}" />

                            <Border Background="#33000000" Grid.Row="0" />
                            <Border Background="#33000000" Grid.Row="3" />

                            <!-- TOP BUTTON -->
                            <Grid Grid.Row="0" Height="80" Margin="0,10,0,0"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Continue"
                                  KeyboardNavigation.ControlTabNavigation="Continue">



                                <StackPanel x:Name="QuickSettingsTopNav"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            KeyboardNavigation.DirectionalNavigation="Continue"
                                            KeyboardNavigation.TabNavigation="Continue"
                                            KeyboardNavigation.ControlTabNavigation="Continue">

                                    <!-- SYSTEM -->
                                    <ButtonEx x:Name="ButtonSystem" Margin="10,0,10,0"
                                              pbeh:FocusBahaviors.FocusBinding="True"
                                              Style="{StaticResource ControlCenterTabSystemStyle}">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeThemeInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDetailsInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeTrailerInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeSystemInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeVisualInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModePlayniteAchievementInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDataInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeAudioInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeLayoutInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </ButtonEx>

                                    <!-- THEME -->
                                    <ButtonEx x:Name="ButtonThemeOption" Margin="10,0,10,0"
                                              Focusable="True"
                                              Style="{StaticResource ControlCenterTabThemeStyle}">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeThemeInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDetailsInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeTrailerInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeSystemInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeVisualInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModePlayniteAchievementInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDataInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeAudioInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeLayoutInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </ButtonEx>

                                    <!-- DETAILS -->
                                    <ButtonEx x:Name="ButtonThemeOptionDetails" Margin="10,0,10,0"
                                              Style="{StaticResource ControlCenterTabDetailsStyle}">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeThemeInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDetailsInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeTrailerInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeSystemInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeVisualInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModePlayniteAchievementInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDataInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeAudioInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeLayoutInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </ButtonEx>

                                    <!-- DATA -->
                                    <ButtonEx x:Name="ButtonData" Margin="10,0,10,0"
                                              Style="{StaticResource ControlCenterTabDataStyle}">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeThemeInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDetailsInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeTrailerInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeSystemInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeVisualInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModePlayniteAchievementInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDataInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeAudioInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeLayoutInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                        <TextBlock Text="&#xe903;"
                                                   FontFamily="{DynamicResource FontIcomoon}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </ButtonEx>

                                    <!-- VISUAL -->
                                    <ButtonEx x:Name="ButtonVisual" Margin="10,0,10,0"
                                              Style="{StaticResource ControlCenterTabVisualStyle}">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeThemeInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDetailsInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeTrailerInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeSystemInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeVisualInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModePlayniteAchievementInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeDataInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeAudioInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ModeLayoutInternal" Storyboard.TargetProperty="IsChecked">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
