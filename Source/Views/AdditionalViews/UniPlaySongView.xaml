<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- UniPlaySong quick settings - premium console overlay -->
    <Style x:Key="UniPlaySongWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained">

                        <Grid.Resources>

                            <Style x:Key="UPSPremiumCheckBoxStyle" TargetType="CheckBoxEx">
                                <Setter Property="Height" Value="68"/>
                                <Setter Property="MinHeight" Value="68"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBoxEx">
                                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                                <Border x:Name="FocusBackground"
                                                        CornerRadius="13"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"
                                                        Opacity="0.74"/>

                                                <Border x:Name="FlashMenuBorder"
                                                        CornerRadius="13"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <Border x:Name="FocusBorder"
                                                        BorderThickness="2"
                                                        CornerRadius="13"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>

                                                <ContentPresenter Margin="16,0"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>

                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FocusBackground" Property="Opacity" Value="0.44"/>
                                                    <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="UPSToggleStatusTextStyle" TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource LOCOff}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDetailBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBoxEx}}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource LOCOn}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="UPSTogglePillStyle" TargetType="Border">
                                <Setter Property="MinWidth" Value="76"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="CornerRadius" Value="14"/>
                                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundNoFocus}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBoxEx}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                        </Grid.Resources>

                        <!-- Modal dim matching Audio Switcher. -->
                        <Border Background="#96000000"/>

                        <Grid x:Name="UniPlaySongPanelHost"
                              Width="770"
                              MaxHeight="820"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0.5"
                              KeyboardNavigation.TabNavigation="Contained"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.ControlTabNavigation="Contained"
                              FocusManager.FocusedElement="{Binding ElementName=UPS_EnableMusicToggle}">

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="0.965" ScaleY="0.965"/>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UniPlaySongPanelHost"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="UniPlaySongPanelHost"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             From="0.965"
                                                             To="1"
                                                             Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="UniPlaySongPanelHost"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             From="0.965"
                                                             To="1"
                                                             Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Border Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"/>

                            <Border Background="{DynamicResource GlassMainBrush}"
                                    CornerRadius="20"
                                    Opacity="0.22"
                                    IsHitTestVisible="False"/>

                            <Border BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Opacity="0.22"
                                    IsHitTestVisible="False"/>

                            <Grid Margin="34,24,34,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,26"
                                            Effect="{DynamicResource SoftTextShadow}">

                                    <Border Width="54"
                                            Height="54"
                                            CornerRadius="27"
                                            Background="{DynamicResource ButtonBackgroundFocus}"
                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,13">
                                        <TextBlock Text="&#xE189;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="27"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="UniPlaySong"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{DynamicResource LOCMusicQuickSettings}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="13"
                                               Opacity="0.72"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                    <Border Width="230"
                                            Height="1"
                                            Background="{DynamicResource FocusGameBorderBrush}"
                                            Opacity="0.48"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0"/>
                                </StackPanel>

                                <!-- Settings panel -->
                                <Border Grid.Row="1"
                                        Padding="20,18,20,10"
                                        Background="{DynamicResource BackgroundMenu}"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Margin="0,0,0,22">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                            <TextBlock Text="{DynamicResource LOCMusicPlayback}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.88"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    KeyboardNavigation.TabNavigation="Continue"
                                                    KeyboardNavigation.DirectionalNavigation="Continue">

                                            <CheckBoxEx x:Name="UPS_EnableMusicToggle"
                                                        Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=EnableMusic, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xE189;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCEnableGameMusic}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="{DynamicResource LOCEnableGameMusicDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11"  Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}">
                                                        <TextBlock Style="{StaticResource UPSToggleStatusTextStyle}"/>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                            <CheckBoxEx Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=EnableDefaultMusic, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCEnableDefaultMusic}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="{DynamicResource LOCEnableDefaultMusicDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}">
                                                        <TextBlock Style="{StaticResource UPSToggleStatusTextStyle}"/>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                            <CheckBoxEx Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xECAD;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCRadioMode}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold" />
                                                        <TextBlock Text="{DynamicResource LOCRadioModeDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}">
                                                        <TextBlock Style="{StaticResource UPSToggleStatusTextStyle}"/>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                            <CheckBoxEx Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=SwitchRadioMode, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xE8AB;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCRadioSource}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="{DynamicResource LOCRadioSourceDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}" MinWidth="92">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Text" Value="UPS"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBoxEx}}" Value="True">
                                                                            <Setter Property="Text" Value="SPOTIFY"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                            <CheckBoxEx Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=PlayOnlyOnGameSelect, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xE7FC;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCPlayOnlyOnGameSelect}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold" />
                                                        <TextBlock Text="{DynamicResource LOCPlayOnlyOnGameSelectDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}">
                                                        <TextBlock Style="{StaticResource UPSToggleStatusTextStyle}"/>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                            <CheckBoxEx Style="{StaticResource UPSPremiumCheckBoxStyle}"
                                                        Margin="0,0,0,0"
                                                        IsChecked="{PluginSettings Plugin=UniPlaySong, Path=CalmDownModeEnabled, Mode=TwoWay}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="&#xE708;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource LOCNightMusicMode}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="{DynamicResource LOCCalmDownModeDescription}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="11" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource UPSTogglePillStyle}">
                                                        <TextBlock Style="{StaticResource UPSToggleStatusTextStyle}"/>
                                                    </Border>
                                                </Grid>
                                            </CheckBoxEx>

                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Footer -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,2,0"
                                            Effect="{DynamicResource SoftTextShadow}">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="B"
                                              Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-50,0,-50"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-300,0,-300,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
