                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Header -->
                            <Grid Height="120"
                                  Margin="36,0,36,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Optional user avatar, same logic as the achievements view -->
                                <Grid Grid.Column="0"
                                      Width="96"
                                      Height="96"
                                      Margin="12,12,24,12"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">

                                    <!-- masque rond -->
                                    <Border x:Name="AvatarMask"
                                            Width="96"
                                            Height="96"
                                            Background="Black"
                                            CornerRadius="48"/>



                                    <TextBlock x:Name="ProfilePicturePath"
                                               Tag="{Api Paths.ConfigurationPath}"
                                               Visibility="Collapsed">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- image user masque en rond -->
                                    <Grid Width="96"
                                          Height="96"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=AvatarMask}" />
                                        </Grid.OpacityMask>

                                        <Control x:Name="UserAvatar"
                                                 Tag="{Binding ElementName=ProfilePicturePath, Path=Text}"
                                                 Width="96"
                                                 Height="96"
                                                 Template="{StaticResource SteamSelfAvatarTemplate}"
                                                 Focusable="False"
                                                 IsTabStop="False"
                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- contour rond -->
                                    <Border Width="96"
                                            Height="96"
                                            CornerRadius="48"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="2"
                                            Background="#12000000"
                                            IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Title -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{DynamicResource LOCFriendsAchievements}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               Typography.Capitals="AllSmallCaps"
                                               TextAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="12"
                                                              ShadowDepth="0"
                                                              Opacity="0.35"
                                                              Color="#000000"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Opacity="0.72"
                                               Margin="0,8,0,0"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">

                                                <!-- unchecked = Top 10 latest unlocks -->
                                                <Setter Property="Text" Value="{DynamicResource LOCFriendsAchievementsSubtitleTop10}"/>

                                                <Style.Triggers>
                                                    <!-- checked = All games trophies by friends -->
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource LOCFriendsAchievementsSubtitleAllGames}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Right info badge -->
                                <Border Grid.Column="2"
                                        Margin="24,18,28,18"
                                        Padding="18,10"
                                        CornerRadius="18"
                                        Background="{DynamicResource SeparatorSuccessBrush}"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCFriendsAchievementsBadge}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Options button -->
                            <CheckBoxEx x:Name="FriendsActivitySortButton"
                                        Margin="50,200,0,0"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Content="&#xE8CB;"
                                        Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendsActivityOptionsWindow]}"
                                        pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                        FontFamily="{DynamicResource FontIcons}"
                                        FontSize="22">
                                <CheckBoxEx.Style>
                                    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}"/>
                                </CheckBoxEx.Style>
                            </CheckBoxEx>

                            <!-- Mode switch: Last trophies / Per game. -->
                            <CheckBoxEx x:Name="FriendActivityModeToggle"
                                        Margin="50,270,0,0"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Content="&#xF1CB;"
                                        IsChecked="True"
                                        FontFamily="{DynamicResource FontIcons}"
                                        FontSize="22"
                                        FontWeight="SemiBold">
                                <CheckBoxEx.Style>
                                    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource FriendsSuccessSorting}"/>
                                </CheckBoxEx.Style>
                            </CheckBoxEx>

                            <!-- Main panel -->
                            <Border CornerRadius="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Height="790"
                                    Width="1620"
                                    Margin="0,110,0,0"
                                    BorderBrush="{DynamicResource SuccessBannerBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SuccessBannerBackgroundBrush}"
                                    Padding="20"/>

                            <Grid x:Name="FriendsActivityRoot"
                                  pbeh:FocusBahaviors.FocusBinding="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Height="735"
                                  Width="1560"
                                  Margin="0,110,0,0"
                                  Background="Transparent"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  KeyboardNavigation.ControlTabNavigation="Cycle">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT : FRIEND LIST -->
                                <Border Grid.Column="0"
                                        CornerRadius="22"
                                        Background="{DynamicResource BackgroundItem}"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1.5"
                                        Padding="16"
                                        ClipToBounds="True">

                                    <Grid>
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Orientation="Vertical"
                                                        Margin="4,0,4,0">

                                                <TextBlock Text="{DynamicResource LOCFriendsAchievementsFriends}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"/>

                                                <TextBlock Text="{DynamicResource LOCFriendsAchievementsSelectFriend}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                           FontSize="17"
                                                           Opacity="0.62"
                                                           Margin="0,4,0,0"
                                                           HorizontalAlignment="Left"/>
                                            </StackPanel>

                                            <ListBox x:Name="FriendScopeList"
                                                     Grid.Row="2"
                                                     pbeh:FocusBahaviors.FocusBinding="True"
                                                     ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendSummaries}"
                                                     SelectedValuePath="FriendScopeKey"
                                                     SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeUserKey, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FocusVisualStyle="{x:Null}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     KeyboardNavigation.DirectionalNavigation="Continue"
                                                     KeyboardNavigation.TabNavigation="Continue"
                                                     KeyboardNavigation.ControlTabNavigation="Continue">

                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Focusable" Value="True"/>
                                                        <Setter Property="IsTabStop" Value="True"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="FriendCard"
                                                                            Height="76"
                                                                            CornerRadius="16"
                                                                            Background="{DynamicResource SuccessFriendsBackgroundBrush}"
                                                                            BorderBrush="#18FFFFFF"
                                                                            BorderThickness="1"
                                                                            Padding="12,9">

                                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Stretch"/>
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>

                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="FriendCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            <Setter TargetName="FriendCard" Property="BorderThickness" Value="2.5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>

                                                        <Style.Triggers>
                                                            <!-- Hide "All" in Per game mode -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True"/>
                                                                    <Condition Binding="{Binding Label}" Value="All"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{Binding SetDynamicFriendScopeUserCommand}"
                                                                  Tag="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicFriendScopeGameCommand}"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch"
                                                                  Padding="0"
                                                                  IsTabStop="True"
                                                                  Focusable="True">

                                                            <i:Interaction.Triggers>
                                                                <!-- Reset PA game scope when friend changes. -->
                                                                <i:EventTrigger EventName="GotKeyboardFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonEx}}"
                                                                                           CommandParameter="All"/>
                                                                </i:EventTrigger>
                                                                <i:EventTrigger EventName="Click">
                                                                    <i:InvokeCommandAction Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonEx}}"
                                                                                           CommandParameter="All"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>


                                                            <!-- ListBoxItem owns focus; content stretches full width. -->
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Stretch"/>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>

                                                            <ButtonEx.Content>
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="92"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Friend avatar / fallback -->
                                                                    <Grid Grid.Column="0"
                                                                          Width="46"
                                                                          Height="46"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left">

                                                                        <Border Width="46"
                                                                                Height="46"
                                                                                CornerRadius="23"
                                                                                Background="#26000000"
                                                                                BorderBrush="#22FFFFFF"
                                                                                BorderThickness="1"/>

                                                                        <TextBlock Text="?"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Opacity="0.65"/>

                                                                        <Border Width="46"
                                                                                Height="46"
                                                                                CornerRadius="23"
                                                                                ClipToBounds="True">
                                                                            <Image Source="{Binding AvatarPath}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                                        </Border>
                                                                    </Grid>


                                                                    <StackPanel Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="8,0,12,0">

                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="19"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="210"/>

                                                                    </StackPanel>

                                                                    <Border Grid.Column="2"
                                                                            Background="{DynamicResource SeparatorSuccessBrush}"
                                                                            CornerRadius="10"
                                                                            Padding="10,5"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right"
                                                                            MinWidth="78">

                                                                        <StackPanel VerticalAlignment="Center">

                                                                            <TextBlock Text="{Binding CollectionLevel, StringFormat=Lv {0}, FallbackValue=Lv --, TargetNullValue=Lv --}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="14"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding CollectionScore, StringFormat=Score {0}, FallbackValue=Score --, TargetNullValue=Score --}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="10"
                                                                                       Opacity="0.62"
                                                                                       Margin="0,1,0,0"
                                                                                       HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </ButtonEx.Content>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- RIGHT : FRIEND ACTIVITY CONTENT -->
                                <Border Grid.Column="2"
                                        CornerRadius="22"
                                        ClipToBounds="True">

                                    <Grid>

                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0"
                                                  Margin="4,0,4,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Orientation="Vertical">

                                                    <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=FriendScopeList, FallbackValue=All, TargetNullValue=All}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                               FontSize="28"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"
                                                               MaxWidth="760"/>

                                                    <TextBlock Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                               FontSize="16"
                                                               Opacity="0.62"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"
                                                               Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Text" Value="{DynamicResource LOCFriendsAchievementsLastTrophies}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCFriendsAchievementsGamesWithAchievements}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Selected friend total trophies -->
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource SeparatorSuccessBrush}"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="14,7"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Visible only in Per game mode. -->
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">

                                                        <!-- Platine : jeux terminés -->
                                                        <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>

                                                        <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeSummary.CompletedGames}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Or : succès rares et ultra rares -->
                                                        <Image Source="{ThemeFile 'Images/Or.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeSummary.TotalRareAndUltraRare.Unlocked}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Argent : succès peu communs -->
                                                        <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeSummary.TotalUncommon.Unlocked}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Bronze : succès communs -->
                                                        <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Margin="16,0,6,0"/>

                                                        <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeSummary.TotalCommon.Unlocked}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   MinWidth="24"
                                                                   VerticalAlignment="Center"/>

                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Content host -->
                                            <Grid Grid.Row="2">

                                                <!-- MODE 0 : Last friend achievements -->
                                                <Grid x:Name="LastTrophiesPanel">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <ListBox x:Name="SelectedFriendRecentAchievementsList"
                                                             Grid.Row="0"
                                                             ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievements}"
                                                             AlternationCount="9999"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FocusVisualStyle="{x:Null}"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                             ScrollViewer.CanContentScroll="False"
                                                             VirtualizingPanel.IsVirtualizing="False"
                                                             KeyboardNavigation.DirectionalNavigation="Continue"
                                                             KeyboardNavigation.TabNavigation="Continue"
                                                             KeyboardNavigation.ControlTabNavigation="Continue">

                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>

                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                <!-- Items outside the visual Top 10 must not participate in focus/navigation. -->
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="IsTabStop" Value="False"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,0,0,12"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="TrophyCard"
                                                                                    Height="108"
                                                                                    CornerRadius="18"
                                                                                    BorderBrush="#18FFFFFF"
                                                                                    BorderThickness="1"
                                                                                    Background="{DynamicResource SuccessFriendsBackgroundBrush}"
                                                                                    Padding="12"
                                                                                    ClipToBounds="True">

                                                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                                                  VerticalAlignment="Stretch"/>
                                                                            </Border>

                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                    <Setter TargetName="TrophyCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                    <Setter TargetName="TrophyCard" Property="BorderThickness" Value="2.5"/>
                                                                                </Trigger>

                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="TrophyCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                    <Setter TargetName="TrophyCard" Property="BorderThickness" Value="2.5"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>

                                                                <!-- Visual limit: last 10 shown -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="4">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="5">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="6">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="7">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="8">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="9">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Focusable" Value="True"/>
                                                                        <Setter Property="IsTabStop" Value="True"/>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>

                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="78"/>
                                                                        <ColumnDefinition Width="78"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="138"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Game cover placeholder / future binding -->
                                                                    <Grid Grid.Column="0"
                                                                          Width="64"
                                                                          Height="82"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left">

                                                                        <Grid Width="64"
                                                                              Height="82"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center">

                                                                            <Border CornerRadius="10"
                                                                                    Background="#22000000"
                                                                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                    BorderThickness="1"/>

                                                                            <Viewbox MaxWidth="64"
                                                                                     MaxHeight="82"
                                                                                     Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Grid Width="{Settings GridItemWidth}"
                                                                                      Height="{Settings GridItemHeight}">
                                                                                    <Image Stretch="{Settings CoverArtStretch}"
                                                                                           StretchDirection="Both"
                                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                                        <Image.Source>
                                                                                            <PriorityBinding>
                                                                                                <Binding Path="GameCoverPath"/>
                                                                                                <Binding Path="Game.CoverImageObject"/>
                                                                                                <Binding Path="CoverImagePath"/>
                                                                                            </PriorityBinding>
                                                                                        </Image.Source>
                                                                                    </Image>
                                                                                </Grid>
                                                                            </Viewbox>
                                                                        </Grid>
                                                                    </Grid>

                                                                    <!-- Achievement icon -->
                                                                    <Grid Grid.Column="1"
                                                                          Width="64"
                                                                          Height="64"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left">

                                                                        <Border CornerRadius="12"
                                                                                Background="#22000000"
                                                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                BorderThickness="1"
                                                                                ClipToBounds="True">

                                                                            <Image Source="{Binding Icon}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Text -->
                                                                    <StackPanel Grid.Column="2"
                                                                                VerticalAlignment="Center"
                                                                                Margin="12,0,18,0">

                                                                        <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Center">

                                                                            <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                                                    Padding="10,3"
                                                                                    CornerRadius="11"
                                                                                    BorderBrush="#18FFFFFF"
                                                                                    BorderThickness="1">

                                                                                <TextBlock Text="{Binding GameName, FallbackValue=Game, TargetNullValue=Game}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="14"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="320"/>
                                                                            </Border>

                                                                            <!-- Friend name, only visible when the "All" scope is selected -->
                                                                            <Border Background="{DynamicResource SeparatorSuccessBrush}"
                                                                                    Padding="9,3"
                                                                                    CornerRadius="10"
                                                                                    BorderBrush="#18FFFFFF"
                                                                                    BorderThickness="1"
                                                                                    Margin="8,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding SelectedItem.Label, ElementName=FriendScopeList}" Value="All">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>

                                                                                <StackPanel Orientation="Horizontal"
                                                                                            VerticalAlignment="Center">
                                                                                    <TextBlock Text="{DynamicResource LOCFriendsAchievementsBy}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"
                                                                                               Opacity="0.62"
                                                                                               VerticalAlignment="Center"/>

                                                                                    <TextBlock Text="{Binding FriendLabel, FallbackValue=Friend, TargetNullValue=Friend}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="150"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <TextBlock Text="{Binding Percent, StringFormat=Rarity {0:F1}%}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="14"
                                                                                       Opacity="0.72"
                                                                                       Margin="12,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <TextBlock Text="{Binding Name}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="23"
                                                                                   FontWeight="SemiBold"
                                                                                   Margin="0,6,0,0"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="760"/>

                                                                        <TextBlock Text="{Binding Description}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="15"
                                                                                   Opacity="0.66"
                                                                                   Margin="0,3,0,0"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="760"/>
                                                                    </StackPanel>

                                                                    <!-- Unlock date -->
                                                                    <Border Grid.Column="3"
                                                                            Background="{DynamicResource SeparatorSuccessBrush}"
                                                                            BorderBrush="#18FFFFFF"
                                                                            BorderThickness="1"
                                                                            CornerRadius="14"
                                                                            Padding="12,9"
                                                                            MinWidth="118"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right">

                                                                        <StackPanel VerticalAlignment="Center">

                                                                            <TextBlock Text="{DynamicResource LOCFriendsAchievementsUnlocked}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       Opacity="0.65"
                                                                                       HorizontalAlignment="Center"/>

                                                                            <TextBlock Text="{Binding DateUnlocked, StringFormat='{}{0:dd/MM HH:mm}'}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="16"
                                                                                       FontWeight="SemiBold"
                                                                                       Margin="0,4,0,0"
                                                                                       HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>

                                                <!-- MODE 1 : Friend games -->
                                                <Grid x:Name="FriendGamesPanel">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FriendActivityModeToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <ListView x:Name="FriendGamesList"
                                                              pbeh:FocusBahaviors.FocusBinding="True"
                                                              Grid.Row="0"
                                                              ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummaries}"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              FocusVisualStyle="{x:Null}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                              ScrollViewer.CanContentScroll="True"
                                                              VirtualizingPanel.IsVirtualizing="True"
                                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                                              VirtualizingPanel.ScrollUnit="Item"
                                                              VirtualizingPanel.CacheLength="1"
                                                              VirtualizingPanel.CacheLengthUnit="Item"
                                                              KeyboardNavigation.DirectionalNavigation="Continue"
                                                              KeyboardNavigation.TabNavigation="Continue"
                                                              KeyboardNavigation.ControlTabNavigation="Continue">

                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>

                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,0,0,12"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListViewItem">
                                                                            <ContentPresenter/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListView.ItemContainerStyle>

                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Set PA game scope, then open friend achievements. -->
                                                                <ButtonEx Tag="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendGameAchievementsWindow]}"
                                                                          Height="148"
                                                                          Margin="0,0,0,0"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          FocusVisualStyle="{x:Null}"
                                                                          HorizontalAlignment="Stretch"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          VerticalContentAlignment="Stretch"
                                                                          Padding="0"
                                                                          IsTabStop="True"
                                                                          Focusable="True">

                                                                    <i:Interaction.Triggers>
                                                                        <!-- Friend card opens the scoped achievement detail view. -->
                                                                        <i:EventTrigger EventName="Click">
                                                                            <i:InvokeCommandAction Command="{Binding SetDynamicFriendScopeGameCommand}"/>
                                                                            <i:InvokeCommandAction Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonEx}}"/>
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>




                                                                    <ButtonEx.Template>
                                                                        <ControlTemplate TargetType="ButtonEx">
                                                                            <Grid>
                                                                                <Border x:Name="Shadow"
                                                                                        CornerRadius="18"
                                                                                        Background="Transparent"
                                                                                        Opacity="0">
                                                                                    <Border.Effect>
                                                                                        <DropShadowEffect BlurRadius="18"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.40"/>
                                                                                    </Border.Effect>
                                                                                </Border>

                                                                                <Border x:Name="ItemRoot"
                                                                                        CornerRadius="18"
                                                                                        BorderBrush="#18FFFFFF"
                                                                                        BorderThickness="1.2"
                                                                                        SnapsToDevicePixels="True">

                                                                                    <Grid>
                                                                                        <Border x:Name="FocusOverlay"
                                                                                                CornerRadius="18"
                                                                                                Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                                                Opacity="0"
                                                                                                IsHitTestVisible="False"/>

                                                                                        <Border x:Name="CardGradient"
                                                                                                CornerRadius="18"
                                                                                                Opacity="0.92"
                                                                                                Background="{DynamicResource BackgroundItem}" />

                                                                                        <Border CornerRadius="18"
                                                                                                Opacity="0.14"
                                                                                                IsHitTestVisible="False">
                                                                                            <Border.Background>
                                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                    <GradientStop Color="#20FFFFFF" Offset="0"/>
                                                                                                    <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                                                </LinearGradientBrush>
                                                                                            </Border.Background>
                                                                                        </Border>

                                                                                        <Border x:Name="FocusFill"
                                                                                                CornerRadius="18"
                                                                                                Background="{DynamicResource FocusFriendsCardBackgroundBrush}"
                                                                                                Opacity="0"
                                                                                                IsHitTestVisible="False"/>

                                                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                                                          VerticalAlignment="Stretch"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>

                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource FocusFriendsCardBorder}"/>
                                                                                    <Setter TargetName="ItemRoot" Property="BorderThickness" Value="2.2"/>
                                                                                    <Setter TargetName="FocusFill" Property="Opacity" Value="0.20"/>
                                                                                    <Setter TargetName="Shadow" Property="Opacity" Value="1"/>
                                                                                    <Setter TargetName="CardGradient" Property="Opacity" Value="1"/>
                                                                                    <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ButtonEx.Template>

                                                                    <ButtonEx.Content>
                                                                        <Grid Margin="14,10,18,10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="120"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="420"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- COVER / FALLBACK -->
                                                                            <Grid Grid.Column="0"
                                                                                  Margin="0,0,8,0"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Left">

                                                                                <Border Width="92"
                                                                                        Height="92"
                                                                                        CornerRadius="16"
                                                                                        Background="#22000000"
                                                                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                        BorderThickness="1"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        ClipToBounds="True">

                                                                                    <Grid>
                                                                                        <TextBlock Text="&#xE7FC;"
                                                                                                   FontFamily="{DynamicResource FontIcons}"
                                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                                   FontSize="30"
                                                                                                   Opacity="0.45"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>

                                                                                        <!-- Keep PA cover test binding. -->
                                                                                        <Image Source="{Binding CoverImagePath}"
                                                                                               Stretch="UniformToFill"
                                                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>

                                                                            <!-- INFOS -->
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="8,0,28,0"
                                                                                        VerticalAlignment="Center">

                                                                                <TextBlock Text="{Binding Name}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                           Opacity="0.92"
                                                                                           FontSize="26"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           TextWrapping="Wrap"
                                                                                           MaxWidth="760"/>

                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Margin="0,10,0,0"
                                                                                            VerticalAlignment="Center">

                                                                                    <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                                                            Padding="14,4"
                                                                                            CornerRadius="13"
                                                                                            HorizontalAlignment="Left"
                                                                                            BorderBrush="#18FFFFFF"
                                                                                            BorderThickness="1">
                                                                                        <TextBlock Text="{Binding Platform}"
                                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                                   Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                                   FontSize="16"
                                                                                                   FontWeight="SemiBold"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </Border>

                                                                                    <TextBlock Text="{Binding LastUnlockDate, StringFormat='  Last unlock: {0:dd/MM/yyyy HH:mm}'}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               FontSize="15"
                                                                                               Opacity="0.65"
                                                                                               Margin="14,4,0,0"
                                                                                               VerticalAlignment="Center"/>


                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- PROGRESSION + TROPHIES -->
                                                                            <Grid Grid.Column="2"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Right">

                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="118"/>
                                                                                    <ColumnDefinition Width="10"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Show platinum before percent/total when completed. -->
                                                                                <Grid Grid.Column="0"
                                                                                      VerticalAlignment="Center"
                                                                                      HorizontalAlignment="Right">

                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Image Grid.Column="0"
                                                                                           Source="{ThemeFile 'Images/platinum.png'}"
                                                                                           RenderOptions.BitmapScalingMode="Fant"
                                                                                           Width="32"
                                                                                           Height="32"
                                                                                           Margin="0,0,8,0"
                                                                                           VerticalAlignment="Center">
                                                                                        <Image.Style>
                                                                                            <Style TargetType="Image">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Image.Style>
                                                                                    </Image>

                                                                                    <StackPanel Grid.Column="1"
                                                                                                VerticalAlignment="Center"
                                                                                                HorizontalAlignment="Right">

                                                                                        <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                                   FontSize="24"
                                                                                                   FontWeight="SemiBold"
                                                                                                   HorizontalAlignment="Right"
                                                                                                   TextAlignment="Right"
                                                                                                   VerticalAlignment="Center"/>

                                                                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                                   FontSize="14"
                                                                                                   Opacity="0.65"
                                                                                                   Margin="0,2,0,0"
                                                                                                   HorizontalAlignment="Right"
                                                                                                   TextAlignment="Right">
                                                                                            <TextBlock.Text>
                                                                                                <MultiBinding StringFormat="{}{0}/{1} total">
                                                                                                    <Binding Path="UnlockedCount"/>
                                                                                                    <Binding Path="AchievementCount"/>
                                                                                                </MultiBinding>
                                                                                            </TextBlock.Text>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Grid>

                                                                                <StackPanel Grid.Column="2"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="14,0,0,0">

                                                                                    <Image Source="{ThemeFile 'Images/Or.png'}"
                                                                                           RenderOptions.BitmapScalingMode="Fant"
                                                                                           Width="32"
                                                                                           Height="32"
                                                                                           VerticalAlignment="Center"/>

                                                                                    <TextBlock Text="{Binding GoldCount}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               FontSize="21"
                                                                                               Margin="6,0,0,0"
                                                                                               MinWidth="24"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="3"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="18,0,0,0">

                                                                                    <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                                                           RenderOptions.BitmapScalingMode="Fant"
                                                                                           Width="32"
                                                                                           Height="32"
                                                                                           VerticalAlignment="Center"/>

                                                                                    <TextBlock Text="{Binding SilverCount}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               FontSize="21"
                                                                                               Margin="6,0,0,0"
                                                                                               MinWidth="24"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="4"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="18,0,0,0">

                                                                                    <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                                                           RenderOptions.BitmapScalingMode="Fant"
                                                                                           Width="32"
                                                                                           Height="32"
                                                                                           VerticalAlignment="Center"/>

                                                                                    <TextBlock Text="{Binding BronzeCount}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               FontSize="21"
                                                                                               Margin="6,0,0,0"
                                                                                               MinWidth="24"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </ButtonEx.Content>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="ConfirmAction"
                                              Content="{DynamicResource LOCButtonPrompt_Select}" />

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="CancelAction" Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}" />

                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Friends Activity Options - Recent achievements view -->
    <Style x:Key="FriendsActivityOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">

                        <Border x:Name="FriendsActivityMenu"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource OverlayMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource HeaderMenu}">

                                    <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <TextBlock Text="{DynamicResource LOCFriendsAchievementsOptionsTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">


                                        <TextBlock Text="{DynamicResource LOCFriendsAchievementsGamesSorting}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <TextBlock Text="{DynamicResource LOCFilter}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    pbeh:FocusBahaviors.FocusBinding="True"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesFilterOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesFilterKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCDirection}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortDirectionOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummariesSortDirectionKey, Mode=TwoWay}" />

                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,22,0,16"/>

                                        <TextBlock Text="{DynamicResource LOCFriendsAchievementsLastTrophiesSorting}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <TextBlock Text="{DynamicResource LOCFilter}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsFilterOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsFilterKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,10"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortKey, Mode=TwoWay}" />

                                        <TextBlock Text="{DynamicResource LOCDirection}"
                                                   Style="{StaticResource TextBlockDetailStyle}"
                                                   FontSize="20"
                                                   Margin="0,0,0,4"/>

                                        <ComboBoxEx Margin="0,0,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortDirectionOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortDirectionKey, Mode=TwoWay}" />


                                    </StackPanel>
                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Opacity="0.75">

                                        <!-- Back -->
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="B"
                                                  Command="{Binding CloseCommand}"
                                                  Content="{DynamicResource LOCBackLabel}"/>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Friend game achievements details -->
    <Style x:Key="FriendGameAchievementsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="FriendGameDetailsRoot"
                          Tag="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicFriendScopeGameCommand}"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.FocusedElement="{Binding ElementName=TrophiesMenuToggle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Opacity="0"
                          Background="{DynamicResource SecondaryViewBackground}">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Unloaded">
                                <i:InvokeCommandAction Command="{Binding Tag, ElementName=FriendGameDetailsRoot}"
                                                       CommandParameter="All"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>




                        <FadeImage Margin="0,-150,0,0"
                                   HorizontalContentAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Height="1000"
                                   Stretch="UniformToFill"
                                   Opacity="0.7">
                            <FadeImage.Source>
                                <PriorityBinding>
                                    <Binding Path="SelectedItem.Game.BackgroundImage" ElementName="FriendGameDynamicAchievementList"/>
                                </PriorityBinding>
                            </FadeImage.Source>
                            <FadeImage.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Black" Offset="0.0" />
                                    <GradientStop Color="Transparent" Offset="0.5" />
                                </LinearGradientBrush>
                            </FadeImage.OpacityMask>
                        </FadeImage>


                        <!-- Bandeau supérieur du panneau de trophées -->
                        <Border Background="Transparent" Margin="0,20,0,0"
                                BorderThickness="0,0,0,0"
                                BorderBrush="{DynamicResource OverlayMenu}"
                                Height="250"
                                VerticalAlignment="Top">

                            <Grid Margin="100,0,100,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Colonne gauche : Friend avatar -->
                                <Grid Grid.Column="0"
                                      Width="130"
                                      Height="130"
                                      Margin="0,20,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                    <Border x:Name="FriendDetailAvatarMask"
                                            Width="130"
                                            Height="130"
                                            Background="Black"
                                            CornerRadius="80"/>

                                    <Border Width="130"
                                            Height="130"
                                            CornerRadius="70"
                                            Background="#26000000"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="2">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="0"
                                                              BlurRadius="10"
                                                              Opacity="0.4"
                                                              Color="Black" />
                                        </Border.Effect>
                                    </Border>

                                    <TextBlock Text="?"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="54"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.45"/>

                                    <Grid Width="130"
                                          Height="130"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=FriendDetailAvatarMask}" />
                                        </Grid.OpacityMask>

                                        <Image Source="{Binding SelectedItem.FriendAvatarPath, ElementName=FriendGameDynamicAchievementList}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                    </Grid>

                                    <Border Width="130"
                                            Height="130"
                                            CornerRadius="80"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="2"
                                            Background="Transparent"
                                            IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Colonne centre : Titre + barre progression -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.GameName, ElementName=FriendGameDynamicAchievementList, FallbackValue=Friend Game}"
                                               HorizontalAlignment="Center"
                                               FontSize="50"
                                               TextWrapping="Wrap"
                                               TextTrimming="WordEllipsis"
                                               MaxWidth="1500">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Selected friend name -->
                                    <Grid Margin="0,8,0,0"
                                          HorizontalAlignment="Center">

                                        <TextBlock x:Name="FriendDetailSelectedFriendLabel"
                                                   Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeUserLabel, StringFormat=Friend: {0}, FallbackValue='', TargetNullValue=''}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.78">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendScopeUserKey, StringFormat=Friend: {0}, FallbackValue=Friend, TargetNullValue=Friend}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.78">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=FriendDetailSelectedFriendLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel >
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Name="LogoPath" Tag="{DynamicResource ExtraMetadataPath}" Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
                                                                <Binding Source="\ExtraMetadata\games\"/>
                                                                <Binding ElementName="FriendGameDynamicAchievementList" Path="SelectedItem.Game.Id"/>
                                                                <Binding Source="\logo.png" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Name="LogoImage" Width="450" MaxHeight="125" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                                               VerticalAlignment="Top" HorizontalAlignment="Center"
                                               Tag="{DynamicResource UseAbsoluteExtraMetadataPath}" >
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                            <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                            <Setter Property="ItemsControl.Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>


                                    <ProgressBar Visibility="Collapsed" Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}"
                                                 Background="{DynamicResource TextBrush}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="10"
                                                 Width="500"
                                                 Style="{DynamicResource ProgressBarCustom}"
                                                 Margin="0,20,0,0"
                                                 Foreground="#FFCD31" />

                                    <TextBlock Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" FontSize="30" Text="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, StringFormat={}{0}%}" />
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Friend-game trophy totals use PA game scope. -->
                        <ItemsControl ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendGameSummaries}"
                                      Visibility="Visible"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Right"
                                      Margin="0,280,150,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">

                                        <!-- Platinum -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="22,0,0,10">
                                            <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="Fant"/>

                                            <TextBlock FontWeight="Light"
                                                       FontSize="26"
                                                       MinWidth="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Text" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Text" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Gold = Rare + UltraRare -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="22,0,0,10">
                                            <Image Source="{ThemeFile 'Images/Or.png'}"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="Fant"/>

                                            <TextBlock Text="{Binding GoldCount, FallbackValue=0, TargetNullValue=0}"
                                                       FontWeight="Light"
                                                       FontSize="26"
                                                       MinWidth="24"
                                                       Style="{StaticResource TextBlockBaseStyle}"/>
                                        </StackPanel>

                                        <!-- Silver = Uncommon -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="22,0,0,10">
                                            <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="Fant"/>

                                            <TextBlock Text="{Binding SilverCount, FallbackValue=0, TargetNullValue=0}"
                                                       FontWeight="Light"
                                                       FontSize="26"
                                                       MinWidth="24"
                                                       Style="{StaticResource TextBlockBaseStyle}"/>
                                        </StackPanel>

                                        <!-- Bronze = Common -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="22,0,0,10">
                                            <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="Fant"/>

                                            <TextBlock Text="{Binding BronzeCount, FallbackValue=0, TargetNullValue=0}"
                                                       FontWeight="Light"
                                                       FontSize="26"
                                                       MinWidth="24"
                                                       Style="{StaticResource TextBlockBaseStyle}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="AchievementList" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="1600" KeyboardNavigation.DirectionalNavigation="Cycle" pbeh:FocusBahaviors.FocusBinding="True" >
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,50"/>
                                    <Setter Property="Height" Value="750"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                                            <Setter Property="Height" Value="870"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.Resources>

                                <ControlTemplate x:Key="AchievementListItemTemplate" TargetType="ListViewItem">
                                    <Grid Height="120"
                                          Width="1400"
                                          Margin="0,8,0,8"
                                          HorizontalAlignment="Center"
                                          SnapsToDevicePixels="True">

                                        <Border x:Name="MainBorder"
                                                CornerRadius="14"
                                                Background="{DynamicResource SuccessMainCardBackground}"
                                                BorderThickness="1.5"
                                                BorderBrush="#18FFFFFF"
                                                SnapsToDevicePixels="True">

                                            <Grid>
                                                <!-- focus fill derrière -->
                                                <Border x:Name="FocusOverlay"
                                                        CornerRadius="14"
                                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>

                                                <!-- fond -->
                                                <Border CornerRadius="14"
                                                        Opacity="0.92" Background="{DynamicResource BackgroundItem}" />

                                                <!-- masque -->
                                                <Border x:Name="mask"
                                                        CornerRadius="14"
                                                        Background="Black"
                                                        Opacity="0"/>

                                                <Grid>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Height="120"
                                                                  Width="120"
                                                                  VerticalAlignment="Center">
                                                                <Grid.OpacityMask>
                                                                    <VisualBrush Stretch="Fill">
                                                                        <VisualBrush.Visual>
                                                                            <Border Width="120"
                                                                                    Height="120"
                                                                                    Background="Black"
                                                                                    CornerRadius="14,0,0,14"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Grid.OpacityMask>


                                                                <Grid>
                                                                    <!-- Real icon -->
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                                        <Setter Property="Opacity" Value="0.25"/>
                                                                                    </DataTrigger>

                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- Lock overlay -->
                                                                    <Image Source="{ThemeFile 'Images/Buttons/locked.png'}"
                                                                           Opacity="0.8"
                                                                           Height="60"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Stretch="Uniform">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- Hidden placeholder -->
                                                                    <Image Source="{ThemeFile 'Images/TrophyHidden.png'}"
                                                                           Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="1350" Height="120" Margin="30,5,0,0">
                                                        <Grid VerticalAlignment="Top" Margin="100,0,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Ligne 1 : Nom -->
                                                            <TextBlock x:Name="Name"
                                                                       Grid.Row="0"
                                                                       Margin="0,5,0,5"
                                                                       HorizontalAlignment="Left"
                                                                       MaxWidth="1150"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="23">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                    <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Opacity" Value="0.75"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock x:Name="Desc"
                                                                       Margin="0,5,0,5"
                                                                       Grid.Row="1"
                                                                       MaxWidth="1200"
                                                                       TextTrimming="WordEllipsis"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Top"
                                                                       HorizontalAlignment="Left"
                                                                       FontSize="20">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Text" Value="{Binding Description}" />
                                                                        <Setter Property="Opacity" Value="0.85"/>
                                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                    <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Opacity" Value="0.6"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>





                                                            <!-- Ligne 3 : % + joueurs -->
                                                            <StackPanel Grid.Row="2"
                                                                        Orientation="Horizontal"
                                                                        Margin="0,5,0,0"
                                                                        VerticalAlignment="Bottom">
                                                                <TextBlock x:Name="Perc"
                                                                           Text="{Binding Percent, Path=Percent, StringFormat={}{0:F0}%}"
                                                                           FontSize="17"
                                                                           Opacity="0.9"
                                                                           Style="{DynamicResource TextBlockBaseStyle}" />
                                                                <TextBlock x:Name="Player"
                                                                           Margin="5,0,0,0"
                                                                           Text="{DynamicResource LOCPlayershaveachievement}"
                                                                           FontSize="16"
                                                                           Opacity="0.9"
                                                                           Style="{DynamicResource TextBlockBaseStyle}" />
                                                            </StackPanel>
                                                        </Grid>



                                                        <StackPanel Margin="0,15,80,0"
                                                                    Orientation="Vertical"
                                                                    HorizontalAlignment="Right"
                                                                    Opacity="0.85"
                                                                    VerticalAlignment="Center">

                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ProgressNum}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProgressDenom}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProgressDenom}" Value="1">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <!-- Progress bar: background track + fill -->
                                                            <Grid Width="160" Height="10" VerticalAlignment="Center">
                                                                <!-- Track -->
                                                                <Border CornerRadius="6"
                                                                        Background="{DynamicResource ProgressBackgroundBrush}"
                                                                        Height="8"
                                                                        VerticalAlignment="Center"/>

                                                                <!-- Fill -->
                                                                <ProgressBar Value="{Binding ProgressNum, FallbackValue=0}"
                                                                             Minimum="0"
                                                                             Maximum="{Binding ProgressDenom, FallbackValue=1}"
                                                                             Height="8"
                                                                             BorderThickness="0"
                                                                             Foreground="{DynamicResource ProgressBrush}"
                                                                             Background="Transparent"
                                                                             VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- Compact counter -->
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Opacity="0.95">
                                                                <Run Text="{Binding ProgressNum}" />
                                                                <Run Text="/" />
                                                                <Run Text="{Binding ProgressDenom}" />
                                                            </TextBlock>

                                                        </StackPanel>

                                                        <!-- Badge : trophée aussi débloqué par l'utilisateur -->
                                                        <Border Margin="0,0,250,0"
                                                                Padding="4"
                                                                CornerRadius="21"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="#30FFFFFF"
                                                                BorderBrush="#45FFFFFF"
                                                                BorderThickness="1"
                                                                Panel.ZIndex="8">

                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UnlockedBySelf}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <!-- Avatar user seul -->
                                                            <Grid Width="34"
                                                                  Height="34"
                                                                  VerticalAlignment="Center">

                                                                <!-- masque rond -->
                                                                <Border x:Name="SelfAvatarMaskAchievementBadge"
                                                                        Width="34"
                                                                        Height="34"
                                                                        Background="Black"
                                                                        CornerRadius="17"/>



                                                                <!-- path image avatar -->
                                                                <TextBlock x:Name="SelfAvatarPathAchievementBadge"
                                                                           Tag="{Api Paths.ConfigurationPath}"
                                                                           Visibility="Collapsed">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text">
                                                                                <Setter.Value>
                                                                                    <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                                                    </MultiBinding>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- image user masquée en rond -->
                                                                <Grid Width="34"
                                                                      Height="34"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                    <Grid.OpacityMask>
                                                                        <VisualBrush Visual="{Binding ElementName=SelfAvatarMaskAchievementBadge}" />
                                                                    </Grid.OpacityMask>

                                                                    <Control x:Name="SelfAvatarImageAchievementBadge"
                                                                             Tag="{Binding ElementName=SelfAvatarPathAchievementBadge, Path=Text}"
                                                                             Width="34"
                                                                             Height="34"
                                                                             Template="{StaticResource SteamSelfAvatarTemplate}"
                                                                             Focusable="False"
                                                                             IsTabStop="False"
                                                                             IsHitTestVisible="False"/>
                                                                </Grid>

                                                                <!-- contour rond -->
                                                                <Border Width="34"
                                                                        Height="34"
                                                                        CornerRadius="17"
                                                                        BorderBrush="#DDFFFFFF"
                                                                        BorderThickness="1"
                                                                        Background="#14000000"
                                                                        IsHitTestVisible="False"
                                                                        Panel.ZIndex="5"/>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Margin="0,10,55,0" Orientation="Vertical" HorizontalAlignment="Right" Opacity="0.7" VerticalAlignment="Center">


                                                            <TextBlock x:Name="Clock1" Visibility="Visible" Margin="0,0,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{Binding DateUnlocked, StringFormat='{}{0:HH:mm}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}" />
                                                            <TextBlock x:Name="Clock2" Visibility="Collapsed" Margin="0,0,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{Binding DateUnlocked, StringFormat='{}{0:t}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}" />
                                                            <TextBlock  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,3,2" Text="{Binding DateUnlocked, StringFormat='{}{0:d MMM yyyy}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Margin="0,10,0,10"
                                                                Padding="10,2"
                                                                CornerRadius="10"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="#26000000"
                                                                BorderBrush="#22FFFFFF"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CategoryType}" Value="Default">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CategoryType}" Value="Base">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock
                                                                Text="{Binding CategoryType}"
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Opacity="0.95">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CategoryType}" Value="Default">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding CategoryType}" Value="Base">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>


                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Width="55" >
                                                            <Image x:Name="Bronze" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Bronze.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Visible"/>
                                                            <Image x:Name="Argent"  Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Argent.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed" />
                                                            <Image x:Name="Or"  Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Or.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                            <Image x:Name="Saphir" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Saphir.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                            <Image x:Name="Completed" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/platinum.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="PercentLogic" Text="{Binding GamerScore}" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </Grid>




                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2.5"/>
                                            <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>

                                            <Setter TargetName="Name" Property="FontSize" Value="25"/>
                                            <Setter TargetName="Desc" Property="Opacity" Value="0.8"/>
                                            <Setter TargetName="Desc" Property="FontSize" Value="22"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="UltraRare"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Rare"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Uncommon"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Common"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[LocalClock]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Clock2" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Clock1" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>

                                <Style x:Key="AchievementListItemContainerStyle" TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template" Value="{StaticResource AchievementListItemTemplate}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Style>

                                <Style x:Key="AchievementListBaseStyle" TargetType="ListView">
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Local"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>

                            </Grid.Resources>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">

                                <TextBlock Text="{DynamicResource LOCSortby}" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20" />

                                <TextBlock Text=" : " HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20"/>

                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="20" >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="Newest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="Oldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCOldest}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="RarityAsc">
                                                    <Setter Property="Text" Value="{DynamicResource LOCRarityAsc}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="RarityDesc">
                                                    <Setter Property="Text" Value="{DynamicResource LOCRarityDesc}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="DefaultOrder">
                                                    <Setter Property="Text" Value="{DynamicResource LOCDefault}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text=" ● " VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="18"/>


                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                           FontSize="20" >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="All">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="Locked">
                                                    <Setter Property="Text" Value="{DynamicResource LOCLockedOnly}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="Unlocked">
                                                    <Setter Property="Text" Value="{DynamicResource LOCUnlockedOnly}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>


                            <Rectangle Fill="{DynamicResource TextBrush}" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0" />

                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0">

                                <CheckBoxEx x:Name="TrophiesMenuToggle"
                                            Content="&#xefb0;"
                                            pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                            FontFamily="{DynamicResource FontIcoFont}"
                                            Command="{PluginSettings Plugin=AnikiHelper, Path=OpenChildWindow[FriendGameAchievementsOptionsWindow]}"
                                            FontSize="22">
                                    <CheckBoxEx.Style>
                                        <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}">
                                            <Style.Triggers>

                                            </Style.Triggers>
                                        </Style>
                                    </CheckBoxEx.Style>

                                </CheckBoxEx>

                            </Grid>

                            <!-- DYNAMIC FRIEND GAME ACHIEVEMENTS LIST -->
                            <ListView x:Name="FriendGameDynamicAchievementList"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      SelectedIndex="0"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievements}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.4" />
                            </Grid.Effect>

                        </Grid>

                        <StackPanel Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" >
                            <TextBlock Text="{DynamicResource LocTotalTrophiesUnlocked}"  Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,5,10" />
                            <TextBlock Text=" : " Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,5,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,0,10" />
                            <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="2,50,2,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,0,10" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,0">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="B"
                                          Content="{DynamicResource LOCBackLabel}" />
                            </StackPanel>


                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728">
                            <Setter Property="Margin" Value="-140,80,30,80" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- PlayniteAchivement Options Panel -->
    <Style x:Key="FriendGameAchievementsOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">


                        <Border x:Name="TrophiesMenu"
                                Grid.RowSpan="2"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="0"
                                                  ShadowDepth="2"
                                                  BlurRadius="10"
                                                  Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource BackgroundAHBrush}">

                                    <Border Background="#12000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- TITRE -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LOCTrophiesOptions}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- separator -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="#22FFFFFF"/>

                                <!-- CONTENT -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <!-- SECTION: Sorting -->
                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx pbeh:FocusBahaviors.FocusBinding="True"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortKey, Mode=TwoWay}"
                                                    Margin="0,10,0,15"
                                                    Height="56">

                                            <ComboBoxItem Content="{DynamicResource LOCDefault}" Tag="Default"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Name}" Tag="Name"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_UnlockTime}" Tag="UnlockTime"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Rarity}" Tag="Rarity"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Status}" Tag="Status"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Progress}" Tag="Progress"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Trophy}" Tag="TrophyType"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Category}" Tag="CategoryType"/>

                                        </ComboBoxEx>

                                        <TextBlock Text="{DynamicResource LOCDirection}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="20"
                                                   Opacity="0.70"
                                                   Margin="0,5,0,5"/>

                                        <ComboBoxEx Margin="0,5,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortDirectionOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsSortDirectionKey, Mode=TwoWay}" />

                                        <!-- SECTION: Show -->
                                        <TextBlock Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx Margin="0,10,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsFilterOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicFriendAchievementsFilterKey, Mode=TwoWay}" />

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Hidden toggle -->
                                        <TextBlock Text="{DynamicResource LOCShowHiddenAchievements}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <CheckBoxEx x:Name="ShowHiddenToggle"
                                                        Content="{DynamicResource LOCShowHiddenAchievements}"
                                                        IsChecked="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements], Mode=TwoWay}"/>
                                        </StackPanel>

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Refresh -->
                                        <TextBlock Text="{DynamicResource LOCRefreshTrophies}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,20,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <ButtonEx Height="50"
                                                      HorizontalContentAlignment="Stretch"
                                                      Content="{DynamicResource LOCRefreshTrophies}"
                                                      IsEnabled="False"/>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Grid.Column="0"
                                                  Tag="Dpad"
                                                  Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                      Tag="A"
                                                      Content="{DynamicResource LOCButtonPrompt_Select}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
