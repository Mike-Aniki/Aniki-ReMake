                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="138">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage138}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="139">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage139}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="140">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage140}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="141">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage141}"/>
