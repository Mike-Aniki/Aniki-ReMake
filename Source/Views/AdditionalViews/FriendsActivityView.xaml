                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="143">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage143}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="144">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage144}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="145">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage145}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="146">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage146}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="147">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage147}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="148">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage148}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="149">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage149}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="151">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage151}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="152">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage152}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="153">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage153}"/>
                                                <Setter Property="Opacity" Value="0.15"/>
                                            </DataTrigger>

                                            <!-- Rare / Lucky Mode background override -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessMainImage150}"/>
                                                <Setter Property="Opacity" Value="0.3"/>
