<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="QuickAccessWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=QuickProfileButton}">
                        <Grid.Resources>

                            <!-- QUICK ACCESS BUTTON STYLE -->
                            <Style x:Key="QuickAccessButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="72"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <!-- FOCUS BACKGROUND -->
                                                <Border x:Name="MainBackground"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <!-- FOCUS BORDER -->
                                                <Border x:Name="MainBorder"
                                                        Margin="0"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <!-- FLASH FX -->
                                                <Border x:Name="FlashMenuBorder"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <!-- CONTENT -->
                                                <Grid Margin="18,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ICON -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"
                                                               SnapsToDevicePixels="True"/>

                                                    <!-- LABEL -->
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{DynamicResource FontMain}"
                                                                      TextElement.FontSize="22"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                    <!-- CHEVRON / EMPTY SLOT -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE76C;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="16"
                                                               Opacity="0"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>

                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>

                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="QuickAccessButtonStyle2" TargetType="ButtonEx">
                                <Setter Property="Height" Value="72"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <!-- FOCUS BACKGROUND -->
                                                <Border x:Name="MainBackground"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <!-- FOCUS BORDER -->
                                                <Border x:Name="MainBorder"
                                                        Margin="0"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <!-- FLASH FX -->
                                                <Border x:Name="FlashMenuBorder"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <!-- CONTENT -->
                                                <Grid Margin="18,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ICON -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               FontFamily="{StaticResource FontIcoFont}"
                                                               FontSize="25"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"
                                                               SnapsToDevicePixels="True"/>

                                                    <!-- LABEL -->
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{DynamicResource FontMain}"
                                                                      TextElement.FontSize="22"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                    <!-- CHEVRON / EMPTY SLOT -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE76C;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="16"
                                                               Opacity="0"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>

                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>

                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="QuickAccessCheckBoxExStyle" TargetType="CheckBoxEx">
                                <Setter Property="Height" Value="72"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBoxEx">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <!-- FOCUS BACKGROUND -->
                                                <Border x:Name="MainBackground"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <!-- FOCUS BORDER -->
                                                <Border x:Name="MainBorder"
                                                        Margin="0"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <!-- FLASH FX -->
                                                <Border x:Name="FlashMenuBorder"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <!-- CONTENT -->
                                                <Grid Margin="18,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ICON -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               FontFamily="{StaticResource FontIcoFont}"
                                                               FontSize="25"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"
                                                               SnapsToDevicePixels="True"/>

                                                    <!-- LABEL -->
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{DynamicResource FontMain}"
                                                                      TextElement.FontSize="22"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                    <!-- CHEVRON / EMPTY SLOT -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE76C;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="16"
                                                               Opacity="0"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>

                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>

                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Grid.Resources>


                        <!-- FULLSCREEN DARK BACKDROP -->
                        <Border Background="#99000000"
                                Opacity="0"/>

                        <!-- MAIN PANEL -->
                        <Grid x:Name="QuickAccessPanel"
                              Width="520"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="42,88,0,0"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0">

                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="QuickAccessPanel"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.22"/>

                                            <DoubleAnimation Storyboard.TargetName="QuickAccessPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="QuickAccessPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="QuickAccessPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="-40"
                                                             To="0"
                                                             Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="QuickAccessPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="-20"
                                                             To="0"
                                                             Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>


                            <!-- PANEL BACKGROUND -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"
                                                      Color="#000000"/>
                                </Border.Effect>
                            </Border>


                            <!-- INNER CONTENT -->
                            <Grid Margin="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- USER HEADER -->
                                <Grid Grid.Row="0"
                                      Height="90"
                                      Margin="22,16,22,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- AVATAR -->
                                    <Grid Grid.Column="0"
                                          Width="56"
                                          Height="56"
                                          VerticalAlignment="Center">

                                        <!-- masque rond -->
                                        <Border x:Name="AvatarMaskHeader"
                                                Width="56"
                                                Height="56"
                                                Background="Black"
                                                CornerRadius="28"/>

                                        <!-- fallback avatar rond -->
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border"
                                                       BasedOn="{StaticResource SelectedAvatarBorderStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=UserAvatarHeader, Path=Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- path image avatar -->
                                        <TextBlock x:Name="ProfilePicturePathHeader"
                                                   Tag="{Api Paths.ConfigurationPath}"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- image user masquée en rond -->
                                        <Grid Width="56"
                                              Height="56"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=AvatarMaskHeader}" />
                                            </Grid.OpacityMask>

                                            <Image x:Name="UserAvatarHeader"
                                                   Source="{Binding ElementName=ProfilePicturePathHeader, Path=Text}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Fant"
                                                   Width="56"
                                                   Height="56"/>
                                        </Grid>

                                        <!-- contour rond -->
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                BorderBrush="{DynamicResource TextBrush}"
                                                BorderThickness="1.4"
                                                Background="#14000000"
                                                IsHitTestVisible="False"
                                                Panel.ZIndex="5"/>
                                    </Grid>


                                    <!-- USER NAME -->
                                    <TextBlock x:Name="UserNameHeader"
                                               Grid.Column="2"
                                               Text="{DynamicResource UserName}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>


                                    <!-- STATUS BADGE BUTTON -->
                                    <ButtonEx x:Name="UserStatusBadgeButton"
                                              Grid.Column="3"
                                              Height="44"
                                              MinWidth="104"
                                              Padding="0"
                                              Focusable="True"
                                              IsTabStop="True"
                                              FocusVisualStyle="{x:Null}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              VerticalAlignment="Center"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenChildWindow[SteamStatusMenuWindowStyle]}">

                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=SteamFriendsFullscreen_d8d67c7e-a797-45d7-ae44-3d53ddecc8d1, Status=Installed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>

                                        <ButtonEx.Template>
                                            <ControlTemplate TargetType="ButtonEx">

                                                <Grid>

                                                    <!-- STATUS BADGE BACKGROUND -->
                                                    <Border x:Name="UserStatusBadge"
                                                            Height="34"
                                                            MinWidth="104"
                                                            Padding="14,0"
                                                            CornerRadius="17"
                                                            Background="#1819F28B"
                                                            BorderBrush="#5519F28B"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">

                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1819F28B"/>
                                                                <Setter Property="BorderBrush" Value="#5519F28B"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="online">
                                                                        <Setter Property="Background" Value="#1819F28B"/>
                                                                        <Setter Property="BorderBrush" Value="#5519F28B"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="offline">
                                                                        <Setter Property="Background" Value="#182D3748"/>
                                                                        <Setter Property="BorderBrush" Value="#554A5A68"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="away">
                                                                        <Setter Property="Background" Value="#18FFC857"/>
                                                                        <Setter Property="BorderBrush" Value="#55FFC857"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="busy">
                                                                        <Setter Property="Background" Value="#18FF4D5A"/>
                                                                        <Setter Property="BorderBrush" Value="#55FF4D5A"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="ingame">
                                                                        <Setter Property="Background" Value="#1846D9FF"/>
                                                                        <Setter Property="BorderBrush" Value="#5546D9FF"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="notrunning">
                                                                        <Setter Property="Background" Value="#185A7D9A"/>
                                                                        <Setter Property="BorderBrush" Value="#555A7D9A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">

                                                            <!-- DOT -->
                                                            <Border x:Name="UserStatusDot"
                                                                    Width="9"
                                                                    Height="9"
                                                                    CornerRadius="4.5"
                                                                    Margin="0,0,7,0"
                                                                    VerticalAlignment="Center"
                                                                    BorderThickness="1"
                                                                    BorderBrush="#B0000000">

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                        <Setter Property="Opacity" Value="0.96"/>

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="online">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="offline">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="away">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="busy">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="ingame">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfState}" Value="notrunning">
                                                                                <Setter Property="Background" Value="#5A7D9A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <!-- TEXT -->
                                                            <TextBlock x:Name="UserStatusHeader"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.95"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{PluginSettings Plugin=SteamFriendsFullscreen, Path=SelfStateLoc}"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                        </StackPanel>
                                                    </Border>

                                                    <!-- FOCUS BORDER -->
                                                    <Border x:Name="FocusBorder"
                                                            Height="38"
                                                            MinWidth="108"
                                                            CornerRadius="19"
                                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                            BorderThickness="2"
                                                            Visibility="Collapsed"
                                                            IsHitTestVisible="False"/>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>

                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </ButtonEx.Template>
                                    </ButtonEx>

                                </Grid>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- BUTTON LIST -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Vertical"
                                            FocusVisualStyle="{x:Null}"
                                            Margin="16,12,16,12"
                                            KeyboardNavigation.TabNavigation="Contained"
                                            KeyboardNavigation.DirectionalNavigation="Continue">

                                    <ButtonEx x:Name="QuickProfileButton"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              pbeh:FocusBahaviors.FocusBinding="True"
                                              Tag="&#xE77B;"
                                              FocusVisualStyle="{x:Null}"
                                              Content="{DynamicResource LOCProfile}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[PlayerProfileWindowStyle]}"/>

                                    <ButtonEx x:Name="QuickNotificationButton"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              FocusVisualStyle="{x:Null}"
                                              Tag="&#xEA8F;"
                                              Content="{DynamicResource LOCNotifications}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[QuickAccessNotificationWindowStyle]}"/>

                                    <ButtonEx x:Name="QuickFriendsButton"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              Tag="&#xE902;"
                                              Content="{DynamicResource LOCSteamFriendsTitle}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendsStyle]}"/>

                                    <ButtonEx x:Name="QuickAchievementsButton"
                                              Style="{StaticResource QuickAccessButtonStyle2}"
                                              Tag="&#xedd7;"
                                              Content="{DynamicResource LOCAchievements}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenAchievementsCommand}"/>

                                    <ButtonEx x:Name="QuickNewsButton"
                                              Style="{StaticResource QuickAccessButtonStyle2}"
                                              Tag="&#xefa6;"
                                              Content="{DynamicResource LOCNewsTab}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[LastUpdatesWindowStyle]}"/>

                                    <ButtonEx x:Name="QuickStoreButton"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              Tag="&#xE719;"
                                              Content="{DynamicResource LOCSteamStoreTitle}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[SteamStoreStyle]}"/>

                                    <ButtonEx x:Name="QuickHelpButton"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              Tag="&#xE897;"
                                              Content="{DynamicResource LOCHelpAndRessource}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[HelpWindowStyle]}"/>


                                    <!-- SEPARATOR -->
                                    <Border Height="1"
                                            Margin="22,5,22,5"
                                            Background="#20FFFFFF"/>

                                    <ButtonEx x:Name="QuickAccessLockScreenButton"
                                              FocusVisualStyle="{x:Null}"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              Tag="&#xE72E;"
                                              Content="{DynamicResource LOCLockScreen}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenLockScreenCommand}" />

                                    <ButtonEx x:Name="QuickAccessPowerButton"
                                              FocusVisualStyle="{x:Null}"
                                              Style="{StaticResource QuickAccessButtonStyle}"
                                              Tag="&#xE7E8;"
                                              Content="Power"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenPowerMenuCommand}" />




                                </StackPanel>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="3"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- FOOTER -->
                                <Grid Grid.Row="4"
                                      Height="58"
                                      Margin="22,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{DynamicResource LOCQUICKACCESS}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="B" Command="{Binding CloseCommand}"
                                                  Content="{DynamicResource LOCBackLabel}" />

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>
