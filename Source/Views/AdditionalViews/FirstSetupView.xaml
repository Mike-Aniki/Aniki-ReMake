                                                           Text="{DynamicResource LOCFirstSetupHelperInputTitle}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"/>

