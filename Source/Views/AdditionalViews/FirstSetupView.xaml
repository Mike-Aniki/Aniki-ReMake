                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=HelperInputDiscoveryMask}"
                                                                         Stretch="Fill"
                                                                         RenderOptions.BitmapScalingMode="Fant"
                                                                         RenderOptions.CachingHint="Cache"/>
                                                        </Border.OpacityMask>
                                                        <Image Source="{ThemeFile 'Themes Option/11.First Setup/Helper/Input.jpg'}"
