                                                       Text="{DynamicResource LOCFirstSetupScreenshotsDesc}"
                                                       Style="{StaticResource FirstSetupExtensionDescriptionStyle}"
                                                       Margin="71,8,0,0"/>
                                            <Grid Grid.Row="2">
                                                <ButtonEx Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ChooseAndInstallScreenshotProviderCommand}">
