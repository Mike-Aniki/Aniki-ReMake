                                               Style="{StaticResource FirstSetupSubtitleStyle}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      Margin="24,3,24,0"
                                      Focusable="False"
                                      IsHitTestVisible="False"
                                      KeyboardNavigation.DirectionalNavigation="None">
