                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SteamReady}" Value="True">
                                                                        <Setter Property="Background" Value="#34225945"/>
                                                                        <Setter Property="BorderBrush" Value="#A648D39A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="14"
                                                                   FontWeight="Bold">
