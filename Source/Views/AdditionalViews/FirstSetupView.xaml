                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ScreenshotUtilitiesNeedsLocalProvider}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ScreenshotUtilitiesLocalProviderQueued}" Value="True">
                                                                    <Setter Property="Content" Value="{DynamicResource LOCFirstSetupCancelScheduledInstall}"/>
