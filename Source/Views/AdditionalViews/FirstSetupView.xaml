                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource FirstSetupExtensionInstallButtonStyle}">
                                                        <Setter Property="Content" Value="{DynamicResource LOCFirstSetupInstallAtEnd}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ExtraMetadataNeedsTools}" Value="True">
                                                                <Setter Property="Content" Value="{DynamicResource LOCFirstSetupInstallMetadataToolsAtEnd}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ExtraMetadataQueued}" Value="True">
                                                                <Setter Property="Content" Value="{DynamicResource LOCFirstSetupCancelScheduledInstall}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ExtraMetadataInstalled}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                        </Grid>
                                    </Border>

                                    <!-- Screenshots -->
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FirstSetupExtensionCardStyle}">
