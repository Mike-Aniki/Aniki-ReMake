                                                                    <Setter Property="Text" Value="{DynamicResource LOCFirstSetupStatusLocalProviderRequired}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ScreenshotProviderQueued}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource LOCFirstSetupStatusScheduled}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ScreenshotUtilitiesLocalProviderQueued}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource LOCFirstSetupStatusScheduled}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
