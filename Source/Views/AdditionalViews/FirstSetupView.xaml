<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="FirstSetupWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>

                        <Style x:Key="FirstSetupPageStyle" TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>

                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}"/>

                        <Style x:Key="FirstSetupItemsControlStyle" TargetType="ItemsControl">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="FirstSetupPreviewHostStyle" TargetType="ContentControl">
                            <Setter Property="Height" Value="500"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
                            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                        </Style>

                        <Style x:Key="FirstSetupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="44"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Effect" Value="{DynamicResource SoftTextShadow}"/>
                        </Style>

                        <Style x:Key="FirstSetupSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="LineHeight" Value="31"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Opacity" Value="0.82"/>
                        </Style>

                        <Style x:Key="FirstSetupNavButtonStyle" TargetType="ButtonEx">
                            <Setter Property="MinWidth" Value="230"/>
                            <Setter Property="Height" Value="62"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Padding" Value="28,0"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="#CC17191F"/>
                            <Setter Property="BorderBrush" Value="#42FFFFFF"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="Root"
                                                CornerRadius="16"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                <Setter TargetName="Root" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="FirstSetupChoiceButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Height" Value="106"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="Card"
                                                Padding="20,14"
                                                CornerRadius="16"
                                                Background="#B015171C"
                                                BorderBrush="#32FFFFFF"
                                                BorderThickness="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SelectionRail"
                                                        Width="6"
                                                        Margin="-20,-14,0,-14"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="16,0,0,16"
                                                        Background="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>
                                                <StackPanel Margin="15,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="54"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="15"
                                                               Margin="0,6,0,0"
                                                               Opacity="0.66"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="56"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border x:Name="RecommendedBadge"
                                                            Padding="10,4"
                                                            CornerRadius="9"
                                                            Background="{DynamicResource ButtonBackgroundFocus}"
                                                            HorizontalAlignment="Right"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="{DynamicResource LOCFirstSetupRecommended}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                    <Border x:Name="SelectedIndicator"
                                                            Width="34"
                                                            Height="34"
                                                            Margin="0,6,0,0"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource ButtonBackgroundFocus}"
                                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                            BorderThickness="3"
                                                            HorizontalAlignment="Right"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="✓"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="19"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                <Setter TargetName="RecommendedBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="Card" Property="BorderThickness" Value="4"/>
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.4" Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <DataTemplate x:Key="FirstSetupChoiceButtonTemplate">
                            <ButtonEx Style="{StaticResource FirstSetupChoiceButtonStyle}"
                                      HorizontalAlignment="Stretch"
                                      Command="{Binding SelectCommand}"/>
                        </DataTemplate>

                        <Style x:Key="FirstSetupColorChoiceButtonStyle"
                               TargetType="ButtonEx"
                               BasedOn="{StaticResource FirstSetupChoiceButtonStyle}">
                            <Setter Property="Height" Value="98"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>

                        <DataTemplate x:Key="FirstSetupColorChoiceButtonTemplate">
                            <ButtonEx Style="{StaticResource FirstSetupColorChoiceButtonStyle}"
                                      HorizontalAlignment="Stretch"
                                      Command="{Binding SelectCommand}"/>
                        </DataTemplate>

                        <DataTemplate x:Key="FirstSetupLoginChoiceButtonTemplate">
                            <ButtonEx Style="{StaticResource FirstSetupChoiceButtonStyle}"
                                      Height="106"
                                      Margin="0,0,10,0"
                                      HorizontalAlignment="Stretch"
                                      Command="{Binding SelectCommand}"/>
                        </DataTemplate>

                        <Style x:Key="FirstSetupAvatarButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Width" Value="116"/>
                            <Setter Property="Height" Value="112"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="AvatarCard"
                                                CornerRadius="20"
                                                Background="#B015171C"
                                                BorderBrush="#32FFFFFF"
                                                BorderThickness="2"
                                                Padding="8">
                                            <Grid>
                                                <Grid Width="78"
                                                      Height="78"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Border x:Name="AvatarImageMask"
                                                            CornerRadius="39"
                                                            Background="Black"/>
                                                    <Border Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=AvatarImageMask}"
                                                                         Stretch="Fill"
                                                                         RenderOptions.BitmapScalingMode="Fant"
                                                                         RenderOptions.CachingHint="Cache"/>
                                                        </Border.OpacityMask>
                                                        <Image Source="{Binding PreviewPath}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </Grid>
                                                <Border x:Name="AvatarSelectedIndicator"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="3"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="✓"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="19"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="AvatarCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="AvatarCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                <Setter TargetName="AvatarSelectedIndicator" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="AvatarCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="AvatarCard" Property="BorderThickness" Value="4"/>
                                                <Setter TargetName="AvatarCard" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.38" Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AvatarCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <DataTemplate x:Key="FirstSetupAvatarButtonTemplate">
                            <ButtonEx Style="{StaticResource FirstSetupAvatarButtonStyle}"
                                      Command="{Binding SelectCommand}"/>
                        </DataTemplate>

                        <Style x:Key="FirstSetupInfoCardStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Background" Value="#B015171C"/>
                            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="25"/>
                            <Setter Property="Margin" Value="10"/>
                        </Style>

                        <Style x:Key="FirstSetupIntegrationInstallButtonStyle" TargetType="ButtonEx">
                            <Setter Property="MinWidth" Value="190"/>
                            <Setter Property="MinHeight" Value="48"/>
                            <Setter Property="Padding" Value="22,8"/>
                            <Setter Property="Margin" Value="0,18,0,0"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="#CC17191F"/>
                            <Setter Property="BorderBrush" Value="#52FFFFFF"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="InstallButtonRoot"
                                                CornerRadius="13"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="InstallButtonRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="InstallButtonRoot" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                <Setter TargetName="InstallButtonRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.48" Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="InstallButtonRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="InstallButtonRoot" Property="Opacity" Value="0.38"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="FirstSetupExtensionCardStyle"
                               TargetType="Border"
                               BasedOn="{StaticResource FirstSetupInfoCardStyle}">
                            <Setter Property="MinHeight" Value="145"/>
                            <Setter Property="Padding" Value="16"/>
                            <Setter Property="Margin" Value="7,20"/>
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionTitleStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionIconFrameStyle"
                               TargetType="Border">
                            <Setter Property="Width" Value="56"/>
                            <Setter Property="Height" Value="56"/>
                            <Setter Property="Margin" Value="0,0,15,0"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="CornerRadius" Value="11"/>
                            <Setter Property="Background" Value="#18000000"/>
                            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionIconStyle"
                               TargetType="Image">
                            <Setter Property="Stretch" Value="Uniform"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionStatusStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="14,2,0,0"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionDescriptionStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlockBaseStyle}">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="LineHeight" Value="19"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,8,0,0"/>
                            <Setter Property="Opacity" Value="0.80"/>
                        </Style>

                        <Style x:Key="FirstSetupExtensionInstallButtonStyle"
                               TargetType="ButtonEx"
                               BasedOn="{StaticResource FirstSetupIntegrationInstallButtonStyle}">
                            <Setter Property="MinWidth" Value="172"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="Padding" Value="16,5"/>
                            <Setter Property="Margin" Value="0,9,0,0"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>

                        <DataTemplate x:Key="FirstSetupChoicePreviewTemplate">
                            <Grid Focusable="False" IsHitTestVisible="False" KeyboardNavigation.DirectionalNavigation="None">
                                <Border x:Name="ChoicePreviewMask"
                                        CornerRadius="28"
                                        Background="Black"/>
                                <Border Background="#FF090A0D">
                                    <Border.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=ChoicePreviewMask}"
                                                     Stretch="Fill"
                                                     RenderOptions.BitmapScalingMode="Fant"
                                                     RenderOptions.CachingHint="Cache"/>
                                    </Border.OpacityMask>
                                    <Image Source="{Binding PreviewPath}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Border CornerRadius="28"
                                        BorderBrush="#3AFFFFFF"
                                        BorderThickness="2"
                                        IsHitTestVisible="False"/>
                                <Border VerticalAlignment="Bottom" Height="255" CornerRadius="0,0,28,28">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#72000000" Offset="0.38"/>
                                            <GradientStop Color="#C9000000" Offset="0.68"/>
                                            <GradientStop Color="#F6000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,28">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="32"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="19"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.86"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>

                    </ControlTemplate.Resources>

                    <Grid x:Name="FirstSetupRoot"
                          Background="#FF08090C"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=FirstSetupStartButton}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsClosing}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                <Storyboard FillBehavior="HoldEnd" Timeline.DesiredFrameRate="30">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid IsHitTestVisible="False">
                            <Image Source="{ThemeFile 'Themes Option/2.Interface/Images/Welcome.jpg'}"
                                   Stretch="UniformToFill"
                                   Opacity="0.24"/>
                            <Rectangle Fill="#D608090C"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.34" RadiusX="0.72" RadiusY="0.72">
                                        <GradientStop Color="#301E8BFF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <Grid x:Name="FirstSetupWizardContent"
                              Margin="74,38,74,36"
                              IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CanInteract}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsOfferVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="92"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="82"/>
                            </Grid.RowDefinitions>

                            <!-- Progress header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LOCFirstSetupTitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="25"
                                               FontWeight="SemiBold"/>
                                    <ProgressBar Width="670"
                                                 Height="5"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,14,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ProgressPercent}"
                                                 Foreground="{DynamicResource FocusGameBorderBrush}"
                                                 Background="#30FFFFFF"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="19">
                                    <Run Text="{DynamicResource LOCFirstSetupStep}"/>
                                    <Run Text=" "/>
                                    <Run Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentStepNumber}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.TotalStepCount}"/>
                                </TextBlock>
                            </Grid>

                            <!-- 0. Welcome -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource FirstSetupPageStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentPage}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
