                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="35,8,35,6">
                                    <TextBlock Text="{DynamicResource LOCFirstSetupHelperTitle}"
                                               Style="{StaticResource FirstSetupTitleStyle}"/>
