                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ExtraMetadataInstalled}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource LOCFirstSetupStatusInstalled}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
