                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SteamReady}" Value="True">
                                                                            <Setter Property="Text" Value="{DynamicResource LOCFirstSetupHelperSteamStatusConnected}"/>
                                                                            <Setter Property="Foreground" Value="#FF80E6B6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

