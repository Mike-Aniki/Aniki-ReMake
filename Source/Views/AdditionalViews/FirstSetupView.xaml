                                        <Border Grid.Column="3"
                                                Style="{StaticResource FirstSetupInfoCardStyle}"
                                                Padding="18,18,18,16"
                                                Margin="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="220"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Height="210"
                                                      Margin="4,0,4,0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Top">
                                                    <Border x:Name="HelperMoreDiscoveryMask"
                                                            CornerRadius="14"
                                                            Background="Black"/>
                                                    <Border>
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=HelperMoreDiscoveryMask}"
                                                                         Stretch="Fill"
                                                                         RenderOptions.BitmapScalingMode="Fant"
                                                                         RenderOptions.CachingHint="Cache"/>
                                                        </Border.OpacityMask>
                                                        <Image Source="{ThemeFile 'Themes Option/11.First Setup/Helper/More.jpg'}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <Rectangle RadiusX="14" RadiusY="14" Fill="#22000000"/>
                                                    <Border CornerRadius="14" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{DynamicResource LOCFirstSetupHelperMoreTitle}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{DynamicResource LOCFirstSetupHelperMoreDesc}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="14"
                                                           LineHeight="19"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Opacity="0.76"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource LOCFirstSetupHelperFooter}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="15"
                                           Opacity="0.72"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="1500"
                                           Margin="0,5,0,0"/>
                            </Grid>

                            <!-- 10. Complete -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource FirstSetupPageStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentPage}" Value="10">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="45,0,60,0">
                                    <TextBlock Text="{DynamicResource LOCFirstSetupCompleteTitle}" Style="{StaticResource FirstSetupTitleStyle}" FontSize="54"/>
                                    <TextBlock Text="{DynamicResource LOCFirstSetupCompleteDesc}" Style="{StaticResource FirstSetupSubtitleStyle}" FontSize="22" Margin="0,20,0,0"/>
                                    <Border Style="{StaticResource FirstSetupInfoCardStyle}" Margin="0,34,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryProfile}"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryStartup}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryLoginScreen}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryInterface}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryColor}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryDetails}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryExperience}" Margin="0,13,0,0"/>
                                                <TextBlock Text="{DynamicResource LOCFirstSetupSummaryTrailers}" Margin="0,13,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryUserName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryStartup}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryLoginScreen}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryInterface}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryColor}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryDetails}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryExperience}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SummaryTrailers}" Margin="0,13,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCFirstSetupCompleteRestartNote}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="16" Opacity="0.7" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="1"
                                      Width="620"
                                      Height="620"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      IsHitTestVisible="False">

                                    <Border x:Name="CompletePagePreviewMask"
                                            Width="620"
                                            Height="620"
                                            CornerRadius="34"
                                            Background="Black"/>

                                    <Border Width="620"
                                            Height="620"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CompletePagePreviewMask}"
                                                         Stretch="Fill"
                                                         RenderOptions.BitmapScalingMode="Fant"
                                                         RenderOptions.CachingHint="Cache"/>
                                        </Border.OpacityMask>

                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CompletePreviewPath}"
                                               Width="620"
                                               Height="620"
                                               Stretch="UniformToFill"
                                               StretchDirection="Both"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <Border Width="620"
                                            Height="620"
                                            CornerRadius="34"
                                            BorderBrush="#42FFFFFF"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>

                            <!-- Common footer navigation -->
                            <Grid Grid.Row="2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentPage}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ButtonEx HorizontalAlignment="Left"
                                          Style="{StaticResource FirstSetupNavButtonStyle}"
                                          Content="{DynamicResource LOCFirstSetupBack}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.BackCommand}"/>
                                <ButtonEx x:Name="FirstSetupContinueButton"
                                          HorizontalAlignment="Right"
                                          Content="{DynamicResource LOCFirstSetupContinue}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ContinueCommand}">
                                    <ButtonEx.Style>
                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource FirstSetupNavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentPage}" Value="10"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                </ButtonEx>
                                <ButtonEx x:Name="FirstSetupFinishButton"
                                          HorizontalAlignment="Right"
                                          Content="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.FinishButtonText}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.FinishCommand}">
                                    <ButtonEx.Style>
                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource FirstSetupNavButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CurrentPage}" Value="10"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                </ButtonEx>
                            </Grid>

                        </Grid>

                        <!-- One-time setup offer for existing users -->
                        <Grid x:Name="FirstSetupOfferOverlay"
                              Panel.ZIndex="900"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Contained">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsOfferVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Width="1120"
                                    Padding="64,58"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="32"
                                    Background="#F015171C"
                                    BorderBrush="#46FFFFFF"
                                    BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.62" Color="#FF000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{DynamicResource LOCFirstSetupOfferTitle}"
                                               Style="{StaticResource FirstSetupTitleStyle}"
                                               FontSize="48"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{DynamicResource LOCFirstSetupOfferDescription}"
                                               Style="{StaticResource FirstSetupSubtitleStyle}"
                                               FontSize="23"
                                               LineHeight="34"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               MaxWidth="930"
                                               Margin="0,28,0,0"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{DynamicResource LOCFirstSetupOfferFamiliar}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="19"
                                               LineHeight="29"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               MaxWidth="930"
                                               Opacity="0.72"
                                               Margin="0,22,0,0"/>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,42,0,0">
                                        <ButtonEx x:Name="FirstSetupOfferSkipButton"
                                                  Style="{StaticResource FirstSetupNavButtonStyle}"
                                                  MinWidth="290"
                                                  Content="{DynamicResource LOCFirstSetupOfferSkip}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.SkipOfferCommand}"/>
                                        <ButtonEx x:Name="FirstSetupOfferStartButton"
                                                  Style="{StaticResource FirstSetupNavButtonStyle}"
                                                  MinWidth="330"
                                                  Content="{DynamicResource LOCFirstSetupOfferStart}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.StartOfferedSetupCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Post-setup Playnite add-on installation flow -->
                        <Grid x:Name="FirstSetupAddonInstallOverlay"
                              Panel.ZIndex="950"
                              Background="#F708090C"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Contained">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsAddonInstallFlowActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Width="1120"
                                    Padding="58,50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="30"
                                    Background="#F017191F"
                                    BorderBrush="#46FFFFFF"
                                    BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.62" Color="#FF000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{DynamicResource LOCFirstSetupAddonInstallFlowTitle}"
                                               Style="{StaticResource FirstSetupTitleStyle}"
                                               FontSize="46"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{DynamicResource LOCFirstSetupAddonInstallFlowDescription}"
                                               Style="{StaticResource FirstSetupSubtitleStyle}"
                                               FontSize="21"
                                               LineHeight="31"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="940"
                                               Margin="0,22,0,0"/>

                                    <Border Grid.Row="2"
                                            CornerRadius="15"
                                            Background="#552C1A00"
                                            BorderBrush="#90FFB44A"
                                            BorderThickness="1"
                                            Padding="20,14"
                                            Margin="0,26,0,0">
                                        <TextBlock Text="{DynamicResource LOCFirstSetupAddonInstallRestartGuide}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="18"
                                                   LineHeight="27"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Grid.Row="3"
                                            CornerRadius="20"
                                            Background="#B015171C"
                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                            BorderThickness="2"
                                            Padding="30,24"
                                            Margin="0,28,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.PendingAddonInstallProgressText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.72"/>
                                                <Border HorizontalAlignment="Right"
                                                        Padding="12,5"
                                                        CornerRadius="10"
                                                        Background="#553C2C00">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.PendingAddonInstallIsLast}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{DynamicResource LOCFirstSetupAddonInstallLastExtension}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="14"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.PendingAddonInstallCurrentName}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="32"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,14,0,0"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{DynamicResource LOCFirstSetupAddonInstallLaunchedNote}"
                                                       FontSize="16"
                                                       Opacity="0.72"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,14,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.PendingAddonInstallCurrentLaunched}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,32,0,0">
                                        <ButtonEx x:Name="FirstSetupAddonInstallButton"
                                                  Style="{StaticResource FirstSetupNavButtonStyle}"
                                                  MinWidth="310"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.PendingAddonInstallButtonText}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.InstallCurrentPendingAddonCommand}"/>

                                        <ButtonEx MinWidth="310"
                                                  Content="{DynamicResource LOCFirstSetupAddonInstallNext}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ContinuePendingAddonInstallCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource FirstSetupNavButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CanContinuePendingAddonInstall}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                        <ButtonEx MinWidth="330"
                                                  Content="{DynamicResource LOCFirstSetupAddonInstallFinishLater}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.FinishPendingAddonInstallCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource FirstSetupNavButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.CanFinishPendingAddonInstall}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Applying settings overlay -->
                        <Grid x:Name="FirstSetupApplyingOverlay"
                              Panel.ZIndex="1000"
                              Background="#F708090C"
                              Focusable="False"
                              KeyboardNavigation.DirectionalNavigation="None"
                              KeyboardNavigation.TabNavigation="None">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsApplying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Width="900"
                                    Padding="54,48"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="28"
                                    Background="#E817191F"
                                    BorderBrush="#42FFFFFF"
                                    BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCFirstSetupApplyingTitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="42"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ApplyStatus}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="21"
                                               Opacity="0.78"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,18,0,0"/>
                                    <ProgressBar Height="12"
                                                 Margin="0,38,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ApplyProgress}"
                                                 Foreground="{DynamicResource FocusGameBorderBrush}"
                                                 Background="#30FFFFFF"/>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.ApplyProgressText}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Opacity="0.82"
                                               HorizontalAlignment="Right"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
