                                              Tag="B"
                                              Command="{Binding CloseCommand}"
                                              Content="{DynamicResource LOCBackLabel}"/>

                                </StackPanel>
                            </Border>
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>
