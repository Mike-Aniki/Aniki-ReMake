                            <Grid VerticalAlignment="Top"
                                  Height="80"
                                  IsHitTestVisible="False">

                                <Border HorizontalAlignment="Stretch"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SeparatorTopBarBrush}"
                                        Opacity="0.35"/>

                                <Grid Margin="20,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCSteamFriendsTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Typography.Capitals="AllSmallCaps"
                                                   Opacity="0.96">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="10"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.24"
                                                                  Color="#000000"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                            </Grid>

                            <Border CornerRadius="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource FriendsBannerBackgroundBrush}"
                                    BorderBrush="{DynamicResource FriendsBannerBorder}"
                                    BorderThickness="1"
                                    Padding="40">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginStatus Plugin=AnikiHelper_96a983a3-3f13-4dce-a474-4052b718bb52, Status=Installed}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="760">

                                        <TextBlock Text="{DynamicResource LOCSteamFriendsPluginRequiredTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,18"/>

                                        <TextBlock Text="{DynamicResource LOCSteamFriendsPluginRequiredDesc}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   Opacity="0.78"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,32"/>

                                        <TextBlock Text="{DynamicResource LOCSteamFriendsPluginRequiredPath}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="18"
                                                   Opacity="0.58"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Friends List -->

                            <Grid Width="1300" Height="840" VerticalAlignment="Center" Margin="20,90,20,90">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Steam Friends setup/config message -->
                                <Border Panel.ZIndex="90"
                                        CornerRadius="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource FriendsBannerBackgroundBrush}"
                                        BorderBrush="{DynamicResource FriendsBannerBorder}"
                                        BorderThickness="1"
                                        Padding="40"
                                        MaxWidth="860">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupMessageVisibility}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,18"/>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupMessage}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   Opacity="0.78"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="760"/>
                                    </StackPanel>
                                </Border>

                                <!-- focus fill -->
                                <Border x:Name="FocusOverlay"
                                        CornerRadius="18"
                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>

                                <Border Margin="0,0,0,0"
                                        CornerRadius="24"
                                        Background="{DynamicResource FriendsBannerBackgroundBrush}"
                                        BorderBrush="{DynamicResource FriendsBannerBorder}"
                                        BorderThickness="1"
                                        Padding="26,24,26,22">

                                    <!-- liste amis -->
                                    <Grid x:Name="FriendsMainPage">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFriendProfileOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- SUB HEADER -->
                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,0"
                                              KeyboardNavigation.DirectionalNavigation="Continue"
                                              KeyboardNavigation.TabNavigation="Continue">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT : SELF CARD -->
                                            <ButtonEx  x:Name="SelfStatusButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSelfStatusWindowCommand}"
                                                      pbeh:FocusBahaviors.FocusBinding="{Binding ElementName=FriendsMainPage, Path=IsVisible}"
                                                      Height="88"
                                                      MinWidth="300"
                                                      Grid.Column="0"
                                                      Background="Transparent"
                                                      FocusVisualStyle="{x:Null}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsTabStop="True"
                                                      Focusable="True">

                                                <ButtonEx.Triggers>
                                                    <EventTrigger RoutedEvent="ButtonBase.Click">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenViewSound"
                                                                                               Storyboard.TargetProperty="LoadedBehavior">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ButtonEx.Triggers>

                                                <ButtonEx.Template>
                                                    <ControlTemplate TargetType="ButtonEx">
                                                        <Border x:Name="Root"
                                                                Width="{TemplateBinding Width}"
                                                                Height="{TemplateBinding Height}"
                                                                MinWidth="300"
                                                                CornerRadius="18"
                                                                BorderThickness="0"
                                                                Background="Transparent"
                                                                Padding="0"
                                                                SnapsToDevicePixels="True">

                                                            <Grid>
                                                                <Grid Margin="4">
                                                                    <!-- overlay derriÃ¨re -->
                                                                    <Border x:Name="FocusOverlay"
                                                                            CornerRadius="15"
                                                                            Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                            Opacity="0"
                                                                            IsHitTestVisible="False"/>

                                                                    <!-- fond principal -->
                                                                    <Border x:Name="BaseBackground"
                                                                            CornerRadius="15"
                                                                            IsHitTestVisible="False"
                                                                            Background="{DynamicResource BackgroundItem}" />


                                                                    <!-- highlight -->
                                                                    <Border CornerRadius="15"
                                                                            Opacity="0.18"
                                                                            IsHitTestVisible="False">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                                                <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>

                                                                    <!-- focus plus serrÃ© -->
                                                                    <Border x:Name="FocusStroke"
                                                                            CornerRadius="15"
                                                                            BorderThickness="2"
                                                                            BorderBrush="{DynamicResource FocusFriendsCardBorder}"
                                                                            Background="Transparent"
                                                                            Opacity="0"
                                                                            IsHitTestVisible="False"/>

                                                                    <!-- contenu -->
                                                                    <Grid Margin="14,10">
                                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ButtonEx.Template>

                                                <ButtonEx.Content>
                                                    <Grid MinHeight="62">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <MediaElement x:Name="OpenViewSound"
                                                                      Source="{ThemeFile 'audio/activation.wav'}"
                                                                      LoadedBehavior="Manual"
                                                                      UnloadedBehavior="Close"
                                                                      Visibility="Collapsed"
                                                                      Volume="{Settings Fullscreen.InterfaceVolume}"
                                                                      IsMuted="False"/>

                                                        <!-- Avatar -->
                                                        <Border Grid.Column="0"
                                                                Width="58"
                                                                Height="58"
                                                                CornerRadius="14"
                                                                ClipToBounds="True"
                                                                BorderBrush="#30FFFFFF"
                                                                BorderThickness="1"
                                                                Background="#18000000"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=SelfAvatar}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Border>

                                                        <!-- Textes -->
                                                        <Grid Grid.Column="1"
                                                              Margin="14,0,0,0"
                                                              VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Ligne 1 -->
                                                            <StackPanel Grid.Row="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">

                                                                <Border Width="14"
                                                                        Height="14"
                                                                        CornerRadius="7"
                                                                        Margin="0,0,10,0"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#AA000000"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                            <Setter Property="Opacity" Value="0.95"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="offline">
                                                                                    <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="away">
                                                                                    <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="busy">
                                                                                    <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                                                    <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="notrunning">
                                                                                    <Setter Property="Background" Value="{DynamicResource StatusNotRunningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>

                                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelfName, FallbackValue=Me}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="23"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           MaxWidth="240"/>
                                                            </StackPanel>

                                                            <!-- Ligne 2 : etat -->
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsStatusButtonText}"
                                                                       Margin="24,4,0,0"
                                                                       FontSize="16"
                                                                       Opacity="0.74"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="260">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Ligne 2 : jeu -->
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SelfGame}"
                                                                       Margin="24,4,0,0"
                                                                       FontSize="16"
                                                                       Opacity="0.74"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="260">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </ButtonEx.Content>
                                            </ButtonEx>

                                            <!-- CENTER / RIGHT : FRIENDS ACTIVITY BUTTON -->
                                            <ButtonEx x:Name="OpenFriendsActivityButton"
                                                      Grid.Column="1"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendsActivityWindow]}"
                                                      Height="58"
                                                      Width="250"
                                                      Margin="0,0,14,0"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      FocusVisualStyle="{x:Null}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch"
                                                      Padding="0"
                                                      IsTabStop="True"
                                                      Focusable="True">

                                                <ButtonEx.Template>
                                                    <ControlTemplate TargetType="ButtonEx">
                                                        <Border x:Name="Root"
                                                                Width="{TemplateBinding Width}"
                                                                Height="{TemplateBinding Height}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                SnapsToDevicePixels="True">

                                                            <Grid Margin="4">
                                                                <Border x:Name="FocusOverlay"
                                                                        CornerRadius="16"
                                                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                        Opacity="0"
                                                                        IsHitTestVisible="False"/>

                                                                <Border x:Name="BaseBackground"
                                                                        CornerRadius="16"
                                                                        Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                                        BorderBrush="#22FFFFFF"
                                                                        BorderThickness="1"
                                                                        IsHitTestVisible="False"/>

                                                                <Border CornerRadius="15"
                                                                        Opacity="0.18"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                                            <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>

                                                                <Border x:Name="FocusStroke"
                                                                        CornerRadius="15"
                                                                        BorderThickness="2"
                                                                        BorderBrush="{DynamicResource FocusFriendsCardBorder}"
                                                                        Background="Transparent"
                                                                        Opacity="0"
                                                                        IsHitTestVisible="False"/>

                                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="FocusStroke" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ButtonEx.Template>

                                                <ButtonEx.Content>
                                                    <Grid Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                                BorderBrush="#20FFFFFF"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">

                                                            <Image Source="{ThemeFile 'Images/Or.png'}"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,0,0">

                                                            <TextBlock Text="{DynamicResource LOCFriendsAchievements}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="180"/>

                                                        </StackPanel>
                                                    </Grid>
                                                </ButtonEx.Content>
                                            </ButtonEx>

                                            <!-- RIGHT : PILLS -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">

                                                <Border Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                        CornerRadius="16"
                                                        Padding="14,7"
                                                        Margin="0,0,10,0"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="10"
                                                                Height="10"
                                                                CornerRadius="5"
                                                                Background="{DynamicResource StatusOnlineBrush}"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource LOCSteamOnline}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   Opacity="0.82"/>
                                                        <TextBlock Text=" " FontSize="17"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OnlineCount, FallbackValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                        CornerRadius="16"
                                                        Padding="14,7"
                                                        Margin="0,0,10,0"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="10"
                                                                Height="10"
                                                                CornerRadius="5"
                                                                Background="{DynamicResource StatusInGameBrush}"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource LOCSteamInGame}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   Opacity="0.82"/>
                                                        <TextBlock Text=" " FontSize="17"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=InGameCount, FallbackValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BadgeStatusFriendsBrush}"
                                                        CornerRadius="16"
                                                        Padding="14,7"
                                                        Margin="0,0,10,0"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="10"
                                                                Height="10"
                                                                CornerRadius="5"
                                                                Background="{DynamicResource StatusOfflineBrush}"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource LOCSteamOffline}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   Opacity="0.74"/>
                                                        <TextBlock Text=" " FontSize="17"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OfflineCount, FallbackValue=0}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   Opacity="0.88"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#AA402020"
                                                        CornerRadius="14"
                                                        Padding="10,6"
                                                        BorderBrush="#40FF9A00"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{DynamicResource LOCSteamDataOutdated}"
                                                               Foreground="Orange"
                                                               FontSize="14"
                                                               Opacity="0.95"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- separator -->
                                        <Border Grid.Row="1"
                                                Height="1"
                                                Margin="0,18,0,18"
                                                Background="{DynamicResource SeparatorBrush}"
                                                Opacity="0.60"/>

                                        <!-- LIST WRAPPER -->
                                        <Border Grid.Row="2"
                                                CornerRadius="22"
                                                Background="#08000000"
                                                BorderBrush="#18FFFFFF"
                                                BorderThickness="1"
                                                Padding="10"
                                                CacheMode="BitmapCache">

                                            <ListBox x:Name="OnlineFriendsList"
                                                     ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=Friends}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FocusVisualStyle="{x:Null}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     KeyboardNavigation.DirectionalNavigation="Continue"
                                                     KeyboardNavigation.TabNavigation="Continue"
                                                     IsTabStop="True"
                                                     Focusable="False">

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{PluginSettings Plugin=AnikiHelper, Path=OpenFriendActionsWindowCommand}"
                                                                  CommandParameter="{Binding steamid}"
                                                                  Height="102"
                                                                  Margin="0,0,0,10"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch"
                                                                  Padding="0"
                                                                  IsTabStop="True">
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Grid>
                                                                        <Border x:Name="Shadow"
                                                                                CornerRadius="18"
                                                                                Background="Transparent"
                                                                                Opacity="0">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect BlurRadius="18"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.40"/>
                                                                            </Border.Effect>
                                                                        </Border>

                                                                        <Border x:Name="ItemRoot"
                                                                                CornerRadius="18"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1.2"
                                                                                SnapsToDevicePixels="True">

                                                                            <Grid>
                                                                                <Border x:Name="FocusOverlay"
                                                                                        CornerRadius="18"
                                                                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                                        Opacity="0"
                                                                                        IsHitTestVisible="False"/>

                                                                                <Border x:Name="CardGradient"
                                                                                        CornerRadius="18"
                                                                                        Opacity="0.92"
                                                                                        Background="{DynamicResource BackgroundItem}" />

                                                                                <Border CornerRadius="18"
                                                                                        Opacity="0.14"
                                                                                        IsHitTestVisible="False">
                                                                                    <Border.Background>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                                                                                            <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Border.Background>
                                                                                </Border>

                                                                                <Border x:Name="FocusFill"
                                                                                        CornerRadius="18"
                                                                                        Background="{DynamicResource FocusFriendsCardBackgroundBrush}"
                                                                                        Opacity="0"
                                                                                        IsHitTestVisible="False"/>

                                                                                <Border x:Name="StateAccent"
                                                                                        Width="4"
                                                                                        CornerRadius="2"
                                                                                        HorizontalAlignment="Left"
                                                                                        Margin="10,10,0,10"
                                                                                        Background="Transparent"
                                                                                        Opacity="0.95"/>

                                                                                <Grid Margin="18,0,12,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="78"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Grid Width="70"
                                                                                          Height="70"
                                                                                          VerticalAlignment="Center">
                                                                                        <Border Width="62"
                                                                                                Height="62"
                                                                                                CornerRadius="14"
                                                                                                Background="#22000000"
                                                                                                BorderBrush="#22FFFFFF"
                                                                                                BorderThickness="1"
                                                                                                ClipToBounds="True"
                                                                                                HorizontalAlignment="Left"
                                                                                                VerticalAlignment="Center">
                                                                                            <Image
                                                                                                Stretch="UniformToFill"
                                                                                                RenderOptions.BitmapScalingMode="Fant">
                                                                                                <Image.Source>
                                                                                                    <Binding Path="avatar"
                                                                                                             IsAsync="True"/>
                                                                                                </Image.Source>
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Opacity" Value="1"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="offline">
                                                                                                                <Setter Property="Opacity" Value="0.48"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>
                                                                                        </Border>
                                                                                    </Grid>

                                                                                    <StackPanel Grid.Column="1"
                                                                                                Margin="10,0,0,0"
                                                                                                VerticalAlignment="Center">

                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <Border Grid.Column="0"
                                                                                                    Width="14"
                                                                                                    Height="14"
                                                                                                    CornerRadius="7"
                                                                                                    Margin="0,0,10,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    BorderThickness="1"
                                                                                                    BorderBrush="#AA000000">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                                                        <Setter Property="Opacity" Value="0.92"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="offline">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                                                                                                <Setter Property="Opacity" Value="0.75"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="online">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="ingame">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="away">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="snooze">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="busy">
                                                                                                                <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                            </Border>

                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding name}"
                                                                                                       VerticalAlignment="Center"
                                                                                                       FontSize="24"
                                                                                                       FontWeight="SemiBold"
                                                                                                       TextTrimming="CharacterEllipsis">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                                        <Setter Property="Opacity" Value="0.98"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding state}" Value="offline">
                                                                                                                <Setter Property="Opacity" Value="0.58"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Grid>

                                                                                        <TextBlock Text="{Binding game}"
                                                                                                   FontSize="19"
                                                                                                   Margin="24,5,0,0"
                                                                                                   Opacity="0.76"
                                                                                                   TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding state}" Value="offline">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>

                                                                                    <Border Grid.Column="2"
                                                                                            VerticalAlignment="Center"
                                                                                            CornerRadius="14"
                                                                                            Padding="12,7"
                                                                                            Margin="12,0,0,0"
                                                                                            BorderBrush="#18FFFFFF"
                                                                                            BorderThickness="1">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="{DynamicResource BadgeStatusFriendsBrush}"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding state}" Value="online">
                                                                                                        <Setter Property="Background" Value="#604CD964"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding state}" Value="ingame">
                                                                                                        <Setter Property="Background" Value="#703DFF7A"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding state}" Value="away">
                                                                                                        <Setter Property="Background" Value="#60FF9800"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding state}" Value="snooze">
                                                                                                        <Setter Property="Background" Value="#60FF9800"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding state}" Value="busy">
                                                                                                        <Setter Property="Background" Value="#60B00020"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>

                                                                                        <TextBlock Text="{Binding stateLoc}"
                                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                                   FontSize="18"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Opacity="0.88"
                                                                                                   Typography.Capitals="AllSmallCaps"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>

                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding state}" Value="offline">
                                                                            <Setter TargetName="CardGradient" Property="Opacity" Value="0.45"/>
                                                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource FriendsCardBorderOfflineBrush}"/>
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="Transparent"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding state}" Value="online">
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding state}" Value="ingame">
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding state}" Value="away">
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding state}" Value="snooze">
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding state}" Value="busy">
                                                                            <Setter TargetName="StateAccent" Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                                        </DataTrigger>

                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource FocusFriendsCardBorder}"/>
                                                                            <Setter TargetName="ItemRoot" Property="BorderThickness" Value="2.2"/>
                                                                            <Setter TargetName="FocusFill" Property="Opacity" Value="0.20"/>
                                                                            <Setter TargetName="Shadow" Property="Opacity" Value="1"/>
                                                                            <Setter TargetName="CardGradient" Property="Opacity" Value="1"/>
                                                                            <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                    </Grid>
                                </Border>



                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFriendProfileOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginStatus Plugin=AnikiHelper_96a983a3-3f13-4dce-a474-4052b718bb52, Status=Installed}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>




