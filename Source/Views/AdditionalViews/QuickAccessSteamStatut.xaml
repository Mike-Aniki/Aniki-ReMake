<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Status Menu -->
    <Style x:Key="SteamStatusMenuWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=SteamStatusOnlineButton}">

                        <Grid.Resources>

                            <!-- STEAM STATUS BUTTON STYLE -->
                            <Style x:Key="SteamStatusButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="72"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <!-- FOCUS BACKGROUND -->
                                                <Border x:Name="MainBackground"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <!-- FOCUS BORDER -->
                                                <Border x:Name="MainBorder"
                                                        Margin="0"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <!-- FLASH FX -->
                                                <Border x:Name="FlashMenuBorder"
                                                        Margin="0"
                                                        CornerRadius="4"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <!-- CONTENT -->
                                                <Grid Margin="18,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- STATUS DOT -->
                                                    <Border Grid.Column="0"
                                                            Width="14"
                                                            Height="14"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                            BorderBrush="#99000000"
                                                            BorderThickness="1"/>

                                                    <!-- LABEL -->
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{DynamicResource FontMain}"
                                                                      TextElement.FontSize="22"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>

                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Grid.Resources>


                        <!-- FULLSCREEN BACKDROP -->
                        <Border Background="#99000000"
                                Opacity="1"/>


                        <!-- MAIN PANEL -->
                        <Grid x:Name="SteamStatusPanel"
                              Width="520"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="42,88,0,0"
                              Opacity="0"
                              RenderTransformOrigin="0.5,0">

                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    <TranslateTransform X="-40" Y="-20"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="SteamStatusPanel"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.22"/>

                                            <DoubleAnimation Storyboard.TargetName="SteamStatusPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="SteamStatusPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="SteamStatusPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="-40"
                                                             To="0"
                                                             Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="SteamStatusPanel"
                                                             Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                             From="-20"
                                                             To="0"
                                                             Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>


                            <!-- PANEL BACKGROUND -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"
                                                      Color="#000000"/>
                                </Border.Effect>
                            </Border>


                            <!-- INNER CONTENT -->
                            <Grid Margin="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- USER HEADER -->
                                <Grid Grid.Row="0"
                                      Height="96"
                                      Margin="22,16,22,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- AVATAR -->
                                    <Grid Grid.Column="0"
                                          Width="56"
                                          Height="56"
                                          VerticalAlignment="Center">

                                        <Border x:Name="SteamStatusAvatarMask"
                                                Width="56"
                                                Height="56"
                                                Background="Black"
                                                CornerRadius="28"/>



                                        <!-- AVATAR PATH -->
                                        <TextBlock x:Name="SteamStatusProfilePicturePath"
                                                   Tag="{Api Paths.ConfigurationPath}"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- USER AVATAR MASKED -->
                                        <Grid Width="56"
                                              Height="56"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=SteamStatusAvatarMask}" />
                                            </Grid.OpacityMask>

                                            <Control x:Name="SteamStatusUserAvatar"
                                                     Tag="{Binding ElementName=SteamStatusProfilePicturePath, Path=Text}"
                                                     Width="56"
                                                     Height="56"
                                                     Template="{StaticResource SteamSelfAvatarTemplate}"
                                                     Focusable="False"
                                                     IsTabStop="False"
                                                     IsHitTestVisible="False"/>
                                        </Grid>

                                        <!-- AVATAR BORDER -->
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                BorderBrush="{DynamicResource TextBrush}"
                                                BorderThickness="1.4"
                                                Background="#14000000"
                                                IsHitTestVisible="False"
                                                Panel.ZIndex="5"/>
                                    </Grid>


                                    <!-- USER NAME + SUBTITLE -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource UserName}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{DynamicResource LOCSteamPresence}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="14"
                                                   Opacity="0.70"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>


                                    <!-- CURRENT STATUS BADGE -->
                                    <Border x:Name="SteamCurrentStatusBadge"
                                            Grid.Column="3"
                                            Height="34"
                                            MinWidth="112"
                                            Padding="14,0"
                                            CornerRadius="17"
                                            Background="#1819F28B"
                                            BorderBrush="#5519F28B"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Background" Value="#1819F28B"/>
                                                <Setter Property="BorderBrush" Value="#5519F28B"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=AnikiHelper_96a983a3-3f13-4dce-a474-4052b718bb52, Status=Installed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="online">
                                                        <Setter Property="Background" Value="#1819F28B"/>
                                                        <Setter Property="BorderBrush" Value="#5519F28B"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="offline">
                                                        <Setter Property="Background" Value="#182D3748"/>
                                                        <Setter Property="BorderBrush" Value="#554A5A68"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="away">
                                                        <Setter Property="Background" Value="#18FFC857"/>
                                                        <Setter Property="BorderBrush" Value="#55FFC857"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="busy">
                                                        <Setter Property="Background" Value="#18FF4D5A"/>
                                                        <Setter Property="BorderBrush" Value="#55FF4D5A"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                        <Setter Property="Background" Value="#1846D9FF"/>
                                                        <Setter Property="BorderBrush" Value="#5546D9FF"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="notrunning">
                                                        <Setter Property="Background" Value="#185A7D9A"/>
                                                        <Setter Property="BorderBrush" Value="#555A7D9A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">

                                            <!-- CURRENT STATUS DOT -->
                                            <Border Width="9"
                                                    Height="9"
                                                    CornerRadius="4.5"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="#B0000000">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                        <Setter Property="Opacity" Value="0.96"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="online">
                                                                <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="offline">
                                                                <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="away">
                                                                <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="busy">
                                                                <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                                <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="notrunning">
                                                                <Setter Property="Background" Value="{DynamicResource StatusNotRunningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- CURRENT STATUS TEXT -->
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.95"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       VerticalAlignment="Center"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsStatusButtonText}"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>
                                    </Border>

                                </Grid>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- STATUS AREA -->
                                <Grid Grid.Row="2"
                                      Margin="16,12,16,12"
                                      FocusVisualStyle="{x:Null}"
                                      KeyboardNavigation.TabNavigation="Contained"
                                      KeyboardNavigation.DirectionalNavigation="Contained">

                                    <!-- STATUS BUTTONS - visible only when Steam is running -->
                                    <StackPanel x:Name="SteamStatusButtons"
                                                Orientation="Vertical"
                                                KeyboardNavigation.DirectionalNavigation="Continue"
                                                KeyboardNavigation.TabNavigation="Continue">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsChangeStatusVisibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- ONLINE -->
                                        <ButtonEx x:Name="SteamStatusOnlineButton"
                                                  Style="{StaticResource SteamStatusButtonStyle}"
                                                  FocusVisualStyle="{x:Null}"
                                                  Tag="{DynamicResource StatusOnlineBrush}"
                                                  Content="{DynamicResource LOCSteamOnline}"
                                                  pbeh:FocusBahaviors.FocusBinding="{Binding ElementName=SteamStatusButtons, Path=IsVisible}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetStatusOnlineCommand}"/>

                                        <!-- AWAY -->
                                        <ButtonEx x:Name="SteamStatusAwayButton"
                                                  Style="{StaticResource SteamStatusButtonStyle}"
                                                  FocusVisualStyle="{x:Null}"
                                                  Tag="{DynamicResource StatusAwayBrush}"
                                                  Content="{DynamicResource LOCSteamAway}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetStatusAwayCommand}"/>

                                        <!-- INVISIBLE / OFFLINE -->
                                        <ButtonEx x:Name="SteamStatusOfflineButton"
                                                  Style="{StaticResource SteamStatusButtonStyle}"
                                                  FocusVisualStyle="{x:Null}"
                                                  Tag="{DynamicResource StatusOfflineBrush}"
                                                  Content="{DynamicResource LOCSteamOffline}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=SetStatusInvisibleCommand}"/>

                                    </StackPanel>

                                    <!-- STEAM FRIENDS SETUP MESSAGE -->
                                    <StackPanel x:Name="SteamSetupMessage"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupMessageVisibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Width="460"
                                                MinHeight="270"
                                                CornerRadius="8"
                                                Padding="24"
                                                Background="#14000000"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1">

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupTitle}"
                                                           Style="{StaticResource TextBlockBaseStyle}"
                                                           FontSize="24"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsSetupMessage}"
                                                           Style="{StaticResource TextBlockBaseStyle}"
                                                           Margin="0,14,0,0"
                                                           FontSize="17"
                                                           Opacity="0.82"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Width="390"
                                                           HorizontalAlignment="Center"/>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- STEAM CLOSED MESSAGE -->
                                    <StackPanel x:Name="SteamClosedMessage"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsOpenSteamButtonVisibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Width="460"
                                                MinHeight="270"
                                                CornerRadius="8"
                                                Padding="24"
                                                Background="#14000000"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1">

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <!-- STEAM CLOSED TITLE -->
                                                <TextBlock Text="{DynamicResource LOCSteamisclosed}"
                                                           FontSize="24"
                                                           Foreground="Red"
                                                           Opacity="0.95"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSteamLaunching}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>


                                                <!-- LAUNCHING MESSAGE -->
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamLaunchMessage}"
                                                           Margin="0,10,0,0"
                                                           FontSize="22"
                                                           TextAlignment="Center">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSteamLaunching}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>


                                                <!-- OPEN STEAM BUTTON -->
                                                <ButtonEx x:Name="OpenSteamBtn"
                                                          Margin="0,18,0,0"
                                                          Width="390"
                                                          Height="72"
                                                          FocusVisualStyle="{x:Null}"
                                                          Tag="{DynamicResource StatusOnlineBrush}"
                                                          Content="{DynamicResource LOCOpenSteam}"
                                                          pbeh:FocusBahaviors.FocusBinding="{Binding ElementName=SteamClosedMessage, Path=IsVisible}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamCommand}">

                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource SteamStatusButtonStyle}">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSteamLaunching}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                </Grid>


                                <!-- SEPARATOR -->
                                <Border Grid.Row="3"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>


                                <!-- FOOTER -->
                                <Grid Grid.Row="4"
                                      Height="58"
                                      Margin="22,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{DynamicResource LOCSTEAMSTATUS}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="B"
                                                  Command="{Binding CloseCommand}"
                                                  Content="{DynamicResource LOCBackLabel}" />

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>