<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="WhatsNewWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <ControlTemplate.Resources>

                        <Style x:Key="WhatsNewSlideButtonStyle" TargetType="ButtonEx">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,28,0"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ButtonEx">
                                        <Border x:Name="CardRoot"
                                                Width="560"
                                                Height="520"
                                                CornerRadius="24"
                                                Background="{DynamicResource OverlayMenu}"
                                                BorderBrush="{DynamicResource StaticBorderBrush}"
                                                BorderThickness="1.5"
                                                SnapsToDevicePixels="True">

                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.28"
                                                                  Color="#FF000000"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="300"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- IMAGE -->
                                                <Grid Grid.Row="0" Margin="18,18,18,0">
                                                    <Border x:Name="ImageMask"
                                                            CornerRadius="18"
                                                            Background="Black"/>

                                                    <Border CornerRadius="18"
                                                            Background="#22000000">
                                                        <Border.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=ImageMask}"
                                                                         Stretch="Fill"
                                                                         RenderOptions.BitmapScalingMode="Fant"
                                                                         RenderOptions.CachingHint="Cache"/>
                                                        </Border.OpacityMask>

                                                        <Image Source="{Binding ImagePath}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Border>

                                                    <Border CornerRadius="18"
                                                            BorderBrush="#22FFFFFF"
                                                            BorderThickness="1"/>

                                                    <Border VerticalAlignment="Bottom"
                                                            Height="120"
                                                            CornerRadius="0,0,18,18"
                                                            IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                <GradientStop Color="#88000000" Offset="0.65"/>
                                                                <GradientStop Color="#DD000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>

                                                <!-- TEXT -->
                                                <StackPanel Grid.Row="1"
                                                            Margin="28,22,28,24">

                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="28"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="76"/>

                                                    <TextBlock Text="{Binding Text}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="18"
                                                               Opacity="0.78"
                                                               LineHeight="27"
                                                               Margin="0,14,0,0"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="118"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                                <Setter TargetName="CardRoot" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="18"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.36"
                                                                          Color="#FFFFFFFF"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </ControlTemplate.Resources>

                    <Grid x:Name="RootGrid"
                          Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=ContinueButton}"
                          Opacity="0">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="28"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="28"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <!-- BACKGROUND -->
                        <Grid IsHitTestVisible="False">
                            <Border Background="{DynamicResource SecondaryViewBackground}"/>

                            <Border Background="{DynamicResource WelcomeImage1}" Opacity="0.35">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.10"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.90"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <Border Background="#99000000"/>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="96"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid Grid.Row="0"
                                  Margin="72,24,72,0"
                                  VerticalAlignment="Center">

                                <StackPanel>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=WhatsNewTitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               Effect="{DynamicResource SoftTextShadow}"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0"
                                                Effect="{DynamicResource SoftTextShadow}">

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=WhatsNewSubtitle}"
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.78"/>

                                        <TextBlock Text="  •  "
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.42"/>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=WhatsNewVersion}"
                                                   Style="{DynamicResource TextBlockDetailStyle}"
                                                   FontSize="19"
                                                   Opacity="0.78"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- SLIDES -->
                            <Grid Grid.Row="1"
                                  VerticalAlignment="Center"
                                  Margin="72,-20,0,0">

                                <ListBox x:Name="SlidesList"
                                         ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=WhatsNewSlides}"
                                         SelectedIndex="0"
                                         SelectionMode="Single"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FocusVisualStyle="{x:Null}"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         KeyboardNavigation.DirectionalNavigation="Continue"
                                         KeyboardNavigation.TabNavigation="Continue"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True">

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="IsTabStop" Value="True"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ButtonEx Style="{StaticResource WhatsNewSlideButtonStyle}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- BOTTOM BAR -->
                            <Grid Grid.Row="2"
                                  Height="96"
                                  VerticalAlignment="Bottom">

                                <!-- CLOSE BUTTON -->
                                <ButtonEx x:Name="ContinueButton"
                                          Width="280"
                                          Height="58"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,18"
                                          Content="{DynamicResource LOCContinue}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=CloseTopWindowCommand}"
                                          pbeh:FocusBahaviors.FocusBinding="True"
                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>