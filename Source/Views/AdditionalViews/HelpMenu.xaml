<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="HelpWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=WhatNewButton}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          Opacity="0">

                        <Grid.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.20"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         From="-60"
                                                         To="0"
                                                         Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid.Resources>

                            <Style x:Key="HelpPanelButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="76"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">

                                            <Grid Background="{TemplateBinding Background}"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True">

                                                <Border x:Name="NormalBackground"
                                                        CornerRadius="7"
                                                        Background="#14000000"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"/>

                                                <Border x:Name="MainBackground"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>

                                                <Border x:Name="MainBorder"
                                                        BorderThickness="2"
                                                        CornerRadius="7"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        Visibility="Collapsed"/>

                                                <Border x:Name="FlashMenuBorder"
                                                        CornerRadius="7"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>

                                                <Grid Margin="18,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"
                                                               SnapsToDevicePixels="True"/>

                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{DynamicResource FontMain}"
                                                                      TextElement.FontSize="22"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE8A7;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="15"
                                                               Opacity="0.75"
                                                               Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>

                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Grid.Resources>

                        <!-- FULLSCREEN DARK BACKDROP -->
                        <Border Background="#99000000"
                                Opacity="0"/>

                        <!-- MAIN PANEL -->
                        <Grid x:Name="HelpPanel"
                              Width="520"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              RenderTransformOrigin="0.5,0.5"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.ControlTabNavigation="Contained">

                            <Border Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="0,0,1,0">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"
                                                      Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <Grid Margin="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Background="#33000000" Grid.Row="0"/>
                                <Border Background="#33000000" Grid.Row="4"/>

                                <!-- HEADER -->
                                <Grid Grid.Row="0"
                                      Height="96"
                                      Margin="22,10,22,10">

                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCHelpandResources}"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextHighlightBrush}"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{DynamicResource LOCGuidesupport}"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.75"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </Grid>

                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>

                                <!-- HELP BUTTONS -->
                                <StackPanel Grid.Row="2"
                                            Margin="16,18,16,18"
                                            FocusVisualStyle="{x:Null}"
                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                            KeyboardNavigation.ControlTabNavigation="Contained">

                                    <ButtonEx x:Name="WhatNewButton"
                                              FocusVisualStyle="{x:Null}"
                                              pbeh:FocusBahaviors.FocusBinding="True"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE789;"
                                              Content="{DynamicResource LOCWhatsNew}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWhatsNewCommand}"/>

                                    <ButtonEx x:Name="HelpGuideButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE82D;"
                                              Content="{DynamicResource LOCUserGuide}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[Guide]}"/>

                                    <ButtonEx x:Name="HelpIssuesButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE7BA;"
                                              Content="{DynamicResource LOCReportanIssue}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[Issues]}"/>

                                    <ButtonEx x:Name="HelpGitHubButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE8A7;"
                                              Content="{DynamicResource LOCGitHubRepository}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[GitHub]}"/>

                                    <ButtonEx x:Name="HelpDiscordButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE902;"
                                              Content="{DynamicResource LOCPlayniteDiscord}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[Discord]}"/>

                                    <ButtonEx x:Name="ExternalClientsButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE8CC;"
                                              Content="{DynamicResource LOCExternalClients}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenExternalClientsCommand}"/>

                                    <!--     <ButtonEx x:Name="GamepadTesterButton"
                                    Tag="&#xE950;"
                                    Content="Gamepad Tester"
                                    Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[GamepadTesterWindowStyle|GamepadTester_ButtonMap]}">
                                    <ButtonEx.Style>
                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource HelpPanelButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                    <DataTrigger Binding="{PluginStatus Plugin=GamepadTester_518dc982-32b5-4493-b32d-1f71de2fe4ad, Status=Installed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                    </ButtonEx.Style>
                                    </ButtonEx> -->

                                    <ButtonEx x:Name="AboutMeButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE77B;"
                                              Content="{DynamicResource LOCAboutMe}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[AboutMe]}"/>

                                    <ButtonEx x:Name="YoutubeButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xE714;"
                                              Content="{DynamicResource LOCYouTubeChannel}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[Youtube]}"/>

                                    <ButtonEx x:Name="HelpKofiButton"
                                              Style="{StaticResource HelpPanelButtonStyle}"
                                              Tag="&#xEB51;"
                                              Content="{DynamicResource LOCSupportMyWork}"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenHelpLink[Kofi]}"/>

                                </StackPanel>

                                <Border Grid.Row="3"
                                        Height="1"
                                        Margin="22,0"
                                        Background="#20FFFFFF"/>

                                <!-- FOOTER -->
                                <Grid Grid.Row="4"
                                      Height="58"
                                      Margin="22,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{DynamicResource LOCThanks}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="CancelAction" Command="{Binding CloseCommand}"
                                                  Content="{DynamicResource LOCBackLabel}" />

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>
