<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact focusable pill used by the Achievements sort toggle. -->
    <Style x:Key="AnikiAchievementsSortButtonStyle" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#10000000" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border x:Name="SortPill"
                            Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="18"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SortPill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="SortPill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="SortPill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="SortPill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SortPill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="SortPill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SortPill" Property="Background" Value="#28D0B06A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact pill used by the hidden-achievements toggle. -->
    <Style x:Key="AnikiAchievementsTogglePillStyle" TargetType="CheckBoxEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#10000000" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    <Border x:Name="TogglePill"
                            Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="18"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TogglePill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="TogglePill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="TogglePill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="TogglePill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TogglePill" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" />
                            <Setter TargetName="TogglePill" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TogglePill" Property="Background" Value="#22D0B06A" />
                            <Setter TargetName="TogglePill" Property="BorderBrush" Value="#55D0B06A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TogglePill" Property="Background" Value="#28D0B06A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay child window for Achievements. -->
    <Style x:Key="AchievementsWindowStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="1920"
                          Height="1080"
                          Background="Transparent"
                          Focusable="False">

                        <Rectangle IsHitTestVisible="False" Fill="#96000000"/>

                        <Border Width="1180"
                                Height="1000"
                                Padding="42,32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="28"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource StaticBorderBrush}"
                                BorderThickness="1"
                                Effect="{DynamicResource SoftTextShadow}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayAchievementsTitle}"
                                               Margin="0,0,0,0"
                                               FontSize="44"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsGameLabel}"
                                               Margin="0,8,0,0"
                                               FontSize="18"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Opacity="0.74"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Width="260"
                                            Height="1"
                                            Margin="0,16,0,0"
                                            Background="#55D0B06A"/>
                                </StackPanel>

                                <!-- Progress summary / sorting -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ButtonEx Grid.Column="0"
                                              Style="{StaticResource AnikiAchievementsSortButtonStyle}"
                                              Margin="0,0,12,0"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=ToggleOverlayAchievementsSortCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8CB;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayAchievementsSortButtonText}"
                                                       Margin="8,0,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ButtonEx>

                                    <CheckBoxEx Grid.Column="1"
                                                Style="{StaticResource AnikiAchievementsTogglePillStyle}"
                                                Margin="0,0,12,0"
                                                IsChecked="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements], Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE890;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Margin="8,0,0,0"
                                                       Text="{DynamicResource LOCShowHiddenAchievements}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBoxEx>

                                    <Border Grid.Column="3"
                                            Height="44"
                                            Padding="14,0"
                                            CornerRadius="22"
                                            Background="#12000000"
                                            BorderBrush="#45D0B06A"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">

                                            <!-- Platinum -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock FontSize="15"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Text" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                                                    <Setter Property="Text" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=IsCompleted}" Value="True">
                                                                    <Setter Property="Text" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Gold -->
                                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Image Source="{ThemeFile 'Images/Or.png'}"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=RareAndUltraRare.Unlocked, FallbackValue=0}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Silver -->
                                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Uncommon.Unlocked, FallbackValue=0}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Bronze -->
                                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Common.Unlocked, FallbackValue=0}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Achievement list -->
                                <Grid Grid.Row="4">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Focusable="False"
                                                  CanContentScroll="True"
                                                  Padding="0,4,12,4">
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievements}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Height="128"
                                                              Margin="0,0,0,12"
                                                              Padding="0"
                                                              HorizontalAlignment="Stretch"
                                                              FocusVisualStyle="{x:Null}"
                                                              Focusable="True"
                                                              IsTabStop="True"
                                                              KeyboardNavigation.IsTabStop="True">
                                                        <ButtonEx.Style>
                                                            <Style TargetType="ButtonEx">
                                                                <Setter Property="Background" Value="#0B000000"/>
                                                                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ButtonEx">
                                                                            <Border x:Name="AchievementCard"
                                                                                    CornerRadius="20"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="AchievementCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AchievementCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsFocused" Value="True">
                                                                                    <Setter TargetName="AchievementCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AchievementCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                    <Setter TargetName="AchievementCard" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                                                    <Setter TargetName="AchievementCard" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ButtonEx.Style>

                                                        <Grid Margin="18,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                            <Setter Property="Opacity" Value="0.62"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon -->
                                                            <Grid Grid.Column="0"
                                                                  Width="76"
                                                                  Height="76"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                                <Border x:Name="AchievementIconMask"
                                                                        CornerRadius="6"
                                                                        Background="Black"/>

                                                                <Border CornerRadius="6"
                                                                        Background="#16000000"
                                                                        BorderBrush="#30FFFFFF"
                                                                        BorderThickness="1"/>

                                                                <Grid>
                                                                    <Grid.OpacityMask>
                                                                        <VisualBrush Visual="{Binding ElementName=AchievementIconMask}"/>
                                                                    </Grid.OpacityMask>

                                                                    <TextBlock Text="&#xE7C1;"
                                                                               FontFamily="{DynamicResource FontIcons}"
                                                                               FontSize="30"
                                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                                               Opacity="0.55"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <Image Source="{Binding Icon}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                                        <Setter Property="Opacity" Value="0.25"/>
                                                                                    </DataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Image Source="{ThemeFile 'Images/Buttons/locked.png'}"
                                                                           Width="38"
                                                                           Height="38"
                                                                           Opacity="0.82"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Image Source="{ThemeFile 'Images/TrophyHidden.png'}"
                                                                           Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Text -->
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="20,0,28,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="23"
                                                                           FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                        <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <BlurEffect Radius="12" KernelType="Gaussian"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Setter Property="Opacity" Value="0.72"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="16"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Opacity" Value="0.88"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                        <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <BlurEffect Radius="12" KernelType="Gaussian"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Setter Property="Opacity" Value="0.58"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                    <TextBlock Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:F0}%}"
                                                                               FontSize="14"
                                                                               Opacity="0.64"
                                                                               Style="{DynamicResource TextBlockDetailStyle}"/>
                                                                    <TextBlock Margin="5,0,0,0"
                                                                               Text="{DynamicResource LOCPlayershaveachievement}"
                                                                               FontSize="14"
                                                                               Opacity="0.64"
                                                                               Style="{DynamicResource TextBlockDetailStyle}"/>

                                                                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ProgressNum}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ProgressDenom}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ProgressDenom}" Value="1">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock FontSize="13"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Opacity="0.60">
                                                                            <Run Text=" • "/>
                                                                            <Run Text="{Binding ProgressNum}"/>
                                                                            <Run Text="/"/>
                                                                            <Run Text="{Binding ProgressDenom}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status + Aniki trophy rank -->
                                                            <Grid Grid.Column="2"
                                                                  Width="190"
                                                                  Margin="18,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Right">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="54"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Unlock date / time -->
                                                                <StackPanel Grid.Column="0"
                                                                            Margin="0,0,10,0"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>

                                                                    <TextBlock Text="{Binding DateUnlocked, StringFormat='{}{0:HH:mm}'}"
                                                                               FontSize="20"
                                                                               Opacity="0.72"
                                                                               HorizontalAlignment="Right">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[LocalClock]}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <TextBlock Text="{Binding DateUnlocked, StringFormat='{}{0:t}'}"
                                                                               FontSize="20"
                                                                               Opacity="0.72"
                                                                               HorizontalAlignment="Right">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[LocalClock]}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <TextBlock Text="{Binding DateUnlocked, StringFormat='{}{0:d MMM yyyy}'}"
                                                                               FontSize="20"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                               Opacity="0.72"
                                                                               HorizontalAlignment="Right"/>
                                                                </StackPanel>

                                                                <!-- Trophy icon centered vertically -->
                                                                <Grid Grid.Column="1"
                                                                      Width="54"
                                                                      Height="54"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center">

                                                                    <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                                                           Height="46"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCapstone}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Image Source="{ThemeFile 'Images/Argent.png'}"
                                                                           Height="46"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                                                            <Condition Binding="{Binding Rarity}" Value="Uncommon"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Image Source="{ThemeFile 'Images/Or.png'}"
                                                                           Height="46"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                                                            <Condition Binding="{Binding Rarity}" Value="UltraRare"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                                                            <Condition Binding="{Binding Rarity}" Value="Rare"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                                           Height="46"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapScalingMode="Fant">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCapstone}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty state -->
                                    <Border Width="720"
                                            Height="240"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="22"
                                            Background="#10000000"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            Padding="28">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7C1;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="42"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource LOCNoAchievementsOverlay}"
                                                       Margin="0,14,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource LOCNoAchievementsOverlay}"
                                                       Margin="0,8,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="16"
                                                       Opacity="0.65"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Footer -->
                                <Grid Grid.Row="5" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="1"
                                            Height="34"
                                            Padding="16,0"
                                            CornerRadius="17"
                                            Background="#10000000"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCPlayAch_Column_Total}"
                                                       Margin="0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Margin="6,0,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <Run Text="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <ButtonEx Grid.Column="2"
                                              Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="CancelAction"
                                              Content="{DynamicResource LOCBackLabel}"
                                              HorizontalAlignment="Right"
                                              Focusable="False"
                                              IsTabStop="False"
                                              IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
