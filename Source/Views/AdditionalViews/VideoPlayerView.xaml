                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeMovies}"
                                                          ItemTemplate="{StaticResource VideoPlayerMediaPosterCardTemplate}"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          FocusVisualStyle="{x:Null}"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ButtonEx x:Name="VideoPlayerHomeMoviesBrowseCardButton"
                                                      Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MoviesLabel}"
                                                      ContentTemplate="{StaticResource VideoPlayerHomeBrowsePosterCardTemplate}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenMoviesLibraryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- TV Shows library preview -->
                                    <StackPanel Margin="0,0,0,28">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeSeries}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <Grid Margin="0,0,0,10" Focusable="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeSeries}"
                                                          ItemTemplate="{StaticResource VideoPlayerMediaPosterCardTemplate}"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          FocusVisualStyle="{x:Null}"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ButtonEx x:Name="VideoPlayerHomeSeriesBrowseCardButton"
                                                      Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesLabel}"
                                                      ContentTemplate="{StaticResource VideoPlayerHomeBrowsePosterCardTemplate}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenSeriesLibraryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Anime library preview -->
                                    <StackPanel Margin="0,0,0,28">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeAnime}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <Grid Margin="0,0,0,10" Focusable="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AnimeLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeAnime}"
                                                          ItemTemplate="{StaticResource VideoPlayerMediaPosterCardTemplate}"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          FocusVisualStyle="{x:Null}"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ButtonEx x:Name="VideoPlayerHomeAnimeBrowseCardButton"
                                                      Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AnimeLabel}"
                                                      ContentTemplate="{StaticResource VideoPlayerHomeBrowsePosterCardTemplate}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenAnimeLibraryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- User-defined fourth library preview -->
                                    <StackPanel Margin="0,0,0,28">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeCustom}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Margin="0,0,0,10" Focusable="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CustomLibraryLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeCustom}"
                                                          ItemTemplate="{StaticResource VideoPlayerMediaPosterCardTemplate}"
                                                          Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"
                                                          KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ButtonEx x:Name="VideoPlayerHomeCustomBrowseCardButton"
                                                      Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CustomLibraryLabel}"
                                                      ContentTemplate="{StaticResource VideoPlayerHomeBrowsePosterCardTemplate}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenCustomLibraryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Show TMDb collections with 2+ owned movies. -->
                                    <StackPanel Margin="0,0,0,28">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeCollections}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Margin="0,0,0,10" Focusable="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CollectionsLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeCollections}"
                                                          ItemTemplate="{StaticResource VideoPlayerCollectionPosterCardTemplate}"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          FocusVisualStyle="{x:Null}"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ButtonEx x:Name="VideoPlayerHomeCollectionsBrowseCardButton"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CollectionsLabel}"
                                                      ContentTemplate="{StaticResource VideoPlayerHomeBrowsePosterCardTemplate}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenCollectionsLibraryCommand}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerLibraryCardStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasMultipleHomeCollections}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                        </StackPanel>
                                    </StackPanel>

                                    </StackPanel>
                                </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Movie detail Hero with controller actions. -->
                            <ScrollViewer x:Name="VideoPlayerMovieDetailRoot"
                                          Grid.Row="2"
                                          Margin="0,-4,0,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalContentAlignment="Bottom"
                                          Focusable="False"
                                          IsTabStop="False"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMovieDetailView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <Grid MinHeight="730" Margin="0,8,0,20" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Keep poster as the main visual anchor. -->
                                    <Border Grid.Column="0"
                                            Width="286" Height="424"
                                            VerticalAlignment="Bottom" Margin="0,0,0,18"
                                            CornerRadius="16"
                                            Background="#36000000"
                                            BorderBrush="#36FFFFFF" BorderThickness="1"
                                            ClipToBounds="True"
                                            Effect="{DynamicResource SoftTextShadow}">
                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailPosterPath}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                MaxWidth="1210"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,18">
                                        <!-- Transparent official logo, with text title fallback. -->
                                        <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailLogoPath}"
                                               MaxWidth="560" MaxHeight="148"
                                               HorizontalAlignment="Left"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Margin="0,0,0,8">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTitle}"
                                                   Foreground="White" FontSize="48" FontWeight="Bold"
                                                   TextWrapping="Wrap" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailLogo}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Year / runtime / genres + provider rating. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailSubtitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="White" FontSize="19" Opacity="0.90"
                                                       VerticalAlignment="Center"/>
                                            <Border Margin="18,0,0,0" Padding="10,4" CornerRadius="10"
                                                    Background="#22000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailRatingText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource FocusGameBorderBrush}"
                                                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailRatingText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Persistent user-state indicators. -->
                                            <Border Width="34" Height="30" Margin="12,0,0,0" CornerRadius="10"
                                                    Background="#28000000" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailIsWatched}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontIcons}"
                                                           Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="17"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="34" Height="30" Margin="8,0,0,0" CornerRadius="10"
                                                    Background="#28000000" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailIsFavorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}"
                                                           Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="17"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Technical media badges. -->
                                        <StackPanel Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailTechnicalBadges}"
                                                          Margin="0" Focusable="False" IsTabStop="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,4" Margin="0,0,8,0"
                                                                CornerRadius="8" Background="#24000000"
                                                                BorderBrush="#2CFFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{Binding}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Foreground="White" FontSize="14" FontWeight="SemiBold" Opacity="0.88"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTagline}"
                                                   Foreground="White" FontSize="18" FontStyle="Italic" Opacity="0.82"
                                                   TextWrapping="Wrap" MaxWidth="1080" Margin="0,14,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTagline}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailOverview}"
                                                   Foreground="White"
                                                   FontSize="18" LineHeight="25" Opacity="0.90" TextWrapping="Wrap"
                                                   MaxWidth="1080" Margin="0,13,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailOverview}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailCredits}"
                                                   Foreground="White"
                                                   FontSize="15" Opacity="0.68" Margin="0,10,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailCredits}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Five explicit actions requested for the movie detail view. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0"
                                                    KeyboardNavigation.TabNavigation="Cycle"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle">
                                            <ButtonEx x:Name="VideoPlayerMovieContinueButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlayMovieDetailCommand}"
                                                      Style="{StaticResource VideoPlayerMoviePrimaryActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE768;" FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailActionLabel}"
                                                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerMovieWatchedButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ToggleMovieDetailWatchedCommand}"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="18" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailIsWatched}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailWatchedActionLabel}"
                                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerMovieFavoriteButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ToggleMovieDetailFavoriteCommand}"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="19" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailIsFavorite}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailFavoriteActionLabel}"
                                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerMovieInfoButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenMovieFileInfoCommand}"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="19" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailFileInfoActionLabel}"
                                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerMovieArtworkButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenArtworkPickerCommand}"
                                                      IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanUseOnlineArtwork}"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE91B;" FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="19" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailArtworkActionLabel}"
                                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ButtonEx>
                                        </StackPanel>

                                        <!-- Resume feedback below Continue. -->
                                        <Grid Margin="2,11,0,0" Width="190" HorizontalAlignment="Left">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailHasProgress}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ProgressBar Grid.Row="0" Height="8"
                                                         Value="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailProgressPercent}"
                                                         Style="{StaticResource VideoPlayerHomeProgressStyle}"/>
                                            <TextBlock Grid.Row="1" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailProgressText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                       FontSize="17" FontWeight="SemiBold" Opacity="0.82" Margin="0,7,0,0"/>
                                        </Grid>

                                        <!-- Cast cards use text only; no portrait downloads. -->
                                        <StackPanel Margin="0,18,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailCast}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailCastCrewLabel}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailCastItems}"
                                                          Focusable="False" IsTabStop="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="166" Height="52" Margin="0,0,14,0" Padding="4,0"
                                                                Background="Transparent" BorderThickness="0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="28" Height="28" CornerRadius="14"
                                                                        Background="#22FFFFFF" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontIcons}"
                                                                               Foreground="White" FontSize="15" Opacity="0.72"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                                           Opacity="0.86" TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Series / Anime detail: seasons and episode grid. -->
                            <ScrollViewer x:Name="VideoPlayerSeriesDetailRoot"
                                          Grid.Row="2"
                                          Margin="0,0,0,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          IsTabStop="False"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsSeriesDetailView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsSeriesSeasonWatchedMenuOpen}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <!-- Anchor series/anime details to bottom; outer ScrollViewer handles overflow. -->
                                <Grid MinHeight="{Binding ActualHeight, ElementName=VideoPlayerSeriesDetailRoot}">
                                    <StackPanel VerticalAlignment="Bottom">
                                        <!-- Series Hero content; backdrop renders outside margins. -->
                                        <Grid MinHeight="370" Margin="0,-6,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="232"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="228" Height="326"
                                                VerticalAlignment="Center"
                                                CornerRadius="12" Background="#50000000"
                                                BorderBrush="#38FFFFFF" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailPosterPath}"
                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="1020" HorizontalAlignment="Left">
                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailLogoPath}"
                                                   MaxWidth="520" MaxHeight="135" HorizontalAlignment="Left"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" Margin="0,0,0,8">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailLogo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTitle}"
                                                       Foreground="White" FontSize="40" FontWeight="Bold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailSubtitle}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                           FontSize="17" Opacity="0.85" VerticalAlignment="Center"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailRatingText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource FocusGameBorderBrush}"
                                                           FontSize="17" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center"/>

                                                <Border Width="32" Height="28" Margin="12,0,0,0" CornerRadius="9"
                                                        Background="#28000000" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailIsWatched}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontIcons}"
                                                               Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Width="32" Height="28" Margin="8,0,0,0" CornerRadius="9"
                                                        Background="#28000000" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailIsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}"
                                                               Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTagline}"
                                                       Foreground="White" FontSize="16" FontStyle="Italic" Opacity="0.78"
                                                       TextWrapping="Wrap" MaxWidth="900" Margin="0,10,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailTagline}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailOverview}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                       FontSize="17" Opacity="0.88" TextWrapping="Wrap"
                                                       MaxWidth="940" Margin="0,11,0,0"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailCredits}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                       FontSize="15" Opacity="0.72" Margin="0,9,0,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
                                                <ButtonEx x:Name="VideoPlayerSeriesContinueButton"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlaySeriesContinueCommand}"
                                                          HorizontalAlignment="Left" MinHeight="50" Padding="19,11">
                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHeroActionButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesContinueItem}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="▶" Margin="0,0,10,0" FontSize="19" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ContinueSeriesLabel}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  •  " Opacity="0.55" FontSize="19" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesContinueEpisodeCode}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ButtonEx>

                                                <ButtonEx x:Name="VideoPlayerSeriesWatchedButton"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ToggleEntireSeriesWatchedCommand}"
                                                          Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                          Margin="12,0,0,0" MinHeight="50" Padding="19,11"
                                                          HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontIcons}"
                                                                   Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailIsWatched}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailWatchedActionLabel}"
                                                                   FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ButtonEx>

                                                <ButtonEx x:Name="VideoPlayerSeriesFavoriteButton"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ToggleSeriesDetailFavoriteCommand}"
                                                          Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                          Margin="12,0,0,0" MinHeight="50" Padding="19,11"
                                                          HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}"
                                                                   Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailIsFavorite}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailFavoriteActionLabel}"
                                                                   FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ButtonEx>

                                                <ButtonEx x:Name="VideoPlayerSeriesArtworkButton"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenArtworkPickerCommand}"
                                                          IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanUseOnlineArtwork}"
                                                          Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                          Margin="12,0,0,0" MinHeight="50" Padding="19,11"
                                                          HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE91B;" FontFamily="{DynamicResource FontIcons}"
                                                                   Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailArtworkActionLabel}"
                                                                   FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ButtonEx>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Cast strip uses the shared metadata model. -->
                                    <StackPanel Margin="251,0,0,24">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesDetailCast}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailCastCrewLabel}"
                                                   Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailCastItems}"
                                                      Focusable="False" IsTabStop="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="162" Height="50" Margin="0,0,14,0" Padding="4,0"
                                                            Background="Transparent" BorderThickness="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="27" Height="27" CornerRadius="14"
                                                                    Background="#20FFFFFF" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontIcons}"
                                                                           Foreground="White" FontSize="14" Opacity="0.70"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                                       Opacity="0.84" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasMultipleSeriesSeasons}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeasonsLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesSeasons}"
                                                      Focusable="False" IsTabStop="False"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx x:Name="VideoPlayerSeriesFirstSeasonButton"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectSeriesSeasonCommand}"
                                                              CommandParameter="{Binding}"
                                                              Width="205" Height="74" Margin="0,0,14,0" Padding="0"
                                                              Foreground="{DynamicResource TextBrush}">
                                                        <ButtonEx.Style>
                                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                                <Setter Property="Background" Value="#16000000"/>
                                                                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                        <Setter Property="Background" Value="#30000000"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ButtonEx.Style>
                                                        <StackPanel Margin="17,9" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="14" Opacity="0.70" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,26,0,26">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.EpisodesLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ScrollViewer x:Name="VideoPlayerSeriesEpisodeScroller"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Focusable="False" IsTabStop="False"
                                                      CanContentScroll="False">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesEpisodes}"
                                                          Focusable="False" IsTabStop="False"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx x:Name="VideoPlayerSeriesFirstEpisodeButton"
                                                                  Width="420" Height="245" Margin="0,0,18,0" Padding="0"
                                                                  Style="{StaticResource VideoPlayerHomeCardButtonStyle}"
                                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlaySeriesEpisodeCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Rectangle RadiusX="17" RadiusY="17">
                                                                    <Rectangle.Fill><ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Rectangle.Fill>
                                                                </Rectangle>
                                                                <Border CornerRadius="17" Background="#20000000"/>
                                                                <Border CornerRadius="17" VerticalAlignment="Bottom" Height="118">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                                            <GradientStop Color="#EE000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                        Margin="0,11,11,0" CornerRadius="15" Background="#C0000000">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="✓" Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Grid VerticalAlignment="Bottom" Margin="15,0,15,13">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="13"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Text="{Binding EpisodeCode}" Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Name}"/>
                                                                    <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent}" Margin="0,7,0,0">
                                                                        <ProgressBar.Style>
                                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource VideoPlayerHomeProgressStyle}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding HasProgress}" Value="True"/>
                                                                                            <Condition Binding="{Binding IsWatched}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ProgressBar.Style>
                                                                    </ProgressBar>
                                                                </Grid>
                                                            </Grid>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.EmptyText}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="18" Opacity="0.72" Margin="0,24,0,0"
                                                   HorizontalAlignment="Center" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesEpisodes}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Movies/TV/Anime library rows are virtualized. -->
                            <ListBox x:Name="VideoPlayerLibraryRoot"
                                     Grid.Row="2"
                                     Margin="0,4,0,0"
                                     ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibraryRows}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     IsTabStop="False"
                                     FocusVisualStyle="{x:Null}"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Item"
                                     VirtualizingPanel.CacheLengthUnit="Item"
                                     VirtualizingPanel.CacheLength="2"
                                     KeyboardNavigation.TabNavigation="Continue"
                                     KeyboardNavigation.DirectionalNavigation="Continue">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical"
                                                                VirtualizingPanel.IsVirtualizing="True"
                                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                                VirtualizingPanel.ScrollUnit="Item"
                                                                VirtualizingPanel.CacheLengthUnit="Item"
                                                                VirtualizingPanel.CacheLength="2"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}"
                                                      ItemTemplate="{StaticResource VideoPlayerMediaPosterCardTemplate}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="2"
                                       Panel.ZIndex="2"
                                       Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.EmptyText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="19"
                                       Opacity="0.72"
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryView}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasBrowserItems}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Browse roots first, then favorite folders. -->
                            <ScrollViewer x:Name="VideoPlayerBrowseHubRoot"
                                          Grid.Row="2"
                                          Margin="0,18,0,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          IsTabStop="False"
                                          FocusVisualStyle="{x:Null}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsBrowseHub}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <StackPanel>
                                    <!-- Media library shortcuts combine roots by category. -->
                                    <StackPanel Margin="0,0,0,34">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibrarySubtitle}"
                                                       Style="{StaticResource VideoPlayerHomeSectionTitleStyle}"
                                                       Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>

                                        <WrapPanel KeyboardNavigation.TabNavigation="Continue"
                                                   KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ButtonEx x:Name="VideoPlayerBrowseMoviesCategoryButton"
                                                      Width="397" Height="110" Margin="0,0,16,16" Padding="0"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseLibraryCategoryCommand}"
                                                      CommandParameter="movies">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasMoviesLibrary}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                                <Grid Margin="20,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MoviesLabel}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource TextDetailAltBrush}" FontSize="30" Opacity="0.58" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerBrowseSeriesCategoryButton"
                                                      Width="397" Height="110" Margin="0,0,16,16" Padding="0"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseLibraryCategoryCommand}"
                                                      CommandParameter="series">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesLibrary}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                                <Grid Margin="20,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesLabel}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource TextDetailAltBrush}" FontSize="30" Opacity="0.58" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerBrowseAnimeCategoryButton"
                                                      Width="397" Height="110" Margin="0,0,16,16" Padding="0"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseLibraryCategoryCommand}"
                                                      CommandParameter="anime">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasAnimeLibrary}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                                <Grid Margin="20,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AnimeLabel}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource TextDetailAltBrush}" FontSize="30" Opacity="0.58" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayerBrowseCustomCategoryButton"
                                                      Width="397" Height="110" Margin="0,0,16,16" Padding="0"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseLibraryCategoryCommand}"
                                                      CommandParameter="custom">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasCustomLibrary}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                                <Grid Margin="20,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontIcons}" FontSize="23" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CustomLibraryLabel}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource TextDetailAltBrush}" FontSize="30" Opacity="0.58" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ButtonEx>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Configured Video Center folders open their exact roots. -->
                                    <StackPanel Margin="0,0,0,40">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ConfiguredLibrariesLabel}"
                                                       Style="{StaticResource VideoPlayerHomeSectionTitleStyle}"
                                                       Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ConfiguredLibraryShortcuts}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx x:Name="VideoPlayerBrowseLibraryButton"
                                                              Width="397"
                                                              Height="126"
                                                              Margin="0,0,16,16"
                                                              Padding="20,0"
                                                              Style="{StaticResource VideoPlayerHomeCardButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenConfiguredLibraryCommand}"
                                                              CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="48"
                                                                    Height="48"
                                                                    CornerRadius="12"
                                                                    Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8B7;"
                                                                           FontFamily="{DynamicResource FontIcons}"
                                                                           FontSize="24"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding CategoryLabel}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="{DynamicResource FocusGameBorderBrush}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="21"
                                                                           FontWeight="SemiBold"
                                                                           Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PathDisplay}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="13"
                                                                           Opacity="0.68"
                                                                           Margin="0,4,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="›"
                                                                       Foreground="{DynamicResource TextDetailAltBrush}"
                                                                       FontSize="30"
                                                                       Opacity="0.58"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="64"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="18,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasConfiguredLibraryShortcuts}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.NoConfiguredLibrariesText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16"
                                                       Opacity="0.85"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Favorite folders -->
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.FavoriteFoldersLabel}"
                                                       Style="{StaticResource VideoPlayerHomeSectionTitleStyle}"
                                                       Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.FavoriteFolders}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx x:Name="VideoPlayerBrowseFavoriteButton"
                                                              Width="397"
                                                              Height="150"
                                                              Margin="0,0,16,16"
                                                              Padding="0"
                                                              Style="{StaticResource VideoPlayerHomeCardButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenItemCommand}"
                                                              CommandParameter="{Binding}">
                                                        <Grid>
                                                            <!-- Use explicit local artwork only; never generated. -->
                                                            <Rectangle RadiusX="17" RadiusY="17">
                                                                <Rectangle.Fill>
                                                                    <ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                                </Rectangle.Fill>
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                            <Border CornerRadius="17">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#09000000" Offset="0"/>
                                                                        <GradientStop Color="#1E000000" Offset="0.48"/>
                                                                        <GradientStop Color="#E8000000" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="White"
                                                                           FontSize="21"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SecondaryText}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Foreground="White"
                                                                           FontSize="13"
                                                                           Opacity="0.8"
                                                                           Margin="0,4,0,0"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Folder card fallback artwork. -->
                                                            <Grid Margin="20">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="48"
                                                                        Height="48"
                                                                        CornerRadius="12"
                                                                        Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                                                        BorderThickness="1"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE8B7;"
                                                                               FontFamily="{DynamicResource FontIcons}"
                                                                               FontSize="24"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="21"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding SecondaryText}"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="15"
                                                                               Opacity="0.85"
                                                                               Margin="0,3,0,0"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="›"
                                                                           Foreground="{DynamicResource TextDetailAltBrush}"
                                                                           FontSize="30"
                                                                           Opacity="0.58"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Grid>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="64"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="18,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasFavoriteFolders}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.FavoriteEmptyText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16"
                                                       Opacity="0.85"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Explorer -->
                            <Border x:Name="VideoPlayerExplorerRoot"
                                    Grid.Row="2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsBrowseHub}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryView}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsSeriesDetailView}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMovieDetailView}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="450"/>
                                    </Grid.ColumnDefinitions>

                                    <ListBox x:Name="VideoPlayerList"
                                             Grid.Column="0"
                                             ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.Items}"
                                             ItemContainerStyle="{StaticResource VideoPlayerListBoxItemStyle}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             KeyboardNavigation.DirectionalNavigation="Continue">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <ButtonEx Style="{StaticResource VideoPlayerItemButtonStyle}"
                                                          IsEnabled="{Binding IsActionable}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenItemCommand}"
                                                          CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Height" Value="58"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                        <Setter Property="Height" Value="64"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="84"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="74"
                                                                Height="40"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeLabel}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="21"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding SecondaryText}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="15"
                                                                           Opacity="0.85"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding ProgressText}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="14"
                                                                           Opacity="0.85"
                                                                           Margin="18,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>

                                                            <ProgressBar Value="{Binding ProgressPercent}"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Height="4"
                                                                         Margin="0,7,0,0"
                                                                         Background="{DynamicResource SeparatorBrush}"
                                                                         Foreground="{DynamicResource FocusGameBorderBrush}"
                                                                         BorderThickness="0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ProgressBar">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                                                                                        <Grid x:Name="PART_Track">
                                                                                            <Border x:Name="PART_Indicator"
                                                                                                    HorizontalAlignment="Left"
                                                                                                    Background="{TemplateBinding Foreground}"
                                                                                                    CornerRadius="2"/>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="3"
                                                                   Text="&#xEB51;"
                                                                   FontFamily="{DynamicResource FontIcons}"
                                                                   Foreground="{DynamicResource FocusGameBorderBrush}"
                                                                   FontSize="19"
                                                                   Margin="16,0,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="✓"
                                                                   Foreground="{DynamicResource FocusGameBorderBrush}"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Margin="16,0,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>


                                                        <TextBlock Grid.Column="4"
                                                                   Text="›"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="30"
                                                                   Opacity="0.48"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,4,0"/>
                                                    </Grid>
                                                </ButtonEx>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- FFmpeg thumbnail only for the selected video. -->
                                    <Border Grid.Column="1"
                                            Margin="26,0,0,0"
                                            Padding="18"
                                            Background="#12000000"
                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ExplorerPreviewItem}">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasExplorerPreviewItem}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="76" Height="76" CornerRadius="18" Background="{DynamicResource ButtonBackgroundNoFocus}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                                    <TextBlock Text="&#xE768;" FontFamily="{DynamicResource FontIcons}" FontSize="30" Foreground="{DynamicResource TextBrush}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ExplorerPreviewEmptyText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="16"
                                                           Opacity="0.72"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="300"
                                                           Margin="0,16,0,0"/>
                                            </StackPanel>

                                            <Grid DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ExplorerPreviewItem}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasExplorerPreviewItem}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <!-- Landscape artwork / FFmpeg thumbnail -->
                                                    <Rectangle Width="410"
                                                               Height="231"
                                                               RadiusX="17"
                                                               RadiusY="17"
                                                               Stroke="{DynamicResource SeparatorBrush}"
                                                               StrokeThickness="1"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                        </Rectangle.Fill>
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLandscapeArtwork}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <!-- Portrait poster/cover in Explorer. -->
                                                    <Rectangle Width="350"
                                                               Height="525"
                                                               RadiusX="17"
                                                               RadiusY="17"
                                                               Stroke="{DynamicResource SeparatorBrush}"
                                                               StrokeThickness="1"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                        </Rectangle.Fill>
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPortraitArtwork}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <Border Width="410"
                                                            Height="231"
                                                            CornerRadius="17"
                                                            Background="{DynamicResource ButtonBackgroundNoFocus}"
                                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="&#xE768;"
                                                                   FontFamily="{DynamicResource FontIcons}"
                                                                   FontSize="38"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Opacity="0.72"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="2,12,2,0"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,8,2,0">
                                                    <TextBlock Text="{Binding DurationText}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="21" Opacity="0.82"/>
                                                    <TextBlock Text="  •  " Foreground="{DynamicResource TextBrush}" FontSize="19" Opacity="0.45">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DurationText}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SecondaryText}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="19" Opacity="0.82"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding QualityText}"
                                                           Foreground="{DynamicResource FocusGameBorderBrush}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.92"
                                                           Margin="2,7,2,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasQuality}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Row="4" Text="{Binding ProgressText}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="17"
                                                           Opacity="0.82"
                                                           Margin="2,10,2,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ProgressBar Grid.Row="5" Value="{Binding ProgressPercent}" Margin="2,7,2,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource VideoPlayerHomeProgressStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <!-- Mouse fallback; controller uses LS/L3. -->
                                                <ButtonEx Grid.Row="6"
                                                          Width="220"
                                                          Height="44"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,18,0,6"
                                                          Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                          Padding="18,0"
                                                          Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailArtworkActionLabel}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenArtworkPickerCommand}"
                                                          IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanUseOnlineArtwork}"
                                                          Focusable="False"
                                                          IsTabStop="False"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="0" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.EmptyText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="22"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.Items.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Dedicated Video Center controller footer. -->
                            <Border Grid.Row="4"
                                    Margin="-96,0,-96,0"
                                    Background="#52000000"
                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0"
                                    IsHitTestVisible="False"
                                    Focusable="False"/>

                            <!-- Home controller prompts -->
                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Effect="{DynamicResource SoftTextShadow}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="Dpad" Content="{DynamicResource LOCButtonPrompt_Navigate}"/>
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="A" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLabel}"/>
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="X" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLabel}"/>
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="Y" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SearchLabel}"/>
                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="B" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"/>
