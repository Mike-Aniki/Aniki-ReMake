<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style x:Key="VideoPlayerWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="1920" Height="1080" Background="Transparent">

                        <Grid.Resources>
                            <Style x:Key="VideoPlayerItemButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="14"
                                                    Padding="18,8">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerControlButtonStyle" TargetType="ButtonEx">
                                <Setter Property="MinWidth" Value="150"/>
                                <Setter Property="Height" Value="52"/>
                                <Setter Property="Margin" Value="6,4"/>
                                <Setter Property="Padding" Value="20,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource StaticBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="ControlBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="16"/>
                                                <Border x:Name="ControlFocusBackground"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        CornerRadius="16"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="ControlFocusBorder"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="16"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="ControlFlash"
                                                        CornerRadius="16"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  TextElement.FontFamily="{DynamicResource FontMain}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="ControlFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ControlFocusBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ControlFlash" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ControlFlash" Property="Tag" Value="True"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ControlFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ControlFocusBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- V2 player HUD: full-width minimal controls. -->
                            <Style x:Key="VideoPlayerHudButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Width" Value="116"/>
                                <Setter Property="Height" Value="76"/>
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="HudFocusBackground"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="HudFocusBorder"
                                                        CornerRadius="18"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="2"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="HudFlash"
                                                        CornerRadius="18"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="HudFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="HudFocusBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="HudFlash" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="HudFlash" Property="Tag" Value="True"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HudFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="HudFocusBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.76"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.30"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Compact round control for Previous / Next / Volume +/- -->
                            <Style x:Key="VideoPlayerHudIconButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Width" Value="62"/>
                                <Setter Property="Height" Value="62"/>
                                <Setter Property="Margin" Value="5,0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid>
                                                <Ellipse x:Name="IconHover"
                                                         Width="56"
                                                         Height="56"
                                                         Fill="#16000000"
                                                         Stroke="#28FFFFFF"
                                                         StrokeThickness="1"
                                                         Visibility="Collapsed"/>
                                                <Ellipse x:Name="IconFocus"
                                                         Width="56"
                                                         Height="56"
                                                         Fill="{DynamicResource ButtonBackgroundFocus}"
                                                         Stroke="{DynamicResource FocusGameBorderBrush}"
                                                         StrokeThickness="2"
                                                         Visibility="Collapsed"/>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="IconFocus" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IconHover" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.25"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerPlayButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Width" Value="92"/>
                                <Setter Property="Height" Value="92"/>
                                <Setter Property="Margin" Value="18,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid>
                                                <Ellipse x:Name="PlayCircle"
                                                         Width="82"
                                                         Height="82"
                                                         Fill="#25000000"
                                                         Stroke="#82FFFFFF"
                                                         StrokeThickness="1.3"/>
                                                <Ellipse x:Name="PlayFocusCircle"
                                                         Width="84"
                                                         Height="84"
                                                         Fill="{DynamicResource ButtonBackgroundFocus}"
                                                         Stroke="{DynamicResource FocusGameBorderBrush}"
                                                         StrokeThickness="2.4"
                                                         Visibility="Collapsed"/>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="PlayFocusCircle" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PlayFocusCircle" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Shared More / Audio / Subtitles / Chapters row. -->
                            <Style x:Key="VideoPlayerOptionButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="62"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="Background" Value="#0BFFFFFF"/>
                                <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="OptionBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="13"/>
                                                <Border x:Name="OptionFocusBackground"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        CornerRadius="13"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="OptionFocusBorder"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="13"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="OptionFlash"
                                                        CornerRadius="13"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="OptionFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="OptionFocusBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="OptionFlash" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="OptionFlash" Property="Tag" Value="True"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="OptionFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="OptionFocusBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.76"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.34"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerTimelineSliderStyle" TargetType="Slider">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track"
                                                       Orientation="Horizontal"
                                                       Margin="0">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                                      Focusable="False"
                                                                      IsTabStop="False">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate TargetType="RepeatButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="14" Height="14">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Ellipse Width="14"
                                                                             Height="14"
                                                                             Fill="{DynamicResource TextBrush}"
                                                                             Stroke="{DynamicResource FocusGameBorderBrush}"
                                                                             StrokeThickness="1.5"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                                      Focusable="False"
                                                                      IsTabStop="False">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate TargetType="RepeatButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerHomeCardButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Padding" Value="20"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="CardBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="18"
                                                        Opacity="0.55"/>
                                                <Border x:Name="CardFocusBackground"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                        CornerRadius="18"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="CardFocusBorder"
                                                        Panel.ZIndex="20"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="18"
                                                        Visibility="Collapsed"/>
                                                <Border x:Name="CardFlash"
                                                        Panel.ZIndex="21"
                                                        CornerRadius="18"
                                                        Style="{DynamicResource AnimatedFlashMenu}"
                                                        Tag="False"
                                                        Visibility="Collapsed"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="CardFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CardFocusBorder" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CardFlash" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CardFlash" Property="Tag" Value="True"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardFocusBackground" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CardFocusBorder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerHomeHeroButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                <Setter Property="Height" Value="166"/>
                                <Setter Property="Padding" Value="26"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>

                            <!-- Only Resume/Browse receive Hero focus. -->
                            <Style x:Key="VideoPlayerHeroActionButtonStyle" TargetType="ButtonEx">
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="MinWidth" Value="118"/>
                                <Setter Property="Padding" Value="20,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ButtonEx">
                                            <Grid>
                                                <Border x:Name="HeroActionBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="15"/>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="HeroActionBackground" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    <Setter TargetName="HeroActionBackground" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeroActionBackground" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    <Setter TargetName="HeroActionBackground" Property="Background" Value="{DynamicResource ButtonBackgroundFocus}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Movie detail buttons sized for TV. -->
                            <Style x:Key="VideoPlayerMovieActionButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHeroActionButtonStyle}">
                                <Setter Property="Height" Value="58"/>
                                <Setter Property="MinWidth" Value="184"/>
                                <Setter Property="Padding" Value="18,0"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Background" Value="#12000000"/>
                                <Setter Property="BorderBrush" Value="#28FFFFFF"/>
                            </Style>

                            <Style x:Key="VideoPlayerMoviePrimaryActionButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerMovieActionButtonStyle}">
                                <Setter Property="MinWidth" Value="190"/>
                                <Setter Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                            </Style>

                            <Style x:Key="VideoPlayerTopNavButtonStyle" TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="MinWidth" Value="112"/>
                                <Setter Property="Padding" Value="18,0"/>
                                <Setter Property="Margin" Value="8,0,0,0"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="VideoPlayerLibraryCardStyle" TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                <Setter Property="Width" Value="230"/>
                                <Setter Property="Height" Value="402"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,16,20"/>
                            </Style>

                            <DataTemplate x:Key="VideoPlayerMediaPosterCardTemplate">
                                <ButtonEx x:Name="VideoPlayerLibraryCardButton"
                                          Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenItemCommand}"
                                          CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="325"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Margin="10,10,10,0"
                                                CornerRadius="14"
                                                Background="#52000000"
                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailPath}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Height" Value="313"/>
                                                            <Setter Property="Stretch" Value="Uniform"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPortraitArtwork}" Value="False">
                                                                    <Setter Property="Height" Value="117"/>
                                                                    <Setter Property="Stretch" Value="UniformToFill"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="38"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Opacity="0.55"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="16" Background="#C0000000">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="✓" Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,10,14,12">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SecondaryText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       Opacity="0.62"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </ButtonEx>
                            </DataTemplate>

                            <DataTemplate x:Key="VideoPlayerCollectionPosterCardTemplate">
                                <ButtonEx x:Name="VideoPlayerHomeCollectionButton"
                                          Style="{StaticResource VideoPlayerLibraryCardStyle}"
                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenMovieCollectionCommand}"
                                          CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="325"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Margin="10,10,10,0"
                                                CornerRadius="14"
                                                Background="#52000000"
                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailPath}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Height" Value="313"/>
                                                            <Setter Property="Stretch" Value="Uniform"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPortraitArtwork}" Value="False">
                                                                    <Setter Property="Height" Value="117"/>
                                                                    <Setter Property="Stretch" Value="UniformToFill"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="38"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Opacity="0.55"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="16" Background="#C0000000">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="✓" Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,10,14,12">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SecondaryText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       Opacity="0.62"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </ButtonEx>
                            </DataTemplate>


                            <!-- Last Home card opens the full library. -->
                            <DataTemplate x:Key="VideoPlayerHomeBrowsePosterCardTemplate">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="325"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Margin="10,10,10,0"
                                            CornerRadius="14"
                                            Background="#42000000"
                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="44"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Opacity="0.78"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLabel}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,14,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="14,10,14,12">
                                        <TextBlock Text="{Binding}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLabel}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   Opacity="0.62"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <Style x:Key="VideoPlayerHomeSectionTitleStyle" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontSize" Value="22"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>

                            <Style x:Key="VideoPlayerHomeProgressStyle" TargetType="ProgressBar">
                                <Setter Property="Height" Value="6"/>
                                <Setter Property="Minimum" Value="0"/>
                                <Setter Property="Maximum" Value="100"/>
                                <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FocusGameBorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                                <Grid x:Name="PART_Track">
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}"
                                                            CornerRadius="3"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="VideoPlayerListBoxItemStyle" TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="IsSelected" Value="True"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>

                        <!-- Video Center uses SecondaryViewBackground. -->
                        <Border Background="{DynamicResource SecondaryViewBackground}"
                                IsHitTestVisible="False"
                                Focusable="False"/>

                        <!-- Light theme-dark veil for depth. -->
                        <Border x:Name="VideoPlayerThemeDim"
                                Opacity="0.22"
                                IsHitTestVisible="False"
                                Focusable="False">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                            </Border.Background>
                        </Border>

                        <!-- Home fanart stays fixed behind scrolling content. -->
                        <Grid x:Name="VideoPlayerHomeBackdrop"
                              Visibility="Collapsed"
                              DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroItem}"
                              IsHitTestVisible="False"
                              Focusable="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeHeroItem}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Use full-window aspect for Hero fanart. -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding ThumbnailPath}"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center"
                                                AlignmentY="Center"/>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#F4FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8FFFFFF" Offset="0.18"/>
                                        <GradientStop Color="#A8FFFFFF" Offset="0.34"/>
                                        <GradientStop Color="#48FFFFFF" Offset="0.48"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.60"/>
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>

                            <!-- Readability veil behind Hero text. -->
                            <Border>
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#B8FFFFFF" Offset="0"/>
                                        <GradientStop Color="#78FFFFFF" Offset="0.36"/>
                                        <GradientStop Color="#30FFFFFF" Offset="0.70"/>
                                        <GradientStop Color="#16FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <!-- Final vertical blend into the normal Video Center surface. -->
                            <Border Background="{DynamicResource SecondaryViewBackground}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0.18"/>
                                        <GradientStop Color="#24FFFFFF" Offset="0.32"/>
                                        <GradientStop Color="#A8FFFFFF" Offset="0.46"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.62"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <!-- Series/anime backdrop sits outside content margins. -->
                        <Grid x:Name="VideoPlayerSeriesBackdrop"
                              IsHitTestVisible="False"
                              Focusable="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMediaDetailView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- PluginSettings on FrameworkElement avoids the Freezable binding crash. -->
                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesDetailBackdropPath}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   SnapsToDevicePixels="True">
                                <Image.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#F4FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8FFFFFF" Offset="0.22"/>
                                        <GradientStop Color="#A8FFFFFF" Offset="0.40"/>
                                        <GradientStop Color="#48FFFFFF" Offset="0.56"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                    </LinearGradientBrush>
                                </Image.OpacityMask>
                            </Image>

                            <Border>
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                        <GradientStop Color="#76FFFFFF" Offset="0.34"/>
                                        <GradientStop Color="#28FFFFFF" Offset="0.72"/>
                                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <Border Background="{DynamicResource SecondaryViewBackground}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0.20"/>
                                        <GradientStop Color="#18FFFFFF" Offset="0.34"/>
                                        <GradientStop Color="#B8FFFFFF" Offset="0.50"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.62"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <!-- Browser / Home -->
                        <Grid x:Name="VideoPlayerBrowserRoot" Margin="96,36,96,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsPlaybackOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkPickerOpen}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMovieFileInfoOpen}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryToolsOpen}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibrarySearchOpen}" Value="True">
                                            <!-- Disable Home focus while Search is open. -->
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
                                            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                                            <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibrarySortOpen}" Value="True">
                                            <!-- Disable library keyboard navigation while the sort modal is open. -->
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
                                            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                                            <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="64"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <!-- Compact media-center header on Home. -->
                                <Grid x:Name="VideoPlayerHomeHeader" Visibility="Collapsed">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{ThemeFile 'Images/Aniki.png'}" Width="46" Height="46" Stretch="Uniform" Margin="0,0,14,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.Title}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="27"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeSubtitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="14"
                                                       Opacity="0.72"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>


                                </Grid>

                                <!-- Dedicated Movies / TV Shows / Anime library header. -->
                                <Grid x:Name="VideoPlayerLibraryHeader">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryView}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CurrentLocationTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="36"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibrarySubtitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="16"
                                                   Opacity="0.72"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ButtonEx Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeLabel}"
                                                  Style="{StaticResource VideoPlayerTopNavButtonStyle}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenHomeCommand}"/>
                                        <ButtonEx Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MoviesLabel}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenMoviesLibraryCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerTopNavButtonStyle}">
                                                    <Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasMoviesLibrary}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <ButtonEx Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeriesLabel}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenSeriesLibraryCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerTopNavButtonStyle}">
                                                    <Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasSeriesLibrary}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <ButtonEx Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AnimeLabel}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenAnimeLibraryCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerTopNavButtonStyle}">
                                                    <Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasAnimeLibrary}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <ButtonEx Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CustomLibraryLabel}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenCustomLibraryCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerTopNavButtonStyle}">
                                                    <Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasCustomLibrary}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <ButtonEx x:Name="VideoPlayerLibrarySortButton"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibrarySortButtonText}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLibrarySortCommand}">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerTopNavButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanSortLibraryView}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <ButtonEx x:Name="VideoPlayerTopBrowseButton"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLabel}"
                                                  Style="{StaticResource VideoPlayerTopNavButtonStyle}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseHubCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Dedicated Browse hub header. -->
                                <StackPanel x:Name="VideoPlayerBrowseHubHeader" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsBrowseHub}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLibrariesLabel}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="38"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseHubSubtitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="18"
                                               Opacity="0.85"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Explorer header while browsing real folders. -->
                                <Grid x:Name="VideoPlayerExplorerHeader">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="False"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsBrowseHub}" Value="False"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryView}" Value="False"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsSeriesDetailView}" Value="False"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMovieDetailView}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.Title}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="38" FontWeight="Bold"/>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowserSubtitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="18" Opacity="0.85" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="820" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}" Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="19" VerticalAlignment="Center" Margin="0,0,9,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsCurrentFolderFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CurrentLocationTitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CurrentPathDisplay}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="16" Opacity="0.85" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Home: fixed premium backdrop + explicit controller navigation. -->
                            <ScrollViewer x:Name="VideoPlayerHomeRoot"
                                          Grid.Row="0"
                                          Grid.RowSpan="4"
                                          Margin="-96,-36,-96,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          IsTabStop="False"
                                          FocusVisualStyle="{x:Null}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsHome}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <Grid>
                                    <!-- Scrolling Home fanart extends past the Hero. -->
                                    <Grid Height="880"
                                          VerticalAlignment="Top"
                                          ClipToBounds="True"
                                          DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroItem}"
                                          IsHitTestVisible="False"
                                          Focusable="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeHeroItem}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <!-- Fade the full scrolling backdrop to avoid a Hero seam. -->
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                <GradientStop Color="#FFFFFFFF" Offset="0.42"/>
                                                <GradientStop Color="#E8FFFFFF" Offset="0.50"/>
                                                <GradientStop Color="#A0FFFFFF" Offset="0.60"/>
                                                <GradientStop Color="#48FFFFFF" Offset="0.70"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.82"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>

                                        <!-- Full-window 16:9 crop with one-layer fade. -->
                                        <Image Source="{Binding ThumbnailPath}"
                                               Height="1080"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Stretch"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Border>
                                            <Border.Background>
                                                <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                            </Border.Background>
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#B8FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#78FFFFFF" Offset="0.36"/>
                                                    <GradientStop Color="#30FFFFFF" Offset="0.70"/>
                                                    <GradientStop Color="#16FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>

                                    </Grid>

                                    <StackPanel>
                                    <!-- Home intro scrolls as one block. -->
                                    <Grid Height="478"
                                          DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroItem}">

                                        <!-- 96px content margins inside the scroller. -->
                                        <Grid Margin="96,36,96,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid x:Name="VideoPlayerHomeScrollingHeader" Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{ThemeFile 'Images/Aniki.png'}" Width="46" Height="46" Stretch="Uniform" Margin="0,0,14,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.Title}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="27"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeSubtitle}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="14"
                                                                   Opacity="0.72"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Premium Home Hero foreground. -->
                                            <Grid Grid.Row="2"
                                                  Height="360"
                                                  Margin="0,0,0,22"
                                                  DataContext="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroItem}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Hero info is not focusable; only Resume/Open is. -->
                                        <Grid Grid.Column="0"
                                              Margin="34,0,30,30">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeHeroItem}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <StackPanel Width="760"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroSectionLabel}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource FocusGameBorderBrush}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"/>

                                                <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroLogoPath}"
                                                       MaxWidth="500" MaxHeight="118" HorizontalAlignment="Left"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                                                       Margin="0,8,0,2">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeHeroLogo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroTitle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="40"
                                                           FontWeight="Bold"
                                                           Margin="0,7,0,0"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasHomeHeroLogo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeHeroMetadata}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.86"
                                                           MaxWidth="720"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,8,0,0"/>

                                                <ProgressBar Value="{Binding ProgressPercent}"
                                                             Width="520"
                                                             HorizontalAlignment="Left"
                                                             Margin="0,18,0,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource VideoPlayerHomeProgressStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="17"
                                                               Opacity="0.86"
                                                               VerticalAlignment="Center"/>

                                                    <ButtonEx x:Name="VideoPlayerContinueButton"
                                                              Margin="20,0,0,0"
                                                              Height="50"
                                                              MinWidth="132"
                                                              Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlayHomeHeroCommand}">
                                                        <Grid>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ResumeLabel}"
                                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ButtonEx}, Path=Foreground}"
                                                                       FontSize="17"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLabel}"
                                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ButtonEx}, Path=Foreground}"
                                                                       FontSize="17"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </ButtonEx>

                                                    <ButtonEx x:Name="VideoPlayerHomeHeroDetailsButton"
                                                              Margin="12,0,0,0"
                                                              Height="50"
                                                              MinWidth="132"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenHomeHeroDetailsCommand}">
                                                        <ButtonEx.Style>
                                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHeroActionButtonStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanOpenHomeHeroDetails}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ButtonEx.Style>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.DetailsLabel}"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ButtonEx}, Path=Foreground}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"/>
                                                    </ButtonEx>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Browse uses a compact focus action. -->
                                        <Border Grid.Column="2"
                                                Height="230"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,30"
                                                Padding="26"
                                                CornerRadius="20"
                                                BorderBrush="#30FFFFFF"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Mid}" Opacity="0.71"/>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel>
                                                    <Border Width="50"
                                                            Height="50"
                                                            CornerRadius="15"
                                                            Background="#24000000"
                                                            BorderBrush="#38FFFFFF"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="&#xE8B7;"
                                                                   FontFamily="{DynamicResource FontIcons}"
                                                                   FontSize="25"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeMediaLibraryLabel}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="27"
                                                               FontWeight="Bold"
                                                               Margin="0,13,0,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HomeMediaLibrarySubtitle}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="15"
                                                               Opacity="0.86"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <ButtonEx x:Name="VideoPlayerHomeSearchButton"
                                                              HorizontalAlignment="Left"
                                                              Height="50"
                                                              MinWidth="98"
                                                              FontSize="15"
                                                              Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                              FontFamily="{DynamicResource FontMain}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLibrarySearchCommand}"
                                                              Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SearchLabel}"/>
                                                    <ButtonEx x:Name="VideoPlayerHomeBrowseButton"
                                                              Margin="12,0,0,0"
                                                              HorizontalAlignment="Left"
                                                              Height="50"
                                                              MinWidth="98"
                                                              FontSize="15"
                                                              Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                              FontFamily="{DynamicResource FontMain}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenBrowseHubCommand}"
                                                              Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BrowseLabel}"/>
                                                    <ButtonEx x:Name="VideoPlayerHomeFileExplorerButton"
                                                              Margin="12,0,0,0"
                                                              Height="50"
                                                              MinWidth="128"
                                                              FontSize="15"
                                                              Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                              FontFamily="{DynamicResource FontMain}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenExplorerCommand}"
                                                              Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.FileExplorerLabel}"/>
                                                    <ButtonEx x:Name="VideoPlayerHomeLibraryToolsButton"
                                                              Margin="12,0,0,0"
                                                              Height="50"
                                                              MinWidth="128"
                                                              FontSize="15"
                                                              Style="{StaticResource VideoPlayerHeroActionButtonStyle}"
                                                              FontFamily="{DynamicResource FontMain}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLibraryToolsCommand}"
                                                              Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibraryToolsLabel}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- Every Home rail keeps the original content margins. -->
                                    <StackPanel Margin="96,-28,96,0">
                                    <!-- Pull Home rails up to clear the fixed footer. -->
                                    <!-- Continue Watching: videos with a real saved resume position. -->
                                    <StackPanel Margin="0,0,0,30">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasContinueWatchingVideos}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ContinueWatchingLabel}"
                                                       Style="{StaticResource VideoPlayerHomeSectionTitleStyle}"
                                                       Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ContinueWatchingVideos}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx x:Name="VideoPlayerContinueRowButton"
                                                              Width="414"
                                                              Height="230"
                                                              Margin="0,0,18,0"
                                                              Padding="0"
                                                              Style="{StaticResource VideoPlayerHomeCardButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenItemCommand}"
                                                              CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Rectangle RadiusX="17" RadiusY="17">
                                                                <Rectangle.Fill>
                                                                    <ImageBrush ImageSource="{Binding ThumbnailPath}"
                                                                                Stretch="UniformToFill"
                                                                                AlignmentX="Center"
                                                                                AlignmentY="Center"/>
                                                                </Rectangle.Fill>
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                            <Border CornerRadius="17" Background="{DynamicResource ButtonBackgroundNoFocus}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Border CornerRadius="17" Background="#36000000"/>
                                                            <Border CornerRadius="17" VerticalAlignment="Bottom" Height="112">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                                        <GradientStop Color="#EA000000" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Bottom" Margin="17,0,17,16">
                                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="White" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="White" FontSize="13" Opacity="0.80" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                                <ProgressBar Value="{Binding ProgressPercent}" Margin="0,8,0,0" Style="{StaticResource VideoPlayerHomeProgressStyle}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Recently Played: four large cards. -->
                                    <StackPanel Margin="0,0,0,30">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasRecentVideos}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2" Background="{DynamicResource FocusGameBorderBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.RecentVideosLabel}" Style="{StaticResource VideoPlayerHomeSectionTitleStyle}" Margin="0"/>
                                            <Border Grid.Column="4" Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.RecentVideos}"
                                                      Focusable="False"
                                                      IsTabStop="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      KeyboardNavigation.TabNavigation="Continue"
                                                      KeyboardNavigation.DirectionalNavigation="Continue">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx x:Name="VideoPlayerRecentButton"
                                                              Width="414"
                                                              Height="230"
                                                              Margin="0,0,18,0"
                                                              Padding="0"
                                                              Style="{StaticResource VideoPlayerHomeCardButtonStyle}"
                                                              Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenItemCommand}"
                                                              CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Rectangle RadiusX="17" RadiusY="17">
                                                                <Rectangle.Fill>
                                                                    <ImageBrush ImageSource="{Binding ThumbnailPath}"
                                                                                Stretch="UniformToFill"
                                                                                AlignmentX="Center"
                                                                                AlignmentY="Center"/>
                                                                </Rectangle.Fill>
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
