                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ScanMissingThumbnailsLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ScanMissingThumbnailsHelp}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="13" Opacity="0.62" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ButtonEx>
                                            <ButtonEx x:Name="VideoPlayerLibraryToolsArtworkButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ScanMissingArtworkFromFullscreenCommand}"
                                                      IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanStartLibraryToolsAction}"
                                                      HorizontalContentAlignment="Left"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}" Height="78" MinWidth="520" Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEB9F;" FontFamily="{DynamicResource FontIcons}" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ScanMissingArtworkLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ScanMissingArtworkHelp}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="13" Opacity="0.62" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ButtonEx>
                                            <ButtonEx x:Name="VideoPlayerLibraryToolsRefreshButton"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.RefreshLibrariesFromFullscreenCommand}"
                                                      IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanStartLibraryToolsAction}"
                                                      HorizontalContentAlignment="Left"
                                                      Style="{StaticResource VideoPlayerMovieActionButtonStyle}" Height="78" MinWidth="520">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource FontIcons}" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.RefreshLibrariesLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.RefreshLibrariesHelp}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="13" Opacity="0.62" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ButtonEx>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="20" Background="#18000000" BorderBrush="#2CFFFFFF" BorderThickness="1" Padding="30">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibraryToolsStatus}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" Foreground="White" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibraryToolsDetail}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" Foreground="White" FontSize="16" Opacity="0.74" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                                <ProgressBar Value="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.LibraryToolsProgressPercent}"
                                                             Height="10" Margin="0,26,0,0" Style="{StaticResource VideoPlayerHomeProgressStyle}"/>
                                                <ButtonEx x:Name="VideoPlayerLibraryToolsCancelButton"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CancelLibraryToolsScanCommand}"
                                                          Margin="0,24,0,0"
                                                          HorizontalAlignment="Left" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CancelScanLabel}">
                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsLibraryToolsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="Dpad" Content="{DynamicResource LOCButtonPrompt_Navigate}"/>
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="A" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLabel}"/>
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="B" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Artwork manager workspace over the active Hero. -->
                        <Grid x:Name="VideoPlayerArtworkModalRoot"
                              Panel.ZIndex="100"
                              Background="Transparent"
                              FocusManager.IsFocusScope="True"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.ControlTabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkPickerOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Background="#A8000000" IsHitTestVisible="False"/>

                            <Border Width="1710"
                                    Height="890"
                                    Padding="34,28,34,20"
                                    CornerRadius="28"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    KeyboardNavigation.TabNavigation="Cycle"
                                    KeyboardNavigation.ControlTabNavigation="Cycle"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkManagerTitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="36" FontWeight="SemiBold"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerStatusText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16" Opacity="0.72"
                                                       Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="1120"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="16,8" CornerRadius="14"
                                                Background="#16000000" BorderBrush="#34FFFFFF" BorderThickness="1"
                                                VerticalAlignment="Top" Margin="24,2,0,0">
                                            <TextBlock Text="TMDb  •  TVMaze  •  AniList"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13" Opacity="0.66"/>
                                        </Border>
                                    </Grid>

                                    <!-- Artwork controls hidden during movie matching. -->
                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkMatchMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerAssociationText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkAssociationLabel}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="13" Opacity="0.50" Margin="10,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerIsMovie}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ButtonEx x:Name="VideoPlayerArtworkChangeMatchButton"
                                                          Height="46" MinWidth="154" Margin="0,0,10,0" Padding="17,0"
                                                          Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkChangeMatchLabel}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ChangeArtworkMatchCommand}">
                                                    <ButtonEx.Style>
                                                        <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerIsMovie}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>

                                                <ButtonEx x:Name="VideoPlayerArtworkResetButton"
                                                          Height="46" MinWidth="190" Margin="0,0,10,0" Padding="17,0"
                                                          Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkResetAutomaticLabel}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ResetArtworkToAutomaticCommand}"
                                                          IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanResetArtworkToAutomatic}"
                                                          Style="{StaticResource VideoPlayerControlButtonStyle}"/>

                                                <ButtonEx x:Name="VideoPlayerArtworkLocalButton"
                                                          Height="46" MinWidth="178" Padding="17,0"
                                                          Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkChooseLocalLabel}"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ChooseLocalArtworkCommand}"
                                                          Style="{StaticResource VideoPlayerControlButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                                            <ButtonEx x:Name="VideoPlayerArtworkTargetCoverButton"
                                                      Width="188" Height="50" Margin="0,0,10,0"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkTargetCoverLabel}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectArtworkTargetCommand}"
                                                      CommandParameter="cover">
                                                <ButtonEx.Style>
                                                    <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                        <Setter Property="Opacity" Value="0.60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetCover}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                            <ButtonEx x:Name="VideoPlayerArtworkTargetLandscapeButton"
                                                      Width="188" Height="50" Margin="0,0,10,0"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkTargetLandscapeLabel}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectArtworkTargetCommand}"
                                                      CommandParameter="landscape">
                                                <ButtonEx.Style>
                                                    <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                        <Setter Property="Opacity" Value="0.60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetLandscape}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                            <ButtonEx x:Name="VideoPlayerArtworkTargetWallpaperButton"
                                                      Width="188" Height="50" Margin="0,0,10,0"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkTargetWallpaperLabel}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectArtworkTargetCommand}"
                                                      CommandParameter="hero">
                                                <ButtonEx.Style>
                                                    <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                        <Setter Property="Opacity" Value="0.60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetWallpaper}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                            <ButtonEx x:Name="VideoPlayerArtworkTargetLogoButton"
                                                      Width="188" Height="50"
                                                      Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkTargetLogoLabel}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectArtworkTargetCommand}"
                                                      CommandParameter="logo">
                                                <ButtonEx.Style>
                                                    <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource VideoPlayerControlButtonStyle}">
                                                        <Setter Property="Opacity" Value="0.60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetLogo}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Search shown for TV/anime artwork and movie matching. -->
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkSearchVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkSearchLabel}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="15" FontWeight="SemiBold" Margin="4,0,0,7"/>
                                        <TextBox x:Name="VideoPlayerArtworkSearchBox"
                                                 Grid.Row="1" Grid.Column="0"
                                                 Height="52" VerticalContentAlignment="Center"
                                                 FontSize="19" Foreground="{DynamicResource TextBrush}"
                                                 Background="#16000000" BorderBrush="#40FFFFFF"
                                                 BorderThickness="1.5" Padding="16,0"
                                                 SelectionBrush="{DynamicResource FocusGameBorderBrush}"
                                                 Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerSearchText, Mode=TwoWay}"
                                                 KeyboardNavigation.TabNavigation="Local"/>
                                        <ButtonEx x:Name="VideoPlayerArtworkSearchButton"
                                                  Grid.Row="1" Grid.Column="2"
                                                  Height="52" Margin="0" Padding="18,0"
                                                  Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkSearchButtonLabel}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SearchArtworkCommand}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkSearchHelp}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="14" Opacity="0.66" Margin="4,8,0,0"/>
                                    </Grid>

                                    <Border Grid.Row="3" Height="1" Background="#38FFFFFF" Opacity="0.70" Margin="0,12,0,12"/>

                                    <!-- Artwork manager: current item left, provider results right. -->
                                    <Grid Grid.Row="4" MinHeight="390">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="400"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Current artwork panel -->
                                        <Border Grid.Column="0" Padding="22" CornerRadius="22"
                                                Background="#48000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid x:Name="VideoPlayerArtworkCurrentPanel">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkMatchMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkCurrentLabel}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                                   FontSize="19" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerCurrentTypeLabel}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                                   FontSize="14" Opacity="0.58" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <Grid Grid.Row="1" Margin="0,16,0,14" VerticalAlignment="Center">
                                                        <Border x:Name="VideoPlayerArtworkCurrentImageFrame"
                                                                CornerRadius="16" ClipToBounds="True"
                                                                Background="#22000000" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Width" Value="205"/>
                                                                    <Setter Property="Height" Value="302"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetLandscape}" Value="True">
                                                                            <Setter Property="Width" Value="320"/>
                                                                            <Setter Property="Height" Value="180"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetWallpaper}" Value="True">
                                                                            <Setter Property="Width" Value="320"/>
                                                                            <Setter Property="Height" Value="180"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetLogo}" Value="True">
                                                                            <Setter Property="Width" Value="320"/>
                                                                            <Setter Property="Height" Value="150"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerCurrentPath}"
                                                                   RenderOptions.BitmapScalingMode="Fant">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkTargetLogo}" Value="True">
                                                                                <Setter Property="Stretch" Value="Uniform"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Border>
                                                        <TextBlock Text="—"
                                                                   Foreground="White"
                                                                   FontSize="38" Opacity="0.22"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasArtworkPickerCurrentArtwork}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <Border Grid.Row="2" HorizontalAlignment="Left" Padding="11,5" CornerRadius="10"
                                                            Background="#22000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerCurrentSourceText}"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                                   FontSize="13" FontWeight="SemiBold" Opacity="0.78"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Distinct Match mode styling. -->
                                                <StackPanel VerticalAlignment="Center" Margin="12">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkMatchMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontIcons}"
                                                               Foreground="{DynamicResource FocusGameBorderBrush}" FontSize="42"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkIdentifyTitle}"
                                                               Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                               FontSize="31" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerAssociationText}"
                                                               Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                               FontSize="18" FontWeight="SemiBold" Opacity="0.90" Margin="0,12,0,0"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkIdentifyHelp}"
                                                               Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                               FontSize="16" Opacity="0.72" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Provider results -->
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="2,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerTitle}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                           FontSize="21" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerCurrentTypeLabel}"
                                                           Foreground="White"
                                                           FontSize="14" Opacity="0.55" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkMatchMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <ScrollViewer x:Name="VideoPlayerArtworkResultsScroller"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Focusable="False" IsTabStop="False"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl x:Name="VideoPlayerArtworkResults"
                                                                  ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerItems}"
                                                                  Focusable="False" IsTabStop="False"
                                                                  KeyboardNavigation.TabNavigation="Cycle"
                                                                  KeyboardNavigation.DirectionalNavigation="Contained">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx x:Name="VideoPlayerArtworkChoiceButton"
                                                                          Width="188" Height="330" Margin="7,0"
                                                                          Padding="10"
                                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectArtworkChoiceCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <ButtonEx.Style>
                                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource VideoPlayerHomeCardButtonStyle}">
                                                                            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ButtonEx.Style>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid Grid.Row="0" HorizontalAlignment="Center">
                                                                            <Border x:Name="VideoPlayerArtworkChoiceImageBorder"
                                                                                    Width="142" Height="210"
                                                                                    CornerRadius="12" ClipToBounds="True"
                                                                                    Background="#20000000" BorderBrush="#34FFFFFF" BorderThickness="1">
                                                                                <Image x:Name="VideoPlayerArtworkChoiceImage"
                                                                                       Source="{Binding PreviewPath}" Stretch="UniformToFill"
                                                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                                                            </Border>
                                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                    Margin="0,8,8,0" Padding="8,4" CornerRadius="8"
                                                                                    Background="{DynamicResource FocusGameBorderBrush}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkCurrentBadgeLabel}"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="Black" FontSize="10" FontWeight="Bold"/>
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Grid.Row="1" Text="{Binding ProviderText}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="{DynamicResource FocusGameBorderBrush}"
                                                                                   FontSize="14" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                                        <TextBlock Grid.Row="2" Text="{Binding MatchText}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                                                   MaxWidth="250" MaxHeight="44" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                                        <TextBlock Grid.Row="3" Text="{Binding LanguageText}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="White" FontSize="13" Opacity="0.78"
                                                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                                        <TextBlock Grid.Row="4" Text="{Binding SizeText}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="White" FontSize="13" Opacity="0.66"
                                                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                        <TextBlock x:Name="VideoPlayerArtworkMatchOverview"
                                                                                   Grid.Row="5" Text="{Binding Overview}"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                                                   Foreground="White" FontSize="13" Opacity="0.68"
                                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="250" MaxHeight="56" Margin="0,8,0,0"
                                                                                   Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </ButtonEx>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding ArtworkTarget}" Value="landscape">
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Width" Value="286"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Height" Value="245"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Width" Value="258"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Height" Value="128"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ArtworkTarget}" Value="hero">
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Width" Value="286"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Height" Value="245"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Width" Value="258"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Height" Value="128"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ArtworkTarget}" Value="logo">
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Width" Value="286"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Height" Value="225"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Width" Value="258"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Height" Value="112"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImage" Property="Stretch" Value="Uniform"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ArtworkTarget}" Value="match">
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Width" Value="250"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceButton" Property="Height" Value="390"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Width" Value="190"/>
                                                                        <Setter TargetName="VideoPlayerArtworkChoiceImageBorder" Property="Height" Value="238"/>
                                                                        <Setter TargetName="VideoPlayerArtworkMatchOverview" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkPickerLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontIcons}"
                                                               Foreground="{DynamicResource FocusGameBorderBrush}"
                                                               FontSize="34" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerStatusText}"
                                                               Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                               FontSize="15" Opacity="0.70" Margin="0,12,0,0"/>
                                                </StackPanel>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsArtworkPickerLoading}" Value="False"/>
                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasArtworkPickerItems}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcons}"
                                                               Foreground="White" FontSize="31" Opacity="0.32" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerStatusText}"
                                                               Style="{DynamicResource TextBlockBaseStyle}" Foreground="White"
                                                               FontSize="15" Opacity="0.62" Margin="0,11,0,0" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="620"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- Controller help -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="Dpad" Content="{DynamicResource LOCButtonPrompt_Navigate}"/>
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="A" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenLabel}"/>
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="X" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ArtworkPickerXActionLabel}"/>
                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="B" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Movie file info modal outside the browser root. -->
                        <Grid x:Name="VideoPlayerMovieFileInfoModalRoot"
                              Panel.ZIndex="110"
                              FocusManager.IsFocusScope="True"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.ControlTabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsMovieFileInfoOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Background="#B8000000" IsHitTestVisible="False"/>

                            <Border Width="860"
                                    MaxHeight="720"
                                    Padding="40,36,40,30"
                                    CornerRadius="26"
                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Effect="{DynamicResource SoftTextShadow}">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                                                Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontIcons}"
                                                       Foreground="{DynamicResource FocusGameBorderBrush}"
                                                       FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailFileInfoTitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="31" FontWeight="SemiBold"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailFileSummary}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="14" Opacity="0.58" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}"
                                            Opacity="0.60" Margin="0,24,0,24"/>

                                    <ScrollViewer Grid.Row="2" MaxHeight="430"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False" IsTabStop="False">
                                        <Border Padding="22" CornerRadius="16" Background="#13000000"
                                                BorderBrush="#22FFFFFF" BorderThickness="1">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MovieDetailFileInfoText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="18" LineHeight="29" Opacity="0.88"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </ScrollViewer>

                                    <Grid Grid.Row="3" Margin="0,26,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ButtonEx x:Name="VideoPlayerMovieInfoCloseButton" Grid.Column="0"
                                                  Width="210" HorizontalAlignment="Left"
                                                  Style="{StaticResource VideoPlayerMoviePrimaryActionButtonStyle}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CloseMovieFileInfoCommand}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="18" Margin="0,0,9,0"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"
                                                           FontSize="17" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ButtonEx>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="A" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"/>
                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="B" Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.BackLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Fullscreen playback -->
                        <Grid x:Name="VideoPlayerPlaybackRoot" Background="Black">


                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsPlaybackOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ContentControl x:Name="AnikiVideoPlayerHost"
                                            Background="Black"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Focusable="False"
                                            IsTabStop="False"/>

                            <!-- Reuse Playnite's VideoView to avoid NonShareable crashes. -->
                            <ContentControl x:Name="AnikiVideoPlayerOverlayStaging"
                                            Width="0"
                                            Height="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Focusable="False"
                                            IsTabStop="False"
                                            IsHitTestVisible="False"
                                            ClipToBounds="True">
                        <Grid Background="#01000000" IsHitTestVisible="True">
                            <!-- Cover LibVLC in black until playback starts to hide the HWND flash. -->
                            <Border Background="Black"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsVideoSurfaceReady}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0"
                                                                             BeginTime="0:0:0.10"
                                                                             Duration="0:0:0.20"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1"
                                                                             Duration="0:0:0.05"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Playback error -->
                            <Border Width="820"
                                    Padding="28,22"
                                    CornerRadius="18"
                                    BorderBrush="#48FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.HasPlaybackError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CurrentVideoName}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlaybackErrorText}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="White"
                                               FontSize="18"
                                               Opacity="0.72"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- V2 full-width cinema HUD. -->
                            <Grid x:Name="VideoPlayerChrome">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AreControlsVisible}" Value="False">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1"
                                                                             To="0"
                                                                             Duration="0:0:0.28"
                                                                             FillBehavior="Stop"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0"
                                                                             To="1"
                                                                             Duration="0:0:0.15"
                                                                             FillBehavior="Stop"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Plex/Infuse-style bottom fade. -->
                                <Rectangle Height="450"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#36000000" Offset="0.14"/>
                                            <GradientStop Color="#82000000" Offset="0.34"/>
                                            <GradientStop Color="#C4000000" Offset="0.58"/>
                                            <GradientStop Color="#EB000000" Offset="0.80"/>
                                            <GradientStop Color="#FA000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Grid Width="1776"
                                      Height="250"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,28"
                                      KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="46"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Movie / episode title -->
                                    <TextBlock Grid.Row="0"
                                               Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CurrentVideoTitle}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontFamily="{DynamicResource FontMain}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Effect="{DynamicResource SoftTextShadow}"/>

                                    <!-- Draggable timeline; LB/RB for fast seek. -->
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Border Height="4"
                                                VerticalAlignment="Center"
                                                CornerRadius="2"
                                                Background="#55FFFFFF"/>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VideoProgress}"
                                                     Height="4"
                                                     VerticalAlignment="Center"
                                                     Background="#00FFFFFF"
                                                     Foreground="{DynamicResource TextHighlightBrush}"
                                                     BorderThickness="0"
                                                     IsHitTestVisible="False"/>
                                        <Slider x:Name="VideoTimelineSlider"
                                                Style="{StaticResource VideoPlayerTimelineSliderStyle}"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="0.25"
                                                LargeChange="1"
                                                Value="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VideoSeekPercent, Mode=TwoWay}"/>
                                    </Grid>

                                    <Grid Grid.Row="2" IsHitTestVisible="False">
                                        <TextBlock HorizontalAlignment="Left"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VideoElapsedText}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VideoDurationText}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <!-- Volume left, transport center, options right. -->
                                    <Grid Grid.Row="3" Margin="0,4,0,0">

                                        <!-- Volume controls on the left. -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE767;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0"/>

                                            <ButtonEx x:Name="VideoVolumeDownButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VolumeDownCommand}">
                                                <TextBlock Text="−"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           FontSize="29"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Margin="0,-3,0,0"/>
                                            </ButtonEx>

                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VideoVolumeText}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="72"
                                                       TextAlignment="Center"/>

                                            <ButtonEx x:Name="VideoVolumeUpButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.VolumeUpCommand}">
                                                <TextBlock Text="+"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           FontSize="27"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </ButtonEx>
                                        </StackPanel>

                                        <!-- Previous / seek backward / Play-Pause / seek forward / Next -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <ButtonEx x:Name="VideoPreviousButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanPlayPrevious}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PreviousFileCommand}">
                                                <TextBlock Text="&#xE892;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="27"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoSeekBackwardButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeekBackwardCommand}">
                                                <TextBlock Text="&#xEB9E;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="24"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoPlayPauseButton"
                                                      Style="{StaticResource VideoPlayerPlayButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.TogglePlayPauseCommand}">
                                                <TextBlock FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="32"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE768;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsPlaying}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE769;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoSeekForwardButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SeekForwardCommand}">
                                                <TextBlock Text="&#xEB9D;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="24"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoNextButton"
                                                      Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                      IsEnabled="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CanPlayNext}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.NextFileCommand}">
                                                <TextBlock Text="&#xE893;"
                                                           FontFamily="{DynamicResource FontIcons}"
                                                           FontSize="27"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </ButtonEx>
                                        </StackPanel>

                                        <!-- Audio / subtitles / chapters / more on the right. -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <ButtonEx x:Name="VideoAudioButton"
                                                      Style="{StaticResource VideoPlayerHudButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenAudioOptionsCommand}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8D6;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.AudioLabel}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontFamily="{DynamicResource FontMain}"
                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoSubtitlesButton"
                                                      Style="{StaticResource VideoPlayerHudButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenSubtitleOptionsCommand}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8D2;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SubtitlesLabel}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontFamily="{DynamicResource FontMain}"
                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoChaptersButton"
                                                      Style="{StaticResource VideoPlayerHudButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenChapterOptionsCommand}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8FD;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ChaptersLabel}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontFamily="{DynamicResource FontMain}"
                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </ButtonEx>

                                            <ButtonEx x:Name="VideoMoreButton"
                                                      Style="{StaticResource VideoPlayerHudButtonStyle}"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OpenMoreOptionsCommand}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE712;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.MoreLabel}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontFamily="{DynamicResource FontMain}"
                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </ButtonEx>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Shared More / Audio / Subtitles / Chapters panel. -->
                            <Border Width="458"
                                    MaxHeight="610"
                                    Padding="14,14,14,14"
                                    CornerRadius="22"
                                    BorderBrush="#32FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,64,274"
                                    Effect="{DynamicResource SoftTextShadow}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_End}" Opacity="0.96"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsOptionsPanelOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="58"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="6,0,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="4"
                                                Height="34"
                                                CornerRadius="2"
                                                Background="{DynamicResource FocusGameBorderBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,13,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OptionsPanelTitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Mouse fallback and empty-list focus target. -->
                                        <ButtonEx x:Name="VideoOptionsCloseButton"
                                                  Grid.Column="2"
                                                  Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                  Width="42"
                                                  Height="42"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ClosePlayerPanelCommand}">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextDetailBrush}"/>
                                        </ButtonEx>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#20FFFFFF"/>

                                    <Grid Grid.Row="3">
                                        <ListBox x:Name="VideoOptionsList"
                                                 ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OptionItems}"
                                                 ItemContainerStyle="{StaticResource VideoPlayerListBoxItemStyle}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Focusable="False"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Section headers in More; track lists stay continuous. -->
                                                        <Border Grid.Row="0"
                                                                Height="1"
                                                                Background="#20FFFFFF"
                                                                Margin="12,6,12,10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Id}" Value="more:info">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Id}" Value="more:restart">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <ButtonEx Grid.Row="1"
                                                                  Style="{StaticResource VideoPlayerOptionButtonStyle}"
                                                                  IsEnabled="{Binding IsEnabled}"
                                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SelectOptionCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontFamily="{DynamicResource FontMain}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="16.5"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <!-- Current value / chapter time / active track. -->
                                                                <Border Grid.Column="1"
                                                                        MinWidth="52"
                                                                        Padding="10,5"
                                                                        Margin="12,0,0,0"
                                                                        CornerRadius="10"
                                                                        Background="#13FFFFFF"
                                                                        BorderBrush="#1CFFFFFF"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SecondaryText}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding SecondaryText}"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                               FontFamily="{DynamicResource FontMain}"
                                                                               Foreground="{DynamicResource TextDetailBrush}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>

                                                                <!-- Selected track / ratio / speed badge. -->
                                                                <Border Grid.Column="2"
                                                                        Width="30"
                                                                        Height="30"
                                                                        Margin="10,0,0,0"
                                                                        CornerRadius="15"
                                                                        Background="{DynamicResource ButtonBackgroundFocus}"
                                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#xE73E;"
                                                                               FontFamily="{DynamicResource FontIcons}"
                                                                               Foreground="{DynamicResource TextHighlightBrush}"
                                                                               FontSize="15"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Chevron for rows that open another page. -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="›"
                                                                           FontFamily="{DynamicResource FontMain}"
                                                                           Foreground="{DynamicResource TextDetailBrush}"
                                                                           FontSize="27"
                                                                           FontWeight="Light"
                                                                           VerticalAlignment="Center"
                                                                           Margin="12,-2,4,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Id}" Value="more:aspect"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Id}" Value="more:speed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Id}" Value="more:info"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Id}" Value="more:shortcuts"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </ButtonEx>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="—"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       Foreground="{DynamicResource FocusGameBorderBrush}"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OptionsPanelEmptyText}"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       FontSize="15"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="330"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OptionItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.OptionItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Player info and shortcuts share the same panel. -->
                            <Border Width="570"
                                    MaxHeight="610"
                                    Padding="16"
                                    CornerRadius="22"
                                    BorderBrush="#32FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,64,274"
                                    Effect="{DynamicResource SoftTextShadow}">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_End}" Opacity="0.96"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsInfoPanelOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="58"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="4,0,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="4"
                                                Height="34"
                                                CornerRadius="2"
                                                Background="{DynamicResource FocusGameBorderBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,13,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.InfoPanelTitle}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontFamily="{DynamicResource FontMain}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="23"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ButtonEx x:Name="VideoInfoCloseButton"
                                                  Grid.Column="2"
                                                  Style="{StaticResource VideoPlayerHudIconButtonStyle}"
                                                  Width="42"
                                                  Height="42"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ClosePlayerPanelCommand}">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextDetailBrush}"/>
                                        </ButtonEx>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#20FFFFFF"/>

                                    <Border Grid.Row="3"
                                            Background="#0CFFFFFF"
                                            BorderBrush="#14FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="17,15">
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.InfoPanelText}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   FontSize="15.5"
                                                   LineHeight="25"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Non-modal Skip Intro / Recap prompt. -->
                            <Border Width="390"
                                    Padding="18,13"
                                    CornerRadius="18"
                                    BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,76,220"
                                    Effect="{DynamicResource SoftTextShadow}"
                                    Panel.ZIndex="80">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_Center}"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsSkipPromptOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="{DynamicResource ButtonBackgroundFocus}"
                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                            BorderThickness="1.5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="A"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SkipPromptLabel}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.SkipPromptTitle}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   Foreground="{DynamicResource TextDetailBrush}"
                                                   FontSize="13"
                                                   Opacity="0.72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Resume prompt -->
                            <Border Width="720"
                                    Padding="30"
                                    CornerRadius="28"
                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Effect="{DynamicResource SoftTextShadow}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_End}" Opacity="0.96"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsResumePromptOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ResumePromptText}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontFamily="{DynamicResource FontMain}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,28,0,0">
                                        <ButtonEx x:Name="VideoResumeButton"
                                                  Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                  MinWidth="220"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ResumePlaybackCommand}"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.ResumeLabel}"/>
                                        <ButtonEx Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                  MinWidth="250"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.StartFromBeginningCommand}"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.StartBeginningLabel}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Show Up Next when another file exists. -->
                            <Border Width="720"
                                    Padding="30"
                                    CornerRadius="28"
                                    BorderBrush="{DynamicResource StaticBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,70,70"
                                    Effect="{DynamicResource SoftTextShadow}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource SecondaryViewBackground_End}" Opacity="0.96"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.IsUpNextPromptOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.UpNextLabel}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource FocusGameBorderBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.UpNextVideoName}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.UpNextCountdownText}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="16"
                                               Opacity="0.78"
                                               Margin="0,8,0,0"/>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
                                        <ButtonEx x:Name="VideoUpNextPlayButton"
                                                  Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                  MinWidth="210"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlayUpNextCommand}"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.PlayNowLabel}"/>
                                        <ButtonEx Style="{StaticResource VideoPlayerControlButtonStyle}"
                                                  MinWidth="170"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CancelUpNextCommand}"
                                                  Content="{PluginSettings Plugin=AnikiHelper, Path=VideoPlayer.CancelLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                            </ContentControl>
                        </Grid>
