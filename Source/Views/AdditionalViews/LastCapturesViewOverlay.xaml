<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Overlay child window for Last Captures. -->
    <Style x:Key="LastCapturesWindowStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="1920"
                          Height="1080"
                          Background="Transparent"
                          Focusable="False"
                          Opacity="0">

                        

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.68">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <!-- Strong modal dim behind the captures panel -->
                        <Rectangle IsHitTestVisible="False" Fill="#96000000"/>

                        <Border Width="1200"
                                Height="700"
                                Padding="42,32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="28"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1"
                                Effect="{DynamicResource SoftTextShadow}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <Border Width="64"
                                            Height="64"
                                            CornerRadius="32"
                                            HorizontalAlignment="Center"
                                            Background="#18000000"
                                            BorderBrush="#80D0B06A"
                                            BorderThickness="1">
                                        <TextBlock Text="&#xE91B;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayLastCapturesTitle}"
                                               Margin="0,14,0,0"
                                               FontFamily="{DynamicResource FontMain}"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayLastCapturesSubtitle}"
                                               Margin="0,8,0,0"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="16"
                                               Opacity="0.74"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Width="260"
                                            Height="1"
                                            Margin="0,16,0,0"
                                            Background="#55D0B06A"/>
                                </StackPanel>


                                <!-- Captures list and in-view refresh button -->
                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ItemsControl Grid.Row="0"
                                                  ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=OverlayLastCaptureItems}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HasOverlayLastCaptures}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Keep the whole card 16:9. Metadata is drawn as a compact
                                                     overlay instead of increasing the card height. -->
                                                <ButtonEx Width="340"
                                                          Height="191.25"
                                                          Margin="14,0"
                                                          Padding="0"
                                                          FocusVisualStyle="{x:Null}"
                                                          Focusable="True"
                                                          IsTabStop="True"
                                                          KeyboardNavigation.IsTabStop="True"
                                                          Command="{PluginSettings Plugin=AnikiHelper, Path=OpenOverlayCapturePreviewCommand}"
                                                          CommandParameter="{Binding}">
                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ButtonEx">
                                                                        <Grid>
                                                                            <!-- Base card/content. -->
                                                                            <Border x:Name="CaptureCard"
                                                                                    CornerRadius="22"
                                                                                    Background="#0C000000"
                                                                                    BorderBrush="#24FFFFFF"
                                                                                    BorderThickness="1"
                                                                                    ClipToBounds="True">
                                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                                            </Border>

                                                                            <!-- Dedicated focus layer rendered above the image and metadata. -->
                                                                            <Border x:Name="FocusBorder"
                                                                                    Panel.ZIndex="100"
                                                                                    CornerRadius="22"
                                                                                    BorderBrush="Transparent"
                                                                                    BorderThickness="3"
                                                                                    Background="Transparent"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsFocused" Value="True">
                                                                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ButtonEx.Style>

                                                    <Grid ClipToBounds="True">
                                                        <!-- Full-card 16:9 capture -->
                                                        <Border x:Name="CaptureFullMask"
                                                                CornerRadius="21"
                                                                Background="Black"/>

                                                        <Grid>
                                                            <Grid.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=CaptureFullMask}"/>
                                                            </Grid.OpacityMask>

                                                            <TextBlock Text="&#xE91B;"
                                                                       FontFamily="{DynamicResource FontIcons}"
                                                                       FontSize="38"
                                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                                       Opacity="0.45"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                            <Image Source="{Binding DisplayThumbnailPath}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Grid>

                                                        <!-- Image / video badge -->
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,11,11,0"
                                                                Padding="8,4"
                                                                CornerRadius="10"
                                                                Background="#B8000000"
                                                                BorderBrush="#35FFFFFF"
                                                                BorderThickness="1">
                                                            <TextBlock FontFamily="{DynamicResource FontMain}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextHighlightBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCImage}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                <Setter Property="Text" Value="{DynamicResource Video}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Compact metadata band kept inside the 16:9 card. -->
                                                        <Border Height="58"
                                                                VerticalAlignment="Bottom"
                                                                Background="#D40A0E14"
                                                                Padding="13,5">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                                           Text="{Binding GameName}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                                           Text="{Binding FileSizeString}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="10"
                                                                           Opacity="0.62"
                                                                           Margin="10,2,0,0"
                                                                           VerticalAlignment="Top"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                                           Text="{Binding CaptureDateString}"
                                                                           Margin="0,3,0,0"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="11"
                                                                           Opacity="0.72"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                                           Text="{Binding SourceProvider}"
                                                                           Margin="10,3,0,0"
                                                                           MaxWidth="120"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="10"
                                                                           Opacity="0.55"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </ButtonEx>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <Border Grid.Row="0"
                                            Width="720"
                                            Height="240"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="22"
                                            Background="#10000000"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            Padding="28">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HasOverlayLastCaptures}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE722;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="40"
                                                       Foreground="{DynamicResource TextDetailBrush}"
                                                       Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource LOCNoCaptures}"
                                                       Margin="0,14,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=OverlayLastCapturesEmptyText}"
                                                       Margin="0,8,0,0"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="16"
                                                       Opacity="0.65"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Refreshes ScreenshotsVisualizer while the game is still running -->
                                    <ButtonEx Grid.Row="1"
                                              MinWidth="280"
                                              Height="54"
                                              Margin="0,22,0,0"
                                              Padding="22,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              Style="{DynamicResource MenuButtonAniki}"
                                              Content="{PluginSettings Plugin=AnikiHelper, Path=OverlayLastCapturesRefreshButtonText}"
                                              Visibility="{PluginSettings Plugin=AnikiHelper, Path=CanRefreshOverlayLastCaptures}"
                                              Focusable="True"
                                              IsTabStop="True"
                                              KeyboardNavigation.IsTabStop="True"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshOverlayLastCapturesCommand}" />
                                </Grid>

                                <!-- Footer -->
                                <Grid Grid.Row="5" Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               MaxWidth="700"
                                               Text="{DynamicResource LOCLastCapturesDescription}"
                                               FontSize="15"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Opacity="0.62"
                                               VerticalAlignment="Bottom"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Tag="B"
                                                  Content="{DynamicResource LOCBackLabel}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  IsHitTestVisible="False" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
