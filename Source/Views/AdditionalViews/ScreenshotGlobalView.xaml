<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style x:Key="MediaGalleryGamesWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <ControlTemplate.Resources>

                        <CubicEase x:Key="EaseOutSoft" EasingMode="EaseOut"/>
                        <QuadraticEase x:Key="EaseOutFast" EasingMode="EaseOut"/>

                        <Storyboard x:Key="SB_MediaTileToNone">
                            <DoubleAnimation Storyboard.TargetName="FocusTransform"
                                             Storyboard.TargetProperty="Y"
                                             To="0"
                                             Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutFast}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1"
                                             Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutFast}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1"
                                             Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_MediaTileToFocus">
                            <DoubleAnimation Storyboard.TargetName="FocusTransform"
                                             Storyboard.TargetProperty="Y"
                                             To="-6"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.035"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.035"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_MediaTileToHover">
                            <DoubleAnimation Storyboard.TargetName="FocusTransform"
                                             Storyboard.TargetProperty="Y"
                                             To="-4"
                                             Duration="0:0:0.14"
                                             EasingFunction="{StaticResource EaseOutFast}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.02"
                                             Duration="0:0:0.14"
                                             EasingFunction="{StaticResource EaseOutFast}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.02"
                                             Duration="0:0:0.14"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_MediaTileToFocusHover">
                            <DoubleAnimation Storyboard.TargetName="FocusTransform"
                                             Storyboard.TargetProperty="Y"
                                             To="-10"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.045"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.045"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                        </Storyboard>

                        <ControlTemplate x:Key="MediaGalleryTileTemplate" TargetType="ListBoxItem">
                            <ButtonEx Command="{PluginSettings Plugin=AnikiHelper, Path=OpenScreenshotsForMediaGameCommand}"
                                      CommandParameter="{Binding}"
                                      Margin="0,0,34,40"
                                      Focusable="True"
                                      FocusVisualStyle="{x:Null}">

                                <ButtonEx.Style>
                                    <Style TargetType="ButtonEx">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ButtonEx.Style>

                                <Grid Margin="0,24,0,24">
                                    <Grid x:Name="TileRoot"
                                          RenderTransformOrigin="0.5,0.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">

                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="FocusTransform" X="0" Y="0"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Top">

                                            <Grid x:Name="CoverFrame"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">

                                                <Viewbox x:Name="CoverViewbox"
                                                         MaxWidth="460"
                                                         MaxHeight="310"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">

                                                    <Grid x:Name="CoverRoot"
                                                          Width="{Settings GridItemWidth}"
                                                          Height="{Settings GridItemHeight}"
                                                          ClipToBounds="False"
                                                          SnapsToDevicePixels="True">

                                                        <Grid x:Name="ShadowLayer"
                                                              IsHitTestVisible="False"
                                                              Opacity="0.55">
                                                            <Grid.RenderTransform>
                                                                <TranslateTransform X="1" Y="1"/>
                                                            </Grid.RenderTransform>

                                                            <Border CornerRadius="{DynamicResource Corner}"
                                                                    Background="#50000000"/>
                                                        </Grid>

                                                        <Border x:Name="Mask"
                                                                Background="#181A1E"
                                                                CornerRadius="{DynamicResource Corner}"/>

                                                        <Grid x:Name="CoverContent">
                                                            <Grid.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=Mask}"/>
                                                            </Grid.OpacityMask>

                                                            <Image Stretch="{Settings CoverArtStretch}"
                                                                   StretchDirection="Both"
                                                                   RenderOptions.BitmapScalingMode="Linear"
                                                                   SnapsToDevicePixels="True">
                                                                <Image.Source>
                                                                    <Binding Path="CoverPath"/>
                                                                </Image.Source>
                                                            </Image>

                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>

                                                                <Border Background="#77000000"/>

                                                                <TextBlock Text="&#xE7FC;"
                                                                           FontFamily="{DynamicResource FontIcoFont}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="48"
                                                                           Opacity="0.58"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>



                                                            <Border x:Name="FocusedTitleOverlay"
                                                                    VerticalAlignment="Bottom"
                                                                    Height="58"
                                                                    CornerRadius="{DynamicResource Corner}"
                                                                    Opacity="0"
                                                                    IsHitTestVisible="False">

                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                                        <GradientStop Color="#D8000000" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>

                                                                <TextBlock Text="{Binding GameName}"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Bottom"
                                                                           TextAlignment="Center"
                                                                           Margin="14,0,14,9"
                                                                           Effect="{DynamicResource SoftTextShadow}"/>
                                                            </Border>

                                                            <Border x:Name="DimGames"
                                                                    Background="Black"
                                                                    IsHitTestVisible="False"
                                                                    CornerRadius="{DynamicResource Corner}"
                                                                    Opacity="0"/>

                                                            <Border x:Name="FlashFocus"
                                                                    Opacity="0"
                                                                    CornerRadius="{DynamicResource Corner}"
                                                                    Tag="False"
                                                                    Visibility="Collapsed"
                                                                    IsHitTestVisible="False"/>

                                                            <Border x:Name="MainBorder"
                                                                    Opacity="0"
                                                                    BorderThickness="3"
                                                                    CornerRadius="{DynamicResource Corner}"
                                                                    Tag="False"
                                                                    Visibility="Collapsed"
                                                                    BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                                    IsHitTestVisible="False"/>
                                                        </Grid>
                                                    </Grid>
                                                </Viewbox>

                                                <Border x:Name="CaptureBadge"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="10,10,0,0"
                                                        Padding="11,5"
                                                        CornerRadius="13"
                                                        Background="{DynamicResource BackgroundMenu}"
                                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                                        BorderThickness="1"
                                                        Panel.ZIndex="50"
                                                        IsHitTestVisible="False">

                                                    <TextBlock Text="{Binding MediaCount}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.95"/>
                                                </Border>

                                            </Grid>

                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ButtonEx>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Tag" Value="True" TargetName="FlashFocus"/>
                                    <Setter Property="Tag" Value="True" TargetName="MainBorder"/>
                                    <Setter Property="Visibility" Value="Visible" TargetName="MainBorder"/>
                                    <Setter Property="Opacity" Value="1" TargetName="MainBorder"/>
                                    <Setter Property="Visibility" Value="Visible" TargetName="FlashFocus"/>
                                    <Setter TargetName="DimGames" Property="Opacity" Value="0"/>
                                    <Setter TargetName="FocusedTitleOverlay" Property="Opacity" Value="1"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocusWithin" Value="False">
                                    <Setter Property="Tag" Value="False" TargetName="FlashFocus"/>
                                    <Setter Property="Tag" Value="False" TargetName="MainBorder"/>
                                    <Setter Property="Visibility" Value="Collapsed" TargetName="MainBorder"/>
                                    <Setter Property="Visibility" Value="Collapsed" TargetName="FlashFocus"/>
                                    <Setter TargetName="DimGames" Property="Opacity" Value="0.12"/>
                                    <Setter TargetName="FocusedTitleOverlay" Property="Opacity" Value="0"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DimGames" Property="Opacity" Value="0"/>
                                </Trigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[EnableFocusFlashCover]}" Value="True"/>
                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Style" TargetName="FlashFocus" Value="{DynamicResource AnimatedFlashFocus}"/>
                                </MultiDataTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                        <BeginStoryboard x:Name="BS_FocusHover" Storyboard="{StaticResource SB_MediaTileToFocusHover}" HandoffBehavior="SnapshotAndReplace"/>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                        <BeginStoryboard x:Name="BS_Focus" Storyboard="{StaticResource SB_MediaTileToFocus}" HandoffBehavior="SnapshotAndReplace"/>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                        <BeginStoryboard x:Name="BS_Hover" Storyboard="{StaticResource SB_MediaTileToHover}" HandoffBehavior="SnapshotAndReplace"/>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                        <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                        <BeginStoryboard x:Name="BS_None" Storyboard="{StaticResource SB_MediaTileToNone}" HandoffBehavior="SnapshotAndReplace"/>
                                    </MultiTrigger.EnterActions>
                                </MultiTrigger>


                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <Style x:Key="MediaGalleryTileContainerStyle" TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
                            <Setter Property="Template" Value="{StaticResource MediaGalleryTileTemplate}"/>

                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="IsSelected" Value="True"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="MediaGalleryTileListStyle" TargetType="ListBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
                            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Once"/>
                            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
                            <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Once"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </ControlTemplate.Resources>

                    <Grid x:Name="RootGrid"
                          Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.FocusedElement="{Binding ElementName=MediaGamesGrid}"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Opacity="0">


                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>


                        <Grid IsHitTestVisible="False">
                            <Border Background="{DynamicResource SecondaryViewBackground}"/>

                            <Border>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#80FFFFFF" Offset="0.30"/>
                                        <GradientStop Color="#80FFFFFF" Offset="0.60"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Tag" Value="{DynamicResource BackgroundImageIndex}" />
                                        <Setter Property="Background" Value="{DynamicResource WelcomeImage1}"/>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="100">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage100}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="101">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage101}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="102">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage102}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="103">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage103}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="104">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage104}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="105">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage105}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="106">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage106}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="107">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage107}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="108">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage108}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="109">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage109}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="110">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage110}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="111">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage111}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="112">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage112}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="113">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage113}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="114">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage114}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="115">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage115}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="116">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage116}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="117">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage117}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="118">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage118}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="119">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage119}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="120">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage120}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="121">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage121}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="122">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage122}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="123">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage123}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="124">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage124}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="125">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage125}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="126">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage126}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="127">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage127}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="128">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage128}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="129">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage129}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="130">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage130}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="131">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage131}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="132">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage132}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="133">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage133}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="134">
                                                <Setter Property="Background" Value="{DynamicResource MediaViewImage134}"/>
                                                <Setter Property="Opacity" Value="0.2"/>
