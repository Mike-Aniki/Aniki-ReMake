                                                                                           MaxWidth="360"/>
                                                                            </Border>

                                                                            <TextBlock Text="  •  "
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="18"
                                                                                       Opacity="0.60"
                                                                                       Margin="8,0"/>

                                                                            <TextBlock Text="{Binding HeaderSubtitle}"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                       FontSize="18"
                                                                                       Opacity="0.78"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="300"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- RIGHT -->
                                                                    <Grid Grid.Column="2"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right">
                                                                        <Border Background="{DynamicResource BadgeTrophéeBrush}"
                                                                                BorderBrush="#18FFFFFF"
                                                                                BorderThickness="1"
                                                                                CornerRadius="14"
                                                                                Padding="12,10">
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">

                                                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="16"
                                                                                           FontWeight="SemiBold"
                                                                                           Opacity="0.78"
                                                                                           Margin="0,0,10,0">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                            <Setter Property="Text" Value="{StaticResource LOCOpen}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                    <Setter Property="Text" Value="{StaticResource LOCClose}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>

                                                                                <Border Background="#26000000"
                                                                                        CornerRadius="8"
                                                                                        Padding="6,2"
                                                                                        Margin="0,0,10,0">
                                                                                    <TextBlock Text="{Binding Items.Count}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"/>
                                                                                </Border>

                                                                                <TextBlock x:Name="Chevron"
                                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                                           Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                           FontSize="18"
                                                                                           FontWeight="SemiBold"
                                                                                           Opacity="0.90">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                            <Setter Property="Text" Value="▼"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                    <Setter Property="Text" Value="▲"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <Border x:Name="HeaderSeparator"
                                                                Height="1"
                                                                Margin="80,0,80,-1"
                                                                Background="{DynamicResource SeparatorBrush}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </CheckBoxEx>

                                                <!-- ITEMS -->
                                                <ListBox x:Name="ItemsPanel"
                                                         ItemsSource="{Binding Items}"
                                                         Margin="0,8,0,8"
                                                         Visibility="Collapsed"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         HorizontalAlignment="Center"
                                                         MaxHeight="310"
                                                         AlternationCount="2"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.CanContentScroll="False"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         KeyboardNavigation.DirectionalNavigation="Continue"
                                                         KeyboardNavigation.TabNavigation="Continue"
                                                         KeyboardNavigation.ControlTabNavigation="Continue"
                                                         SelectionMode="Single">

                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Focusable" Value="False"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>

                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx x:Name="FriendItemButton"
                                                                      Style="{DynamicResource ButtonTrophyRowStyle}"
                                                                      HorizontalAlignment="Center"
                                                                      Focusable="True"
                                                                      IsTabStop="True"
                                                                      Margin="0,0,0,8"
                                                                      Padding="0"
                                                                      KeyboardNavigation.DirectionalNavigation="Continue">

                                                                <Grid Width="1440"
                                                                      Height="96"
                                                                      HorizontalAlignment="Center">

                                                                    <Border x:Name="ItemMainBorder"
                                                                            CornerRadius="14"
                                                                            BorderThickness="1"
                                                                            BorderBrush="#18FFFFFF"
                                                                            Background="{DynamicResource SuccessFriendsBackgroundBrush}"
                                                                            ClipToBounds="True">

                                                                        <Grid>
                                                                            <!-- focus fill -->
                                                                            <Border x:Name="ItemFocusOverlay"
                                                                                    CornerRadius="14"
                                                                                    Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                                    Opacity="0"
                                                                                    IsHitTestVisible="False"/>

                                                                            <!-- fond subtil -->
                                                                            <Border CornerRadius="14" Opacity="0.92" Background="{DynamicResource BackgroundItem}" />


                                                                            <Grid Margin="14,10">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="90"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="120"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- ICON -->
                                                                                <Grid Grid.Column="0"
                                                                                      VerticalAlignment="Center">
                                                                                    <Border Width="72"
                                                                                            Height="72"
                                                                                            CornerRadius="12"
                                                                                            ClipToBounds="True"
                                                                                            Background="#22000000"
                                                                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                            BorderThickness="1">
                                                                                        <Image Source="{Binding FriendAchievementIcon}"
                                                                                               Stretch="UniformToFill"
                                                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                                                    </Border>
                                                                                </Grid>

                                                                                <!-- TEXT -->
                                                                                <StackPanel Grid.Column="1"
                                                                                            VerticalAlignment="Center"
                                                                                            HorizontalAlignment="Left"
                                                                                            Margin="14,0,0,0">
                                                                                    <TextBlock Text="{Binding AchievementDisplayName}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               FontSize="22"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="960"/>

                                                                                    <TextBlock Text="{Binding AchievementDescription}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               Opacity="0.72"
                                                                                               FontSize="16"
                                                                                               Margin="0,4,0,0"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="960"/>
                                                                                </StackPanel>

                                                                                <!-- TIME -->
                                                                                <Grid Grid.Column="2"
                                                                                      VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding UnlockTimeLocal, StringFormat='{}{0:HH:mm}'}"
                                                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                                                               Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                               Opacity="0.78"
                                                                                               FontSize="18"
                                                                                               HorizontalAlignment="Right"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </ButtonEx>

                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="FriendItemButton" Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="ItemMainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                    <Setter TargetName="ItemMainBorder" Property="BorderThickness" Value="2.5"/>
                                                                    <Setter TargetName="ItemFocusOverlay" Property="Opacity" Value="0.9"/>
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="ItemsPanel" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Chevron" Property="Text" Value="▲"/>
                                            </DataTrigger>

                                            <Trigger SourceName="HeaderToggle" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="HeaderMainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter TargetName="HeaderMainBorder" Property="BorderThickness" Value="2.5"/>
                                                <Setter TargetName="HeaderFocusOverlay" Property="Opacity" Value="0.9"/>
                                                <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ButtonBottom -->


                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">

                            <TextBlock Text="{DynamicResource LocTotalTrophiesUnlocked}" Margin="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Foreground="{DynamicResource ButtonIconDarkBrush}"
                                       HorizontalAlignment="Right"
                                       Opacity="0.9"/>
                            <TextBlock Text=" : " Margin="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Foreground="{DynamicResource ButtonIconDarkBrush}"
                                       HorizontalAlignment="Right"
                                       Opacity="0.9"/>
                            <TextBlock Text="{PluginSettings Plugin=SSHelper, Path=GSTotal}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Foreground="{DynamicResource ButtonIconDarkBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <!-- Visible par défaut -->
                                    <Setter Property="Visibility" Value="Visible"/>

                                    <Style.Triggers>
                                        <!-- Quand le bouton Friends est activé -->
                                        <DataTrigger Binding="{Binding ElementName=FriendsButton, Path=IsChecked}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,20">

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="Dpad"
                                      Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="A"
                                      Content="{DynamicResource LOCButtonPrompt_Select}" />

                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                      Tag="B"
                                      Content="{DynamicResource LOCBackLabel}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
