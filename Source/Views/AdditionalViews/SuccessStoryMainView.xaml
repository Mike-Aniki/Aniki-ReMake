                        <Grid x:Name="HeaderRoot"
                              Height="120"
                              Margin="36,0,36,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- AVATAR ROND -->
                            <Grid Grid.Column="0"
                                  Width="96"
                                  Height="96"
                                  Margin="12,12,24,12"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">

                                <Border x:Name="AvatarMask"
                                        Width="96"
                                        Height="96"
                                        Background="Black"
                                        CornerRadius="48"/>

                                

                                <TextBlock x:Name="ProfilePicturePath"
                                           Tag="{Api Paths.ConfigurationPath}"
                                           Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Width="96"
                                      Height="96"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=AvatarMask}" />
                                    </Grid.OpacityMask>

                                    <Control x:Name="UserAvatar"
                                             Tag="{Binding ElementName=ProfilePicturePath, Path=Text}"
                                             Width="96"
                                             Height="96"
                                             Template="{StaticResource SteamSelfAvatarTemplate}"
                                             Focusable="False"
                                             IsTabStop="False"
                                             IsHitTestVisible="False"/>
                                </Grid>

                                <Border Width="96"
                                        Height="96"
                                        CornerRadius="48"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="2"
                                        Background="#12000000"
                                        IsHitTestVisible="False"/>
                            </Grid>

                            <!-- TITRE / SOUS-TITRE -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock FontSize="34"
                                           FontWeight="SemiBold"
                                           Typography.Capitals="AllSmallCaps"
                                           TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="#000000"/>
                                    </TextBlock.Effect>

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAchievementsTitle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FriendsAchievementsScroll, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Text" Value="{DynamicResource LOCFriendsActivityTitle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=PlatineList, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Text" Value="{DynamicResource LOCCompletedGamesTitle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Opacity="0.72"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubRecentActivity}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FriendsAchievementsScroll, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubFriendsActivity}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=PlatineList, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAchievementsSubRecentCompletions}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- LEVEL À DROITE -->
                            <Border Grid.Column="2"
                                    Margin="24,18,28,18"
                                    Padding="18,10"
                                    CornerRadius="18"
                                    Background="#12FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="46"
                                            Height="46"
                                            ClipToBounds="True"
                                            Style="{StaticResource SSHelper_UserLevelBorderStyle}">

                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LOCLevel}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{PluginSettings Plugin=SSHelper, Path=GSLevel}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="AchievementsInfoBar"
                                Width="1550"
                                Height="54"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,140,0,0"
                                Padding="16,10"
                                CornerRadius="14"
                                Background="#0FFFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="Opacity" Value="0.15"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- NEXT LEVEL -->
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCNextLevel}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Opacity="0.78"
                                               VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"/>

                                    <ProgressBar Grid.Column="1"
                                                 Margin="12,0,10,0"
                                                 Value="{PluginSettings Plugin=SSHelper, Path=GSLevelProgress}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="8"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource ProgressBrush}"
                                                 Background="{DynamicResource ProgressBackgroundBrush}"
                                                 VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{PluginSettings Plugin=SSHelper, Path=GSLevelProgress, StringFormat={}{0}%}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Opacity="0.85"
                                               VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"/>
                                </Grid>

                                <!-- TROPHÉES -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Image Width="26" Height="26" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Source="{ThemeFile 'Images/platinum.png'}"/>
                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{PluginSettings Plugin=SSHelper, Path=GSPlat}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Image Width="26" Height="26" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Source="{ThemeFile 'Images/Or.png'}"/>
                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{PluginSettings Plugin=SSHelper, Path=GS90}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Image Width="26" Height="26" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Source="{ThemeFile 'Images/Argent.png'}"/>
                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{PluginSettings Plugin=SSHelper, Path=GS30}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="26" Height="26" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Source="{ThemeFile 'Images/Bronze.png'}"/>
                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{PluginSettings Plugin=SSHelper, Path=GS15}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Vertical">
                            <!--Trophée Change button -->
                            <CheckBoxEx x:Name="SortButton"
                                        Margin="20,200,0,0"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Focusable="True"
                                        Style="{StaticResource TrophViewButton}" />

                            <!-- Friends achievements button -->
                            <CheckBoxEx x:Name="FriendsButton"
                                        Margin="20,20,0,0"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Focusable="True"
                                        Content="F">
                                <CheckBoxEx.Style>
                                    <Style TargetType="CheckBoxEx"
                                           BasedOn="{StaticResource FriendTrophViewButton}">
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginStatus Plugin=FriendsAchievementFeed, Status=Installed}" Value="True"/>
                                                    <Condition Binding="{PluginStatus Plugin=FriendsAchievementFeedFullscreenCompanion_9fc60469-d8db-4dec-b5c8-65b4b5a88123, Status=Installed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </CheckBoxEx.Style>

                            </CheckBoxEx>
                        </StackPanel>

                        <!-- Liste des Trophées -->
                        <ListView x:Name="AchievementsList"
                                  ItemsSource="{PluginSettings Plugin=SSHelper, Path=AllGamesWithAchievements}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Height="740"
                                  Width="1550"
                                  Margin="0,150,0,0"
                                  BorderBrush="Transparent"
                                  FocusVisualStyle="{x:Null}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Continue"
                                  KeyboardNavigation.ControlTabNavigation="Continue"
                                  VirtualizingPanel.IsVirtualizing="True"
