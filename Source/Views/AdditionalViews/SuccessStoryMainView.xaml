                                        <GradientStop Color="#00FFFFFF" Offset="0.15"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.35"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.85"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Border.Style>
