<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Style pour le bouton d'action de statut de jeu -->
    <Style x:Key="ButtonGameStatusAction" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="0,5,0,5" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border CornerRadius="{DynamicResource Corner}" Visibility="Collapsed" Background="{DynamicResource ButtonBackgroundFocus}"
                                x:Name="MainBackground"/>
                        <Border x:Name="MainBorder" Margin="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="3" CornerRadius="{DynamicResource Corner}" Visibility="Collapsed" />
                        <TextBlock x:Name="Text" Style="{DynamicResource ButtonTextBlockBaseStyle}"
                                   Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Margin="25,0" FontSize="24">
                            <ContentPresenter />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBackground"  />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBackground"  />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style pour l'état de jeu -->
    <Style TargetType="{x:Type GameStatus}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameStatus}">
                    <Grid x:Name="PART_ViewHost"
                          FocusManager.IsFocusScope="True"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Black">

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True">
                                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=GameStatusButton}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoGameStatut]}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- fallback si pas de background -->
                        <Image Source="{ThemeFile 'Images/ShadowBackground/NoBackground.png'}"
                               RenderOptions.BitmapScalingMode="Fant"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Panel.ZIndex="-30" />

                        <!-- image du jeu -->
                        <Image RenderOptions.BitmapScalingMode="Fant"
                               Source="{Binding Game.BackgroundImage, Converter={StaticResource ImageStringToImageConverterCached}}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Panel.ZIndex="-20">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- voile sombre -->
                        <Grid Panel.ZIndex="-10">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C0000000" Offset="0"/>
                                    <GradientStop Color="#8A000000" Offset="0.45"/>
                                    <GradientStop Color="#D8000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                        </Grid>

                        <!-- léger shade / texture -->
                        <Border Panel.ZIndex="-5"
                                RenderOptions.BitmapScalingMode="Fant">
                            <Border.Background>
                                <ImageBrush ImageSource="{ThemeFile 'Images/ShadowBackground/Shade.png'}"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Opacity="0.55"
                                            Stretch="Fill"/>
                            </Border.Background>
                        </Border>

                        <!-- Notification fermeture du jeu -->
                        <Border x:Name="GameClosingPanel"
                                Background="{DynamicResource OverlayMenu}"
                                CornerRadius="{DynamicResource Corner}"
                                Height="70"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Panel.ZIndex="5"
                                Margin="0,28,28,0"
                                RenderTransformOrigin="1,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="2"
                                                  Color="Black"
                                                  Opacity="0.5"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="500"/>
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=NowPlaying, Path=GameClosing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         From="500"
                                                                         To="0"
                                                                         Duration="0:0:0.3"
                                                                         AccelerationRatio="0.3"
                                                                         DecelerationRatio="0.7"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Margin="15,0,0,0"
                                           FontSize="20"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Text="Closing " />
                                <TextBlock FontSize="20"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           MaxWidth="250"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ClipToBounds="True"
                                           Text="{PluginSettings Plugin=NowPlaying, Path=RunningGame.GameName}" />
                                <TextBlock FontSize="20"
                                           Margin="5,0,0,0"
                                           Width="30"
                                           TextAlignment="Left"
                                           Style="{DynamicResource TextBlockBaseStyle}">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text"
                                                                                   Duration="0:0:1.2"
                                                                                   RepeatBehavior="Forever">
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value="." />
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.4" Value=".." />
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.8" Value="..." />
                                                    </StringAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.RowSpan="3"
                                VerticalAlignment="Bottom"
                                Padding="26,12,18,18"
                                Background="#0E000000"
                                Panel.ZIndex="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Button visible -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Opacity="0.92">
                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="A"
                                              Content="{DynamicResource LOCBackToLibrary}" />
                                </StackPanel>

                                <!-- Vrai bouton focusable, invisible -->
                                <ButtonEx x:Name="GameStatusButton"
                                          Grid.Column="1"
                                          Command="{Binding DataContext.CloseGameStatusCommand, RelativeSource={RelativeSource AncestorType=Main}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0.01"
                                          Width="260"
                                          Height="44"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Focusable="True"
                                          IsTabStop="True"
                                          Content=""
                                          Foreground="Transparent"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Setter TargetName="PART_ViewHost" Property="FocusManager.IsFocusScope" Value="True"/>
                            <Setter TargetName="PART_ViewHost" Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
                            <Setter TargetName="PART_ViewHost" Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
                            <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=GameStatusButton}"/>
                            <Setter TargetName="PART_ViewHost" Property="IsEnabled" Value="True"/>
                        </Trigger>

                        <Trigger Property="IsVisible" Value="False">
                            <Setter TargetName="PART_ViewHost" Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

