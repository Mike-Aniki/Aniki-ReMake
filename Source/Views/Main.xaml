                                    <Border HorizontalAlignment="Stretch" Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorTopBarBrush}" Opacity="{DynamicResource OpacityBar}" CornerRadius="0"/>

                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Library needs a little more room when every center action is visible. -->
                                        <ColumnDefinition Width="500"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="500"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- Avatar Left -->

                                    <Grid Grid.Column="0" Effect="{StaticResource SoftTextShadow}" Grid.Row="0" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">

                                        <ButtonEx x:Name="QuickAccessButton" Grid.ColumnSpan="3" MinWidth="50" Height="60" Padding="10,0,10,0" Focusable="True" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[QuickAccessWindowStyle|FocusFirst]}">

                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource TopBarIndicatorButtonStyle}">
                                                    <Setter Property="Opacity" Value="0.92"/>
                                                </Style>


                                            </ButtonEx.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- AVATAR -->
                                                <Grid Width="56" Height="56" VerticalAlignment="Center">

                                                    <!-- masque rond -->
                                                    <Border x:Name="AvatarMaskHeader" Width="56" Height="56" Background="Black" CornerRadius="28"/>

                                                    <!-- path image avatar -->
                                                    <TextBlock x:Name="ProfilePicturePathHeader" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text">
                                                                    <Setter.Value>
                                                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- image user masquée en rond -->
                                                    <Grid Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
