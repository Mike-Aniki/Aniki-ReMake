                                                <CheckBoxEx x:Name="ButtonPower" Content="{DynamicResource LOCPower}" Style="{StaticResource WelcomeHubQuickButtonStyleCheckBoxEx}" MinWidth="120" Margin="8,0" Padding="20,8" FocusVisualStyle="{x:Null}" Grid.Column="7" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsChecked="True">

                                                </CheckBoxEx>







                                            </StackPanel>
                                        </Grid>
