                                                        <ButtonEx.Triggers>
                                                            <EventTrigger RoutedEvent="GotKeyboardFocus">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="HubSectionsTranslate"
                                                                                         Storyboard.TargetProperty="Y"
                                                                                         To="0"
                                                                                         Duration="0:0:0.30">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </ButtonEx.Triggers>

