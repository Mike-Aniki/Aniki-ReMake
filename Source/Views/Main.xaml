                                                                    <MediaTimeline Storyboard.TargetName="OpenViewSound" Source="{ThemeFile 'audio/OpenAdditionalView.wav'}" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
