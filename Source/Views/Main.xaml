                                                        </ObjectAnimationUsingKeyFrames>

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>

                                            <MultiDataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BeginLuckyDayNotif"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
