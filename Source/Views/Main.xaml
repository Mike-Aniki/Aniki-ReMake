                                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SuggestedGameBackgroundPathA}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
