                                                    <Border x:Name="NormalBackground" CornerRadius="7" Background="#10000000" BorderBrush="#12FFFFFF" BorderThickness="1"/>

                                                    <!-- FOCUS BACKGROUND -->
                                                    <Border x:Name="MainBackground" CornerRadius="7" Background="{DynamicResource ButtonBackgroundFocus}" Visibility="Collapsed"/>

                                                    <!-- FOCUS BORDER -->
                                                    <Border x:Name="MainBorder" BorderThickness="2" CornerRadius="7" BorderBrush="{DynamicResource FocusGameBorderBrush}" Visibility="Collapsed"/>

                                                    <!-- FLASH FX -->
                                                    <Border x:Name="FlashMenuBorder" CornerRadius="7" Style="{DynamicResource AnimatedFlashMenu}" Tag="False" Visibility="Collapsed"/>

                                                    <ContentPresenter Margin="18,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="NormalBackground" Property="Background" Value="#26000000"/>
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Grid.Resources>


                            <!-- MAIN PANEL -->
                            <Grid x:Name="PowerPanel" Width="520" HorizontalAlignment="Left" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.ControlTabNavigation="Contained">
                                <Grid.Resources>
                                    <Style x:Key="PowerButtonStyle" TargetType="ButtonEx">
                                        <Setter Property="Height" Value="72"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Focusable" Value="True"/>
                                        <Setter Property="IsTabStop" Value="True"/>
                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ButtonEx">

                                                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">

                                                        <!-- FOCUS BACKGROUND -->
                                                        <Border x:Name="MainBackground" Margin="0" CornerRadius="4" Background="{DynamicResource ButtonBackgroundFocus}" Visibility="Collapsed"/>

                                                        <!-- FOCUS BORDER -->
                                                        <Border x:Name="MainBorder" Margin="0" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource FocusGameBorderBrush}" Visibility="Collapsed"/>

                                                        <!-- FLASH FX -->
                                                        <Border x:Name="FlashMenuBorder" Margin="0" CornerRadius="4" Style="{DynamicResource AnimatedFlashMenu}" Tag="False" Visibility="Collapsed"/>

                                                        <!-- CONTENT -->
                                                        <Grid Margin="18,0">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- ICON -->
                                                            <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="{StaticResource FontIcons}" FontSize="25" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True"/>

                                                            <!-- LABEL -->
                                                            <ContentPresenter Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" TextElement.FontFamily="{DynamicResource FontMain}" TextElement.FontSize="22" TextElement.FontWeight="SemiBold" TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                            <!-- CHEVRON / EMPTY SLOT -->
                                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{DynamicResource FontIcons}" FontSize="16" Opacity="0" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        </Grid>

                                                    </Grid>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </Trigger>

                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>

                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-60" To="0" Duration="0:0:0.30">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <!-- PANEL BACKGROUND -->
                                <Border Background="{DynamicResource OverlayMenu}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,1,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="#000000" RenderingBias="Performance"/>
                                    </Border.Effect>
                                </Border>

                                <!-- GLASS OVERLAY -->
                                <Border Background="{DynamicResource GlassMainBrush}" IsHitTestVisible="False" Opacity="0.55"/>


                                <!-- INNER CONTENT -->
                                <Grid Margin="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#33000000" Grid.Row="0"/>
                                    <Border Background="#33000000" Grid.Row="4"/>


                                    <!-- HEADER -->
                                    <Grid Grid.Row="0" Height="96" Margin="22,10,22,10">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="54" Height="54" CornerRadius="27" Background="#14000000" BorderBrush="#24FFFFFF" BorderThickness="1" VerticalAlignment="Center">

                                            <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource FontIcons}" Foreground="{DynamicResource TextHighlightBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="16,0,0,0">

                                            <TextBlock Text="{DynamicResource LOCPowerControlCenter}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHighlightBrush}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{DynamicResource LOCPowerControlCenter}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" Opacity="0.65" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                    </Grid>


                                    <!-- SEPARATOR -->
                                    <Border Grid.Row="1" Height="1" Margin="22,0" Background="#20FFFFFF"/>


                                    <!-- BUTTONS -->
                                    <ScrollViewer Grid.Row="2" Margin="16,14,16,14" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">

                                        <StackPanel Orientation="Vertical" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">

                                            <!-- EXIT PLAYNITE -->
                                            <ButtonEx x:Name="ExitCommand" pbeh:FocusBahaviors.OnVisibilityFocus="True" Tag="&#xE8BB;" Content="{DynamicResource LOCExitPlaynite}" Command="{Binding Data.MainMenu.ExitCommand, Source={StaticResource ANIKIHELPER_Commands}}" Style="{StaticResource PowerButtonStyle}"/>

                                            <!-- MINIMIZE -->
                                            <ButtonEx x:Name="MinimizeCommand" Tag="&#xE921;" Content="{DynamicResource LOCMinimize}" Command="{Binding Data.MainMenu.MinimizeCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowMinimize}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- DESKTOP MODE -->
                                            <ButtonEx x:Name="DesktopCommand" Tag="&#xEC4E;" Content="{DynamicResource LOCBackToDesktopMode}" Command="{Binding SwitchToDesktopCommand}" Style="{StaticResource PowerButtonStyle}"/>

                                            <!-- SEPARATOR -->
                                            <Border Height="1" Margin="22,5,22,5" Background="#20FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=LockCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=LogoutCommand, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- LOCK SYSTEM -->
                                            <ButtonEx x:Name="LockCommand" Tag="&#xE72E;" Content="{DynamicResource LOCMenuLockSystem}" Command="{Binding Data.MainMenu.LockSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowLock}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- LOG OUT USER -->
                                            <ButtonEx x:Name="LogoutCommand" Tag="&#xE8AC;" Content="{DynamicResource LOCMenuLogoutUser}" Command="{Binding Data.MainMenu.LogoutUserCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowLogout}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <Border Height="1" Margin="22,5,22,5" Background="#20FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=SleepCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=HibernateCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=RestartCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=ShutdownCommand, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- SLEEP SYSTEM -->
                                            <ButtonEx x:Name="SleepCommand" Tag="&#xE708;" Content="{DynamicResource LOCMenuSuspendSystem}" Command="{Binding Data.MainMenu.SleepSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowSuspend}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- HIBERNATE SYSTEM -->
                                            <ButtonEx x:Name="HibernateCommand" Tag="&#xE823;" Content="{DynamicResource LOCMenuHibernateSystem}" Command="{Binding Data.MainMenu.HibernateSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowHibernate}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- RESTART SYSTEM -->
                                            <ButtonEx x:Name="RestartCommand" Tag="&#xE72C;" Content="{DynamicResource LOCMenuRestartSystem}" Command="{Binding Data.MainMenu.RestartSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowRestart}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- SHUTDOWN SYSTEM -->
                                            <ButtonEx x:Name="ShutdownCommand" Tag="&#xE7E8;" Content="{DynamicResource LOCMenuShutdownSystem}" Command="{Binding Data.MainMenu.ShutdownSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowShutdown}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                        </StackPanel>
                                    </ScrollViewer>


                                    <!-- SEPARATOR -->
                                    <Border Grid.Row="3" Height="1" Margin="22,0" Background="#20FFFFFF"/>


                                    <!-- FOOTER -->
                                    <Grid Grid.Row="4" Height="58" Margin="22,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource LOCPower}" FontSize="13" FontWeight="Bold" Style="{DynamicResource TextBlockBaseStyle}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="CancelAction" Content="{DynamicResource LOCBackLabel}" Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}" CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]"/>

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Grid>


                        <Grid>
                            <ContentControl x:Name="UPS_MusicControl">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Tag" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>



                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=LocalTrailer, Path=Volume}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=TrailerVideoLoadedFlag, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=LocalTrailer, Path=Volume}" Value="0"/>
                                                    <Condition Binding="{Binding ElementName=TrailerVideoLoadedFlag, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="False"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>


                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubClosing}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- Pause UPS dans les fenêtres Aniki, sauf en Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>

                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- Pause UPS when another Windows app is foreground. -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="False">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <!-- Standalone Video Player always has audio priority. -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="True">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <!-- Pause UPS avec le navigateur Web, sauf en Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWebBrowserOpen}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- ScreenSaver soundtrack has priority over UPS, except Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>



                            <ContentControl x:Name="Sounds_MusicControl">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Tag" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="False"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>


                        <!-- Sound -->


                        <!-- ScreenSaver ambient soundtrack. Theme/UPS music is paused while this is active. -->
                        <MediaElement x:Name="ScreenSaverOST"
                                      Source="{PluginSettings Plugin=AnikiHelper, Path=SoundPackScreenSaverOstPath}"
                                      Volume="{Settings Fullscreen.BackgroundVolume}"
                                      MediaElementBehaviors.Repeat="True">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <!-- ========================================================== MUSIQUE DES FENÊTRES SECONDAIRES — MODE NORMAL ========================================================== -->

                        <MediaElement x:Name="SecondaryViewsOSTNormal" Source="{PluginSettings Plugin=AnikiHelper, Path=SoundPackSecondaryViewsOstPath}" Volume="{Settings Fullscreen.BackgroundVolume}" MediaElementBehaviors.Repeat="True">

                            <MediaElement.Style>
                                <Style TargetType="MediaElement">

                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Jouer uniquement en mode normal -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsMediaGalleryVideoPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="False"/>


                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>


                                        <!-- Radio Mode prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- Arrêter complètement la musique normale en Lucky Mode -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
