                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85"/>
                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Padding="18,10" SnapsToDevicePixels="True" BorderBrush="{DynamicResource HubCardBottomBorderBrush}" BorderThickness="0,2,0,0">
                                                                                    <Grid>
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                            <RowDefinition Height="*"/>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                        </Grid.RowDefinitions>
