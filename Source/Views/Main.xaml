                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubMostPlayedName}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>

                                                                <Grid Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
