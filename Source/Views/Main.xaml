                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ButtonEx Width="700" Height="370" Focusable="True" FocusVisualStyle="{x:Null}" Style="{StaticResource HubCardFocusButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[FriendsStyle|SecondaryMusic]}">

                                                                        <Border CornerRadius="20" Style="{DynamicResource HubCardBorderStyle}">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <!-- IMAGE / BACKGROUND -->
                                                                                <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="20" ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <Grid.OpacityMask>
                                                                                            <VisualBrush Visual="{Binding ElementName=HubFriendActivityImageMask}" Stretch="Fill"/>
                                                                                        </Grid.OpacityMask>

                                                                                        <Border x:Name="HubFriendActivityImageMask" CornerRadius="20" Background="Black"/>

                                                                                        <Border Background="{DynamicResource HubCardBottomBackgroundBrush}"/>

                                                                                        <!-- Main game image when available -->
                                                                                        <Image Source="{Binding gameImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                                                                                            <Image.Style>
                                                                                                <Style TargetType="Image">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding gameImage}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding gameImage}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Image.Style>
                                                                                        </Image>

                                                                                        <!-- Friend avatar fallback for empty cards. -->
                                                                                        <Image Source="{Binding friendAvatar}" Stretch="UniformToFill" Opacity="0.38" RenderOptions.BitmapScalingMode="Fant">
                                                                                            <Image.Style>
                                                                                                <Style TargetType="Image">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding gameImage}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding gameImage}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Image.Style>
                                                                                        </Image>

                                                                                        <Border Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                                                                                        <Border VerticalAlignment="Bottom" Height="120" IsHitTestVisible="False">
                                                                                            <Border.Background>
                                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                                                    <GradientStop Color="#CC000000" Offset="1"/>
                                                                                                </LinearGradientBrush>
                                                                                            </Border.Background>
                                                                                        </Border>

                                                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="10,4" CornerRadius="8" Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}">
                                                                                            <TextBlock Text="{Binding badgeText}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubSuggestedGameBannerBrush}" FontSize="15" FontWeight="SemiBold"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- BOTTOM INFO -->
                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85"/>
                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Padding="18,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource HubCardBottomBorderBrush}" BorderThickness="0,2,0,0">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">

                                                                                            <Border x:Name="HubFriendActivityFooterIconMask" Width="48" Height="48" CornerRadius="24" Background="Black"/>

                                                                                            <Image Source="{Binding footerIcon}" Width="48" Height="48" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                                                                <Image.OpacityMask>
                                                                                                    <VisualBrush Visual="{Binding ElementName=HubFriendActivityFooterIconMask}" Stretch="Fill"/>
                                                                                                </Image.OpacityMask>
                                                                                            </Image>

                                                                                            <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#88FFFFFF" BorderThickness="1.2" Background="#16000000" IsHitTestVisible="False"/>
                                                                                        </Grid>

                                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding title}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                                                                            <TextBlock Text="{Binding subtitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="17" Opacity="0.82" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ButtonEx>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </Grid.Resources>

                                            <ContentControl RenderTransformOrigin="0.5,0.5">
                                                <ContentControl.RenderTransform>
                                                    <TranslateTransform X="0"/>
                                                </ContentControl.RenderTransform>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Keep only current / previous / next Hub pages instantiated. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShouldLoadFriendActivityPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubFriendActivityContentTemplate}"/>
                                                            </MultiDataTrigger>

                                                            <!-- Only the active Hub page can take focus. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsFriendActivityPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubFriendActivityContentTemplate}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </MultiDataTrigger>

                                                            <!-- Shorter enter animation for fast LB/RB navigation. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsFriendActivityPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubFriendActivityForwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubFriendActivityForwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Backward enter. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsFriendActivityPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubFriendActivityBackwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubFriendActivityBackwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Keep previous Hub page alive for cross-fade. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasFriendActivityPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubFriendActivityForwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubFriendActivityForwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasFriendActivityPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubFriendActivityBackwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubFriendActivityBackwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>

                                        <!-- PAGE UPCOMING -->
                                        <Grid x:Name="HubUpcomingSection" Grid.Row="0" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">

                                            <Grid.Resources>
                                                <DataTemplate x:Key="HubUpcomingContentTemplate">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Orientation="Vertical" Margin="0,0,0,10" Grid.Row="0">
                                                            <TextBlock Text="{DynamicResource LOCUpcomingSoon}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardTitleBrush}" FontSize="34" FontWeight="Bold" Margin="0,0,0,5"/>

                                                            <TextBlock Text="{DynamicResource LOCUpcomingReleases}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" Opacity="0.75" Margin="0,0,0,0"/>

                                                        </StackPanel>

                                                        <ItemsControl Grid.Row="1" ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreUpcomingHub}" AlternationCount="20" HorizontalAlignment="Center" VerticalAlignment="Top" FocusVisualStyle="{x:Null}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">

                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Width="1560" ItemWidth="780" ItemHeight="420"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>

                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Margin" Value="20"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ButtonEx Width="700" Height="370" Focusable="True" FocusVisualStyle="{x:Null}" Style="{StaticResource HubCardFocusButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenSteamStoreDetailsCommand}" CommandParameter="{Binding}">

                                                                        <Border CornerRadius="20" Style="{DynamicResource HubCardBorderStyle}">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <!-- IMAGE -->
                                                                                <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="20" ClipToBounds="True">

                                                                                    <Grid>
                                                                                        <!-- Mask arrondi comme Store -->
                                                                                        <Grid.OpacityMask>
                                                                                            <VisualBrush Visual="{Binding ElementName=UpcomingImageMask}" Stretch="Fill"/>
                                                                                        </Grid.OpacityMask>

                                                                                        <Border x:Name="UpcomingImageMask" CornerRadius="20" Background="Black"/>

                                                                                        <Image RenderOptions.BitmapScalingMode="Fant" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                            <Image.Source>
                                                                                                <Binding Path="StoreCardImage" IsAsync="True"/>
                                                                                            </Image.Source>
                                                                                        </Image>
                                                                                        <Border Panel.ZIndex="4" Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                                                                                        <!-- Dégradé lisibilité -->
                                                                                        <Border Panel.ZIndex="5" IsHitTestVisible="False" CornerRadius="20">
                                                                                            <Border.Background>
                                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                    <GradientStop Color="#16000000" Offset="0"/>
                                                                                                    <GradientStop Color="#00000000" Offset="0.35"/>
                                                                                                    <GradientStop Color="#66000000" Offset="1"/>
                                                                                                </LinearGradientBrush>
                                                                                            </Border.Background>
                                                                                        </Border>

                                                                                        <!-- Badge discount en haut à droite -->
                                                                                        <Border Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Background="#DD10151C" CornerRadius="9" Padding="10,5">
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding DiscountDisplay}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>

                                                                                            <TextBlock Text="{Binding DiscountDisplay}" Foreground="White" FontSize="17" FontWeight="Bold"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- BANDEAU BAS -->
                                                                                <Grid Grid.Row="1">
                                                                                    <Border CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85" IsHitTestVisible="False"/>
                                                                                    <Border Style="{StaticResource HubBottomBannerStyle}" Background="Transparent">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <!-- Date de sortie à gauche -->
                                                                                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">

                                                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="14" FontWeight="SemiBold" Opacity="0.65" TextTrimming="CharacterEllipsis"/>

                                                                                                <TextBlock Text="{Binding ReleaseDateDisplay}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                                            </StackPanel>

                                                                                            <!-- Prix à droite -->
                                                                                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="25,0,0,0">

                                                                                                <TextBlock Text="{Binding OriginalPriceDisplay}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="15" Opacity="0.55" HorizontalAlignment="Right" TextDecorations="Strikethrough">
                                                                                                    <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding OriginalPriceDisplay}" Value="">
                                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </TextBlock.Style>
                                                                                                </TextBlock>

                                                                                                <TextBlock Text="{Binding FinalPriceDisplay}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                                                                    <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding FinalPriceDisplay}" Value="">
                                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </TextBlock.Style>
                                                                                                </TextBlock>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ButtonEx>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </Grid.Resources>
                                            <ContentControl RenderTransformOrigin="0.5,0.5">
                                                <ContentControl.RenderTransform>
                                                    <TranslateTransform X="0"/>
                                                </ContentControl.RenderTransform>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Keep only current / previous / next Hub pages instantiated. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShouldLoadUpcomingPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubUpcomingContentTemplate}"/>
                                                            </MultiDataTrigger>

                                                            <!-- Only the active Hub page can take focus. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsUpcomingPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubUpcomingContentTemplate}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </MultiDataTrigger>

                                                            <!-- Shorter enter animation for fast LB/RB navigation. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsUpcomingPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubUpcomingForwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubUpcomingForwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Backward enter. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsUpcomingPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubUpcomingBackwardEnter" HandoffBehavior="SnapshotAndReplace">
