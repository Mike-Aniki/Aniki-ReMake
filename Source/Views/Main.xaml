                                    <Border CornerRadius="0" Opacity="{DynamicResource OpacityBar}" Margin="1" BorderBrush="{DynamicResource GlassInnerLineBrush}" IsHitTestVisible="False" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

