                                        <ButtonEx x:Name="HiddenOpenAchievementsButton" Width="1" Height="1" Opacity="0" Focusable="False" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[AchievementsWindow|SortButton|SecondaryMusic]}"/>



                                        <ButtonEx x:Name="NowPlay" Content="NowPlay" Command="{PluginSettings Plugin=NowPlaying, Path=OpenCustomDialog}" Height="40" MinWidth="50" Margin="0,0,7,0" Padding="0" Grid.Column="0">
