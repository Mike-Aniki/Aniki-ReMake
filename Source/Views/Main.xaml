                                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" Padding="9,4" Background="#CC11161E" CornerRadius="7">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
