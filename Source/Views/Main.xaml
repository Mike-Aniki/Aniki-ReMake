                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[DisableCenterTopButtons]}" Value="true">
