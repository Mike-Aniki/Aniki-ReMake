                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                            <TextBlock Text="{DynamicResource LOCHubVideoCenterRecentlyAdded}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="13" FontWeight="SemiBold" Opacity="0.65">
