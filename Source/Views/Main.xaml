                    </Grid>

                    <ControlTemplate.Triggers>


                        <DataTrigger Binding="{Settings Fullscreen.HorizontalLayout}" Value="True">
                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeViewButton, Path=IsChecked, Mode=TwoWay}" />
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutHorizontal}" />

                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeViewButton, Path=IsChecked, Mode=TwoWay}" />
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutVertical}" />

                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True" />
                                <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="ChangeViewButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChangeDetailsButton" Property="Visibility" Value="Collapsed" />

                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeDetailsButton, Path=IsChecked}" />
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutList}" />

                        </MultiDataTrigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

