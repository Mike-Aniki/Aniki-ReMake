                                                    <RadioButton Content="Tiles" GroupName="Group" Margin="0,5,0,0" IsChecked="{Settings Fullscreen.ShowGameTitles, Mode=TwoWay, Converter={StaticResource NegateConverter}}"/>
                                                </StackPanel>

                                                <ButtonEx x:Name="PART_ButtonFilter" Content="{DynamicResource LOCFilter}" MinWidth="120" Margin="8,0" Padding="20,8" Style="{DynamicResource WelcomeHubQuickButtonStyle}" Grid.Column="7"/>

                                                <ButtonEx x:Name="PART_ButtonSearch" Content="{DynamicResource LOCSearchLabel}" MinWidth="120" Margin="8,0" Padding="20,8" Style="{DynamicResource WelcomeHubQuickButtonStyle}" Grid.Column="7"/>


                                                <ButtonEx x:Name="ToolsCommand" Content="{DynamicResource LOCMenuTools}" MinWidth="120" Margin="8,0" Padding="20,8" Command="{Binding Data.MainMenu.OpenToolsCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowToolsButton]}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
