                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="600" To="0" BeginTime="0:0:2" Duration="0:0:0.35" AccelerationRatio="0.3" DecelerationRatio="0.7"/>

                                                        <!-- Battement continu X pendant toute la notification -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:2" Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:1.70" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.00" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.25" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.55" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.30" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.55" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.85" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.60" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.85" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:9.15" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:10.90" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.15" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.45" Value="1"/>
                                                        </DoubleAnimationUsingKeyFrames>

                                                        <!-- Battement continu Y pendant toute la notification -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:2" Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:1.70" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.00" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.25" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.55" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.30" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.55" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.85" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.60" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.85" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:9.15" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:10.90" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.15" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.45" Value="1"/>
                                                        </DoubleAnimationUsingKeyFrames>

