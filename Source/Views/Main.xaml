                                                        </StackPanel>

                                                        <ItemsControl Grid.Row="1" ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamStoreRecommendedHub}" AlternationCount="20" HorizontalAlignment="Center" VerticalAlignment="Top" FocusVisualStyle="{x:Null}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Width="1560" ItemWidth="780" ItemHeight="420"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
