                                        <!-- Update -->
                                        <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center" Margin="0,0,7,0" Padding="0" Height="40" MinWidth="50" Background="Transparent" BorderThickness="0" Focusable="True" Style="{DynamicResource TopBarIndicatorButtonStyle}" Grid.Column="1">
                                            <ButtonEx.Content>
