                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubMostPlayedIsMonthly}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <TextBlock Text="{DynamicResource LOCHubMostPlayed}" HorizontalAlignment="Center" Foreground="{DynamicResource TextHubBannerCardTitleBrush}" FontSize="24" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubMostPlayedIsMonthly}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>

                                                                <ButtonEx x:Name="HubPage2MostPlayedCard" Grid.Row="1" Width="700" Height="370" Focusable="True" FocusVisualStyle="{x:Null}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenGameDetailsCommand}" CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=HubMostPlayedGameId}" Style="{StaticResource HubCardFocusButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                    <Border CornerRadius="20" Style="{DynamicResource HubCardBorderStyle}">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="*"/>
