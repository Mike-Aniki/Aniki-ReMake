                                                <Condition Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWebBrowserOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsClosing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource FirstSetupMusicFadeOutStop}"/>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>






                                        <!-- Arrêter complètement si Lucky Style 1 n'est plus actif -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- La Radio UniPlaySong est prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- Lucky / Rare Mode Hub OST - Style 2 -->
                        <MediaElement x:Name="WelcomeOpenLuckyStyle2" Source="{ThemeFile 'audio/Lucky/HubOST2.mp3'}" MediaElementBehaviors.Repeat="True" Volume="{Settings Fullscreen.BackgroundVolume}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Jouer la musique du Hub uniquement lorsque Lucky Style 2 est actif -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWebBrowserOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=FirstSetup.IsClosing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource FirstSetupMusicFadeOutStop}"/>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>




                                        <!-- Pause UPS si Playnite perd le focus avec le Hub ouvert. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiWindowOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="LoadedBehavior" Value="Pause"/>
                                        </MultiDataTrigger>


                                        <!-- Arrêter complètement si Lucky Style 2 n'est plus actif -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- La Radio UniPlaySong est prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>




                        <Canvas x:Name="AnikiFocusedCoverOverlayLayer" Panel.ZIndex="500" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" ClipToBounds="False" Visibility="Collapsed">
                            <Grid x:Name="AnikiFocusedCoverOverlayPanel" Width="400" Height="300" Opacity="0" Visibility="Collapsed" Background="Black" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0" Y="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=AnikiFocusedCoverOverlayMask}" Stretch="Fill"/>
                                </Grid.OpacityMask>

                                <Border x:Name="AnikiFocusedCoverOverlayMask" Background="Black" CornerRadius="{DynamicResource Corner}"/>

                                <Image x:Name="AnikiFocusedCoverOverlayBackground" Opacity="0" Visibility="Collapsed" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>

                                <MediaElement x:Name="AnikiFocusedCoverOverlayMedia" Opacity="0" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LoadedBehavior="Play" UnloadedBehavior="Close" ScrubbingEnabled="False" MediaElementBehaviors.Repeat="True" Tag="{DynamicResource UseAbsoluteExtraMetadataPath}"/>

                                <Border x:Name="AnikiFocusedCoverOverlayCover" Background="Black" Opacity="1" CornerRadius="{DynamicResource Corner}"/>

                                <Border x:Name="AnikiFocusedCoverOverlaySweep" Width="92" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#A8FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="AnikiFocusedCoverOverlayShade" Background="#B0000000" Opacity="0" CornerRadius="{DynamicResource Corner}"/>

                                <!-- White transition wash above the dark shade. -->
                                <Border x:Name="AnikiFocusedCoverOverlaySilver" Background="#FFFFFFFF" Opacity="0" IsHitTestVisible="False" CornerRadius="{DynamicResource Corner}"/>

                                <Image x:Name="AnikiFocusedCoverOverlayLogo" Opacity="0" Visibility="Collapsed" MaxWidth="285" MaxHeight="130" Margin="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="Fant">
                                    <Image.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.72"/>
                                    </Image.Effect>
                                </Image>

                                <Border x:Name="AnikiFocusedCoverOverlayEdge" BorderBrush="{DynamicResource FocusGameBorderBrush}" BorderThickness="3.5" Margin="-1" Opacity="0" CornerRadius="{DynamicResource Corner}"/>
                            </Grid>
                        </Canvas>


                    </Grid>

                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Settings Fullscreen.HorizontalLayout}" Value="True">
                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeViewButton, Path=IsChecked, Mode=TwoWay}"/>
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutHorizontal}"/>

                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="False"/>
                                <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeViewButton, Path=IsChecked, Mode=TwoWay}"/>
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutVertical}"/>

                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False"/>
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="ChangeViewButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ChangeDetailsButton" Property="Visibility" Value="Collapsed"/>

                            <Setter TargetName="ToggleViewButton" Property="IsChecked" Value="{Binding ElementName=ChangeDetailsButton, Path=IsChecked}"/>
                            <Setter TargetName="ToggleViewButton" Property="Content" Value="{DynamicResource LOCLayoutList}"/>

                        </MultiDataTrigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
