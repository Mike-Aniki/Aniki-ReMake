<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:p="clr-namespace:Playnite;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    xmlns:ctrl="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:prism="clr-namespace:Prism.Interactivity;assembly=Prism.Wpf"
                    xmlns:Behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:BehaviorsCore="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:BehaviorsMedia="clr-namespace:Microsoft.Xaml.Behaviors.Media;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:fullscreen="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
                    xmlns:playnite="clr-namespace:Playnite;assembly=Playnite"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="{ThemeFile 'DerivedStyles/WelcomeHubResources.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/FriendProfil.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/FriendView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/ScreenshotView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/FriendProfil.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/FriendView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/SteamStore.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/PlayniteAchievementMainView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/SuccessStoryMainView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/ProfilView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/QuickOptionsView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/NewsView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/NowPlayingView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/GameNewsView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/QuickAccessMenu.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/MenuNotification.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/HelpMenu.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/WhatsNewView.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/QuickAccessNotification.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/QuickAccessSteamStatut.xaml'}" />
        <ResourceDictionary Source="{ThemeFile 'Views/AdditionalViews/ScreenshotGlobalView.xaml'}" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Wrong Message -->
    <Style x:Key="WrongSettingStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="WrongSettingRoot"
                          Background="{DynamicResource OverlayMenu}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=SliderColumns}">

                        <Rectangle Fill="#CC000000" />

                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22000000" Offset="0" />
                                    <GradientStop Color="#44000000" Offset="0.45" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid Width="1320"
                              Height="860"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10">

                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="35"
                                                  ShadowDepth="0"
                                                  Opacity="0.45"
                                                  Color="Black" />
                            </Grid.Effect>

                            <Border CornerRadius="28"
                                    Background="#E6101115"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1" />

                            <Border Margin="10"
                                    CornerRadius="22"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1.5"
                                    Background="{DynamicResource TopBar}" />

                            <Border Margin="10"
                                    CornerRadius="22"
                                    VerticalAlignment="Top"
                                    Height="145"
                                    Opacity="0.22"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="70,44,70,42">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical">

                                    <Border Padding="18,8,18,8"
                                            CornerRadius="18"
                                            Background="#AA7A1010"
                                            BorderBrush="#55FF6B6B"
                                            BorderThickness="1.2"
                                            HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xea39;"
                                                       FontFamily="{DynamicResource FontIcoFont}"
                                                       FontSize="24"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#FFFF8A8A" />
                                            <TextBlock Text="{DynamicResource LOCWrongSetting}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="26"
                                                       VerticalAlignment="Center"
                                                       Typography.Capitals="AllSmallCaps" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Margin="0,28,0,0"
                                               Text="{DynamicResource LOCWrongSettingText1}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               MaxWidth="980"
                                               FontSize="34"
                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                </StackPanel>

                                <!-- Separator -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="120,28,120,0"
                                        Background="{DynamicResource TextBrush}"
                                        Opacity="0.14" />

                                <!-- Settings cards -->
                                <StackPanel Grid.Row="3"
                                            Orientation="Vertical"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Stretch">

                                    <!-- Columns -->
                                    <Border CornerRadius="22"
                                            Background="#14000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="30,24,30,24">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{DynamicResource LOCSettingsFullscreenColumns}"
                                                           FontSize="28"
                                                           Foreground="White"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{DynamicResource LOCWrongColumnsHelp}"
                                                           TextWrapping="Wrap"
                                                           FontSize="19"
                                                           Opacity="0.82"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                                <Border Margin="0,14,0,0"
                                                        Padding="14,8,14,8"
                                                        CornerRadius="14"
                                                        Background="#22311E1E"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock FontSize="18"
                                                               Foreground="#FFF1D1D1">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Text" Value="{DynamicResource LOCWrongColumnsRecommended}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Settings CoverAspectRatio}" Value="1:1">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCWrongColumnsRecommended2}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Settings CoverAspectRatio}" Value="92:43">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCWrongColumnsRecommended3}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <Grid Grid.Row="2"
                                                  Margin="0,20,0,0"
                                                  VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Height="48"
                                                        Padding="0"
                                                        CornerRadius="14"
                                                        Background="#22000000"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Settings Fullscreen.Columns}"
                                                               FontSize="28"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                </Border>

                                                <SliderEx x:Name="SliderColumns"
                                                          Grid.Column="2"
                                                          Width="600"
                                                          VerticalAlignment="Center"
                                                          Focusable="True"
                                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                          pbeh:FocusBahaviors.FocusBinding="True"
                                                          IsSnapToTickEnabled="True"
                                                          TickFrequency="1"
                                                          Minimum="1"
                                                          Maximum="10"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          Value="{Settings Fullscreen.Columns, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Rows -->
                                    <Border Margin="0,22,0,0"
                                            CornerRadius="22"
                                            Background="#14000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="30,24,30,24">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{DynamicResource LOCSettingsFullscreenRows}"
                                                           FontSize="28"
                                                           Foreground="White"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{DynamicResource LOCWrongRowsHelp}"
                                                           TextWrapping="Wrap"
                                                           FontSize="19"
                                                           Opacity="0.82"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                                <Border Margin="0,14,0,0"
                                                        Padding="14,8,14,8"
                                                        CornerRadius="14"
                                                        Background="#22311E1E"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock FontSize="18"
                                                               Foreground="#FFF1D1D1">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Text" Value="{DynamicResource LOCWrongRowsRecommended}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Settings CoverAspectRatio}" Value="1:1">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCWrongRowsRecommended2}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Settings CoverAspectRatio}" Value="92:43">
                                                                        <Setter Property="Text" Value="{DynamicResource LOCWrongRowsRecommended3}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <Grid Grid.Row="2"
                                                  Margin="0,20,0,0"
                                                  VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Height="48"
                                                        Padding="0"
                                                        CornerRadius="14"
                                                        Background="#22000000"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Settings Fullscreen.Rows}"
                                                               FontSize="28"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                </Border>

                                                <SliderEx x:Name="SliderRows"
                                                          Grid.Column="2"
                                                          Width="600"
                                                          VerticalAlignment="Center"
                                                          IsSnapToTickEnabled="True"
                                                          TickFrequency="1"
                                                          Minimum="1"
                                                          Maximum="10"
                                                          Style="{DynamicResource SettingsSectionSlider}"
                                                          Value="{Settings Fullscreen.Rows, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ThemeSettings -->
    <Style x:Key="TOMissingStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="TOMissingRoot"
                          Background="{DynamicResource OverlayMenu}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained"
                          FocusManager.FocusedElement="{Binding ElementName=Wrong}">

                        <!-- Dim global -->
                        <Rectangle Fill="#CC000000" />

                        <!-- Légère couche premium -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22000000" Offset="0" />
                                    <GradientStop Color="#44000000" Offset="0.45" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Carte centrale -->
                        <Grid Width="1180"
                              Height="700"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,20">

                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="35"
                                                  ShadowDepth="0"
                                                  Opacity="0.45"
                                                  Color="Black" />
                            </Grid.Effect>

                            <!-- couche fond -->
                            <Border CornerRadius="28"
                                    Background="#E6101115"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1" />

                            <!-- couche interne -->
                            <Border Margin="10"
                                    CornerRadius="22"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1.5"
                                    Background="{DynamicResource TopBar}" />

                            <!-- lueur haute -->
                            <Border Margin="10"
                                    CornerRadius="22"
                                    VerticalAlignment="Top"
                                    Height="140"
                                    Opacity="0.22"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="70,50,70,45">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical">

                                    <Border Padding="18,8,18,8"
                                            CornerRadius="18"
                                            Background="#AA7A1010"
                                            BorderBrush="#55FF6B6B"
                                            BorderThickness="1.2"
                                            HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xea39;"
                                                       FontFamily="{DynamicResource FontIcoFont}"
                                                       FontSize="24"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#FFFF8A8A" />
                                            <TextBlock Text="{DynamicResource LOCMissingAddon}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="26"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Typography.Capitals="AllSmallCaps" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Margin="0,36,0,0"
                                               Text="{DynamicResource LOCToMissingText1}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               FontSize="38"
                                               Foreground="White"
                                               Style="{DynamicResource TextBlockBaseStyle}" />

                                    <TextBlock Margin="0,14,0,0"
                                               Text="{DynamicResource LOCToMissingText2}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               MaxWidth="860"
                                               FontSize="22"
                                               Opacity="0.78"
                                               Foreground="{DynamicResource TextBrush}"
                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                </StackPanel>

                                <!-- Séparateur -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="90,34,90,0"
                                        Background="{DynamicResource TextBrush}"
                                        Opacity="0.14" />

                                <!-- Bloc explications -->
                                <Grid Grid.Row="3"
                                      Margin="0,35,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Colonne gauche -->
                                    <Border Grid.Column="0"
                                            CornerRadius="20"
                                            Background="#14000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="34,28,34,28">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCRequiredPlugins}"
                                                       FontSize="24"
                                                       Foreground="White"
                                                       Style="{DynamicResource TextBlockBaseStyle}" />

                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="• Aniki Helper"
                                                           FontSize="22"
                                                           Opacity="0.88"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Colonne droite -->
                                    <Border Grid.Column="2"
                                            CornerRadius="20"
                                            Background="#14000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="34,28,34,28">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCHowToFix}"
                                                       FontSize="24"
                                                       Foreground="White"
                                                       Style="{DynamicResource TextBlockBaseStyle}" />

                                            <TextBlock Margin="0,16,0,0"
                                                       Text="{DynamicResource LOCToMissingText3}"
                                                       TextWrapping="Wrap"
                                                       FontSize="22"
                                                       Opacity="0.88"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Version -->
                                <Border Grid.Row="4"
                                        Margin="0,36,0,0"
                                        Padding="18,10,18,10"
                                        CornerRadius="16"
                                        Background="#66A31515"
                                        BorderBrush="#44FF6D6D"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LOCToMissingText4}"
                                               FontSize="20"
                                               Foreground="#FFFF9D9D"
                                               TextAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Flèche + bouton -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,70">

                            <TextBlock x:Name="Arrow"
                                       Margin="0,0,0,16"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource FontIcoFont}"
                                       FontSize="42"
                                       Text="&#xea5b;"
                                       Visibility="{Binding ElementName=Wrong, Path=Visibility}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <Trigger Property="Visibility" Value="Visible">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseSB">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1"
                                                                             To="0.28"
                                                                             Duration="0:0:0.8" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                            <Trigger Property="Visibility" Value="Collapsed">
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseSB" />
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ToggleButtonEx x:Name="Wrong"
                                            Margin="0,0,0,0"
                                            Width="720"
                                            Height="72"
                                            Command="{Binding SwitchToDesktopCommand}"
                                            pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                            pbeh:FocusBahaviors.FocusBinding="True"
                                            Style="{DynamicResource WarningDesktopTogglePremium}">
                                <ToggleButtonEx.Style>
                                    <Style TargetType="ToggleButtonEx" BasedOn="{StaticResource WarningDesktopTogglePremium}">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>


                                            <DataTrigger Binding="{PluginStatus Plugin=AnikiHelper_96a983a3-3f13-4dce-a474-4052b718bb52, Status=Installed}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButtonEx.Style>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">


                                    <TextBlock Text="{DynamicResource LOCBackToDesktopMode}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="28"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButtonEx>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WELCOME HUB OVERLAY -->
    <Style x:Key="WelcomehubStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ControlTemplate.Resources>
                        <Style x:Key="Chip" TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="#28FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                        </Style>

                    </ControlTemplate.Resources>
                    <Grid x:Name="WelcomeHubOverlay"
                          FocusManager.FocusedElement="{Binding ElementName=ProfileCard}"
                          KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          Background="{DynamicResource SecondaryViewBackground}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.InputBindings>

                            <pin:GameControllerInputBinding Button="Back"
                                                            Command="{Binding Command, ElementName=HubCloseToLibraryShortcutButton}" />

                            <pin:GameControllerInputBinding Button="Start"
                                                            Command="{Binding Command, ElementName=HubOpenMainMenuShortcutButton}" />

                        </Grid.InputBindings>

                        <ButtonEx x:Name="HubCloseToLibraryShortcutButton"
                                  Visibility="Collapsed"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Command="{PluginSettings Plugin=AnikiHelper, Path=CloseHubToLibraryCommand}" />

                        <ButtonEx x:Name="HubOpenMainMenuShortcutButton"
                                  Visibility="Collapsed"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Command="{PluginSettings Plugin=AnikiHelper, Path=OpenPlayniteMainMenuCommand}" />


                        <Grid>
                            <Border>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <!-- 0% → totalement opaque -->
