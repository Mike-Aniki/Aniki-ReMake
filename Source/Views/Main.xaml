                                                                                        </Grid>
                                                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
