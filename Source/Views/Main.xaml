                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE904;" FontFamily="{DynamicResource FontIcomoon}" Style="{StaticResource TextBlockBaseStyle}" FontSize="22" Opacity="0.9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="10,0,0,1" Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal}" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" FontSize="22" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- separator -->
                                            <Rectangle Width="1" Height="26" Fill="{DynamicResource SeparatorBrush}" Margin="10,0,10,0" Visibility="{Binding ElementName=StackPanelFavorite, Path=Visibility}"/>

                                            <StackPanel x:Name="StackPanelFavorite" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">

                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Favorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="22" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                <TextBlock Text="{DynamicResource LOCGameFavoriteTitle}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="22" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- separator -->
                                            <Rectangle Width="1" Height="26" Fill="{DynamicResource SeparatorBrush}" Margin="10,0,10,0" Visibility="{Binding ElementName=StackPanelAge, Path=Visibility}"/>

                                            <!-- AGE RATING ICONS -->
                                            <StackPanel x:Name="StackPanelAge" Orientation="Horizontal" Margin="10,0,10,0" Tag="{Binding SelectedGame.AgeRatings, Converter={StaticResource ListToStringConverter}}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=RatingIconImage, Path=Source}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ItemsControlEx ItemsSource="{Binding SelectedGame.AgeRatings}" IsTabStop="False" IsEnabled="False" Focusable="False" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <ItemsControlEx.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControlEx.ItemsPanel>

                                                    <ItemsControlEx.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image x:Name="RatingIconImage" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True" Source="{ThemeFileBinding Name, PathFormat='Icons/AgeRating/Alt/{0}.png'}"/>

                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=RatingIconImage, Path=Source}" Value="{x:Null}">
                                                                    <Setter TargetName="RatingIconImage" Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControlEx.ItemTemplate>
                                                </ItemsControlEx>
                                            </StackPanel>

                                            <Rectangle Width="1" Height="26" Fill="{DynamicResource SeparatorBrush}" Margin="10,0,10,0" Visibility="{Binding ElementName=StackPanelSourcePlatformText, Path=Visibility}"/>

                                            <StackPanel x:Name="StackPanelSourcePlatformText" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">

                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <!-- Si source vide ET platform vide -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedGame.Source.Name}" Value=""/>
                                                                    <Condition Binding="{Binding SelectedGame.Platforms[0].Name}" Value=""/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>

                                                            <!-- Si source null ET platform null -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}"/>
                                                                    <Condition Binding="{Binding SelectedGame.Platforms[0].Name}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="22" Width="24" TextAlignment="Center" Opacity="0.9" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                <Grid VerticalAlignment="Center">

                                                    <!-- Source en priorité -->
                                                    <TextBlock x:Name="SourceNameTextMain" Margin="0,0,0,1" Text="{Binding SelectedGame.Source.Name}" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Opacity="0.85">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Platform seulement si aucune source -->
                                                    <TextBlock x:Name="PlatformNameTextMain" Margin="0,0,0,1" Text="{Binding SelectedGame.Platforms[0].Name}" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Opacity="0.85">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                                <Style.Triggers>

                                                                    <!-- Affiche la platform si la source est vide -->
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>

                                                                    <!-- Affiche la platform si la source est null -->
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>

                                                                    <!-- Mais si la platform est vide, on cache quand même -->
                                                                    <DataTrigger Binding="{Binding SelectedGame.Platforms[0].Name}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>

                                                                    <!-- Mais si la platform est null, on cache quand même -->
                                                                    <DataTrigger Binding="{Binding SelectedGame.Platforms[0].Name}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>

                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                </Grid>
                                            </StackPanel>

                                            <Rectangle Width="1" Height="26" Fill="{DynamicResource SeparatorBrush}" Margin="10,0,10,0" Visibility="{Binding ElementName=StackPanelFeature, Path=Visibility}"/>


                                            <!-- FEATURES -->
                                            <ItemsControl x:Name="StackPanelFeature" Margin="10,0,10,0" ItemsSource="{Binding SelectedGame.Features}" Focusable="False" MaxWidth="300" ClipToBounds="False" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=HasItems}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[FeaturesSteamMain]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Width="34" Height="34" Margin="0,0,8,0" Opacity="0.85" Stretch="Uniform" Source="{ThemeFileBinding Name, PathFormat='Icons/Features/{0}.png'}" RenderOptions.BitmapScalingMode="Fant">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>

                                    </Grid>
                                </Grid>

                                <!-- Top Right Capsules -->
                                <StackPanel x:Name="TopRightCapsules" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="5">

                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="0,-50,28,0"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CompactGameInfoBar]}" Value="False"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[DetailedSideInfoPanel]}" Value="False"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>

                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowGameListBackground]}" Value="True">
                                                    <Setter Property="Margin" Value="0,-65,28,0"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Favorite Capsule -->
                                    <Border x:Name="FavoriteCapsule" Padding="16,10,16,10" CornerRadius="16" Background="{DynamicResource BackgroundMenu}" BorderBrush="{DynamicResource SeparatorListGameBrush}" BorderThickness="1">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                                <Setter Property="Margin" Value="0,0,10,0"/>

                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CompactGameInfoBar]}" Value="False"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[DetailedSideInfoPanel]}" Value="False"/>
                                                            <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[FavoriteCapsule]}" Value="True"/>
                                                            <Condition Binding="{Binding SelectedGame.Favorite}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" Color="Black" Opacity="0.8" RenderingBias="Performance"/>
                                                </TextBlock.Effect>
                                            </TextBlock>

                                            <TextBlock Text="{DynamicResource LOCGameFavoriteTitle}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Trophy Capsule -->
                                    <Border x:Name="TrophyCapsule" Padding="16,10,16,10" CornerRadius="16" Background="{DynamicResource BackgroundMenu}" BorderBrush="{DynamicResource SeparatorListGameBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                                <Setter Property="Margin" Value="0,0,10,0"/>
                                                <Style.Triggers>
                                                    <!-- PlayniteAchievements -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CompactGameInfoBar]}" Value="False"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[DetailedSideInfoPanel]}" Value="False"/>
                                                            <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SuccessOnMainMenu]}" Value="True"/>
                                                            <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>



                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <!-- PlayniteAchievements -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Image Source="{ThemeFile 'Images/Trophy.png'}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                    <Image.Effect>
                                                        <DropShadowEffect ShadowDepth="2" Color="Black" Opacity="0.8" RenderingBias="Performance"/>
                                                    </Image.Effect>
                                                </Image>

                                                <Image Source="{ThemeFile 'Images/platinum.png'}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                    <Image.Effect>
                                                        <DropShadowEffect ShadowDepth="2" Color="Black" Opacity="0.8" RenderingBias="Performance"/>
                                                    </Image.Effect>
                                                </Image>

                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" VerticalAlignment="Center"/>

                                                <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" Margin="4,0,4,0" VerticalAlignment="Center"/>

                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" VerticalAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </Border>

                                    <!-- SourceLogo Capsule -->
                                    <Border x:Name="SourceLogoCapsule" Padding="16,10,16,10" CornerRadius="16" Background="{DynamicResource BackgroundMenu}" BorderBrush="{DynamicResource SeparatorListGameBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SourceLogoOnMainScreen]}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=CustomLibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                            <Condition Binding="{Binding ElementName=LibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                            <Condition Binding="{Binding ElementName=CustomPlateformIconMain, Path=Visibility}" Value="Collapsed"/>
                                                            <Condition Binding="{Binding ElementName=PlateformIconMain, Path=Visibility}" Value="Collapsed"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                            <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <!-- Chemin custom défini dans Aniki Helper -->
                                            <TextBlock x:Name="CustomSourceIconPathTextMain" Text="{PluginSettings Plugin=AnikiHelper, Path=CustomSourceIconsFolder}" Visibility="Collapsed"/>

                                            <!-- Chemin final source : CustomFolder/SelectedGame.Source.Name.png -->
                                            <TextBlock x:Name="CustomLibraryIconPathMain" Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomSourceIconPathTextMain"/>
                                                        <Binding Path="SelectedGame.Source.Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- Chemin final plateforme : CustomFolder/SelectedGame.Platforms[0].Name.png -->
                                            <TextBlock x:Name="CustomPlatformIconPathMain" Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomSourceIconPathTextMain"/>
                                                        <Binding Path="SelectedGame.Platforms[0].Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- Icône source custom utilisateur -->
                                            <Image x:Name="CustomLibraryIconMain" RenderOptions.BitmapScalingMode="Fant" Height="25" MaxWidth="130" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Text, ElementName=CustomLibraryIconPathMain}">

                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <!-- Aucun dossier custom défini -->
                                                            <DataTrigger Binding="{Binding ElementName=CustomSourceIconPathTextMain, Path=Text}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <!-- Icône custom source absente -->
                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- Icône source par défaut du thème -->
                                            <Image x:Name="LibraryIconMain" RenderOptions.BitmapScalingMode="Fant" Height="25" MaxWidth="130" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{ThemeFileBinding SelectedGame.Source.Name, PathFormat='Icons/Source/{0}.png'}">

                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <!-- Fallback thème si l’icône custom source est absente -->
                                                            <DataTrigger Binding="{Binding ElementName=CustomLibraryIconMain, Path=Visibility}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <!-- Icône thème source absente -->
                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- Icône plateforme custom utilisateur -->
                                            <Image x:Name="CustomPlateformIconMain" RenderOptions.BitmapScalingMode="Fant" Height="25" MaxWidth="130" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Text, ElementName=CustomPlatformIconPathMain}">

                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <!-- Plateforme custom seulement si aucune icône source n’est disponible -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=LibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>

                                                            <!-- Aucun dossier custom défini -->
                                                            <DataTrigger Binding="{Binding ElementName=CustomSourceIconPathTextMain, Path=Text}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <!-- Icône plateforme custom absente -->
                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- Icône plateforme par défaut du thème -->
                                            <Image x:Name="PlateformIconMain" RenderOptions.BitmapScalingMode="Fant" Height="25" MaxWidth="130" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{ThemeFileBinding SelectedGame.Platforms[0].Name, PathFormat='Icons/Source/{0}.png'}">

                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <!-- Fallback plateforme thème si source + plateforme custom absentes -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=LibraryIconMain, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=CustomPlateformIconMain, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>

                                                            <!-- Icône plateforme thème absente -->
                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </Grid>


                            <!-- Background List View -->
                            <Border Grid.Row="0" Panel.ZIndex="-45" Grid.RowSpan="5" Grid.ColumnSpan="5" Background="{DynamicResource SecondaryViewBackground}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger.Setters>

                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border Grid.Row="0" Height="1000" VerticalAlignment="Top" HorizontalAlignment="Right" Panel.ZIndex="-45" Opacity="0.2" Grid.RowSpan="5" Grid.ColumnSpan="5">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <!-- 0% → totalement opaque -->
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>

                                        <!-- 70% → encore opaque (départ du fade) -->
                                        <GradientStop Color="#FFFFFFFF" Offset="0.30"/>

                                        <!-- 100% → totalement transparent -->
                                        <GradientStop Color="#00FFFFFF" Offset="0.60"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <FadeImage Source="{Binding SelectedGame.BackgroundImage}"
                                           SourceUpdateDelay="150"
                                           RenderOptions.BitmapScalingMode="LowQuality"
                                           Visibility="Visible">
                                    <FadeImage.Style>
                                        <Style TargetType="FadeImage">
                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="True">
                                                    <Setter Property="Stretch" Value="Uniform"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </FadeImage.Style>
                                </FadeImage>

                            </Border>

                            <!-- ListView -->
                            <Grid x:Name="DetailedListView" Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="5" Margin="50,10,50,90">
                                <Grid.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ActivateSelectedCommand}"/>

                                    <KeyBinding Key="{Binding ElementName=GAMEPAD_Details, Path=Content}" Command="{Binding ToggleGameDetailsCommand}"/>

                                    <KeyBinding Key="{Binding ElementName=GAMEPAD_Run, Path=Content}" Command="{Binding ActivateSelectedCommand}"/>

                                    <KeyBinding Key="Apps" Command="{Binding OpenGameMenuCommand}"/>

                                    <pin:GameControllerInputBinding Button="Y" Command="{Binding OpenGameMenuCommand}"/>

                                    <pin:GameControllerInputBinding Button="{Binding ElementName=GAMEPAD_Run, Path=Content}" Command="{Binding ActivateSelectedCommand}"/>

                                    <pin:GameControllerInputBinding Button="{Binding ElementName=GAMEPAD_Details, Path=Content}" Command="{Binding ToggleGameDetailsCommand}"/>
                                </Grid.InputBindings>


                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="140"/>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="False"/>
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger.Setters>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.34">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="140"/>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="-8">
                                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                                </EasingDoubleKeyFrame>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="0">
                                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                                </EasingDoubleKeyFrame>
                                                            </DoubleAnimationUsingKeyFrames>


                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="530"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.Resources>

                                    <Style x:Key="DetailedInfoCardStyle" TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ListDetailsBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ListDetailsBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="18"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>

                                    <Style x:Key="MetaSeparatorStyle" TargetType="Rectangle">
                                        <Setter Property="Width" Value="1"/>
                                        <Setter Property="Height" Value="24"/>
                                        <Setter Property="Margin" Value="12,0,12,0"/>
                                        <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}"/>
                                    </Style>

                                    <Style x:Key="LiveInfoCardStyle" TargetType="Border" BasedOn="{StaticResource DetailedInfoCardStyle}">
                                        <Setter Property="Padding" Value="18,16"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>

                                    <Style x:Key="DetailedEmptyValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Text" Value="..."/>
                                        <Setter Property="FontSize" Value="22"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>

                                </Grid.Resources>

                                <!-- ========================= -->
                                <!-- LEFT COLUMN -->
                                <!-- ========================= -->

                                <Border Grid.Column="0" Background="{DynamicResource ListBackgroundBrush}" CornerRadius="22" Margin="0,14,0,0" Padding="14" BorderBrush="{DynamicResource ListBorder}" BorderThickness="1">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <ListBoxEx x:Name="PART_ListGameItemsDetailed" Grid.Row="2" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ScrollViewer.IsDeferredScrollingEnabled="False" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemTemplate="{StaticResource DetailedListItemTemplate}" ItemContainerStyle="{DynamicResource DetailedListItemContainerStyle}" ItemsSource="{Binding GamesView.CollectionView}" SelectedItem="{Binding SelectedGame}">

                                            <ListBoxEx.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel Orientation="Vertical" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="8"/>
                                                </ItemsPanelTemplate>
                                            </ListBoxEx.ItemsPanel>
                                        </ListBoxEx>


                                    </Grid>
                                </Border>

                                <!-- ========================= -->
                                <!-- RIGHT COLUMN -->
                                <!-- ========================= -->

                                <Grid Grid.Column="2" DataContext="{Binding SelectedGame}" Margin="0,6,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- HEADER -->
                                    <StackPanel Grid.Row="0">

                                        <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>

                                        <TextBlock Margin="0,8,0,0" Text="{Binding ReleaseDate, StringFormat={}{0:dd/MM/yyyy}}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" Opacity="0.82"/>
                                    </StackPanel>



                                    <!-- HERO + SIDE RAIL -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="96"/>
                                        </Grid.RowDefinitions>

                                        <!-- IMAGE / HERO -->
                                        <ButtonEx Grid.Column="0" Grid.Row="0" Grid.RowSpan="7" x:Name="DetailedHeroFrame" FocusVisualStyle="{x:Null}" Focusable="True" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx">
                                                    <Setter Property="Width" Value="717"/>
                                                    <Setter Property="Height" Value="405"/>
                                                    <Setter Property="Background" Value="#22000000"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ButtonEx">
                                                                <Border x:Name="CardBorder" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                </Border>

                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2.5"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="True">
                                                            <Setter Property="Width" Value="717"/>
                                                            <Setter Property="Height" Value="316"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                                                            <Setter Property="Width" Value="580"/>
                                                            <Setter Property="Height" Value="300"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>

                                            <Grid>
                                                <!-- masque arrondi -->
                                                <Border x:Name="DetailedHeroMask" CornerRadius="22" Background="Black" IsHitTestVisible="False"/>

                                                <!-- contenu masqué -->
                                                <Grid x:Name="DetailedHeroContent">
                                                    <Grid.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=DetailedHeroMask}" Stretch="Fill"/>
                                                    </Grid.OpacityMask>

                                                    <!-- IMAGE -->
                                                    <FadeImage Source="{Binding BackgroundImage}" RenderOptions.BitmapScalingMode="Fant" Visibility="Visible">
                                                        <FadeImage.Style>
                                                            <Style TargetType="FadeImage">
                                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="True">
                                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1">
                                                                        <Setter Property="Opacity" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </FadeImage.Style>
                                                    </FadeImage>

                                                    <!-- Overlay -->
                                                    <Rectangle RadiusX="22" RadiusY="22" IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#10000000" Offset="0"/>
                                                                <GradientStop Color="#18000000" Offset="0.45"/>
                                                                <GradientStop Color="#3A000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <!-- Highlight -->
                                                    <Rectangle RadiusX="22" RadiusY="22" IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#26FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#08FFFFFF" Offset="0.18"/>
                                                                <GradientStop Color="#00000000" Offset="0.35"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>
                                        </ButtonEx>

                                        <!-- COLONNE CARTES 1 -->
                                        <!-- Carte 1 : Playtime -->
                                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCPlayTime}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>
                                                <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}, FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="23" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 2 : Install Size -->
                                        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCInstallSize}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal, FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="23" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 3 : Last Activity -->
                                        <Border Grid.Column="2" Grid.Row="4" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCGameLastActivityTitle}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>
                                                <TextBlock Text="{Binding LastActivity, StringFormat={}{0:dd MMM yyyy}, FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="20" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 4 : Critic Score -->
                                        <Border Grid.Column="2" Grid.Row="6" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="&#xEC7C;" FontFamily="{DynamicResource FontIcoFont}" Style="{StaticResource TextBlockBaseStyle}" FontSize="20" Opacity="0.85" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="{Binding CriticScore, FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="22" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 5 : Genres -->
                                        <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource DetailedInfoCardStyle}">

                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>

                                                <WrapPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Genres[0], FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold" Opacity="0.92"/>
                                                    <TextBlock Text="{Binding Genres[1]}" Margin="10,0,0,0" Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold" Opacity="0.92"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 6 : Age Rating -->
                                        <Border Grid.Column="4" Grid.Row="2" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>

                                                <Grid x:Name="AgeRatingCardContent" Margin="0,8,0,0" Tag="{Binding AgeRatings, Converter={StaticResource ListToStringConverter}}">

                                                    <!-- Affiche uniquement le premier Age Rating -->
                                                    <ItemsControlEx ItemsSource="{Binding AgeRatings}" AlternationCount="99" IsTabStop="False" IsEnabled="False" Focusable="False" VerticalAlignment="Center">

                                                        <ItemsControlEx.Style>
                                                            <Style TargetType="ItemsControlEx">
                                                                <Setter Property="Visibility" Value="Visible"/>

                                                                <Style.Triggers>
                                                                    <!-- Cache la liste si aucun age rating -->
                                                                    <DataTrigger Binding="{Binding ElementName=AgeRatingCardContent, Path=Tag}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControlEx.Style>

                                                        <ItemsControlEx.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControlEx.ItemsPanel>

                                                        <ItemsControlEx.ItemTemplate>
                                                            <DataTemplate>

                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <!-- Par défaut on cache tous les items -->
                                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                                            <Style.Triggers>
                                                                                <!-- On affiche seulement le premier item -->
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>

                                                                    <Grid Width="34" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left">

                                                                        <!-- Image PEGI / ESRB / etc. -->
                                                                        <Image x:Name="DetailedRatingIconImage2" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True" Source="{ThemeFileBinding Name, PathFormat='Icons/AgeRating/Alt/{0}.png'}">

                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Visible"/>

                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>

                                                                        </Image>

                                                                        <!-- Bouclier si l'image n'existe pas -->
                                                                        <TextBlock Text="&#xEA18;" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource FontIcons}" Foreground="{DynamicResource TextBrush}">

                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ElementName=DetailedRatingIconImage2, Path=Source}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>

                                                                        </TextBlock>

                                                                    </Grid>

                                                                    <!-- Texte du premier age rating -->
                                                                    <TextBlock Margin="10,0,0,0" Text="{Binding Name, FallbackValue='...', TargetNullValue='...'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                                </StackPanel>

                                                            </DataTemplate>
                                                        </ItemsControlEx.ItemTemplate>
                                                    </ItemsControlEx>

                                                    <!-- Fallback si aucun Age Rating -->
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailedEmptyValueTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=AgeRatingCardContent, Path=Tag}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 7 : Features -->
                                        <Border Grid.Column="4" Grid.Row="4" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>

                                                <Grid Margin="0,8,0,0">

                                                    <ItemsControl ItemsSource="{Binding Game.Features}" Focusable="False" ClipToBounds="False" FocusVisualStyle="{x:Null}">

                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Visible"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Game.Features}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Game.Features.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>

                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Image Width="30" Height="30" Margin="0,0,8,8" Opacity="0.85" Stretch="Uniform" Source="{ThemeFileBinding Name, PathFormat='Icons/Features/{0}.png'}" RenderOptions.BitmapScalingMode="Fant">

                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>

                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>

                                                                </Image>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Fallback si aucune feature -->
                                                    <TextBlock>

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailedEmptyValueTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Game.Features}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Game.Features.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 8 : Trophies PA -->
                                        <Border Grid.Column="4" Grid.Row="6" x:Name="DetailedTrophyCard_PA">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DetailedInfoCardStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCAchievements}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" Opacity="0.62"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Image Source="{ThemeFile 'Images/Trophy.png'}" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>

                                                    <TextBlock Margin="10,0,0,0" Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" FontWeight="SemiBold"/>

                                                    <TextBlock Text="/" Margin="6,0,6,0" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" FontWeight="SemiBold" Opacity="0.42"/>

                                                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24" FontWeight="SemiBold"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>
                                    </Grid>


                                    <!-- GAME PROFILE BANNER -->
                                    <Border x:Name="GameProfileBannerCard" Grid.Row="4" Focusable="True" FocusVisualStyle="{x:Null}">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ListDetailsBackgroundBrush}"/>
                                                <Setter Property="CornerRadius" Value="20"/>
                                                <Setter Property="Padding" Value="22"/>
                                                <Setter Property="MinHeight" Value="220"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ListDetailsBorder}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#000000" ShadowDepth="0" Opacity="0.30" RenderingBias="Performance"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2.5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.Resources>

                                            <DropShadowEffect x:Key="GameProfileInnerCardShadow" Color="#000000" ShadowDepth="0" Opacity="0.20" RenderingBias="Performance"/>

                                            <Style x:Key="GameProfileInnerCardStyle" TargetType="Border">
                                                <Setter Property="CornerRadius" Value="22"/>
                                                <Setter Property="Padding" Value="18"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="#05FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Effect" Value="{StaticResource GameProfileInnerCardShadow}"/>
                                            </Style>

                                            <Style x:Key="GameProfileCardTitleText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="20"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                                            </Style>

                                            <Style x:Key="GameProfileCardBodyText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="17"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Style>

                                            <Style x:Key="GameProfileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="18"/>
                                                <Setter Property="Opacity" Value="0.80"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="26"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileSubValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="18"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileChip" TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>

                                        </Border.Resources>

                                        <Grid KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                                    <TextBlock Text="{DynamicResource LOCGameProfile}" Style="{StaticResource GameProfileCardTitleText}" FontSize="28" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- SourceLogo -->
                                                <Grid Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,0">

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Margin" Value="0,0,20,0"/>
                                                                <Setter Property="Visibility" Value="Visible"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SourceLogoOnMainScreen]}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <!-- Chemin custom défini dans Aniki Helper -->
                                                        <TextBlock x:Name="CustomIconSourcePathText" Text="{PluginSettings Plugin=AnikiHelper, Path=CustomSourceIconsFolder}" Visibility="Collapsed"/>

                                                        <!-- Chemin final source : CustomFolder/Game.Source.Name.png -->
                                                        <TextBlock x:Name="CustomLibraryIconPath" Visibility="Collapsed">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}/{1}.png">
                                                                    <Binding Path="Text" ElementName="CustomIconSourcePathText"/>
                                                                    <Binding Path="Game.Source.Name"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <!-- Chemin final plateforme : CustomFolder/Game.Platforms[0].Name.png -->
                                                        <TextBlock x:Name="CustomPlatformIconPath" Visibility="Collapsed">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}/{1}.png">
                                                                    <Binding Path="Text" ElementName="CustomIconSourcePathText"/>
                                                                    <Binding Path="Game.Platforms[0].Name"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                                                            <!-- 1. Icône source custom utilisateur -->
                                                            <Image x:Name="CustomLibraryIcon" RenderOptions.BitmapScalingMode="Fant" Height="50" MaxWidth="180" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Text, ElementName=CustomLibraryIconPath}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>

                                                                        <Style.Triggers>
                                                                            <!-- Aucun dossier custom défini -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomIconSourcePathText, Path=Text}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône custom source absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 2. Icône source par défaut du thème -->
                                                            <Image x:Name="LibraryIcon" RenderOptions.BitmapScalingMode="Fant" Height="50" MaxWidth="180" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Source/{0}.png'}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- On affiche le fallback thème si l’icône custom source est absente -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône source thème absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 3. Icône plateforme custom utilisateur -->
                                                            <Image x:Name="CustomPlateformIcon" RenderOptions.BitmapScalingMode="Fant" Height="50" MaxWidth="180" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Text, ElementName=CustomPlatformIconPath}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- Plateforme custom seulement si aucune icône source n’est disponible -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=LibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>

                                                                            <!-- Aucun dossier custom défini -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomIconSourcePathText, Path=Text}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône plateforme custom absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 4. Icône plateforme par défaut du thème -->
                                                            <Image x:Name="PlateformIcon" RenderOptions.BitmapScalingMode="Fant" Height="50" MaxWidth="180" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Source/{0}.png'}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- Fallback plateforme thème si source + plateforme custom absentes -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=LibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=CustomPlateformIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>

                                                                            <!-- Icône plateforme thème absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- Content -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CARD 1 -->
                                                <Border Grid.Column="0" Style="{StaticResource GameProfileInnerCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="{DynamicResource LOCStudio}" Style="{StaticResource GameProfileCardTitleText}" Margin="0,0,0,4"/>

                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{DynamicResource LOCGameDevelopersTitle}" Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Developers[0].Name, FallbackValue='-', TargetNullValue='-'}" Margin="0,6,0,0" Style="{StaticResource GameProfileValueStyle}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4">
                                                            <TextBlock Text="{DynamicResource LOCGamePublishersTitle}" Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Publishers[0].Name, FallbackValue='-', TargetNullValue='-'}" Margin="0,6,0,0" Style="{StaticResource GameProfileSubValueStyle}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- CARD 2 -->
                                                <Border Grid.Column="2" Style="{StaticResource GameProfileInnerCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="{DynamicResource LOCLibraryList}" Style="{StaticResource GameProfileCardTitleText}" Margin="0,0,0,4"/>

                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{DynamicResource LOCAddedtoLibrary}" Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Added, StringFormat={}{0:dd MMM yyyy}, FallbackValue='-'}" Margin="0,6,0,0" Style="{StaticResource GameProfileValueStyle}"/>
                                                        </StackPanel>

                                                        <WrapPanel Grid.Row="4" Margin="0,6,0,0">

                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock Text="{Binding Source.Name, FallbackValue='-', TargetNullValue='-'}" Style="{StaticResource GameProfileCardBodyText}" FontSize="18" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock Text="{Binding Platforms[0].Name, FallbackValue='-', TargetNullValue='-'}" Style="{StaticResource GameProfileCardBodyText}" FontSize="18" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock Text="{Binding Series[0].Name, FallbackValue='No series', TargetNullValue='No series'}" Style="{StaticResource GameProfileCardBodyText}" FontSize="18" FontWeight="SemiBold"/>
                                                            </Border>

                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- CARD 3 -->
                                                <Border Grid.Column="4" Style="{StaticResource GameProfileInnerCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="16"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="16"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="Collection" Style="{StaticResource GameProfileCardTitleText}" Margin="0,0,0,4"/>

                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{StaticResource GameProfileLabelStyle}"/>
                                                                <TextBlock Text="{Binding CompletionStatus, FallbackValue='-'}" Margin="0,6,0,0" Style="{StaticResource GameProfileValueStyle}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{DynamicResource LOCPlayCount}" Style="{StaticResource GameProfileLabelStyle}"/>
                                                                <TextBlock Text="{Binding PlayCount, FallbackValue='0'}" Margin="0,6,0,0" Style="{StaticResource GameProfileValueStyle}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <WrapPanel Grid.Row="4" Margin="0,6,0,0">

                                                            <!-- Installed -->
                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock FontSize="18">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Text" Value="{DynamicResource LOCGameIsInstalledTitle}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                                    <Setter Property="Text" Value="{DynamicResource LOCGameIsUnInstalledTitle}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Favorite -->
                                                            <Border>
                                                                <TextBlock FontSize="18" Text="{DynamicResource LOCGameFavoriteTitle}" Style="{StaticResource TextBlockBaseStyle}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource GameProfileChip}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <!-- Categorie -->
                                                            <Border>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource GameProfileChip}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Game.Categories[0]}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.Categories.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock FontSize="18" Text="{Binding Categories[0], TargetNullValue='', FallbackValue=''}" Style="{StaticResource TextBlockBaseStyle}"/>
                                                            </Border>

                                                            <Border>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource GameProfileChip}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Game.Categories[1]}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.Categories.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock FontSize="18" Text="{Binding Categories[1], TargetNullValue='', FallbackValue=''}" Style="{StaticResource TextBlockBaseStyle}"/>
                                                            </Border>

                                                            <Border>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource GameProfileChip}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Game.Categories[2]}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Game.Categories.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock FontSize="18" Text="{Binding Categories[2], TargetNullValue='', FallbackValue=''}" Style="{StaticResource TextBlockBaseStyle}"/>
                                                            </Border>

                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Grid>

                            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Grid.Row" Value="4"/>
                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=BottomBar, Path=IsKeyboardFocusWithin}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AutoHideBottomFilterBar]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:1.0" From="0" To="1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:0.40" From="1" To="0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="Dpad" Content="{DynamicResource LOCButtonPrompt_Navigate}"/>

                                    <!-- PLAY -->
                                    <ButtonEx Tag="PlayAction" Content="{DynamicResource LOCPlayGame}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource ButtonBottomMenuDark}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                    </ButtonEx>

                                    <!-- INSTALL -->
                                    <ButtonEx Tag="PlayAction" Content="{DynamicResource LOCInstallGame}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource ButtonBottomMenuDark}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                    </ButtonEx>

                                    <!-- DETAILS -->
                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="DetailsAction" Content="{DynamicResource LOCSettingsGameDetailsLabel}"/>

                                    <!-- CHANGE VIEW -->
                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDual}" Tag="Y" Content="{DynamicResource LOCGameOptions}" CommandParameter="{DynamicResource LOCChangeView}"/>


                                </StackPanel>
                            </Grid>

                            <!-- Main View media card mask: same technique as DetailedHeroMask in the Details panel. -->
                            <Border x:Name="TrailerCardMask"
                                    Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="0" Grid.RowSpan="5"
                                    Width="780" Height="439"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,175,120,0"
                                    CornerRadius="{DynamicResource Corner}"
                                    Background="Black"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="-12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="720"/>
                                                <Setter Property="Height" Value="405"/>
                                                <Setter Property="Margin" Value="0,160,80,0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Main View media card image: always visible; Trailer mode draws video over it when available. -->
                            <Border x:Name="TrailerCardFallback" ClipToBounds="True"
                                    Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="0" Grid.RowSpan="5"
                                    Width="780" Height="439"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,175,120,0"
                                    CornerRadius="{DynamicResource Corner}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Background="Black"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="-11">
                                <!-- Hard rounded clip applied to the bitmap itself. -->
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,780,439" RadiusX="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}" RadiusY="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}"/>
                                </Border.Clip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="720"/>
                                                <Setter Property="Height" Value="405"/>
                                                <Setter Property="Margin" Value="0,160,80,0"/>
                                                <Setter Property="Clip">
                                                    <Setter.Value>
                                                        <RectangleGeometry Rect="0,0,720,405" RadiusX="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}" RadiusY="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- Source is assigned directly by Aniki Helper after selection settles.
                                Do not bind another FadeImage to DisplayBackgroundImageObject here: that
                                interferes with BackgroundChanger's own background crossfade. -->
                                <Image x:Name="TrailerCardFallbackImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       IsHitTestVisible="False">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <!-- Background-only card: show the Helper-provided bitmap normally. -->
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <!-- Trailer card: stay black while EML resolves/starts the trailer. -->
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger>

                                                <!-- Only reveal the fallback once selection has settled AND EML confirms
                                                that the selected game has no trailer. This prevents the background
                                                from flashing briefly before a valid trailer starts. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True"/>
                                                        <Condition Binding="{Binding ElementName=Trigger, Path=Opacity}" Value="1"/>
                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="False"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>

                            <!-- Main View media card outline. -->
                            <Border x:Name="TrailerCardStroke"
