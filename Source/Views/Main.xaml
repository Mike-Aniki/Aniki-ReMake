                                    <DataTrigger Binding="{Binding ElementName=WrongColumns, Path=Visibility}" Value="Visible" >
                                        <Setter Property="Background" Value="{DynamicResource SecondaryViewBackground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ContentControl x:Name="AnikiHelper_GlobalControllerShortcuts" >
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Tag" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemGameDetails}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemGameStatus}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=AcceuilSettings}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=WrongSettings}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemFilters}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ContentFilterItems}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemFiltersAdditional}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=Power}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.InputBindings>

                                <pin:GameControllerInputBinding
                                    Button="Start"
                                    Command="{Binding Data.ControllerHoldCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                    <pin:GameControllerInputBinding.CommandParameter>
                                        <x:Array Type="{x:Type Button}">
                                            <Button Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[QuickAccessWindowStyle]}" />

                                            <Button Command="{PluginSettings Plugin=AnikiHelper, Path=OpenPlayniteSettingsCommand}" />
                                        </x:Array>
                                    </pin:GameControllerInputBinding.CommandParameter>
                                </pin:GameControllerInputBinding>

                                <pin:GameControllerInputBinding
                                    Button="Y"
                                    Command="{Binding Data.ControllerHoldCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                    <pin:GameControllerInputBinding.CommandParameter>
                                        <x:Array Type="{x:Type Button}">
                                            <Button Command="{Binding Data.OpenGameMenuCommand, Source={StaticResource MAIN_Commands}}" />

                                            <Button Command="{Binding Data.Toggle, Source={StaticResource ANIKIHELPER_Commands}}"
                                                    CommandParameter="ToggleViewButton" />
                                        </x:Array>
                                    </pin:GameControllerInputBinding.CommandParameter>
                                </pin:GameControllerInputBinding>

                                <pin:GameControllerInputBinding
                                    Button="Back"
                                    Command="{Binding Data.ControllerHoldCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                    <pin:GameControllerInputBinding.CommandParameter>
                                        <x:Array Type="{x:Type Button}">

                                            <!-- Short press Select/View = Hub -->
                                            <Button
                                                Command="{PluginSettings Plugin=AnikiHelper, Path=ToggleWelcomeHubCommand}" />

                                            <!-- Long press Select/View = Quick Options -->
                                            <Button
                                                Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[ControlCenterWindowStyle]}" />

                                        </x:Array>
                                    </pin:GameControllerInputBinding.CommandParameter>
                                </pin:GameControllerInputBinding>


                                <pin:GameControllerInputBinding
                                    Button="LeftStick"
                                    Command="{Binding Data.ControllerTapCommand, Source={StaticResource ANIKIHELPER_Commands}}"
                                    CommandParameter="{Binding Data.OpenSearchCommand, Source={StaticResource MAIN_Commands}}"/>


                            </ContentControl.InputBindings>
                        </ContentControl>

                        <ContentControl x:Name="AnikiHelper_GlobalControllerShortcutsHub">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Tag" Value="False"/>

                                    <Style.Triggers>
                                        <!-- Active only when Hub is visible -->
                                        <DataTrigger Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Visible">
                                            <Setter Property="Tag" Value="True"/>
                                        </DataTrigger>

                                        <!-- Safety disables -->
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemGameDetails}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemGameStatus}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Visibility, ElementName=AcceuilSettings}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Visibility, ElementName=WrongSettings}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Visibility, ElementName=Power}" Value="Visible">
                                            <Setter Property="Tag" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>

                            <ContentControl.InputBindings>

                                <pin:GameControllerInputBinding
                                    Button="Back"
                                    Command="{Binding Data.ControllerHoldCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                    <pin:GameControllerInputBinding.CommandParameter>
                                        <x:Array Type="{x:Type Button}">

                                            <!-- Short press Back/View/Touchpad = close Hub -->
                                            <Button
                                                Command="{PluginSettings Plugin=AnikiHelper, Path=CloseHubToLibraryCommand}" />

                                            <!-- Long press Back/View/Touchpad = Control Center -->
                                            <Button
                                                Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[ControlCenterWindowStyle]}" />

