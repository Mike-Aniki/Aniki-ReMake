                                    BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="2"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="-8"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MediaCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="720"/>
                                                <Setter Property="Height" Value="405"/>
                                                <Setter Property="Margin" Value="0,160,80,0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Trailer -->
                            <Border x:Name="TrailerContainer" ClipToBounds="True" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="0" Grid.RowSpan="5" Background="Black">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <!-- mode horizontal par défaut -->
                                        <Setter Property="Height" Value="800"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="Panel.ZIndex" Value="-10"/>
                                        <Style.Triggers>
                                            <!-- mode LIST = petit -->
                                            <DataTrigger Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="True">
                                                <Setter Property="Width" Value="{Binding ElementName=DetailedHeroContent, Path=ActualWidth}"/>
                                                <Setter Property="Height" Value="{Binding ElementName=DetailedHeroContent, Path=ActualHeight}"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Margin" Value="0,199,-25,0"/>
                                                <Setter Property="Panel.ZIndex" Value="99"/>
                                                <Setter Property="CornerRadius" Value="22"/>
                                                <Setter Property="Background" Value="#22000000"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="OpacityMask">
                                                    <Setter.Value>
                                                        <VisualBrush Visual="{Binding ElementName=DetailedHeroMask}" Stretch="Fill"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="{Binding ElementName=DetailedHeroContent, Path=ActualWidth}"/>
                                                <Setter Property="Height" Value="{Binding ElementName=DetailedHeroContent, Path=ActualHeight}"/>
                                                <Setter Property="Margin" Value="0,188,-80,0"/>
                                            </MultiDataTrigger>


                                            <!-- mode Vertical -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="1920"/>
                                                <Setter Property="Height" Value="1080"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Panel.ZIndex" Value="-46"/>
                                                <Setter Property="Margin" Value="0,-250,0,0"/>
                                            </MultiDataTrigger>

                                            <!-- Main View trailer card layout -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="780"/>
                                                <Setter Property="Height" Value="439"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Margin" Value="0,175,120,0"/>
                                                <Setter Property="Panel.ZIndex" Value="-10"/>
                                                <Setter Property="CornerRadius" Value="{DynamicResource Corner}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="OpacityMask" Value="{x:Null}"/>
                                                <Setter Property="Clip">
                                                    <Setter.Value>
                                                        <RectangleGeometry Rect="0,0,780,439" RadiusX="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}" RadiusY="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=DetailedListView, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="720"/>
                                                <Setter Property="Height" Value="405"/>
                                                <Setter Property="Margin" Value="0,160,80,0"/>
                                                <Setter Property="Clip">
                                                    <Setter.Value>
                                                        <RectangleGeometry Rect="0,0,720,405" RadiusX="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}" RadiusY="{Binding ElementName=TrailerCardMask, Path=CornerRadius.TopLeft}"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </MultiDataTrigger>




                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnMainView]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <!-- Background layout keeps the original soft fade. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnMainView]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Opacity}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:1" From="0" To="1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuinticEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" From="1" To="0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <!-- Card layout appears immediately as soon as EML starts the new trailer. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Settings Fullscreen.HorizontalLayout}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerCardOnMainView]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="1"/>
                                            </MultiDataTrigger>

                                            <!-- Hard off outside Horizontal: the card and its video surface are removed. -->
                                            <DataTrigger Binding="{Settings Fullscreen.HorizontalLayout}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Clip" Value="{x:Null}"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound" Focusable="False" Panel.ZIndex="-46">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Background" Value="Black"/>
