                            <p:BindingProxy x:Key="ANIKIHELPER_Commands" Data="{Binding Content, ElementName=AnikiHelper_ControllerCommands}" />
                        </Grid.Resources>

                        <!-- Style de la grille principale -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Black"/>
