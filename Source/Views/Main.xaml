                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                                <Image.Effect>
                                                    <DropShadowEffect ShadowDepth="2" Color="Black" Opacity="0.8"/>
                                                </Image.Effect>
