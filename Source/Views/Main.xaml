                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)" BeginTime="0:0:8.0" To="600" Duration="0:0:0.30" AccelerationRatio="0.3" DecelerationRatio="0.7"/>

