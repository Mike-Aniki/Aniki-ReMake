                                                    <ButtonEx.Style>
                                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource WelcomeHubQuickButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowExtensionsButton]}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
