                                                </ContentControl.RenderTransform>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Keep only current / previous / next Hub pages instantiated. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShouldLoadVideoCenterPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubVideoCenterContentTemplate}"/>
                                                            </MultiDataTrigger>

                                                            <!-- Only the active Hub page can take focus. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsVideoCenterPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubVideoCenterContentTemplate}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </MultiDataTrigger>

                                                            <!-- Shorter enter animation for fast LB/RB navigation. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsVideoCenterPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubVideoCenterForwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubVideoCenterForwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Backward enter. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsVideoCenterPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubVideoCenterBackwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubVideoCenterBackwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Keep previous Hub page alive for cross-fade. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasVideoCenterPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubVideoCenterForwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubVideoCenterForwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasVideoCenterPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubVideoCenterBackwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubVideoCenterBackwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>

                                        <!-- PAGE 3 : HUB APPS -->
                                        <Grid x:Name="HubAppsSection" Grid.Row="0" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=ShowHubAppsPage}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.Resources>
                                                <DataTemplate x:Key="HubAppsContentTemplate">
                                                    <Grid Width="1560">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                                                            <TextBlock Text="{DynamicResource LOCHubFeaturesAppsTitle}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardTitleBrush}" FontSize="34" FontWeight="Bold" Margin="0,0,0,5"/>

                                                            <TextBlock Text="{DynamicResource LOCHUBAppsSubtile}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" Opacity="0.75"/>
                                                        </StackPanel>

                                                        <ItemsControl Grid.Row="1" ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=HubAppItems}" AlternationCount="20" HorizontalAlignment="Center" VerticalAlignment="Top" FocusVisualStyle="{x:Null}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">

                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <!-- Same logic as the other Hub 2x2 pages -->
                                                                    <WrapPanel Width="1560" ItemWidth="780" ItemHeight="420"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>

                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Margin" Value="20"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ButtonEx Width="700" Height="370" Focusable="True" FocusVisualStyle="{x:Null}" Style="{StaticResource HubCardFocusButtonStyle}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenOverlayAppCommand}" CommandParameter="{Binding}">
                                                                        <Border CornerRadius="20" Style="{DynamicResource HubCardBorderStyle}">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <!-- App background / fallback placeholder -->
                                                                                <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="20" ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <Grid.OpacityMask>
                                                                                            <VisualBrush Visual="{Binding ElementName=HubAppImageMask}" Stretch="Fill"/>
                                                                                        </Grid.OpacityMask>

                                                                                        <Border x:Name="HubAppImageMask" CornerRadius="20" Background="Black"/>

                                                                                        <!-- Default placeholder from the theme Images folder -->
                                                                                        <Image Source="{ThemeFile 'Images/NoBackgroundApp.png'}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>

                                                                                        <!-- Custom background selected in Aniki Helper -->
                                                                                        <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                                                                                            <Image.Style>
                                                                                                <Style TargetType="Image">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Image.Style>
                                                                                        </Image>

                                                                                        <!-- Same dark readable layer as the other Hub cards -->
                                                                                        <Border Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                                                                                        <Border VerticalAlignment="Bottom" Height="120" IsHitTestVisible="False">
                                                                                            <Border.Background>
                                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                                                    <GradientStop Color="#CC000000" Offset="1"/>
                                                                                                </LinearGradientBrush>
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- Bottom band: app icon + app name -->
                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85"/>
                                                                                <Border Grid.Row="1" CornerRadius="0,0,20,20" Padding="16,10" SnapsToDevicePixels="True" BorderBrush="{DynamicResource HubCardBottomBorderBrush}" BorderThickness="0,2,0,0">
                                                                                    <Grid VerticalAlignment="Center">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="14"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                                                                            <Image Source="{Binding IconPath}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>

                                                                                            <!-- Fallback icon if the Software Tool has no icon -->
                                                                                            <TextBlock Text="&#xECAA;" FontFamily="{DynamicResource FontIcons}" FontSize="26" Foreground="{DynamicResource TextHubBannerCardTitleBrush}" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Grid>

                                                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ButtonEx>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </Grid.Resources>

                                            <ContentControl RenderTransformOrigin="0.5,0.5">
                                                <ContentControl.RenderTransform>
                                                    <TranslateTransform X="0"/>
                                                </ContentControl.RenderTransform>

                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Keep only current / previous / next Hub pages instantiated. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShouldLoadAppsPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubAppsContentTemplate}"/>
                                                            </MultiDataTrigger>

                                                            <!-- Only the active Hub page can take focus. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsAppsPage}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubAppsContentTemplate}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </MultiDataTrigger>

                                                            <!-- Shorter enter animation for fast LB/RB navigation. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsAppsPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubAppsForwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubAppsForwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Backward enter. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsAppsPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubAppsBackwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubAppsBackwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Keep previous Hub page alive for cross-fade. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasAppsPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubAppsForwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubAppsForwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasAppsPage}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubAppsBackwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubAppsBackwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>


                                    </Grid>
                                </Grid>
                            </Grid>

                        </Grid>

                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Left" Margin="20,0,0,10">
                                <!-- LIBRARY VIEW -->
                                <ButtonEx Style="{DynamicResource ButtonBottomMenu}" Tag="Back" Content="{DynamicResource LOCLibrary}"/>
                                <!-- MENU -->
                                <ButtonEx x:Name="PART_ButtonGameOptions" Style="{DynamicResource ButtonBottomMenu}" Tag="Start" Content="{DynamicResource LOCMainMenu}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuShoulders}" Content="{DynamicResource LOCSwitchSection}"/>

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="A" Content="{DynamicResource LOCButtonPrompt_Select}"/>

                            </StackPanel>

                        </Grid>

                        <Grid x:Name="HubPageDots" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Height="80" Panel.ZIndex="50" IsHitTestVisible="False">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- PAGE 1 -->
                                <Border Width="10" Height="10" Margin="6,0,6,0" CornerRadius="5" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PageDotsBackgroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShowPageDot1}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=HubRoot, Path=Tag}" Value="Page1">
                                                    <Setter Property="Background" Value="{DynamicResource PageDotsFocusBrush}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- PAGE 2 -->
                                <Border Width="10" Height="10" Margin="6,0,6,0" CornerRadius="5" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PageDotsBackgroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShowPageDot2}" Value="False">
