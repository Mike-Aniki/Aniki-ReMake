                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathA}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathA}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Image.Style>
                                                                                        </Image>

                                                                                        <!-- VIGNETTE LÉGÈRE -->
                                                                                        <Border Panel.ZIndex="5" IsHitTestVisible="False" CornerRadius="20">
                                                                                            <Border.Background>
                                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                    <GradientStop Color="#18000000" Offset="0.0"/>
                                                                                                    <GradientStop Color="#00000000" Offset="0.30"/>
                                                                                                    <GradientStop Color="#00000000" Offset="0.65"/>
                                                                                                    <GradientStop Color="#70000000" Offset="1.0"/>
                                                                                                </LinearGradientBrush>
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- IMAGE B -->
                                                                                <Grid Panel.ZIndex="1" Tag="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsShowLayerB}" IsHitTestVisible="False">
                                                                                    <Grid.Style>
                                                                                        <Style TargetType="Grid">
                                                                                            <Setter Property="Opacity" Value="0"/>

                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                                    <DataTrigger.EnterActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard FillBehavior="Stop">
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.50">
                                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                                        <QuadraticEase EasingMode="EaseInOut"/>
                                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                                </DoubleAnimation>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.EnterActions>
                                                                                                </DataTrigger>

                                                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                                                                                                    <Setter Property="Opacity" Value="0"/>
                                                                                                    <DataTrigger.EnterActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard FillBehavior="Stop">
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.50">
                                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                                        <QuadraticEase EasingMode="EaseInOut"/>
                                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                                </DoubleAnimation>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.EnterActions>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Grid.Style>

                                                                                    <Border CornerRadius="20" ClipToBounds="True">
                                                                                        <Border.OpacityMask>
                                                                                            <VisualBrush Visual="{Binding ElementName=CoverMask3B}" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" RenderOptions.CachingHint="Cache"/>
                                                                                        </Border.OpacityMask>

                                                                                        <Grid>
                                                                                            <Border x:Name="CoverMask3B" CornerRadius="20" Background="{DynamicResource HubCardMaskImageBrush}"/>

                                                                                            <Image RenderOptions.BitmapScalingMode="Fant" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathB}">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathB}" Value="">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathB}" Value="{x:Null}">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>
                                                                                            <Border Panel.ZIndex="4" Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                                                                                            <Image RenderOptions.BitmapScalingMode="Fant" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{ThemeFile 'Images/NoImagesNews.png'}">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathB}" Value="">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsLocalImagePathB}" Value="{x:Null}">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>

                                                                                            <!-- VIGNETTE LÉGÈRE -->
                                                                                            <Border Panel.ZIndex="5" IsHitTestVisible="False" CornerRadius="20">
                                                                                                <Border.Background>
                                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                        <GradientStop Color="#18000000" Offset="0.0"/>
                                                                                                        <GradientStop Color="#00000000" Offset="0.30"/>
                                                                                                        <GradientStop Color="#00000000" Offset="0.65"/>
                                                                                                        <GradientStop Color="#70000000" Offset="1.0"/>
                                                                                                    </LinearGradientBrush>
                                                                                                </Border.Background>
                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Grid>

                                                                            <Grid Grid.Row="1">
                                                                                <Border CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85" IsHitTestVisible="False"/>
                                                                                <Border Style="{StaticResource HubBottomBannerStyle}" Background="Transparent">
                                                                                    <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=LatestNewsTitle}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </ButtonEx>
                                                            </Grid>
                                                        </Grid>

                                                    </Grid>
                                                </DataTemplate>
                                            </Grid.Resources>
                                            <ContentControl RenderTransformOrigin="0.5,0.5">
                                                <ContentControl.RenderTransform>
                                                    <TranslateTransform X="0"/>
                                                </ContentControl.RenderTransform>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Keep only current / previous / next Hub pages instantiated. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubShouldLoadPage1}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubPage1ContentTemplate}"/>
                                                            </MultiDataTrigger>

                                                            <!-- Only the active Hub page can take focus. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsPage1}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Content" Value="{Binding}"/>
                                                                <Setter Property="ContentTemplate" Value="{StaticResource HubPage1ContentTemplate}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                            </MultiDataTrigger>

                                                            <!-- Shorter enter animation for fast LB/RB navigation. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsPage1}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubPage1ForwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubPage1ForwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Backward enter. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubIsPage1}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubPage1BackwardEnter" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubPage1BackwardEnter"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <!-- Keep previous Hub page alive for cross-fade. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasPage1}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Forward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubPage1ForwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubPage1ForwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=WelcomeHubOverlay}" Value="Visible"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubWasPage1}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HubPageDirection}" Value="Backward"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="HubPage1BackwardExit" HandoffBehavior="SnapshotAndReplace">
                                                                        <Storyboard FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="18" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="HubPage1BackwardExit"/>
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>

                                        <!-- PAGE 2 -->
                                        <Grid x:Name="HubThirdSection" Grid.Row="0" Height="1000" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.Resources>
                                                <DataTemplate x:Key="HubPage2ContentTemplate">
                                                    <Grid>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="420"/>
                                                            <RowDefinition Height="420"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Page header: same visual rhythm as the other Hub slides. -->
                                                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                                                            <TextBlock Text="{DynamicResource LOCHubLibraryOverviewTitle}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardTitleBrush}" FontSize="34" FontWeight="Bold" Margin="0,0,0,5"/>
                                                            <TextBlock Text="{DynamicResource LOCHubLibraryOverviewSubtitle}" HorizontalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" FontSize="18" Opacity="0.75"/>
                                                        </StackPanel>

                                                        <!-- TOP ROW -->
                                                        <Grid Grid.Row="1" HorizontalAlignment="Center" Width="1560" Height="420" VerticalAlignment="Top">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="780"/>
                                                                <ColumnDefinition Width="780"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- LAST PLAYED CARD -->
                                                            <Grid x:Name="HubPage2LastPlayed" Grid.Column="0" HorizontalAlignment="Center" Width="780" Height="420" VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <ButtonEx x:Name="LastPlayedCardPage2" Grid.Row="1" Width="700" Height="370" Focusable="True" FocusVisualStyle="{x:Null}" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenGameDetailsCommand}" CommandParameter="{PluginSettings Plugin=AnikiHelper, Path=SessionGameId}" Style="{StaticResource HubCardFocusButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">


                                                                    <Border CornerRadius="20" Style="{DynamicResource HubCardBorderStyle}">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="*"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="20">
                                                                                <Border.OpacityMask>
                                                                                    <VisualBrush Visual="{Binding ElementName=LastPlayedMaskPage3}" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" RenderOptions.CachingHint="Cache"/>
                                                                                </Border.OpacityMask>

                                                                                <Grid>
                                                                                    <Border x:Name="LastPlayedMaskPage3" CornerRadius="20" Background="{DynamicResource HubCardMaskImageBrush}"/>

                                                                                    <Image RenderOptions.BitmapScalingMode="Fant" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{PluginSettings Plugin=AnikiHelper, Path=SessionGameBackgroundPath}"/>
                                                                                    <Border Panel.ZIndex="4" Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                                                                                    <Grid Panel.ZIndex="2">
                                                                                        <Grid.Style>
                                                                                            <Style TargetType="Grid">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SessionGameBackgroundPath}" Value="">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>

                                                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SessionGameBackgroundPath}" Value="{x:Null}">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Grid.Style>

                                                                                        <Border x:Name="FallbackImageMask_LastPlayed" Background="Black" CornerRadius="20"/>

                                                                                        <Grid>
                                                                                            <Grid.OpacityMask>
                                                                                                <VisualBrush Visual="{Binding ElementName=FallbackImageMask_LastPlayed}"/>
                                                                                            </Grid.OpacityMask>

                                                                                            <Image Source="{ThemeFile 'Images/NoBackground.png'}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>

                                                                                            <Border Background="#44000000"/>

                                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">

                                                                                                <TextBlock Text="{DynamicResource LOCHubNoPlayedGameTitle}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center"/>

                                                                                                <TextBlock Text="{DynamicResource LOCHubNoPlayedGameSubtitle}" Margin="0,12,0,0" Style="{DynamicResource TextBlockBaseStyle}" FontSize="17" Opacity="0.78" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="460"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </Grid>

                                                                                    <Border Panel.ZIndex="5" IsHitTestVisible="False" CornerRadius="20">
                                                                                        <Border.Background>
                                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                                <GradientStop Color="#18000000" Offset="0.0"/>
                                                                                                <GradientStop Color="#00000000" Offset="0.30"/>
                                                                                                <GradientStop Color="#00000000" Offset="0.65"/>
                                                                                                <GradientStop Color="#70000000" Offset="1.0"/>
                                                                                            </LinearGradientBrush>
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                    <Border Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="10,4" CornerRadius="8" Background="{DynamicResource HubSuggestedGameBannerBackgroundBrush}" IsHitTestVisible="False">
                                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubSuggestedGameBannerBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>

                                                                            <Grid Grid.Row="1">
                                                                                <Border CornerRadius="0,0,20,20" Background="{DynamicResource HubCardBottomBackgroundBrush}" Opacity="0.85"/>
                                                                                <Border CornerRadius="0,0,20,20" Padding="18,12" SnapsToDevicePixels="True" BorderBrush="{DynamicResource HubCardBottomBorderBrush}" BorderThickness="0,2,0,0">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SessionGameName}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                                                                        <TextBlock Margin="0,2,0,0" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHubBannerCardBottomBrush}" FontSize="16" Opacity="0.75" TextTrimming="CharacterEllipsis">
                                                                                            <Run Text="{DynamicResource LOCLastSessionDuration}"/>
                                                                                            <Run Text=" : "/>
                                                                                            <Run Text="{PluginSettings Plugin=AnikiHelper, Path=SessionDurationString}"/>
                                                                                            <Run Text=" / "/>
                                                                                            <Run Text="{PluginSettings Plugin=AnikiHelper, Path=SessionTotalPlaytimeString}"/>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </ButtonEx>
