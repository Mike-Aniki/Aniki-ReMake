                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <!-- LIST principal (détails FERMÉS) -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SB_ResetBgFromList" HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.20"/>

                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.20"/>

                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.20"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="SB_ResetBgFromList"/>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <!-- DÉTAILS OUVERTS depuis HORIZONTAL -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[EnterDetailsZoom]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SB_ZoomInFromHorizontal" HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:1" BeginTime="0:0:0.03">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:1" BeginTime="0:0:0.03">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard x:Name="SB_ZoomOutToHorizontal" HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>


                                            <!-- DÉTAILS OUVERTS depuis VERTICAL -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False"/>
                                                    <Condition Binding="{Settings Fullscreen.ShowGameTitles}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=IsVisible}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SB_VertDetailDown" HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="-200" To="0" Duration="0:0:1.45">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard x:Name="SB_VertDetailUp" HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-200" Duration="0:0:1.45">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>


                                            <DataTrigger Binding="{Binding ElementName=CurrentLayoutMarker, Path=Text}" Value="PanelLayout">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AutoHideBottomFilterBar]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Game backgrounds: Playnite, BackgroundChanger and ImageRotater. -->
                                <Grid x:Name="GameBackgroundLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>

                                            <!-- In None mode the game layer is hidden on the main view. -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="None">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger>

                                                <!-- Fade the game background in/out when entering/leaving details. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="None"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGameBackgroundOnDetails]}" Value="True"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="None"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGameBackgroundOnDetails]}" Value="True"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- No Background Changer -->

                                    <FadeImage x:Name="ControlRoot" SourceUpdateDelay="150" RenderTransformOrigin="0.5,1">
                                        <FadeImage.Style>
                                            <Style TargetType="FadeImage">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Clip" Value="{x:Null}"/>
                                                <Setter Property="AnimationEnabled" Value="True"/>
                                                <Setter Property="Source" Value="{Binding SelectedGame.DisplayBackgroundImageObject}"/>

                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[BackgroundStretchMode]}" Value="True">
                                                        <Setter Property="Stretch" Value="Fill"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True">
                                                        <Setter Property="AnimationEnabled" Value="False"/>
                                                    </DataTrigger>


                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="True">
                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationBackground]}" Value="True"/>

                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>

                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="False"/>

                                                            <!-- Do not spend composition time on background animation while rapidly browsing games. -->
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFastNavigating, FallbackValue=False}" Value="False"/>

                                                            <!-- L’animation fonctionne uniquement lorsque Playnite est actif -->
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="BgZoomStoryboard" HandoffBehavior="SnapshotAndReplace">

                                                                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" AutoReverse="True">

                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.0" To="1.09" Duration="0:0:35">

                                                                        <DoubleAnimation.EasingFunction>
                                                                            <PowerEase EasingMode="EaseInOut" Power="2"/>
                                                                        </DoubleAnimation.EasingFunction>

                                                                    </DoubleAnimation>

                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.0" To="1.09" Duration="0:0:35">

                                                                        <DoubleAnimation.EasingFunction>
                                                                            <PowerEase EasingMode="EaseInOut" Power="2"/>
                                                                        </DoubleAnimation.EasingFunction>

                                                                    </DoubleAnimation>

                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>

                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="BgZoomStoryboard"/>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </FadeImage.Style>
                                    </FadeImage>

                                    <!-- Missing game background fallback -->

                                    <Grid x:Name="MissingGameBackgroundFallback" FocusVisualStyle="{x:Null}" Panel.ZIndex="-46">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.RowSpan" Value="4"/>
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True"/>
                                                            <Condition Binding="{Binding ElementName=ControlRoot, Path=Source}" Value="{x:Null}"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Image x:Name="MissingGameBackgroundFallbackImage" Source="{ThemeFile 'Images/ShadowBackground/NoBackground.png'}" Stretch="UniformToFill"/>
                                    </Grid>

                                    <!-- BackgroundChanger : image et vidéo gérées directement par le plugin -->
                                    <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="0" RenderTransformOrigin="0.5,1">
                                        <ContentControl.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </ContentControl.RenderTransform>
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="True">
                                                        <Setter Property="Height" Value="600"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationBackground]}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[SteamBanner]}" Value="False"/>
                                                            <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=BackgroundIsVideo}" Value="False"/>
                                                            <!-- Skip BackgroundChanger zoom while rapidly browsing games. -->
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFastNavigating, FallbackValue=False}" Value="False"/>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Visibility}" Value="Visible"/>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>

                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="BCBackgroundZoomStoryboard" HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.09" Duration="0:0:35">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <PowerEase EasingMode="EaseInOut" Power="2"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.09" Duration="0:0:35">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <PowerEase EasingMode="EaseInOut" Power="2"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>

                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="BCBackgroundZoomStoryboard"/>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>


                                    <!-- ImageRotater Background : image / GIF / vidéo -->
                                    <ContentControl x:Name="ImageRotater_Background" Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" IsHitTestVisible="False" Panel.ZIndex="0"/>

                                </Grid>

                                <!-- Alternative library backgrounds: Visual Pack or active filter. -->
                                <Grid x:Name="AlternativeBackgroundLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Panel.ZIndex="0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Opacity" Value="1"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="VisualPack">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="Filter">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <!-- Crossfade to the selected game's background in details. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGameBackgroundOnDetails]}" Value="True"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseGameBackgroundOnDetails]}" Value="True"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                                        <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="0"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border x:Name="BackgroundVisualPack" Width="{Binding ActualWidth, ElementName=PART_ViewHost}" Height="{Binding ActualHeight, ElementName=PART_ViewHost}" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Tag" Value="{DynamicResource BackgroundImageIndex}"/>
                                                <Setter Property="Background" Value="{DynamicResource MainBackgroundImage1}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[MainBackgroundMode]}" Value="VisualPack">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="100">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage100}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="101">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage101}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="102">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage102}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="103">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage103}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="104">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage104}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="105">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage105}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="106">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage106}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="107">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage107}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="108">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage108}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="109">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage109}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="110">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage110}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="111">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage111}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="112">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage112}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="113">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage113}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="114">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage114}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="115">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage115}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="116">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage116}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="117">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage117}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="118">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage118}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="119">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage119}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="120">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage120}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="121">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage121}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="122">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage122}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="123">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage123}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="124">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage124}"/>

                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="125">
                                                        <Setter Property="Background" Value="{DynamicResource MainBackgroundImage125}"/>

