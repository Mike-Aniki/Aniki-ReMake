                                                <CheckBoxEx x:Name="ToggleViewButton" Content="{DynamicResource LOCLayout}" Style="{DynamicResource WelcomeHubQuickButtonStyleCheckBoxEx}" MinWidth="120" Margin="8,0" Padding="20,8" FocusVisualStyle="{x:Null}" Visibility="Visible" Grid.Column="4"/>

                                                <CheckBoxEx x:Name="ChangeViewButton" Content="{DynamicResource LOCLayout}" Style="{DynamicResource WelcomeHubQuickButtonStyleCheckBoxEx}" MinWidth="120" Margin="8,0" Padding="20,8" FocusVisualStyle="{x:Null}" IsChecked="{Settings Fullscreen.HorizontalLayout, Mode=TwoWay}" Visibility="Collapsed" Grid.Column="4"/>

                                                <CheckBoxEx x:Name="ChangeDetailsButton" Content="{DynamicResource LOCLayout}" Style="{DynamicResource WelcomeHubQuickButtonStyleCheckBoxEx}" MinWidth="120" Margin="8,0" Padding="20,8" FocusVisualStyle="{x:Null}" IsChecked="{Settings Fullscreen.ShowGameTitles, Mode=TwoWay}" Visibility="Collapsed" Grid.Column="4"/>

