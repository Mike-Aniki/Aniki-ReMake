                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- AVATAR -->
                                                <Grid Width="56" Height="56" VerticalAlignment="Center">

                                                    <!-- masque rond -->
                                                    <Border x:Name="AvatarMaskHeader" Width="56" Height="56" Background="Black" CornerRadius="28"/>

                                                    <!-- path image avatar -->
