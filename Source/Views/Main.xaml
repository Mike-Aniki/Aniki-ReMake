                                                                                     RelativeSource="{RelativeSource Self}" />
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Image x:Name="UserAvatarLogin"
                                                           Source="{Binding ElementName=ProfilePicturePathLogin, Path=Text}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"
                                                           Width="201"
                                                           Height="201"/>
                                                </Grid>

                                                <!-- contour rond -->
                                                <Border Width="201"
                                                        Height="201"
                                                        CornerRadius="101"
                                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                                        BorderThickness="2"
                                                        Background="#23000000"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="5"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,-300"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="2" Opacity="1" />
                                    </Grid.Effect>

                                    <Grid.Resources>
                                        <Storyboard x:Key="PressAToContinuePulse"
                                                    RepeatBehavior="Forever"
                                                    AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="PressAToContinueGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="0.80"
                                                             Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </Grid.Resources>

                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard x:Name="PressAToContinuePulse_SB"
                                                             Storyboard="{StaticResource PressAToContinuePulse}" />
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Unloaded">
                                            <StopStoryboard BeginStoryboardName="PressAToContinuePulse_SB"/>
                                        </EventTrigger>
                                    </Grid.Triggers>

                                    <!-- glow discret -->
                                    <Border x:Name="PressAToContinueGlow"
                                            Padding="18,8,18,8"
                                            CornerRadius="18"
                                            Background="#66FFFFFF"
                                            Opacity="1"
                                            IsHitTestVisible="False"
                                            RenderTransformOrigin="0.5,0.5">

                                    </Border>

                                    <Border x:Name="BackgroundButton"
                                            Padding="16,4,16,4"
                                            CornerRadius="18"
                                            Background="{DynamicResource BottomBar}"
                                            Opacity="0.6"
                                            IsHitTestVisible="False"
                                            RenderTransformOrigin="0.5,0.5">

                                    </Border>

                                    <!-- capsule -->
                                    <Border Padding="16,4,16,4"
                                            CornerRadius="18"
                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                            BorderThickness="1.5">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCPress}"
                                                       Foreground="#F5F5F5"
                                                       FontSize="22"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                            <ButtonEx Margin="-18,0,-20,0"
                                                      Style="{DynamicResource ButtonBottomMenu}"
                                                      Tag="A"
                                                      Opacity="1"/>

                                            <TextBlock Text="{DynamicResource LOCCcontinue}"
                                                       Margin="0,0,0,0"
                                                       Foreground="#EAEAEA"
                                                       FontSize="22"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- FOOTER -->
                                <TextBlock Text="Aniki ReMake v3.1.1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,22,18"
                                           FontSize="16"
                                           Opacity="0.30"
                                           Foreground="White"
                                           Style="{DynamicResource TextBlockBaseStyle}"/>
                            </Grid>


                            <StackPanel KeyboardNavigation.TabNavigation="Contained"
                                        KeyboardNavigation.ControlTabNavigation="Contained"
                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                        Margin="0,0,0,370"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        Opacity="0">

                                <ToggleButtonEx x:Name="Acceuil"
                                                Focusable="True"
                                                pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                VerticalAlignment="Center"
                                                Margin="20,0,20,0"
                                                Width="280"
                                                Style="{DynamicResource AcceuilChangeToggle}"
                                                Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}"
                                                CommandParameter="[Setter ElementName=LockScreen, Property=IsChecked, Value=False]">

                                    <ToggleButtonEx.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <MediaTimeline Source="{ThemeFile 'audio/Connexion.mp3'}"
                                                                   Storyboard.TargetName="ConnexionClick"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ToggleButtonEx.Triggers>

                                    <ToggleButtonEx.Content>
                                        <Grid>
                                            <Border RenderOptions.BitmapScalingMode="Fant"
                                                    CornerRadius="{DynamicResource Corner}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Height" Value="60"/>
                                                                <Setter Property="Width" Value="60"/>
                                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </ToggleButtonEx.Content>
                                </ToggleButtonEx>
                            </StackPanel>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Source={StaticResource AcceuilOrNot}}" Value="False"/>
                                                <Condition Binding="{Binding ElementName=LockScreen, Path=IsChecked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=LockScreen, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="1"/>

                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0"
                                                                         To="1"
                                                                         Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.94"
                                                                         To="1"
                                                                         Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.94"
                                                                         To="1"
                                                                         Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=Acceuil, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>


                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- Power ControlCenter -->
                        <Grid x:Name="Power"
                              Panel.ZIndex="50"
                              Focusable="True"
                              Background="#99000000"
                              KeyboardNavigation.TabNavigation="Contained"
                              KeyboardNavigation.ControlTabNavigation="Contained"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              FocusManager.FocusedElement="{Binding ElementName=ExitCommand}">

                            <Grid.InputBindings>
                                <pin:GameControllerInputBinding Button="B"
                                                                Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}"
                                                                CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]" />

                                <KeyBinding Key="Esc"
                                            Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}"
                                            CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]" />
                            </Grid.InputBindings>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ButtonPower, Path=IsChecked}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0"
                                                                         To="1"
                                                                         Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.Resources>

                                <!-- ==========================================================
                                POWER MENU BUTTON STYLE
                                ========================================================== -->
                                <Style x:Key="PowerMenuButtonStyle" TargetType="ButtonEx">
                                    <Setter Property="Height" Value="68"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="IsTabStop" Value="True"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ButtonEx">

                                                <Grid Background="{TemplateBinding Background}"
                                                      ClipToBounds="True"
                                                      SnapsToDevicePixels="True">

                                                    <!-- NORMAL BACKGROUND -->
                                                    <Border x:Name="NormalBackground"
                                                            CornerRadius="7"
                                                            Background="#10000000"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"/>

                                                    <!-- FOCUS BACKGROUND -->
                                                    <Border x:Name="MainBackground"
                                                            CornerRadius="7"
                                                            Background="{DynamicResource ButtonBackgroundFocus}"
                                                            Visibility="Collapsed"/>

                                                    <!-- FOCUS BORDER -->
                                                    <Border x:Name="MainBorder"
                                                            BorderThickness="2"
                                                            CornerRadius="7"
                                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                            Visibility="Collapsed"/>

                                                    <!-- FLASH FX -->
                                                    <Border x:Name="FlashMenuBorder"
                                                            CornerRadius="7"
                                                            Style="{DynamicResource AnimatedFlashMenu}"
                                                            Tag="False"
                                                            Visibility="Collapsed"/>

                                                    <ContentPresenter Margin="18,0"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"/>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="NormalBackground" Property="Background" Value="#26000000"/>
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Grid.Resources>


                            <!-- MAIN PANEL -->
                            <Grid x:Name="PowerPanel"
                                  Width="520"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  RenderTransformOrigin="0.5,0.5"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.ControlTabNavigation="Contained">

                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>

                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                 From="-60"
                                                                 To="0"
                                                                 Duration="0:0:0.30">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <!-- PANEL BACKGROUND -->
                                <Border Background="{DynamicResource OverlayMenu}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="0,0,1,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28"
                                                          ShadowDepth="0"
                                                          Opacity="0.55"
                                                          Color="#000000"/>
                                    </Border.Effect>
                                </Border>

                                <!-- GLASS OVERLAY -->
                                <Border Background="{DynamicResource GlassMainBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0.55"/>


                                <!-- INNER CONTENT -->
                                <Grid Margin="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#33000000" Grid.Row="0"/>
                                    <Border Background="#33000000" Grid.Row="4"/>


                                    <!-- HEADER -->
                                    <Grid Grid.Row="0"
                                          Height="96"
                                          Margin="22,10,22,10">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="54"
                                                Height="54"
                                                CornerRadius="27"
                                                Background="#14000000"
                                                BorderBrush="#24FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="&#xE7E8;"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0,0,0">

                                            <TextBlock Text="{DynamicResource LOCPowerControlCenter}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Foreground="{DynamicResource TextHighlightBrush}"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="System and session options"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.65"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                    </Grid>


                                    <!-- SEPARATOR -->
                                    <Border Grid.Row="1"
                                            Height="1"
                                            Margin="22,0"
                                            Background="#20FFFFFF"/>


                                    <!-- BUTTONS -->
                                    <ScrollViewer Grid.Row="2"
                                                  Margin="16,14,16,14"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  Focusable="False">

                                        <StackPanel Orientation="Vertical"
                                                    KeyboardNavigation.TabNavigation="Cycle"
                                                    KeyboardNavigation.DirectionalNavigation="Contained">

                                            <!-- EXIT PLAYNITE -->
                                            <ButtonEx x:Name="ExitCommand"
                                                      pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                      Style="{StaticResource PowerMenuButtonStyle}"
                                                      Command="{Binding Data.MainMenu.ExitCommand, Source={StaticResource ANIKIHELPER_Commands}}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE8BB;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCExitPlaynite}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>


                                            <!-- MINIMIZE -->
                                            <ButtonEx x:Name="MinimizeCommand"
                                                      Command="{Binding Data.MainMenu.MinimizeCommand, Source={StaticResource ANIKIHELPER_Commands}}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerMenuButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowMinimizeButton]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE921;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCMinimize}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>


                                            <!-- DESKTOP MODE -->
                                            <ButtonEx x:Name="DesktopCommand"
                                                      Command="{Binding SwitchToDesktopCommand}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerMenuButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowDesktopButton]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xEC4E;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCBackToDesktopMode}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>


                                            <!-- RESTART SYSTEM -->
                                            <ButtonEx x:Name="RestartCommand"
                                                      Command="{Binding Data.MainMenu.RestartSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerMenuButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowRestartButton]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE72C;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCMenuRestartSystem}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>


                                            <!-- SHUTDOWN SYSTEM -->
                                            <ButtonEx x:Name="ShutdownCommand"
                                                      Command="{Binding Data.MainMenu.ShutdownSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerMenuButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowShutdownButton]}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE7E8;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="27"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCMenuShutdownSystem}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>

                                            <!-- LOCK SYSTEM -->
                                            <ButtonEx x:Name="LockCommand"
                                                      Command="{Binding Data.MainMenu.LockSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}"
                                                      Style="{StaticResource PowerMenuButtonStyle}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE72E;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCMenuLockSystem}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>

                                            <!-- LOG OUT USER -->
                                            <ButtonEx x:Name="LogoutCommand"
                                                      Command="{Binding Data.MainMenu.LogoutUserCommand, Source={StaticResource ANIKIHELPER_Commands}}"
                                                      Style="{StaticResource PowerMenuButtonStyle}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE8AC;"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="25"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{DynamicResource LOCMenuLogoutUser}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </ButtonEx>


                                            <!-- SLEEP SYSTEM -->
                                            <ButtonEx x:Name="SleepCommand"
                                                      Command="{Binding Data.MainMenu.SleepSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerMenuButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowSleepButton]}" Value="False">
