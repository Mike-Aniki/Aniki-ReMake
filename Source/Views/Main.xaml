                                            <StackPanel Orientation="Horizontal">

                                                <ButtonEx x:Name="PART_ButtonMainMenu" Content="{DynamicResource LOCMainMenu}" MinWidth="120" Margin="8,0" Padding="20,8" Visibility="Collapsed" Style="{StaticResource WelcomeHubQuickButtonStyle}" Command="{Binding OpenMainMenuCommand}" Focusable="False"/>

                                                <CheckBoxEx x:Name="WelcomeHubButton" Content="{DynamicResource LOCHub}" Style="{DynamicResource WelcomeHubQuickButtonStyleCheckBoxEx}" MinWidth="120" Margin="8,0" Padding="20,8" FocusVisualStyle="{x:Null}" Grid.Column="7" IsChecked="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Command="{PluginSettings Plugin=AnikiHelper, Path=ToggleWelcomeHubCommand}">
