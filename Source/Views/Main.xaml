                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#10000000" Offset="0"/>
                                                                <GradientStop Color="#18000000" Offset="0.45"/>
                                                                <GradientStop Color="#3A000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <!-- Highlight -->
                                                    <Rectangle RadiusX="22"
                                                               RadiusY="22"
                                                               IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#26FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#08FFFFFF" Offset="0.18"/>
                                                                <GradientStop Color="#00000000" Offset="0.35"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>
                                        </ButtonEx>

                                        <!-- COLONNE CARTES 1 -->
                                        <!-- Carte 1 : Playtime -->
                                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Playtime"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>
                                                <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="23"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 2 : Install Size -->
                                        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Install Size"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>
                                                <TextBlock Text="{Binding InstallSize, Converter={StaticResource NullableUlongBytesSizeToStringConverter}, ConverterParameter=' / '}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="23"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 3 : Last Activity -->
                                        <Border Grid.Column="2" Grid.Row="4" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Last Activity"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>
                                                <TextBlock Text="{Binding LastActivity, StringFormat={}{0:dd MMM yyyy}}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="20"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 4 : Critic Score -->
                                        <Border Grid.Column="2" Grid.Row="6" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Critic Score"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="&#xec7c;"
                                                               FontFamily="{DynamicResource FontIcoFont}"
                                                               Style="{StaticResource TextBlockBaseStyle}"
                                                               FontSize="20"
                                                               Opacity="0.85"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Text="{Binding CriticScore}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 5 : Genres -->
                                        <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource DetailedInfoCardStyle}">

                                            <StackPanel>
                                                <TextBlock Text="Genres"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <WrapPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Genres[0]}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.92"/>
                                                    <TextBlock Text="{Binding Genres[1]}"
                                                               Margin="10,0,0,0"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.92"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 6 : Age Rating -->
                                        <Border Grid.Column="4" Grid.Row="2" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Age Rating"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <ItemsControlEx ItemsSource="{Binding AgeRatings}"
                                                                Margin="0,8,0,0"
                                                                IsTabStop="False"
                                                                IsEnabled="False"
                                                                Focusable="False"
                                                                VerticalAlignment="Center">
                                                    <ItemsControlEx.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControlEx.ItemsPanel>

                                                    <ItemsControlEx.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image x:Name="DetailedRatingIconImage2"
                                                                   Height="26"
                                                                   Margin="0,0,8,0"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   SnapsToDevicePixels="True"
                                                                   Source="{ThemeFileBinding Name, PathFormat='Icons/AgeRating/Alt/{0}.png'}"/>

                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=DetailedRatingIconImage2, Path=Source}" Value="{x:Null}">
                                                                    <Setter TargetName="DetailedRatingIconImage2" Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControlEx.ItemTemplate>
                                                </ItemsControlEx>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 7 : Features -->
                                        <Border Grid.Column="4" Grid.Row="4" Style="{StaticResource DetailedInfoCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Features"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <ItemsControl Margin="0,8,0,0"
                                                              ItemsSource="{Binding Game.Features}"
                                                              Focusable="False"
                                                              ClipToBounds="False"
                                                              FocusVisualStyle="{x:Null}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Width="30"
                                                                   Height="30"
                                                                   Margin="0,0,8,8"
                                                                   Opacity="0.85"
                                                                   Stretch="Uniform"
                                                                   Source="{ThemeFileBinding Name, PathFormat='Icons/Features/{0}.png'}"
                                                                   RenderOptions.BitmapScalingMode="Fant">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 8 : Trophies PA -->
                                        <Border Grid.Column="4" Grid.Row="6" x:Name="DetailedTrophyCard_PA">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DetailedInfoCardStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="Trophies"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Image Source="{ThemeFile 'Images/Trophy.png'}"
                                                           Height="20"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="Fant"/>

                                                    <TextBlock Margin="10,0,0,0"
                                                               Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock Text="/"
                                                               Margin="6,0,6,0"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.42"/>

                                                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>

                                        <!-- Carte 8bis : Trophies SS -->
                                        <Border Grid.Column="4" Grid.Row="6" x:Name="DetailedTrophyCard_SS">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DetailedInfoCardStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                                <Condition Binding="{PluginStatus Plugin=playnite-successstory-plugin, Status=Installed}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="Trophies"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="15"
                                                           Opacity="0.62"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Image Source="{ThemeFile 'Images/Trophy.png'}"
                                                           Height="20"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="Fant"/>

                                                    <TextBlock Margin="10,0,0,0"
                                                               Text="{PluginSettings Plugin=SuccessStory, Path=Unlocked, FallbackValue='-'}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock Text="/"
                                                               Margin="6,0,6,0"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.42"/>

                                                    <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Total, FallbackValue='-'}"
                                                               Style="{DynamicResource TextBlockBaseStyle}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>
                                    </Grid>


                                    <!-- GAME PROFILE BANNER -->
                                    <Border x:Name="GameProfileBannerCard"
                                            Grid.Row="4"
                                            Focusable="True"
                                            FocusVisualStyle="{x:Null}">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ListDetailsBackgroundBrush}"/>
                                                <Setter Property="CornerRadius" Value="20"/>
                                                <Setter Property="Padding" Value="22"/>
                                                <Setter Property="MinHeight" Value="220"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ListDetailsBorder}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#000000"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.30"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2.5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.Resources>

                                            <DropShadowEffect x:Key="GameProfileInnerCardShadow"
                                                              Color="#000000"
                                                              ShadowDepth="0"
                                                              Opacity="0.20"/>

                                            <Style x:Key="GameProfileInnerCardStyle"
                                                   TargetType="Border">
                                                <Setter Property="CornerRadius" Value="22"/>
                                                <Setter Property="Padding" Value="18"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="#05FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Effect" Value="{StaticResource GameProfileInnerCardShadow}"/>
                                            </Style>

                                            <Style x:Key="GameProfileCardTitleText"
                                                   TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="20"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                                            </Style>

                                            <Style x:Key="GameProfileCardBodyText"
                                                   TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="17"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Style>

                                            <Style x:Key="GameProfileLabelStyle"
                                                   TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="18"/>
                                                <Setter Property="Opacity" Value="0.80"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileValueStyle"
                                                   TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="26"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextTitleStatViewBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileSubValueStyle"
                                                   TargetType="TextBlock"
                                                   BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="FontSize" Value="18"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>

                                            <Style x:Key="GameProfileChip"
                                                   TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>

                                        </Border.Resources>

                                        <Grid KeyboardNavigation.TabNavigation="Continue"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical"
                                                            HorizontalAlignment="Left">
                                                    <TextBlock Text="Game Profile"
                                                               Style="{StaticResource GameProfileCardTitleText}"
                                                               FontSize="28"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!--SourceLogo-->
                                                <Grid Grid.Row="0"
                                                      HorizontalAlignment="Right"
                                                      Margin="0,0,0,0">

                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">

                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Margin" Value="0,0,20,0"/>
                                                                <Setter Property="Visibility" Value="Visible"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <!-- Chemin custom défini dans Aniki Helper -->
                                                        <TextBlock x:Name="CustomIconSourcePathText"
                                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=CustomSourceIconsFolder}"
                                                                   Visibility="Collapsed"/>

                                                        <!-- Chemin final source : CustomFolder/Game.Source.Name.png -->
                                                        <TextBlock x:Name="CustomLibraryIconPath"
                                                                   Visibility="Collapsed">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}/{1}.png">
                                                                    <Binding Path="Text" ElementName="CustomIconSourcePathText"/>
                                                                    <Binding Path="Game.Source.Name"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <!-- Chemin final plateforme : CustomFolder/Game.Platforms[0].Name.png -->
                                                        <TextBlock x:Name="CustomPlatformIconPath"
                                                                   Visibility="Collapsed">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}/{1}.png">
                                                                    <Binding Path="Text" ElementName="CustomIconSourcePathText"/>
                                                                    <Binding Path="Game.Platforms[0].Name"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <Grid VerticalAlignment="Center"
                                                              HorizontalAlignment="Center">

                                                            <!-- 1. Icône source custom utilisateur -->
                                                            <Image x:Name="CustomLibraryIcon"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   Height="50"
                                                                   MaxWidth="180"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Source="{Binding Text, ElementName=CustomLibraryIconPath}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>

                                                                        <Style.Triggers>
                                                                            <!-- Aucun dossier custom défini -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomIconSourcePathText, Path=Text}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône custom source absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 2. Icône source par défaut du thème -->
                                                            <Image x:Name="LibraryIcon"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   Height="50"
                                                                   MaxWidth="180"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Source/{0}.png'}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- On affiche le fallback thème si l’icône custom source est absente -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône source thème absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 3. Icône plateforme custom utilisateur -->
                                                            <Image x:Name="CustomPlateformIcon"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   Height="50"
                                                                   MaxWidth="180"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Source="{Binding Text, ElementName=CustomPlatformIconPath}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- Plateforme custom seulement si aucune icône source n’est disponible -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=LibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>

                                                                            <!-- Aucun dossier custom défini -->
                                                                            <DataTrigger Binding="{Binding ElementName=CustomIconSourcePathText, Path=Text}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                            <!-- Icône plateforme custom absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- 4. Icône plateforme par défaut du thème -->
                                                            <Image x:Name="PlateformIcon"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   Height="50"
                                                                   MaxWidth="180"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Source/{0}.png'}">

                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>
                                                                            <!-- Fallback plateforme thème si source + plateforme custom absentes -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=CustomLibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=LibraryIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                    <Condition Binding="{Binding ElementName=CustomPlateformIcon, Path=Visibility}" Value="Collapsed"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>

                                                                            <!-- Icône plateforme thème absente -->
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- Content -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CARD 1 -->
                                                <Border Grid.Column="0"
                                                        Style="{StaticResource GameProfileInnerCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{DynamicResource LOCStudio}"
                                                                   Style="{StaticResource GameProfileCardTitleText}"
                                                                   Margin="0,0,0,4"/>

                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{DynamicResource LOCGameDevelopersTitle}"
                                                                       Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Developers[0].Name, FallbackValue='-', TargetNullValue='-'}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource GameProfileValueStyle}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4">
                                                            <TextBlock Text="{DynamicResource LOCGamePublishersTitle}"
                                                                       Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Publishers[0].Name, FallbackValue='-', TargetNullValue='-'}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource GameProfileSubValueStyle}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- CARD 2 -->
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource GameProfileInnerCardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{DynamicResource LOCLibraryList}"
                                                                   Style="{StaticResource GameProfileCardTitleText}"
                                                                   Margin="0,0,0,4"/>

                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{DynamicResource LOCAddedtoLibrary}"
                                                                       Style="{StaticResource GameProfileLabelStyle}"/>
                                                            <TextBlock Text="{Binding Added, StringFormat={}{0:dd MMM yyyy}, FallbackValue='-'}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource GameProfileValueStyle}"/>
                                                        </StackPanel>

                                                        <WrapPanel Grid.Row="4"
                                                                   Margin="0,6,0,0">

                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock Text="{Binding Source.Name, FallbackValue='-', TargetNullValue='-'}"
                                                                           Style="{StaticResource GameProfileCardBodyText}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>

                                                            <Border Style="{StaticResource GameProfileChip}">
                                                                <TextBlock Text="{Binding Platforms[0].Name, FallbackValue='-', TargetNullValue='-'}"
