                                        <!-- TROPHY : PLAYNITE ACHIEVEMENTS -->
                                        <CheckBoxEx x:Name="TopBarTrophy_PA" Grid.Column="3" Margin="0,0,7,0" VerticalAlignment="Center" Height="40" MinWidth="50" Focusable="True" Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[AchievementsWindow|SortButton|SecondaryMusic]}">
                                            <CheckBoxEx.Style>
                                                <Style TargetType="CheckBoxEx" BasedOn="{StaticResource TopBarAchievementButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowAchievementsButton]}" Value="True"/>
                                                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBoxEx.Style>

                                            <CheckBoxEx.Triggers>
                                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenViewSound" Storyboard.TargetProperty="LoadedBehavior">
