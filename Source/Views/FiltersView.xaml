<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Navigation button -->
    <Style x:Key="FilterPanelNagivationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="12,2,12,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Height" Value="52" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="MainBackground"
                                CornerRadius="{DynamicResource Corner}"
                                Background="Transparent" />

                        <Border x:Name="MainBorder"
                                Margin="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="3"
                                CornerRadius="{DynamicResource Corner}"
                                Visibility="Collapsed" />

                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TextContent"
                                       Grid.Column="0"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <ContentPresenter />
                            </TextBlock>

                            <TextBlock x:Name="IconText"
                                       Grid.Column="1"
                                       Text="&#xeaa0;"
                                       FontFamily="{DynamicResource FontIcoFont}"
                                       FontSize="28"
                                       Margin="16,0,0,0"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selection items -->
    <Style x:Key="FilterItemtSelectionStyle" TargetType="CheckBoxEx" BasedOn="{StaticResource FilterPanelCheckBoxEx}" />

    <!-- Checkbox / toggle -->
    <Style x:Key="FilterPanelCheckBoxEx" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
        <Setter Property="Margin" Value="18,2,12,2" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Action button (Clear etc.) -->
    <Style x:Key="FilterPanelButtonEx" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="50" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Margin" Value="18,18,18,18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="MainBackground"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{TemplateBinding Background}" />

                        <Border x:Name="MainBorder"
                                Margin="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="3"
                                CornerRadius="{DynamicResource Corner}"
                                Visibility="Collapsed" />

                        <TextBlock Style="{DynamicResource ButtonTextBlockBaseStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="24"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter />
                        </TextBlock>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="FilterPanelComboBoxEx" TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBoxEx}}">
        <Setter Property="Margin" Value="12,2,12,8" />
        <Setter Property="Height" Value="52" />
    </Style>

    <!-- Section text -->
    <Style x:Key="FilterPanelText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin" Value="18,24,18,8" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>

    <!-- Preset bottom buttons -->
    <Style x:Key="FilterPanelFilterPresetActionButton" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="Margin" Value="12,20,12,0" />
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="#12000000" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="MainBackground"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{TemplateBinding Background}" />

                        <Border x:Name="MainBorder"
                                Margin="0"
                                CornerRadius="{DynamicResource Corner}"
                                BorderThickness="3"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}" />

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundFocus}" TargetName="MainBackground" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset icons -->
    <DataTemplate x:Key="FilterPanelAddPresetTemplate">
        <TextBlock Text="&#xefc2;"
                   TextAlignment="Center"
                   FontFamily="{StaticResource FontIcoFont}"
                   FontWeight="Bold"
                   FontSize="24"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRenamePresetTemplate">
        <TextBlock Text="&#xec55;"
                   TextAlignment="Center"
                   Margin="0,0,0,0"
                   FontFamily="{StaticResource FontIcoFont}"
                   FontWeight="Bold"
                   FontSize="22"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRemovePresetTemplate">
        <TextBlock Text="&#xeee4;"
                   TextAlignment="Center"
                   Margin="0,5,0,0"
                   FontFamily="{StaticResource FontIcoFont}"
                   FontWeight="Bold"
                   FontSize="28"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </DataTemplate>

    <!-- Filters host -->
    <Style TargetType="{x:Type Filters}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Filters}">
                    <Border Background="Transparent"
                            CornerRadius="0"
                            Width="560"
                            Height="{StaticResource DesignHeight}">
                        <ItemsControlEx x:Name="PART_ItemsHost"
                                        Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True"
                                                  Padding="0,12,0,18">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControlEx>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>