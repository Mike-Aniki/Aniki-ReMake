    <sys:String x:Key="LOCFirstSetupInterfaceTitle">Escolha o estilo da interface</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceDesc">Selecione a quantidade de informações e atalhos exibidos na interface principal.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfacePresetNote">Estas são apenas configurações predefinidas. Cada opção pode ser ajustada individualmente em Settings > Customization.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceClean">Limpa</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCleanDesc">Ativa a ocultação automática das barras superior e inferior, oculta os painéis de informações e a maioria dos botões integrados, mantendo o Overlay disponível.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandard">Padrão</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandardDesc">Usa a configuração padrão do Aniki ReMake: barra superior visível, barra inferior com ocultação automática, atalhos do controle e principais botões de recursos.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhanced">Aprimorada</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhancedDesc">Mantém a barra superior visível e oculta automaticamente a inferior, com barra superior transparente, informações compactas do jogo e principais botões.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Completa</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Mantém as duas barras visíveis e ativa a moldura da lista, os atalhos do controle, o painel lateral detalhado e todos os recursos integrados.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorTitle">Escolha uma cor</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDesc">Selecione um preset representativo para a primeira experiência.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefault">Default</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefaultDesc">A paleta original do Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreen">Hunter Green</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreenDesc">Uma paleta verde profunda com um visual natural e discreto.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlue">Orbis Blue</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlueDesc">Uma paleta azul limpa inspirada em consolas.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRed">Scarlet Red</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRedDesc">Uma paleta vermelha forte e mais energética.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestige">Sapphire Prestige</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestigeDesc">Um preset escuro premium com destaques refinados.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPink">Midnight Pink</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPinkDesc">Uma paleta rosa profunda com um visual mais escuro e atmosférico.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorMorePresets">Mais de 40 presets de cor estão disponíveis no menu Customization.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsTitle">Escolha o layout de detalhes</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsDesc">Selecione como as informações do jogo são organizadas no ecrã de detalhes.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignature">Signature</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignatureDesc">O layout de detalhes Signature do Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModern">Moderno</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModernDesc">Uma apresentação espaçosa e contemporânea.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassic">Clássico</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassicDesc">Um layout familiar focado na legibilidade.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginal">Original</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginalDesc">Retoma o estilo da tela de Detalhes do Aniki ReMake original (v1).</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcase">Showcase</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcaseDesc">Um layout visual com mais espaço para as imagens do jogo.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanel">Painéis</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanelDesc">Um layout estruturado com informações agrupadas em painéis.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceTitle">Escolha a experiência visual</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceDesc">Cada predefinição controla as animações e os efeitos visuais do tema.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFull">Full Animated</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFullDesc">Ativa todas as animações e efeitos visuais do tema, incluindo fundos animados.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimated">Animada</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimatedDesc">Mantém as principais animações e efeitos visuais, mas desativa os fundos animados.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalanced">Equilibrada</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalancedDesc">Usa os padrões recomendados do Aniki ReMake para equilibrar animações, efeitos visuais e fluidez.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformance">Desempenho</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformanceDesc">Desativa todas as animações e efeitos visuais do tema para oferecer o melhor desempenho possível. Recomendado para dispositivos portáteis e computadores mais modestos.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceWarning">Animações contínuas e efeitos visuais podem reduzir o desempenho em portáteis ou computadores modestos.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersTitle">Escolha onde os trailers são reproduzidos automaticamente</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDesc">Escolha nenhum trailer, apenas nos detalhes dos jogos ou na biblioteca e nos detalhes.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabled">Desativados</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabledDesc">Desativa trailers automáticos na biblioteca e nos detalhes dos jogos.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetails">Apenas detalhes</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetailsDesc">Reproduz trailers automaticamente apenas nas páginas de detalhes dos jogos.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetails">Biblioteca e detalhes</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetailsDesc">Reproduz trailers automaticamente na biblioteca principal e nas páginas de detalhes.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersNote">A exibição em miniatura ou tela inteira e as outras opções continuam disponíveis em Settings > Customization. O streaming pode usar recursos adicionais.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsTitle">Extensões para a experiência completa do Aniki ReMake</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsDesc">Selecione as extensões ausentes. Elas serão instaladas depois que a configuração for aplicada, para que seja necessário apenas um reinício final. Depois de reiniciar, ainda será necessário abrir as configurações delas no modo Desktop para configurá-las.</sys:String>
    <sys:String x:Key="LOCFirstSetupSteamDesc">Entre no Steam pelas configurações do Aniki Helper no modo Área de trabalho para amigos, lista de desejos, recomendações e Store.</sys:String>
    <sys:String x:Key="LOCFirstSetupAchievementsDesc">Adiciona conquistas, progresso, raridade e notificações de conquistas.</sys:String>
    <sys:String x:Key="LOCFirstSetupMusicDesc">Adiciona música de fundo, música das telas e o player integrado.</sys:String>
    <sys:String x:Key="LOCFirstSetupAudioSwitcherDesc">Permite trocar rapidamente o dispositivo de áudio pelo tema e pelo overlay durante o jogo.</sys:String>
    <sys:String x:Key="LOCFirstSetupCustomFadeDesc">Permite alterar e personalizar a animação de transição dos planos de fundo ao trocar de jogo.</sys:String>
    <sys:String x:Key="LOCFirstSetupExtraMetadataDesc">Carrega logos, vídeos, trailers e outras mídias adicionais usadas pelo tema. O Extra Metadata Fullscreen Mode Helper também será instalado.</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsTitle">Capturas e galeria</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsDesc">Escolha Screenshots Visualizer ou Screenshot Utilities para exibir capturas e vídeos na galeria, no Hub e no overlay durante o jogo.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsOptional">Todas as extensões são opcionais, mas cada uma ativa uma parte importante da experiência completa do Aniki ReMake.</sys:String>
