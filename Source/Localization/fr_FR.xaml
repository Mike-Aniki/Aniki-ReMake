    <sys:String x:Key="LOCFirstSetupInterfaceStandardDesc">Utilise la configuration Aniki ReMake par défaut : barre supérieure visible, barre inférieure en masquage automatique, raccourcis manette et principaux boutons de fonctions.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhanced">Enrichie</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhancedDesc">Garde la barre supérieure visible et masque automatiquement la barre inférieure, avec une barre supérieure transparente, les informations compactes du jeu et les principaux boutons.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Complète</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Garde les deux barres visibles et active le cadre de la liste, les raccourcis manette, le panneau latéral détaillé et toutes les fonctions intégrées.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorTitle">Choisissez une couleur</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDesc">Sélectionnez un preset représentatif pour votre première expérience.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefault">Default</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefaultDesc">La palette originale d’Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreen">Hunter Green</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreenDesc">Une palette vert profond au style naturel et discret.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlue">Orbis Blue</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlueDesc">Une palette bleue épurée inspirée des interfaces console.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRed">Scarlet Red</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRedDesc">Une palette rouge marquée au style plus énergique.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestige">Sapphire Prestige</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestigeDesc">Un preset sombre premium avec des reflets raffinés.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPink">Midnight Pink</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPinkDesc">Une palette rose profond au style plus sombre et atmosphérique.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorMorePresets">Plus de 40 presets de couleurs sont disponibles dans le menu Customization.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsTitle">Choisissez une disposition des détails</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsDesc">Sélectionnez la façon dont les informations sont organisées sur la page d’un jeu.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignature">Signature</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignatureDesc">La disposition Signature d’Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModern">Moderne</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModernDesc">Une présentation spacieuse et contemporaine.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassic">Classique</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassicDesc">Une disposition familière axée sur la lisibilité.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginal">Originale</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginalDesc">Reprend le style de la vue Détails de la version originale d’Aniki ReMake (v1).</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcase">Showcase</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcaseDesc">Une présentation visuelle donnant plus de place aux illustrations.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanel">Panneaux</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanelDesc">Une disposition structurée regroupant les informations par panneaux.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceTitle">Choisissez votre expérience visuelle</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceDesc">Chaque preset contrôle les animations et les effets visuels du thème.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFull">Full Animated</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFullDesc">Active toutes les animations et tous les effets visuels du thème, y compris les arrière-plans animés.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimated">Animée</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimatedDesc">Conserve les principales animations et les effets visuels, mais désactive les arrière-plans animés.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalanced">Équilibrée</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalancedDesc">Utilise les réglages recommandés d’Aniki ReMake pour équilibrer animations, effets visuels et fluidité.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformance">Performance</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformanceDesc">Désactive toutes les animations et tous les effets visuels du thème afin d’obtenir les meilleures performances. Recommandé pour les consoles portables et les configurations modestes.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceWarning">Les animations continues et les effets visuels peuvent réduire les performances sur les consoles portables ou les PC modestes.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersTitle">Choisissez où les trailers se lancent automatiquement</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDesc">Choisissez de ne lancer aucun trailer, de les afficher uniquement dans les détails ou dans la bibliothèque et les détails.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabled">Désactivés</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabledDesc">Désactive le lancement automatique des trailers dans la bibliothèque et les détails des jeux.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetails">Détails uniquement</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetailsDesc">Lance automatiquement les trailers uniquement sur les pages de détails des jeux.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetails">Bibliothèque et détails</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetailsDesc">Lance automatiquement les trailers dans la bibliothèque principale et sur les pages de détails.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersNote">L’affichage mini ou plein écran et les autres options restent configurables dans Settings > Customization. Le streaming peut consommer davantage de ressources.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsTitle">Extensions pour profiter pleinement d’Aniki ReMake</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsDesc">Sélectionnez les extensions manquantes. Elles seront installées après l’application de votre configuration afin de ne demander qu’un seul redémarrage final. Après le redémarrage, vous devrez toutefois ouvrir leurs réglages en mode Bureau pour les configurer.</sys:String>
    <sys:String x:Key="LOCFirstSetupSteamDesc">Connectez-vous à Steam depuis les réglages d’Aniki Helper en mode Bureau pour utiliser les amis Steam, la wishlist, les recommandations et le Store.</sys:String>
    <sys:String x:Key="LOCFirstSetupAchievementsDesc">Ajoute les trophées, la progression, la rareté et les notifications de succès.</sys:String>
    <sys:String x:Key="LOCFirstSetupMusicDesc">Ajoute les musiques de fond, les musiques des vues et le lecteur intégré.</sys:String>
    <sys:String x:Key="LOCFirstSetupAudioSwitcherDesc">Permet de changer rapidement de périphérique audio depuis le thème et l’overlay en jeu.</sys:String>
    <sys:String x:Key="LOCFirstSetupCustomFadeDesc">Permet de changer et de personnaliser l’animation de transition des arrière-plans lorsque vous changez de jeu.</sys:String>
    <sys:String x:Key="LOCFirstSetupExtraMetadataDesc">Charge les logos, vidéos, trailers et autres médias supplémentaires utilisés par le thème. Extra Metadata Fullscreen Mode Helper sera également installé.</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsTitle">Captures et galerie</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsDesc">Choisissez Screenshots Visualizer ou Screenshot Utilities pour afficher les captures et vidéos dans la galerie, le Hub et l’overlay en jeu.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsOptional">Toutes les extensions restent facultatives, mais chacune active une partie importante de l’expérience complète Aniki ReMake.</sys:String>
