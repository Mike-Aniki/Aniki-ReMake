    <sys:String x:Key="LOCFirstSetupStartupLibrary">Bibliothek</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLibraryDesc">Öffnet die Bibliothek nach dem optionalen Anmeldebildschirm.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceTitle">Wähle deinen Oberflächenstil</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceDesc">Lege fest, wie viele Informationen und Verknüpfungen in der Hauptoberfläche angezeigt werden.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfacePresetNote">Dies sind nur Voreinstellungen. Jede Option kann anschließend unter Settings > Customization einzeln angepasst werden.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceClean">Aufgeräumt</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCleanDesc">Blendet die obere und untere Leiste automatisch aus, verbirgt Informationsbereiche und die meisten integrierten Schaltflächen, lässt das Overlay jedoch verfügbar.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandard">Standard</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandardDesc">Verwendet die Standardkonfiguration von Aniki ReMake: obere Leiste sichtbar, untere Leiste automatisch ausgeblendet, Controller-Kurzbefehle und wichtigste Funktionsschaltflächen.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhanced">Erweitert</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhancedDesc">Lässt die obere Leiste sichtbar und blendet die untere automatisch aus, mit transparenter oberer Leiste, kompakten Spielinformationen und den wichtigsten Schaltflächen.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Vollständig</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Lässt beide Interfaceleisten sichtbar und aktiviert Spielelistenrahmen, Controller-Kurzbefehle, detaillierte Seitenleiste und alle integrierten Funktionen.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorTitle">Theme-Farbe auswählen</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDesc">Wähle ein repräsentatives Farbpreset für dein erstes Erlebnis.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefault">Default</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefaultDesc">Die ursprüngliche Farbpalette von Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreen">Hunter Green</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreenDesc">Eine tiefgrüne Palette mit natürlicher, dezenter Wirkung.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlue">Orbis Blue</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlueDesc">Eine klare blaue Palette im Konsolenstil.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRed">Scarlet Red</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRedDesc">Eine kräftige rote Palette mit dynamischer Wirkung.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestige">Sapphire Prestige</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestigeDesc">Ein hochwertiges dunkles Preset mit feinen Highlights.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPink">Midnight Pink</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPinkDesc">Eine tiefrosa Palette mit einer dunkleren, atmosphärischen Wirkung.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorMorePresets">Mehr als 40 Farbpresets sind im Menü Customization verfügbar.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsTitle">Detailansicht auswählen</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsDesc">Wähle, wie Spielinformationen auf der Detailseite angeordnet werden.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignature">Signature</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignatureDesc">Das Signature-Detail-Layout von Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModern">Modern</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModernDesc">Eine großzügige und zeitgemäße Darstellung.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassic">Klassisch</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassicDesc">Ein vertrautes, gut lesbares Layout.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginal">Original</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginalDesc">Übernimmt den Stil der Detailansicht aus dem ursprünglichen Aniki ReMake v1.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcase">Showcase</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcaseDesc">Ein visuelles Layout mit mehr Raum für Artwork.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanel">Panel</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanelDesc">Ein strukturiertes Layout mit gruppierten Informationsfeldern.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceTitle">Visuelles Erlebnis auswählen</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceDesc">Jedes Preset steuert die Animationen und visuellen Effekte des Themes.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFull">Full Animated</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFullDesc">Aktiviert alle Animationen und visuellen Effekte des Themes, einschließlich animierter Hintergründe.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimated">Animiert</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimatedDesc">Behält die wichtigsten Animationen und visuellen Effekte bei, deaktiviert jedoch animierte Hintergründe.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalanced">Ausgewogen</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalancedDesc">Verwendet die empfohlenen Aniki-ReMake-Standardeinstellungen für ein ausgewogenes Verhältnis aus Animationen, Effekten und Reaktionsgeschwindigkeit.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformance">Leistung</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformanceDesc">Deaktiviert alle Animationen und visuellen Effekte des Themes für die bestmögliche Leistung. Empfohlen für Handhelds und leistungsschwächere Systeme.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceWarning">Dauerhafte Animationen und Effekte können die Leistung auf Handhelds oder schwächeren PCs reduzieren.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersTitle">Wähle, wo Trailer automatisch abgespielt werden</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDesc">Wähle zwischen keinen Trailern, nur Spieldetails oder Bibliothek und Details.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabled">Deaktiviert</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabledDesc">Deaktiviert automatische Trailer in der Bibliothek und in den Spieldetails.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetails">Nur Details</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetailsDesc">Spielt Trailer automatisch nur auf den Spieldetailseiten ab.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetails">Bibliothek und Details</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetailsDesc">Spielt Trailer automatisch in der Hauptbibliothek und auf den Spieldetailseiten ab.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersNote">Mini- oder Vollbildanzeige und weitere Trailer-Optionen bleiben unter Settings > Customization einstellbar. Streaming kann zusätzliche Ressourcen benötigen.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsTitle">Erweiterungen für das vollständige Aniki ReMake-Erlebnis</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsDesc">Wähle die fehlenden Erweiterungen aus. Sie werden nach dem Anwenden der Einrichtung installiert, sodass nur ein abschließender Neustart nötig ist. Nach dem Neustart musst du ihre Einstellungen trotzdem im Desktop-Modus öffnen und sie konfigurieren.</sys:String>
    <sys:String x:Key="LOCFirstSetupSteamDesc">Melde dich in den Aniki Helper-Einstellungen im Desktopmodus bei Steam an, um Freunde, Wunschliste, Empfehlungen und Store-Funktionen zu nutzen.</sys:String>
    <sys:String x:Key="LOCFirstSetupAchievementsDesc">Fügt Erfolge, Fortschritt, Seltenheit und Erfolgsbenachrichtigungen hinzu.</sys:String>
    <sys:String x:Key="LOCFirstSetupMusicDesc">Fügt Hintergrundmusik, Musik für Ansichten und den integrierten Musikplayer hinzu.</sys:String>
    <sys:String x:Key="LOCFirstSetupAudioSwitcherDesc">Ermöglicht den schnellen Wechsel des Audiogeräts im Theme und im In-Game-Overlay.</sys:String>
    <sys:String x:Key="LOCFirstSetupCustomFadeDesc">Ermöglicht das Ändern und Anpassen der Hintergrund-Übergangsanimation beim Wechseln zwischen Spielen.</sys:String>
    <sys:String x:Key="LOCFirstSetupExtraMetadataDesc">Lädt zusätzliche Logos, Videos, Trailer und andere vom Theme verwendete Medien. Extra Metadata Fullscreen Mode Helper wird ebenfalls installiert.</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsTitle">Screenshots und Galerie</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsDesc">Wähle Screenshots Visualizer oder Screenshot Utilities, um Aufnahmen und Videos in Galerie, Hub und In-Game-Overlay anzuzeigen.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsOptional">Alle Erweiterungen sind optional, aber jede aktiviert einen wichtigen Teil des vollständigen Aniki ReMake-Erlebnisses.</sys:String>
