    <sys:String x:Key="LOCFirstSetupHelperTitle">Aniki Helper entdecken</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperDesc">Controller-orientierte Werkzeuge und Steam-Dienste für das vollständige Aniki ReMake-Erlebnis.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperOverlayTitle">In-Game-Overlay</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperOverlayDesc">Öffne das Aniki Control Center über deinen Spielen, um zu Playnite zurückzukehren, das Spiel zu schließen und schnell auf deine Werkzeuge zuzugreifen.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperKeyboardTitle">Virtuelle Tastatur</sys:String>
