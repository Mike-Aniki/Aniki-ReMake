    <sys:String x:Key="LOCCustomization">Anpassung</sys:String>
    <sys:String x:Key="LOCShowFriendsButtonDesc">Zeigt eine Schaltfläche in der oberen Leiste mit deinen aktuell online befindlichen Steam-Freunden an. Erfordert das Steam Friends Fullscreen Plugin.</sys:String>
