    <sys:String x:Key="LOCFirstSetupHelperMouseTitle">Controller-Maus</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperMouseDesc">Steuere den Windows-Zeiger, Klicks und das Scrollen direkt mit deinem Controller.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperFooter">Öffne nach der Einrichtung die Aniki-Helper-Einstellungen im Desktop-Modus, um alle Funktionen zu konfigurieren.</sys:String>
