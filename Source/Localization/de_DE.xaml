    <sys:String x:Key="LOCFirstSetupHelperInputTitle">Maus und Tastatur per Controller</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperInputDesc">Steuere Windows-Cursor, Klicks, Scrollen und Texteingabe vollständig mit deinem Controller.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamDesc">Greife auf Steam-Freunde, Wunschliste, Empfehlungen und integrierte Store-Funktionen zu.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperCapturesTitle">Aufnahmen und Videos</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperCapturesDesc">Finde Screenshots und Videos über kompatible Erweiterungen in Galerie, Hub und Overlay.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperMoreTitle">Und vieles mehr</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperMoreDesc">Konfiguriere Controller-Kürzel, Audiowechsel, Startvideos, Screenshots, Spielverhalten und viele weitere Optionen.</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferTitle">Einrichtungsassistent verfügbar</sys:String>
