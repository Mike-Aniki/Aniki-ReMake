    <sys:String x:Key="LOCVisualPackCategoryCustomDesc">Zeigt Visual Packs an, die in Aniki Helper installiert sind – unabhängig davon, ob sie lokal importiert oder aus der Community heruntergeladen wurden.</sys:String>
    <sys:String x:Key="LOCHubAchievementMemoriesTitle">Erfolgserinnerungen</sys:String>
