    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Completa</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Mantiene visibili entrambe le barre e attiva la cornice dell’elenco, le scorciatoie del controller, il pannello laterale dettagliato e tutte le funzioni integrate.</sys:String>
