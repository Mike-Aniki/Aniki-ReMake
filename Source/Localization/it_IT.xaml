    <sys:String x:Key="LOCVisualEffectsHeader">Effetti Visivi</sys:String>
    <sys:String x:Key="LOCPowerMenuHeader">Menu Alimentazione</sys:String>
    <sys:String x:Key="LOCMenusTitle">Impostazioni</sys:String>
    <sys:String x:Key="LOCMediaGallery">Galleria delle catture</sys:String>
    <sys:String x:Key="LOCMedia">Contenuti Multimediali</sys:String>
    <sys:String x:Key="LOCAchievementBadgeOnMainView">Mostra badge obiettivi</sys:String>
    <sys:String x:Key="LOCAchievementBadgeOnMainViewDesc">Mostra un badge obiettivi nella schermata principale con il numero di obiettivi sbloccati e totali.</sys:String>
    <sys:String x:Key="LOCAgeRatingOnMainViewDesc">Mostra un piccolo badge di classificazione per età sul lato destro della schermata principale.</sys:String>
    <sys:String x:Key="LOCAnimationPanelDesc">Aggiunge un'animazione ai pannelli informativi quando si apre la schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCArcade">Arcade</sys:String>
    <sys:String x:Key="LOCAutoHideBottomFilterBar">Nascondi automaticamente la barra filtri inferiore</sys:String>
    <sys:String x:Key="LOCAutoHideBottomFilterBarDesc">Nasconde automaticamente la barra filtri inferiore per mantenere lo schermo pulito. Verrà mostrata nuovamente quando navighi verso la parte inferiore dello schermo.</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBar">Nascondi automaticamente la barra superiore</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBarDesc">Nasconde automaticamente la barra superiore per mantenere lo schermo pulito. Verrà mostrata nuovamente quando navighi verso la parte superiore dello schermo.</sys:String>
    <sys:String x:Key="LOCAvatarDesc">Seleziona l'avatar integrato mostrato nell'interfaccia. Se è impostata un'immagine profilo tramite Extra Metadata, verrà utilizzata quella.</sys:String>
    <sys:String x:Key="LOCUseSteamAvatarDesc">Usa l’avatar del tuo profilo Steam prima dell’immagine profilo di Extra Metadata e dell’avatar integrato selezionato. Se l’avatar Steam non è disponibile, viene mantenuta la priorità normale.</sys:String>
    <sys:String x:Key="LOCBubbles">Bollicine</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBar">Mostra barra informazioni compatta</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBarDesc">Mostra una barra informazioni compatta sopra le copertine dei giochi. Attivandola vengono disattivati la barra scorciatoie del controller e il pannello laterale dettagliato.</sys:String>
    <sys:String x:Key="LOCCompletionStatusOnGameCoverDesc">Mostra un indicatore di stato sulle copertine dei giochi, come Nuovo, In corso o Completato, in base alle impostazioni di completamento di Playnite.</sys:String>
    <sys:String x:Key="LOCControllerShortcutBar">Mostra barra scorciatoie controller</sys:String>
    <sys:String x:Key="LOCControllerShortcutBarDesc">Mostra le scorciatoie del controller sotto le copertine dei giochi. Attivandola viene disattivata la barra informazioni compatta.</sys:String>
    <sys:String x:Key="LOCCornerDesc">Regola quanto arrotondati appaiono pannelli, pulsanti e copertine. Valori bassi rendono gli angoli più netti, valori alti più arrotondati.</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanel">Mostra pannello informazioni dettagliato</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanelDesc">Mostra informazioni dettagliate sul gioco sul lato destro dello schermo. Attivandolo viene disattivata la barra informazioni compatta. Questa opzione non è disponibile mentre è attiva una scheda multimediale della vista principale.</sys:String>
    <sys:String x:Key="LOCDetailsViewLayoutDesc">Seleziona il layout utilizzato nella schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtons">Disattiva i pulsanti centrali della barra superiore</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtonsDesc">Disattiva completamente i pulsanti centrali della barra superiore, come Menu Principale, Hub, Layout, Filtri e Ricerca. Utilizza invece le scorciatoie del controller.</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBar">Disattiva barra filtri inferiore</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBarDesc">Disattiva completamente la barra dei filtri inferiore. È diverso dall'opzione di nascondimento automatico. Quando attivata, la barra viene completamente disabilitata.</sys:String>
    <sys:String x:Key="LOCEnterDetailsZoomDesc">Aggiunge un'animazione di zoom all'apertura della schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCFeaturesSteamDesc">Nasconde le icone delle funzionalità nella schermata dettagli, come Steam Cloud, Condivisione Familiare, supporto controller o obiettivi.</sys:String>
    <sys:String x:Key="LOCFeaturesSteamMainDesc">Mostra le icone delle funzionalità Steam nella schermata principale in base al campo Funzionalità del gioco in Playnite.</sys:String>
    <sys:String x:Key="LOCFilteredGameCountDesc">Mostra il numero di giochi visualizzati nella schermata principale verticale dopo l'applicazione dei filtri.</sys:String>
    <sys:String x:Key="LOCFontStyle">Scegli stile del carattere</sys:String>
    <sys:String x:Key="LOCFontStyleDesc">Seleziona lo stile del carattere utilizzato nell'interfaccia.</sys:String>
    <sys:String x:Key="LOCGameLogoAnimationOnMainViewDesc">Aggiunge una leggera animazione al logo del gioco selezionato nella schermata principale. Disattivala su PC poco potenti se l'interfaccia risulta meno fluida.</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevel">Mostra Gamerscore invece del livello</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevelDesc">Mostra il tuo Gamerscore al posto del livello obiettivi in tutto il tema.</sys:String>
    <sys:String x:Key="LOCIconControllerDesc">Seleziona le icone dei pulsanti del controller utilizzate nell'interfaccia.</sys:String>
    <sys:String x:Key="LOCLoginScreenBackgroundDesc">Seleziona l'immagine di sfondo mostrata nella schermata iniziale.</sys:String>
    <sys:String x:Key="LOCLogoInTrophyDesc">Mostra il logo del gioco invece del titolo nella schermata degli obiettivi.</sys:String>
    <sys:String x:Key="LOCMainDescDesc">Mostra la descrizione del gioco selezionato sotto il logo nella schermata principale.</sys:String>
    <sys:String x:Key="LOCMainViewInfoDisplayHeader">Intestazione della lista giochi</sys:String>
    <sys:String x:Key="LOCNoActivityDesc">Nasconde la data dell'ultima sessione di gioco del titolo selezionato.</sys:String>
    <sys:String x:Key="LOCNoBarModeDesc">Nasconde la barra di stato nella schermata dettagli, inclusi avatar, obiettivi e logo piattaforma.</sys:String>
    <sys:String x:Key="LOCNoAvatarDetails">Nascondi avatar dalla barra di stato</sys:String>
    <sys:String x:Key="LOCNoAvatarDetailsDesc">Nasconde l’avatar dalla barra di stato nella schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetails">Nascondi obiettivi dalla barra di stato</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetailsDesc">Nasconde l’avanzamento degli obiettivi dalla barra di stato nella schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCNoCompletionDesc">Nasconde lo stato di completamento del gioco nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoGameStatutDesc">Nasconde la schermata predefinita di Playnite mostrata dopo l'avvio di un gioco, inclusi sfondo, messaggio di avvio e pulsante di ritorno. Non influisce sulla schermata splash personalizzata di Aniki.</sys:String>
    <sys:String x:Key="LOCNoGenreDetailsDesc">Nasconde il genere del gioco nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoHLTBDetailsDesc">Nasconde le stime di durata di HowLongToBeat nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoLogoDesc">Sostituisce il logo del gioco con il titolo nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogo">Nascondi logo e titolo del gioco</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogoDesc">Nasconde sia il logo del gioco sia il titolo alternativo nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoPlayerDetailsDesc">Nasconde il numero di giocatori attuali nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoSizeDesc">Nasconde la dimensione installata del gioco nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoStarDesc">Nasconde il punteggio del gioco nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoTimeDesc">Nasconde il tempo totale di gioco del titolo selezionato.</sys:String>
    <sys:String x:Key="LOCNoTrophyDetailsDesc">Nasconde le informazioni sugli obiettivi nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCNoYearDesc">Nasconde l'anno di uscita del gioco nella schermata dettagli.</sys:String>
    <sys:String x:Key="LOCOpacityBackgroundListGameDesc">Modifica la visibilità del riquadro dietro le copertine dei giochi. 0 è completamente trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCOpacityBarDetailDesc">Modifica la visibilità dello sfondo della barra di stato. 0 è completamente trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCOpacityBottomBarDesc">Modifica la visibilità dello sfondo della barra filtri inferiore. 0 è completamente trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCOpacityPanelModernLayoutDesc">Modifica la visibilità dello sfondo del pannello informazioni nel layout Modern. 0.4 è più trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCOpacityPanelShowcaseLayoutDesc">Modifica la visibilità dello sfondo del pannello informazioni nel layout Showcase. 0.4 è più trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCOpacityTopBarDesc">Modifica la visibilità dello sfondo della barra superiore. 0 è completamente trasparente, 1 completamente opaco.</sys:String>
    <sys:String x:Key="LOCPlatformBannerDesc">Mostra i banner della piattaforma nella parte superiore delle copertine dei giochi.</sys:String>
    <sys:String x:Key="LOCRetroRoom">Stanza Retro</sys:String>
    <sys:String x:Key="LOCShowCoverDetailsDesc">Mostra la copertina del gioco nel layout dettagli Modern.</sys:String>
    <sys:String x:Key="LOCShowGameListBackground">Mostra sfondo del riquadro lista giochi</sys:String>
    <sys:String x:Key="LOCShowGameListBackgroundDesc">Mostra un riquadro di sfondo dietro le copertine dei giochi per un aspetto più definito.</sys:String>
    <sys:String x:Key="LOCShowHiddenAchievementsDesc">Rivela automaticamente gli obiettivi nascosti all'apertura della schermata obiettivi.</sys:String>
    <sys:String x:Key="LOCShowLoginScreenOnStartupDesc">Mostra la schermata iniziale all'avvio di Playnite. Disattivala per accedere direttamente all'interfaccia principale.</sys:String>
    <sys:String x:Key="LOCShowMoDataDesc">Mostra lo stato della connessione Internet nell'interfaccia. Richiede l'estensione MoData.</sys:String>
    <sys:String x:Key="LOCShowTrailerTimeDesc">Mostra il tempo di riproduzione del trailer nella schermata dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCSourceLogoOnDetailsViewDesc">Mostra il logo della piattaforma di origine del gioco nella schermata dettagli, come Steam, Epic, GOG o Xbox.</sys:String>
    <sys:String x:Key="LOCSourceLogoOnMainScreenDesc">Mostra un badge della piattaforma di origine nella parte superiore della schermata principale.</sys:String>
    <sys:String x:Key="LOCThemeColorDesc">Seleziona il preset colore principale utilizzato nell'interfaccia.</sys:String>
    <sys:String x:Key="LOCTopOrBottomBarDesc">Sposta la barra di stato dalla parte superiore a quella inferiore dello schermo.</sys:String>
    <sys:String x:Key="LOCTrailerOnDetailsViewDesc">Mostra il trailer del gioco selezionato nella schermata dettagli quando disponibile tramite l'estensione Extra Metadata Loader.</sys:String>
    <sys:String x:Key="LOCTrailerOnMainViewDesc">Riproduce il trailer del gioco selezionato come sfondo della vista principale quando disponibile tramite Extra Metadata Loader. Questa opzione non è disponibile mentre è attiva una scheda multimediale della vista principale.</sys:String>
    <sys:String x:Key="LOCMicroTrailerOnFocusedCoverDesc">Espande la copertina selezionata in un’anteprima cinematografica con micro trailer e logo del gioco. Se non è disponibile un micro trailer, usa lo sfondo del gioco. Può essere usato contemporaneamente al trailer della schermata principale e disattiva Sfondo + logo sulla copertina selezionata.</sys:String>
    <sys:String x:Key="LOCBackgroundOnFocusedCoverDesc">Espande la copertina del gioco selezionato in una vista cinematografica usando lo sfondo e il logo del gioco. Non viene caricato né riprodotto alcun video. L'attivazione di questa opzione disattiva automaticamente Micro trailer sulla copertina selezionata.</sys:String>
    <sys:String x:Key="LOCVisualPackDesc">Seleziona il pacchetto visivo utilizzato per sfondi e immagini decorative dell'interfaccia.</sys:String>
    <sys:String x:Key="LOCSoundPack">Pacchetto audio</sys:String>
    <sys:String x:Key="LOCSoundPackDesc">Modifica i suoni e la musica dell'interfaccia con un Sound Pack installato. Gli elementi mancanti usano automaticamente quelli predefiniti di Aniki ReMake. È necessario riavviare Playnite per applicare la modifica.</sys:String>
    <sys:String x:Key="LOCDefaultSoundPack">Predefinito</sys:String>
    <sys:String x:Key="LOCCompletePack">Complete Pack</sys:String>
    <sys:String x:Key="LOCCompletePackDesc">Applica un Complete Pack installato per modificare in una sola volta gli elementi visivi, i colori, il login e i suoni inclusi. I componenti non inclusi mantengono la selezione attuale.</sys:String>
    <sys:String x:Key="LOCNoCompletePack">Nessun Complete Pack</sys:String>
    <sys:String x:Key="LOCIndicatorActiv">Mostra l’indicatore di stato attivo di Playnite</sys:String>
    <sys:String x:Key="LOCChangeMenuPlacement">Cambia lato del menu</sys:String>
    <sys:String x:Key="LOCCorner">Raggio degli angoli dell’interfaccia</sys:String>
    <sys:String x:Key="LOCSteamBanner">Modalità compatibilità banner Steam</sys:String>
    <sys:String x:Key="LOCDefaultLoginScreen">Schermata di accesso predefinita</sys:String>

    <!-- Cover logos / Signature layout -->
    <sys:String x:Key="LOCCoverLogoBadge">Mostra i loghi sulle copertine</sys:String>
    <sys:String x:Key="LOCCoverLogoBadgeDesc">Mostra un piccolo logo della fonte o della piattaforma nell’angolo in basso a destra di ogni copertina. I loghi vengono caricati da Icons\Logo, usando prima il nome della fonte e poi la prima piattaforma come alternativa.</sys:String>
    <sys:String x:Key="LOCSignatureLayout">Layout Signature</sys:String>

