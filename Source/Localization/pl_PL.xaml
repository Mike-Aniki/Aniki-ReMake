    <sys:String x:Key="LOCFirstSetupInterfaceEnhancedDesc">Zachowuje widoczny górny pasek i autoukrywa dolny pasek, z przezroczystym górnym paskiem, kompaktowymi informacjami o grze i głównymi przyciskami funkcji.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Kompletny</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Zachowuje widoczność obu pasków interfejsu i włącza ramkę listy gier, skróty kontrolera, szczegółowy panel boczny oraz wszystkie zintegrowane funkcje.</sys:String>
