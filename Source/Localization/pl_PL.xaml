    <sys:String x:Key="LOCWrongSetting">Nieobsługiwane ustawienia układu</sys:String>
    <sys:String x:Key="LOCWrongSettingText1">Ta wiadomość pojawia się, ponieważ obecne ustawienia siatki nie są obsługiwane dla wybranego formatu okładek.</sys:String>

    <sys:String x:Key="LOCWrongSettingTextBottom">Dla standardowych formatów okładek użyj od 6 do 10 kolumn oraz 1 lub 2 rzędów.</sys:String>
    <sys:String x:Key="LOCWrongSettingTextBottom2">Dla kwadratowych okładek użyj od 5 do 9 kolumn oraz 2 rzędów.</sys:String>
    <sys:String x:Key="LOCWrongSettingTextBottom3">Dla okładek typu baner lub hero użyj od 2 do 4 kolumn oraz 2 lub 3 rzędów.</sys:String>

    <sys:String x:Key="LOCWrongColumnsRecommended">Obsługiwana wartość: od 6 do 10 kolumn</sys:String>
