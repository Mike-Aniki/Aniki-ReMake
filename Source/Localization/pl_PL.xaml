    <sys:String x:Key="LOCAchievementBadgeOnMainView">Pokaż odznakę osiągnięć</sys:String>
    <sys:String x:Key="LOCAchievementBadgeOnMainViewDesc">Pokazuje odznakę osiągnięć w głównym widoku z liczbą odblokowanych i wszystkich osiągnięć.</sys:String>
    <sys:String x:Key="LOCAgeRatingOnMainViewDesc">Pokazuje małą odznakę klasyfikacji wiekowej po prawej stronie głównego widoku.</sys:String>
    <sys:String x:Key="LOCAnimationPanelDesc">Dodaje animację paneli informacyjnych podczas otwierania ekranu szczegółów gry.</sys:String>
    <sys:String x:Key="LOCArcade">Arcade</sys:String>
    <sys:String x:Key="LOCAutoHideBottomFilterBar">Autoukrywanie dolnego paska filtrów</sys:String>
    <sys:String x:Key="LOCAutoHideBottomFilterBarDesc">Automatycznie ukrywa dolny pasek filtrów, by utrzymać czysty ekran. Pasek pojawi się ponownie po przejściu na sam dół ekranu.</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBar">Autoukrywanie górnego paska przycisków</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBarDesc">Automatycznie ukrywa górny pasek przycisków, by utrzymać czysty ekran. Pasek pojawi się ponownie po przejściu na samą górę ekranu.</sys:String>
    <sys:String x:Key="LOCAvatarDesc">Wybierz wbudowany awatar wyświetlany w interfejsie. Jeśli w Extra Metadata ustawiono zdjęcie profilowe, zostanie ono użyte zamiast niego.</sys:String>
    <sys:String x:Key="LOCUseSteamAvatarDesc">Używa awatara z profilu Steam przed zdjęciem z Extra Metadata i wybranym wbudowanym awatarem. Jeśli awatar Steam jest niedostępny, zachowywany jest normalny priorytet awatarów.</sys:String>
    <sys:String x:Key="LOCBubbles">Bąbelki</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBar">Pokaż kompaktowy pasek informacyjny gry</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBarDesc">Pokazuje kompaktowy pasek informacyjny nad okładkami gier. Włączenie tej opcji wyłącza pasek skrótów kontrolera oraz szczegółowy panel boczny.</sys:String>
    <sys:String x:Key="LOCCompletionStatusOnGameCoverDesc">Pokazuje baner statusu ukończenia na okładkach gier (np. Nowa, W trakcie gry, Ukończona), bazując na ustawieniach statusu w Playnite.</sys:String>
    <sys:String x:Key="LOCControllerShortcutBar">Pokaż pasek skrótów kontrolera</sys:String>
    <sys:String x:Key="LOCControllerShortcutBarDesc">Pokazuje skróty kontrolera pod okładkami gier. Włączenie tej opcji wyłącza kompaktowy pasek informacyjny.</sys:String>
    <sys:String x:Key="LOCCornerDesc">Dostosowuje stopień zaokrąglenia paneli interfejsu, przycisków i okładek gier. Niższe wartości oznaczają ostrzejsze krawędzie, wyższe - bardziej zaokrąglone.</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanel">Pokaż szczegółowy boczny panel informacyjny</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanelDesc">Pokazuje szczegółowe informacje o grze po prawej stronie ekranu. Włączenie tej opcji wyłącza kompaktowy pasek informacyjny. Ta opcja jest niedostępna, gdy włączona jest karta multimedialna widoku głównego.</sys:String>
    <sys:String x:Key="LOCDetailsViewLayoutDesc">Określa układ używany na ekranie szczegółów gry.</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtons">Wyłącz środkowe przyciski na górnym pasku</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtonsDesc">Całkowicie wyłącza środkowe przyciski na górnym pasku (Menu Główne, Hub, Układ, Filtry, Szukaj). Zamiast nich używaj skrótów na kontrolerze.</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBar">Wyłącz dolny pasek filtrów</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBarDesc">Całkowicie wyłącza dolny pasek presetów filtrów. Działa to inaczej niż autoukrywanie - gdy włączone, pasek filtrów jest całkowicie wyłączony.</sys:String>
    <sys:String x:Key="LOCEnterDetailsZoomDesc">Dodaje animację powiększenia podczas otwierania ekranu szczegółów gry.</sys:String>
    <sys:String x:Key="LOCFeaturesSteamDesc">Ukrywa ikony funkcji na ekranie szczegółów (np. Steam Cloud, Chmura Rodzinna, obsługa kontrolera czy osiągnięcia).</sys:String>
    <sys:String x:Key="LOCFeaturesSteamMainDesc">Pokazuje ikony funkcji Steam w widoku głównym. Włącz "Pokaż szczegółowy boczny panel informacyjny", aby z tego korzystać.</sys:String>
    <sys:String x:Key="LOCFilteredGameCountDesc">Pokazuje liczbę wyświetlanych gier w pionowym widoku głównym po zastosowaniu filtrów.</sys:String>
    <sys:String x:Key="LOCFontStyle">Wybierz styl czcionki</sys:String>
    <sys:String x:Key="LOCFontStyleDesc">Wybierz styl czcionki używany w całym interfejsie.</sys:String>
    <sys:String x:Key="LOCGameLogoAnimationOnMainViewDesc">Dodaje subtelną animację do wybranego logo gry w głównym widoku. Wyłącz to na bardzo słabych komputerach, jeśli odczuwasz spadki płynności interfejsu.</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevel">Pokaż Gamerscore zamiast poziomu</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevelDesc">Wyświetla Twój Gamerscore zamiast poziomu osiągnięć w całym motywie.</sys:String>
    <sys:String x:Key="LOCIconControllerDesc">Wybierz styl ikon przycisków kontrolera używanych w całym interfejsie.</sys:String>
    <sys:String x:Key="LOCLoginScreenBackgroundDesc">Wybierz obraz tła wyświetlany na ekranie logowania.</sys:String>
    <sys:String x:Key="LOCLogoInTrophyDesc">Wyświetla logo gry zamiast jej tytułu na ekranie osiągnięć.</sys:String>
    <sys:String x:Key="LOCMainDescDesc">Pokazuje opis wybranej gry pod logo gry w głównym widoku.</sys:String>
    <sys:String x:Key="LOCMainViewInfoDisplayHeader">Nagłówek listy gier</sys:String>
    <sys:String x:Key="LOCNoActivityDesc">Ukrywa datę ostatniego uruchomienia wybranej gry.</sys:String>
    <sys:String x:Key="LOCNoBarModeDesc">Ukrywa pasek statusu na ekranie szczegółów gry, włączając w to awatar, osiągnięcia i logo platformy.</sys:String>
    <sys:String x:Key="LOCNoAvatarDetails">Ukryj awatar z paska statusu</sys:String>
    <sys:String x:Key="LOCNoAvatarDetailsDesc">Ukrywa awatar z paska statusu na ekranie szczegółów gry.</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetails">Ukryj osiągnięcia z paska statusu</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetailsDesc">Ukrywa postęp osiągnięć z paska statusu na ekranie szczegółów gry.</sys:String>
    <sys:String x:Key="LOCNoCompletionDesc">Ukrywa status ukończenia gry na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoGameStatutDesc">Ukrywa domyślny ekran Playnite pojawiający się po uruchomieniu gry, zawierający tło gry, wiadomość o starcie i przycisk powrotu. Nie wpływa to na niestandardowy ekran ładowania Aniki.</sys:String>
    <sys:String x:Key="LOCNoGenreDetailsDesc">Ukrywa gatunek gry na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoHLTBDetailsDesc">Ukrywa szacowany czas gry HowLongToBeat na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoLogoDesc">Zastępuje logo gry jej tytułem na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogo">Ukryj logo i tytuł gry</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogoDesc">Ukrywa zarówno logo gry, jak i zastępczy tytuł na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoPlayerDetailsDesc">Ukrywa bieżącą liczbę graczy na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoSizeDesc">Ukrywa rozmiar instalacji gry na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoStarDesc">Ukrywa ocenę gry na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoTimeDesc">Ukrywa Twój całkowity czas spędzony w wybranej grze.</sys:String>
    <sys:String x:Key="LOCNoTrophyDetailsDesc">Ukrywa informacje o osiągnięciach na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCNoYearDesc">Ukrywa rok wydania gry na ekranie szczegółów.</sys:String>
    <sys:String x:Key="LOCOpacityBackgroundListGameDesc">Zmienia widoczność ramki tła za okładkami gier. 0 to pełna przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCOpacityBarDetailDesc">Zmienia widoczność tła paska statusu. 0 to pełna przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCOpacityBottomBarDesc">Zmienia widoczność tła dolnego paska presetów filtrów. 0 to pełna przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCOpacityPanelModernLayoutDesc">Zmienia widoczność tła panelu informacyjnego w Nowoczesnym układzie szczegółów. 0.4 oznacza większą przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCOpacityPanelShowcaseLayoutDesc">Zmienia widoczność tła panelu informacyjnego w układzie Prezentacji. 0.4 oznacza większą przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCOpacityTopBarDesc">Zmienia widoczność tła górnego paska. 0 to pełna przezroczystość, 1 to brak przezroczystości.</sys:String>
    <sys:String x:Key="LOCPlatformBannerDesc">Pokazuje banery platform na górze okładek gier.</sys:String>
    <sys:String x:Key="LOCRetroRoom">Pokój retro</sys:String>
    <sys:String x:Key="LOCShowCoverDetailsDesc">Pokazuje okładkę gry w Nowoczesnym układzie szczegółów.</sys:String>
    <sys:String x:Key="LOCShowGameListBackground">Pokaż tło ramki listy gier</sys:String>
    <sys:String x:Key="LOCShowGameListBackgroundDesc">Pokazuje ramkę tła za okładkami gier dla uzyskania mocniejszego efektu oddzielenia.</sys:String>
    <sys:String x:Key="LOCShowHiddenAchievementsDesc">Automatycznie odsłania ukryte osiągnięcia podczas otwierania ekranu osiągnięć.</sys:String>
    <sys:String x:Key="LOCShowLoginScreenOnStartupDesc">Pokazuje ekran logowania przy uruchamianiu Playnite. Wyłącz to, aby przejść bezpośrednio do głównego interfejsu.</sys:String>
    <sys:String x:Key="LOCShowMoDataDesc">Pokazuje status Twojego połączenia z internetem w interfejsie. Wymaga rozszerzenia MoData.</sys:String>
    <sys:String x:Key="LOCShowTrailerTimeDesc">Pokazuje czas odtwarzania zwiastuna na ekranie szczegółów gry.</sys:String>
    <sys:String x:Key="LOCSourceLogoOnDetailsViewDesc">Pokazuje logo źródła gry na ekranie szczegółów (np. Steam, Epic, GOG czy Xbox).</sys:String>
    <sys:String x:Key="LOCSourceLogoOnMainScreenDesc">Pokazuje odznakę z logo źródła gry na górze głównego widoku.</sys:String>
    <sys:String x:Key="LOCThemeColorDesc">Wybiera główny preset kolorystyczny używany w całym interfejsie.</sys:String>
    <sys:String x:Key="LOCTopOrBottomBarDesc">Przenosi pasek statusu z góry ekranu na dół.</sys:String>
    <sys:String x:Key="LOCTrailerOnDetailsViewDesc">Pokazuje zwiastun wybranej gry na ekranie szczegółów, jeśli jest on dostępny dzięki rozszerzeniu Extra Metadata Loader.</sys:String>
    <sys:String x:Key="LOCTrailerOnMainViewDesc">Odtwarza zwiastun wybranej gry jako tło widoku głównego, jeśli jest dostępny przez Extra Metadata Loader. Ta opcja jest niedostępna, gdy włączona jest karta multimedialna widoku głównego.</sys:String>
    <sys:String x:Key="LOCMicroTrailerOnFocusedCoverDesc">Rozwija zaznaczoną okładkę w kinowy podgląd mikrozwiastuna z logo gry. Wykorzystuje tło gry, gdy mikrozwiastun jest niedostępny. Może być używana jednocześnie ze zwiastunem w głównym widoku i automatycznie wyłącza opcję 'Tło + logo na zaznaczonej okładce'.</sys:String>
    <sys:String x:Key="LOCBackgroundOnFocusedCoverDesc">Rozwija zaznaczoną okładkę do widoku kinowego wykorzystującego tło i logo gry. Żadne wideo nie jest ładowane ani odtwarzane. Włączenie tej opcji automatycznie wyłącza mikrozwiastun na zaznaczonej okładce.</sys:String>
    <sys:String x:Key="LOCVisualPackDesc">Wybiera paczkę wizualną używaną do teł interfejsu i obrazów dekoracyjnych.</sys:String>
    <sys:String x:Key="LOCSoundPack">Pakiet dźwięków</sys:String>
    <sys:String x:Key="LOCSoundPackDesc">Zmienia dźwięki i muzykę interfejsu za pomocą zainstalowanego Sound Packa. Brakujące elementy automatycznie używają domyślnych zasobów Aniki ReMake. Aby zastosować zmianę, wymagane jest ponowne uruchomienie Playnite.</sys:String>
    <sys:String x:Key="LOCDefaultSoundPack">Domyślny</sys:String>
    <sys:String x:Key="LOCCompletePack">Pakiet kompletny</sys:String>
    <sys:String x:Key="LOCCompletePackDesc">Stosuje zainstalowany Complete Pack, aby jednocześnie zmienić zawarte w nim elementy wizualne, kolory, ekran logowania i dźwięki. Elementy, których pakiet nie zawiera, zachowują bieżący wybór.</sys:String>
    <sys:String x:Key="LOCNoCompletePack">Brak Complete Pack</sys:String>
    <sys:String x:Key="LOCIndicatorActiv">Pokaż wskaźnik aktywności Playnite</sys:String>
    <sys:String x:Key="LOCChangeMenuPlacement">Przełącz stronę menu</sys:String>
    <sys:String x:Key="LOCCorner">Promień zaokrąglenia rogów interfejsu</sys:String>
    <sys:String x:Key="LOCSteamBanner">Tryb kompatybilności z banerami Steam</sys:String>
    <sys:String x:Key="LOCDefaultLoginScreen">Domyślny ekran logowania</sys:String>

    <!-- Cover logos / Signature layout -->
    <sys:String x:Key="LOCCoverLogoBadge">Pokaż logotypy na okładkach</sys:String>
    <sys:String x:Key="LOCCoverLogoBadgeDesc">Pokazuje małe logo źródła lub platformy w prawym dolnym rogu każdej okładki gry. Logotypy są ładowane z folderu Icons\Logo, wykorzystując w pierwszej kolejności nazwę źródła, a pierwszą platformę jako zastępstwo.</sys:String>
    <sys:String x:Key="LOCSignatureLayout">Układ sygnatur</sys:String>

