    <sys:String x:Key="LOCFirstSetupHelperSteamTitle">Połączenie ze Steam</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamStatusConnected">Połączono</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamStatusDisconnected">Rozłączono</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamInstruction">Otwórz tryb pulpitu i przejdź do ustawień Aniki Helper, aby połączyć konto Steam.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamBenefits">Połącz, aby wyświetlać znajomych Steam i ich status, zintegrowany sklep, listę życzeń, rekomendacje oraz wiadomości i aktualizacje dla swoich gier Steam.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSplashTitle">Ekran powitalny gry</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSplashDesc">Wyświetlaj konfigurowalny ekran ładowania podczas uruchamiania gry.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperInputTitle">Mysz i klawiatura na gamepadzie</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperInputDesc">Kontroluj kursor Windows, kliknięcia, przewijanie i wprowadzanie tekstu w całości za pomocą kontrolera.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperSteamDesc">Uzyskaj dostęp do znajomych Steam, listy życzeń, rekomendacji i zintegrowanych funkcji sklepu.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperCapturesTitle">Zrzuty i wideo</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperCapturesDesc">Znajduj swoje zrzuty ekranu i nagrania w galerii, hubie i nakładce dzięki kompatybilnym rozszerzeniom.</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperMoreTitle">I wiele więcej</sys:String>
    <sys:String x:Key="LOCFirstSetupHelperMoreDesc">Skonfiguruj skróty kontrolera, przełączanie audio, wideo powitalne, zrzuty ekranu, zachowanie gier i wiele innych opcji.</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferTitle">Dostępny asystent konfiguracji</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferDescription">Aniki ReMake zawiera nowo dodanego asystenta, który pozwala szybko skonfigurować profil, interfejs i preferencje wizualne.</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferFamiliar">Znasz już opcje motywu? Możesz pominąć ten krok. Asystent pozostanie dostępny w dowolnym momencie w sekcji Pomoc i wsparcie.</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferStart">Uruchom asystenta</sys:String>
    <sys:String x:Key="LOCFirstSetupOfferSkip">Pomiń ten krok</sys:String>

