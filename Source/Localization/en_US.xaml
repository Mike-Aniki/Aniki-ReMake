    <sys:String x:Key="LOCAutoHideBottomFilterBar">Auto-hide bottom filter bar</sys:String>
    <sys:String x:Key="LOCAutoHideBottomFilterBarDesc">Automatically hides the bottom filter bar to keep the screen clean. The bar will appear again when you navigate to the bottom of the screen.</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBar">Auto-hide top button bar</sys:String>
    <sys:String x:Key="LOCAutoHideTopButtonBarDesc">Automatically hides the top button bar to keep the screen clean. The bar will appear again when you navigate to the top of the screen.</sys:String>
    <sys:String x:Key="LOCAvatarDesc">Select the built-in avatar shown in the interface. If a profile picture is set with Extra Metadata, it will be used instead.</sys:String>
    <sys:String x:Key="LOCUseSteamAvatarDesc">Uses your Steam profile avatar before the Extra Metadata profile picture and the selected built-in avatar. If the Steam avatar is unavailable, the normal avatar priority is kept.</sys:String>
    <sys:String x:Key="LOCBubbles">Bubbles</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBar">Show compact game info bar</sys:String>
    <sys:String x:Key="LOCCompactGameInfoBarDesc">Shows a compact information bar above the game covers. Enabling this disables the controller shortcut bar and the detailed side panel.</sys:String>
    <sys:String x:Key="LOCCompletionStatusOnGameCoverDesc">Shows a completion status banner on game covers, such as New, Playing, Completed, based on your Playnite completion status settings.</sys:String>
    <sys:String x:Key="LOCControllerShortcutBar">Show controller shortcut bar</sys:String>
    <sys:String x:Key="LOCControllerShortcutBarDesc">Shows controller shortcuts below the game covers. Enabling this disables the compact game info bar.</sys:String>
    <sys:String x:Key="LOCCornerDesc">Adjusts how rounded the interface panels, buttons, and game covers look. Lower values are sharper, higher values are more rounded.</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanel">Show detailed side info panel</sys:String>
    <sys:String x:Key="LOCDetailedSideInfoPanelDesc">Shows detailed game information on the right side of the screen. Enabling this disables the compact info bar.</sys:String>
    <sys:String x:Key="LOCDetailsViewLayoutDesc">Selects the layout used on the game details screen.</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtons">Disable center top bar buttons</sys:String>
    <sys:String x:Key="LOCDisableCenterTopButtonsDesc">Completely disables the center buttons in the top bar, such as Main Menu, Hub, Layout, Filters, Search. Use controller shortcuts instead.</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBar">Disable bottom filter bar</sys:String>
    <sys:String x:Key="LOCDisableFilterBottomBarDesc">Completely disables the bottom filter preset bar. This is different from auto-hide. When enabled, the filter bar is disabled entirely.</sys:String>
    <sys:String x:Key="LOCEnterDetailsZoomDesc">Adds a zoom animation when opening the game details screen.</sys:String>
    <sys:String x:Key="LOCFeaturesSteamDesc">Hides the feature icons on the details screen, such as Steam Cloud, Family Sharing, controller support, or achievements.</sys:String>
    <sys:String x:Key="LOCFeaturesSteamMainDesc">Shows Steam feature icons on the main view. Enable “Show detailed side info panel” to use this setting.</sys:String>
    <sys:String x:Key="LOCFilteredGameCountDesc">Shows the number of displayed games in the vertical main view after filters are applied.</sys:String>
    <sys:String x:Key="LOCFontStyle">Choose font style</sys:String>
    <sys:String x:Key="LOCFontStyleDesc">Select the font style used across the interface.</sys:String>
    <sys:String x:Key="LOCGameLogoAnimationOnMainViewDesc">Adds a subtle animation to the selected game logo on the main view. Disable this on very low-end PCs if the interface feels less smooth.</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevel">Show Gamerscore instead of level</sys:String>
    <sys:String x:Key="LOCGamerscoreInsteadOfLevelDesc">Displays your Gamerscore instead of your achievement level throughout the theme.</sys:String>
    <sys:String x:Key="LOCIconControllerDesc">Select the controller button icons used across the interface.</sys:String>
    <sys:String x:Key="LOCLoginScreenBackgroundDesc">Select the background image shown on the login screen.</sys:String>
    <sys:String x:Key="LOCLogoInTrophyDesc">Displays the game logo instead of the game title on the game achievements screen.</sys:String>
    <sys:String x:Key="LOCMainDescDesc">Shows the selected game description below the game logo on the main view.</sys:String>
    <sys:String x:Key="LOCMainViewInfoDisplayHeader">Information Display Mode</sys:String>
    <sys:String x:Key="LOCNoActivityDesc">Hides the last played date for the selected game.</sys:String>
    <sys:String x:Key="LOCNoBarModeDesc">Hides the status bar on the game details screen, including avatar, achievements, and platform logo.</sys:String>
    <sys:String x:Key="LOCNoAvatarDetails">Hide avatar from status bar</sys:String>
    <sys:String x:Key="LOCNoAvatarDetailsDesc">Hides the avatar from the status bar on the game details screen.</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetails">Hide achievements from status bar</sys:String>
    <sys:String x:Key="LOCNoAchievementsDetailsDesc">Hides achievement progress from the status bar on the game details screen.</sys:String>
    <sys:String x:Key="LOCNoCompletionDesc">Hides the game completion status on the details screen.</sys:String>
    <sys:String x:Key="LOCNoGameStatutDesc">Hides Playnite’s default screen shown after launching a game, with the game background, launch message, and return button. This does not affect Aniki’s custom splash screen.</sys:String>
    <sys:String x:Key="LOCNoGenreDetailsDesc">Hides the game genre on the details screen.</sys:String>
    <sys:String x:Key="LOCNoHLTBDetailsDesc">Hides HowLongToBeat playtime estimates from the details screen.</sys:String>
    <sys:String x:Key="LOCNoLogoDesc">Replaces the game logo with the game title on the details screen.</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogo">Hide game logo and title</sys:String>
    <sys:String x:Key="LOCShowNoTittleAndLogoDesc">Hides both the game logo and the fallback game title on the details screen.</sys:String>
