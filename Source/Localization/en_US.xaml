    <sys:String x:Key="LOCNoActivityDesc">Hides the last played date for the selected game.</sys:String>
    <sys:String x:Key="LOCNoBarModeDesc">Hides the status bar on the game details screen, including avatar, achievements, and platform logo.</sys:String>
    <sys:String x:Key="LOCNoCompletionDesc">Hides the game completion status on the details screen.</sys:String>
    <sys:String x:Key="LOCNoGameStatutDesc">Hides Playnite’s default screen shown after launching a game, with the game background, launch message, and return button. This does not affect Aniki’s custom splash screen.</sys:String>
    <sys:String x:Key="LOCNoGenreDetailsDesc">Hides the game genre on the details screen.</sys:String>
    <sys:String x:Key="LOCNoHLTBDetailsDesc">Hides HowLongToBeat playtime estimates from the details screen.</sys:String>
    <sys:String x:Key="LOCNoLogoDesc">Replaces the game logo with the game title on the details screen.</sys:String>
    <sys:String x:Key="LOCNoPlayerDetailsDesc">Hides the current player count on the details screen.</sys:String>
    <sys:String x:Key="LOCNoSizeDesc">Hides the installed game size on the details screen.</sys:String>
    <sys:String x:Key="LOCNoStarDesc">Hides the game rating score on the details screen.</sys:String>
    <sys:String x:Key="LOCNoTimeDesc">Hides your total playtime for the selected game.</sys:String>
    <sys:String x:Key="LOCNoTrophyDetailsDesc">Hides achievement information on the details screen.</sys:String>
    <sys:String x:Key="LOCNoYearDesc">Hides the game release year on the details screen.</sys:String>
    <sys:String x:Key="LOCOpacityBackgroundListGameDesc">Changes how visible the background frame behind the game covers is. 0 is fully transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCOpacityBarDetailDesc">Changes how visible the status bar background is. 0 is fully transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCOpacityBottomBarDesc">Changes how visible the bottom filter preset bar background is. 0 is fully transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCOpacityPanelModernLayoutDesc">Changes how visible the information panel background is in the Modern details layout. 0.4 is more transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCOpacityPanelShowcaseLayoutDesc">Changes how visible the information panel background is in the Showcase details layout. 0.4 is more transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCOpacityTopBarDesc">Changes how visible the top bar background is. 0 is fully transparent, 1 is fully opaque.</sys:String>
    <sys:String x:Key="LOCPlatformBannerDesc">Shows platform banners at the top of game covers.</sys:String>
    <sys:String x:Key="LOCRetroRoom">Retro Room</sys:String>
    <sys:String x:Key="LOCShowCoverDetailsDesc">Shows the game cover in the Modern details layout.</sys:String>
    <sys:String x:Key="LOCShowGameListBackground">Show game list frame background</sys:String>
    <sys:String x:Key="LOCShowGameListBackgroundDesc">Shows a background frame behind the game covers for a stronger framed look.</sys:String>
    <sys:String x:Key="LOCShowHiddenAchievementsDesc">Automatically reveals hidden achievements when opening the achievements screen.</sys:String>
    <sys:String x:Key="LOCShowLoginScreenOnStartupDesc">Shows the login screen when Playnite starts. Disable this to go directly to the main interface.</sys:String>
    <sys:String x:Key="LOCShowMoDataDesc">Shows your internet connection status in the interface. Requires the MoData extension.</sys:String>
