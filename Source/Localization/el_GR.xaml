    <sys:String x:Key="LOCDisplayedInformationHeader">Πληροφορίες που εμφανίζονται</sys:String>
    <sys:String x:Key="LOCVisualEffectsHeader">Οπτικά εφέ</sys:String>
    <sys:String x:Key="LOCPowerMenuHeader">Μενού τροφοδοσίας</sys:String>
