    <sys:String x:Key="LOCOpacityBarDetail">Αδιαφάνεια γραμμής κατάστασης</sys:String>
    <sys:String x:Key="LOCOpacityBottomBar">Αδιαφάνεια γραμμής κατάστασης</sys:String>
    <sys:String x:Key="LOCOpacityPanelModernLayout">Αδιαφάνεια πίνακα μοντέρνας διάταξης</sys:String>
    <sys:String x:Key="LOCOpacityPanelShowcaseLayout">Αδιαφάνεια πίνακα διάταξης παρουσίασης</sys:String>
    <sys:String x:Key="LOCOpacityTopBar">Αδιαφάνεια επάνω μπάρας</sys:String>
    <sys:String x:Key="LOCPerformanceModeDesc">Απενεργοποιεί τα περισσότερα οπτικά εφέ και τις κινούμενες εικόνες, ώστε η διεπαφή να λειτουργεί πιο ομαλά σε συστήματα χαμηλότερων προδιαγραφών.</sys:String>
    <sys:String x:Key="LOCPlatformBanner">Εμφάνιση banner πλατφόρμας</sys:String>
    <sys:String x:Key="LOCShowCoverDetails">Εμφάνιση εξωφύλλου σε μοντέρνα διάταξη</sys:String>
    <sys:String x:Key="LOCShowHiddenAchievements">Εμφάνιση κρυφών επιτευγμάτων από προεπιλογή</sys:String>
    <sys:String x:Key="LOCShowMoData">Εμφάνιση κατάστασης σύνδεσης στο διαδίκτυο.</sys:String>
    <sys:String x:Key="LOCShowToolsButton">Εμφάνιση κουμπιού εργαλείων στο επάνω μενού</sys:String>
    <sys:String x:Key="LOCShowTrailerTime">Εμφάνιση διάρκειας τρέιλερ στην προβολή λεπτομερειών</sys:String>
    <sys:String x:Key="LOCSourceLogoOnDetailsView">Εμφάνιση λογότυπου πηγής</sys:String>
    <sys:String x:Key="LOCSourceLogoOnMainScreen">Εμφάνιση λογότυπου πηγής</sys:String>
    <sys:String x:Key="LOCSteamBannerDesc">Προσαρμόζει τη διάταξη της κύριας προβολής για τις πλατιές εικόνες banner του Steam και εμφανίζει αυτόματα το φόντο του πλαισίου της λίστας παιχνιδιών, για μια πιο καθαρή διάταξη του banner. Ορισμένες επιλογές διάταξης ενδέχεται να μην ισχύουν σε αυτήν τη λειτουργία.</sys:String>
    <sys:String x:Key="LOCThemeColor">Επιλέξτε χρώμα θέματος</sys:String>
    <sys:String x:Key="LOCThemeColorStyle">Στυλ χρωμάτων θέματος</sys:String>
    <sys:String x:Key="LOCThemeColorStyleDesc">Επιλέξτε τον τύπο χρωμάτων θέματος που θα εμφανίζεται στην παρακάτω λίστα.</sys:String>
    <sys:String x:Key="LOCSelectThemeColorPlaceholder">Επιλέξτε ένα χρώμα θέματος…</sys:String>
