    <sys:String x:Key="LOCFirstSetupStart">Start</sys:String>
    <sys:String x:Key="LOCFirstSetupWelcomeTitle">Welcome to Aniki ReMake</sys:String>
    <sys:String x:Key="LOCFirstSetupWelcomeDesc">Personalize your console-like experience in a few quick steps. Every choice can be changed later.</sys:String>
    <sys:String x:Key="LOCFirstSetupWelcomeDefaultsNote">Επαναφέρει όλες τις επιλογές προσαρμογής θέματος στις προεπιλεγμένες τιμές τους. Μπορείτε να τις ελέγξετε πριν από την εφαρμογή.</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileTitle">Ποιος χρησιμοποιεί το Aniki ReMake;</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileDesc">Επιλέξτε το όνομα και το avatar που εμφανίζονται σε όλο το θέμα.</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileName">Όνομα Χρήστη</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileEmptyName">Εάν το όνομα παραμείνει κενό, θα χρησιμοποιηθεί η λέξη &quot;Παίκτης&quot;.</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileAvatar">Επιλέξτε το avatar σας</sys:String>
    <sys:String x:Key="LOCFirstSetupProfileMoreAvatars">Περισσότερα avatar είναι διαθέσιμα αργότερα στο μενού Προσαρμογή.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupTitle">Επιλέξτε την οθόνη εκκίνησης</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupDesc">Αποφασίστε τι θα πρέπει να εμφανίζει το Aniki ReMake όταν ξεκινά η λειτουργία πλήρους οθόνης.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLogin">Οθόνη σύνδεσης</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLoginDesc">Εμφάνιση της οθόνης σύνδεσης πριν από την είσοδο στη διεπαφή.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupDestination">Προορισμός εκκίνησης</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLoginEnabled">Ενεργοποιημένη</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLoginEnabledDesc">Εμφάνιση της οθόνης σύνδεσης πριν από τον επιλεγμένο προορισμό.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLoginDisabled">Απενεργοποιημένη</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLoginDisabledDesc">Μετάβαση απευθείας στον επιλεγμένο προορισμό.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupHub">Κέντρο Καλωσορίσματος</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupHubDesc">Ανοίξτε το Κέντρο Υποδοχής μετά την προαιρετική οθόνη σύνδεσης.</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLibrary">Συλλογή</sys:String>
    <sys:String x:Key="LOCFirstSetupStartupLibraryDesc">Ανοίξτε τη συλλογή παιχνιδιών σας μετά την προαιρετική οθόνη σύνδεσης.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceTitle">Επιλέξτε το στυλ διεπαφής σας</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceDesc">Επιλέξτε πόσες πληροφορίες και πόσες συντομεύσεις εμφανίζονται στην κύρια διεπαφή.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfacePresetNote">Αυτές είναι προκαθορισμένες διαμορφώσεις. Κάθε επιλογή μπορεί να προσαρμοστεί ανεξάρτητα στις Ρυθμίσεις &gt; Προσαρμογή.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceClean">Απλοποιημένη Εμπειρία</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCleanDesc">Αποκρύπτει αυτόματα τις επάνω και κάτω γραμμές, τα πλαίσια πληροφοριών και τα περισσότερα ενσωματωμένα κουμπιά λειτουργιών, διατηρώντας παράλληλα διαθέσιμη την Επικάλυψη.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandard">Κανονική Εμπειρία</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceStandardDesc">Χρησιμοποιεί την προεπιλεγμένη διαμόρφωση Aniki ReMake, με την επάνω γραμμή ορατή, την κάτω γραμμή αυτόματα κρυμμένη, τις συντομεύσεις του χειριστηρίου και τα κύρια κουμπιά λειτουργιών.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhanced">Βελτιωμένη Εμπειρία</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceEnhancedDesc">Διατηρεί την επάνω γραμμή ορατή και αποκρύπτει αυτόματα την κάτω γραμμή, με μια διαφανή επάνω γραμμή, συμπαγείς πληροφορίες παιχνιδιού και τα κουμπιά των κύριων λειτουργιών.</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceComplete">Ολοκληρωμένη Εμπειρία</sys:String>
    <sys:String x:Key="LOCFirstSetupInterfaceCompleteDesc">Διατηρεί ορατές και τις δύο γραμμές διεπαφής και ενεργοποιεί το πλαίσιο λίστας παιχνιδιών, τις συντομεύσεις χειριστηρίου, τον λεπτομερή πλευρικό πίνακα και όλες τις ενσωματωμένες λειτουργίες.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorTitle">Επιλέξτε ένα χρώμα θέματος</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDesc">Επιλέξτε μία αντιπροσωπευτική προεπιλογή χρώματος για την πρώτη σας εμπειρία.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefault">Προεπιλεγμένο</sys:String>
    <sys:String x:Key="LOCFirstSetupColorDefaultDesc">Η αυθεντική παλέτα χρωμάτων Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreen">Πράσινο του Κυνηγού</sys:String>
    <sys:String x:Key="LOCFirstSetupColorGreenDesc">Μια βαθιά πράσινη παλέτα με μια φυσική, διακριτική εμφάνιση.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlue">Μπλε Orbis</sys:String>
    <sys:String x:Key="LOCFirstSetupColorBlueDesc">Μια καθαρή μπλε παλέτα εμπνευσμένη από τις διεπαφές κονσόλας.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRed">Ζωηρό Κόκκινο</sys:String>
    <sys:String x:Key="LOCFirstSetupColorRedDesc">Μια έντονη κόκκινη παλέτα με πιο ενεργητική εμφάνιση.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestige">Ζαφείρι Κύρους</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPrestigeDesc">Μια premium σκοτεινή προεπιλογή με εκλεπτυσμένες φωτεινότητες.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPink">Ροζ Μεσονύχτιου</sys:String>
    <sys:String x:Key="LOCFirstSetupColorPinkDesc">Μια βαθιά ροζ παλέτα με μια πιο σκούρα, πιο ατμοσφαιρική εμφάνιση.</sys:String>
    <sys:String x:Key="LOCFirstSetupColorMorePresets">Περισσότερες από 40 προεπιλογές χρωμάτων είναι διαθέσιμες στο μενού Προσαρμογή.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsTitle">Επιλέξτε μια διάταξη λεπτομερειών</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsDesc">Επιλέξτε τον τρόπο με τον οποίο θα ταξινομούνται οι πληροφορίες του παιχνιδιού στην οθόνη λεπτομερειών.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignature">Χαρακτηριστική</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsSignatureDesc">Η χαρακτηριστική διάταξη λεπτομερειών της Aniki ReMake.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModern">Μοντέρνα</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsModernDesc">Μια ευρύχωρη και σύγχρονη παρουσίαση.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassic">Κλασική</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsClassicDesc">Μια οικεία διάταξη με επίκεντρο την αναγνωσιμότητα.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginal">Πρωτότυπη</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsOriginalDesc">Αναδημιουργεί το στυλ προβολής Λεπτομέρειες από το αρχικό Aniki ReMake v1.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcase">Παρουσίαση</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsShowcaseDesc">Μια οπτική διάταξη που δίνει περισσότερο χώρο για έργα τέχνης παιχνιδιού.</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanel">Πίνακας</sys:String>
    <sys:String x:Key="LOCFirstSetupDetailsPanelDesc">Μια δομημένη διάταξη με πληροφορίες ομαδοποιημένες σε πλαίσια.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceTitle">Επιλέξτε την οπτική σας εμπειρία</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceDesc">Κάθε προεπιλογή ελέγχει τις κινούμενες εικόνες και τα οπτικά εφέ του θέματος.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFull">Πλήρως κινούμενα σχέδια</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceFullDesc">Ενεργοποιεί όλα τα κινούμενα σχέδια θεμάτων και τα οπτικά εφέ, συμπεριλαμβανομένων των κινούμενων φόντων.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimated">Με εφέ κίνησης</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceAnimatedDesc">Διατηρεί τις κύριες κινούμενες εικόνες και τα οπτικά εφέ, αλλά απενεργοποιεί τα κινούμενα φόντα.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalanced">Ισορροπημένο</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceBalancedDesc">Χρησιμοποιεί τις προτεινόμενες προεπιλογές του Aniki ReMake για ένα ισορροπημένο μείγμα κινούμενων σχεδίων, οπτικών εφέ και απόκρισης.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformance">Λειτουργία Απόδοσης</sys:String>
    <sys:String x:Key="LOCFirstSetupExperiencePerformanceDesc">Απενεργοποιεί όλα τα κινούμενα σχέδια και τα οπτικά εφέ θέματος για να προσφέρει την καλύτερη δυνατή απόδοση. Συνιστάται για φορητές συσκευές και συστήματα κατώτερης κατηγορίας.</sys:String>
    <sys:String x:Key="LOCFirstSetupExperienceWarning">Οι συνεχείς κινούμενες εικόνες και τα οπτικά εφέ μπορούν να μειώσουν την απόδοση σε φορητές συσκευές ή σε μέτριους υπολογιστές.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersTitle">Επιλέξτε πού αναπαράγονται αυτόματα τα τρέιλερ</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDesc">Επιλέξτε να μην εμφανίζονται αυτόματα τρέιλερ, μόνο λεπτομέρειες παιχνιδιού ή και τα δύο, τη βιβλιοθήκη και τις λεπτομέρειες.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabled">Απενεργοποιημένο</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDisabledDesc">Απενεργοποιεί τα αυτόματα τρέιλερ τόσο στη βιβλιοθήκη όσο και στις λεπτομέρειες του παιχνιδιού.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetails">Μόνο λεπτομέρειες</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersDetailsDesc">Αναπαράγει αυτόματα τα τρέιλερ μόνο στις σελίδες λεπτομερειών του παιχνιδιού.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetails">Βιβλιοθήκη και λεπτομέρειες</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersMainDetailsDesc">Αναπαράγει αυτόματα τρέιλερ στην κύρια βιβλιοθήκη και στις σελίδες λεπτομερειών του παιχνιδιού.</sys:String>
    <sys:String x:Key="LOCFirstSetupTrailersNote">Η μίνι ή πλήρης οθόνη και άλλες επιλογές τρέιλερ μπορούν να προσαρμοστούν στις Ρυθμίσεις &gt; Προσαρμογή. Η ροή τρέιλερ ενδέχεται να χρησιμοποιεί πρόσθετους πόρους.</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsTitle">Επεκτάσεις για την πλήρη εμπειρία Aniki ReMake</sys:String>
    <sys:String x:Key="LOCFirstSetupIntegrationsDesc">Επιλέξτε τις επεκτάσεις που λείπουν και θέλετε. Θα εγκατασταθούν μετά την εφαρμογή της ρύθμισής σας, επομένως χρειάζεται μόνο μία τελευταία επανεκκίνηση. Μετά την επανεκκίνηση, θα χρειαστεί να ανοίξετε τις ρυθμίσεις τους σε λειτουργία επιφάνειας εργασίας για να τις διαμορφώσετε.</sys:String>
    <sys:String x:Key="LOCFirstSetupSteamDesc">Συνδεθείτε στο Steam από τις ρυθμίσεις του Aniki Helper στη λειτουργία Desktop για να χρησιμοποιήσετε τους φίλους, τη λίστα επιθυμιών, τις προτάσεις και τις λειτουργίες του καταστήματος στο Steam.</sys:String>
    <sys:String x:Key="LOCFirstSetupAchievementsDesc">Προσθέτει ειδοποιήσεις για τρόπαια, πρόοδο, σπανιότητα και επιτεύγματα.</sys:String>
    <sys:String x:Key="LOCFirstSetupMusicDesc">Προσθέτει μουσική υπόκρουση, προβολή μουσικής και το ενσωματωμένο πρόγραμμα αναπαραγωγής μουσικής.</sys:String>
    <sys:String x:Key="LOCFirstSetupAudioSwitcherDesc">Σας επιτρέπει να αλλάζετε γρήγορα συσκευές ήχου από το θέμα και την επικάλυψη εντός παιχνιδιού.</sys:String>
    <sys:String x:Key="LOCFirstSetupCustomFadeDesc">Σας επιτρέπει να αλλάζετε και να προσαρμόζετε την κινούμενη εικόνα μετάβασης φόντου κατά την εναλλαγή μεταξύ παιχνιδιών.</sys:String>
    <sys:String x:Key="LOCFirstSetupExtraMetadataDesc">Φορτώνει τα επιπλέον λογότυπα, βίντεο, τρέιλερ και άλλα μέσα που χρησιμοποιούνται από το θέμα. Θα εγκατασταθεί επίσης το πρόσθετο βοηθητικό πρόγραμμα λειτουργίας πλήρους οθόνης μεταδεδομένων.</sys:String>
    <sys:String x:Key="LOCFirstSetupScreenshotsTitle">Στιγμιότυπα οθόνης και συλλογή</sys:String>
