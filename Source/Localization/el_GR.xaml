    <sys:String x:Key="LOCBackgroundOnFocusedCover">Φόντο + λογότυπο στο εστιασμένο εξώφυλλο</sys:String>
    <sys:String x:Key="LOCUserName">Επιλέξτε το όνομα χρήστη σας</sys:String>
    <sys:String x:Key="LOCUseSteamAvatar">Χρήση avatar προφίλ Steam</sys:String>
    <sys:String x:Key="LOCVisualPack">Επιλέξτε πακέτο οπτικών στοιχείων φόντου</sys:String>
    <sys:String x:Key="LOCHubAchievementMemoriesTitle">Αναμνήσεις Επιτευγμάτων</sys:String>
    <sys:String x:Key="LOCHubAchievementMemoriesSubtitle">Αναμνήσεις από</sys:String>
