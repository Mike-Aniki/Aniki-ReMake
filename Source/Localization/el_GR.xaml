    <sys:String x:Key="LOCDefaultLoginScreen">Προεπιλεγμένη οθόνη σύνδεσης</sys:String>

    <!-- Cover logos / Signature layout -->
    <sys:String x:Key="LOCCoverLogoBadge">Εμφάνιση λογοτύπων στα εξώφυλλα</sys:String>
    <sys:String x:Key="LOCCoverLogoBadgeDesc">Εμφανίζει ένα μικρό λογότυπο πηγής ή πλατφόρμας στην κάτω δεξιά γωνία κάθε εξωφύλλου παιχνιδιού. Τα λογότυπα φορτώνονται από τον φάκελο Icons\Logo, χρησιμοποιώντας κατά προτεραιότητα το όνομα της πηγής και, ως εναλλακτική λύση, την πρώτη πλατφόρμα.</sys:String>
