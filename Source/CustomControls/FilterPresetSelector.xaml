<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Définition du style pour les éléments de sélection rapide des filtres -->
    <Style x:Key="ItemFilterQuickPreset" TargetType="CheckBoxEx">
        <!-- Définition des propriétés par défaut -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />

        <!-- Définition du modèle de contrôle -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">

                    <Grid x:Name="GridBox">

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="10" />
                                <Setter Property="Height" Value="60" />
                            </Style>
                        </Grid.Style>

                        <!-- Chemin custom défini dans Aniki Helper -->
                        <TextBlock x:Name="CustomIconFilterPathText"
                                   Text="{PluginSettings Plugin=AnikiHelper, Path=CustomFilterIconsFolder}"
                                   Visibility="Collapsed" />

                        <!-- Chemin final : CustomFolder/NomDuFiltre.png -->
                        <TextBlock x:Name="CustomIconFilterPath"
                                   Visibility="Collapsed">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}/{1}.png">
                                    <Binding Path="Text" ElementName="CustomIconFilterPathText" />
                                    <Binding Path="Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>


                        <!-- Bordure principale -->
                        <Border x:Name="MainBorder"
                                Margin="0"
                                BorderThickness="3"
                                CornerRadius="{DynamicResource Corner}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                Tag="False"
                                Visibility="Collapsed" />

                        <!-- Bordure clignotante pour le menu -->
                        <Border x:Name="FlashMenuBorder"
                                Margin="0"
                                CornerRadius="{DynamicResource Corner}"
                                Style="{DynamicResource AnimatedFlashMenu}"
                                Tag="False"
                                Visibility="Collapsed" />

                        <!-- Icônes de filtre : custom utilisateur + fallback thème -->
                        <Grid x:Name="FilterIconContainer"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="20,10,20,10"
                              MinWidth="70">

                            <!-- Icône par défaut du thème -->
                            <Image x:Name="Filter"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{ThemeFileBinding Name, PathFormat='Icons/Filter/{0}.png'}"
                                   Stretch="Uniform"
                                   Height="40"
                                   MaxWidth="180"
                                   MaxHeight="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />

                            <!-- Icône custom utilisateur -->
                            <Image x:Name="CustomFilter"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{Binding Text, ElementName=CustomIconFilterPath}"
                                   Stretch="Uniform"
                                   Height="40"
                                   MaxWidth="180"
                                   MaxHeight="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        </Grid>

                        <!-- Texte fallback si aucune icône n’est disponible -->
                        <TextBlock x:Name="TextContent"
                                   Text="{Binding Name}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Lato Bold"
                                   Foreground="{DynamicResource TextWhiteBrush}"
                                   TextAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Margin" Value="20,10,20,10"/>
                                    <Setter Property="FontSize" Value="28"/>
                                    <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Si aucun dossier custom n’est défini, on masque l’image custom -->
                        <DataTrigger Binding="{Binding ElementName=CustomIconFilterPathText, Path=Text}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CustomFilter" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Filter" />
                        </DataTrigger>

                        <!-- Si l’icône custom n’existe pas, on affiche l’icône du thème -->
                        <DataTrigger Binding="{Binding ElementName=CustomFilter, Path=Source}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CustomFilter" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Filter" />
                        </DataTrigger>

                        <!-- Texte uniquement si custom ET thème sont absents -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=CustomFilter, Path=Source}" Value="{x:Null}" />
                                <Condition Binding="{Binding ElementName=Filter, Path=Source}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>

                            <Setter Property="Visibility" Value="Collapsed" TargetName="CustomFilter" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Filter" />
                            <Setter Property="Visibility" Value="Visible" TargetName="TextContent" />
                        </MultiDataTrigger>

                        <!-- Focus -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Tag" Value="True" TargetName="MainBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="MainBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FlashMenuBorder" />
                            <Setter Property="Tag" Value="True" TargetName="FlashMenuBorder" />

                            <Setter Property="Opacity" Value="1" TargetName="TextContent" />
                            <Setter Property="Opacity" Value="1" TargetName="Filter" />
                            <Setter Property="Opacity" Value="1" TargetName="CustomFilter" />
                        </Trigger>

                        <!-- Pas focus -->
                        <Trigger Property="IsFocused" Value="False">
                            <Setter Property="Opacity" Value="0.5" TargetName="TextContent" />
                            <Setter Property="Opacity" Value="0.5" TargetName="Filter" />
                            <Setter Property="Opacity" Value="0.5" TargetName="CustomFilter" />
                        </Trigger>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Opacity" Value="1" TargetName="TextContent" />
                            <Setter Property="Opacity" Value="1" TargetName="Filter" />
                            <Setter Property="Opacity" Value="1" TargetName="CustomFilter" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FlashMenuBorder" />
                            <Setter Property="Tag" Value="True" TargetName="FlashMenuBorder" />
                        </Trigger>

                        <!-- MouseOver -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GridBox" />
                            <Setter Property="Opacity" Value="1" TargetName="TextContent" />
                            <Setter Property="Opacity" Value="1" TargetName="Filter" />
                            <Setter Property="Opacity" Value="1" TargetName="CustomFilter" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Définition du style pour le sélecteur de préréglages de filtre -->
    <Style TargetType="{x:Type FilterPresetSelector}">
        <!-- Définition des propriétés par défaut -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MaxWidth" Value="{StaticResource DesignWidth}" />
        <Setter Property="MaxHeight" Value="{StaticResource DesignHeight}" />
        <!-- Définition du modèle de contrôle -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPresetSelector}">
                    <!-- Contenu principal du modèle -->
                    <ItemsControlEx x:Name="PART_ItemsFilterPresets" Focusable="False"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    KeyboardNavigation.TabNavigation="Cycle"
                                    KeyboardNavigation.ControlTabNavigation="Cycle">
                        <ItemsControlEx.Style>
                            <Style TargetType="ItemsControlEx">
                                <Setter Property="HorizontalLayout" Value="True"/>
                            </Style>
                        </ItemsControlEx.Style>
                        <ItemsControl.ItemsPanel>
                            <!-- Panneau pour disposer les éléments en ligne -->
                            <ItemsPanelTemplate>
                                <StackPanel >
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Orientation" Value="Horizontal"/>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <!-- Modèle pour afficher le contenu dans un ScrollViewer -->
                            <ControlTemplate>
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControlEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
