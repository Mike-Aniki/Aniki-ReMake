<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Définition du style pour les éléments de sélection d'éléments de la liste d'énumération du filtre -->
    <Style TargetType="{x:Type FilterEnumListSelection}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterEnumListSelection}">
                    <Border Background="Transparent">
                        <DockPanel x:Name="PART_MenuHost"
                                   MinWidth="560"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   LastChildFill="True">

                            <!-- Bouton retour / titre -->
                            <ButtonEx x:Name="PART_ButtonBack"
                                      DockPanel.Dock="Top"
                                      Margin="18,18,18,12"
                                      Height="54"
                                      Style="{DynamicResource FilterPanelButtonEx}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center">
                                <ButtonEx.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xe72b;"
                                                   FontFamily="{DynamicResource FontIcoFont}"
                                                   FontSize="22"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonEx}}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   FontSize="24"
                                                   Style="{DynamicResource ButtonTextBlockBaseStyle}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonEx}}"/>
                                    </Grid>
                                </ButtonEx.Content>
                            </ButtonEx>

                            <!-- Bouton clear -->
                            <ButtonEx x:Name="PART_ButtonClear"
                                      Content="{DynamicResource LOCClearLabel}"
                                      DockPanel.Dock="Top"
                                      Margin="18,0,18,14"
                                      Height="50"
                                      Style="{DynamicResource FilterPanelButtonEx}"/>

                            <!-- Séparateur -->
                            <Border DockPanel.Dock="Top"
                                    Height="1"
                                    Margin="18,0,18,14"
                                    Background="{DynamicResource SeparatorBrush}" />

                            <!-- Conteneur des éléments -->
                            <ScrollViewer DockPanel.Dock="Top"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True"
                                          Padding="0,0,0,18">
                                <ItemsControlEx x:Name="PART_ItemsHost"
                                                Margin="0,6,0,0"
                                                Focusable="False"
                                                KeyboardNavigation.DirectionalNavigation="Once">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControlEx>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
