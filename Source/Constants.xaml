    <!-- ========================================================== Shared avatar and PlayniteAchievements summary ========================================================== -->

    <DataTemplate x:Key="AnikiUserAvatarTemplate">
        <Grid Width="56" Height="56" VerticalAlignment="Center">
            <Border x:Name="AvatarMaskShared"
                    Width="56"
                    Height="56"
                    Background="Black"
                    CornerRadius="28"/>

            <TextBlock x:Name="ProfilePicturePathShared"
                       Tag="{Api Paths.ConfigurationPath}"
                       Visibility="Collapsed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text">
                            <Setter.Value>
                                <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Width="56"
                  Height="56"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=AvatarMaskShared}"/>
                </Grid.OpacityMask>

                <Control Tag="{Binding ElementName=ProfilePicturePathShared, Path=Text}"
                         Width="56"
                         Height="56"
                         Template="{StaticResource SteamSelfAvatarTemplate}"
                         Focusable="False"
                         IsTabStop="False"
                         IsHitTestVisible="False"/>
            </Grid>

            <Border Width="56"
                    Height="56"
                    CornerRadius="28"
                    BorderBrush="{DynamicResource TextBrush}"
                    BorderThickness="1.4"
                    Background="#14000000"
                    IsHitTestVisible="False"
                    Panel.ZIndex="5"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AnikiPlayniteAchievementsSummaryTemplate">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="20,0,20,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=Tag}" Value="Visible"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                <Image Source="{ThemeFile 'Images/platinum.png'}" RenderOptions.BitmapScalingMode="Fant"/>
            </Border>
            <TextBlock Margin="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDetailStyle}">
                        <Setter Property="Text" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                <Setter Property="Text" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                <Image Source="{ThemeFile 'Images/Or.png'}" RenderOptions.BitmapScalingMode="Fant"/>
            </Border>
            <TextBlock Margin="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=RareAndUltraRare.Unlocked, StringFormat={}{0}}"
                       Style="{StaticResource TextBlockDetailStyle}"
                       FontSize="20"/>

            <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                <Image Height="55"
                       Source="{ThemeFile 'Images/Argent.png'}"
                       RenderOptions.BitmapScalingMode="Fant"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Margin="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=Uncommon.Unlocked, StringFormat={}{0}}"
                       Style="{StaticResource TextBlockDetailStyle}"
                       FontSize="20"/>

            <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                <Image Source="{ThemeFile 'Images/Bronze.png'}"
                       RenderOptions.BitmapScalingMode="Fant"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Margin="0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=Common.Unlocked, StringFormat={}{0}}"
                       Style="{StaticResource TextBlockDetailStyle}"
                       FontSize="20"/>

            <StackPanel.Effect>
                <DropShadowEffect ShadowDepth="2"
                                  Color="Black"
                                  BlurRadius="2"
                                  RenderingBias="Performance"
                                  Opacity="0.8"/>
            </StackPanel.Effect>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AnikiSourceIconFallbackTemplate">
        <Grid Focusable="False"
              FocusVisualStyle="{x:Null}">
            <TextBlock x:Name="CustomSourceIconFolderPath"
                       Text="{PluginSettings Plugin=AnikiHelper, Path=CustomSourceIconsFolder}"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="CustomSourceIconPath" Visibility="Collapsed">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}.png">
                        <Binding Path="Text" ElementName="CustomSourceIconFolderPath"/>
                        <Binding Path="Source.Name"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock x:Name="CustomPlatformIconPath" Visibility="Collapsed">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}.png">
                        <Binding Path="Text" ElementName="CustomSourceIconFolderPath"/>
                        <Binding Path="Platforms[0].Name"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Image x:Name="CustomSourceIcon"
                   Source="{Binding Text, ElementName=CustomSourceIconPath, IsAsync=True}"
                   RenderOptions.BitmapScalingMode="Fant"
                   Stretch="Uniform"
                   Focusable="False"
                   FocusVisualStyle="{x:Null}"
                   Height="50"
                   MaxWidth="180"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=CustomSourceIconFolderPath, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <Image x:Name="ThemeSourceIcon"
                   Source="{ThemeFileBinding Source.Name, PathFormat='Icons/Source/{0}.png', FallbackValue={x:Null}}"
                   RenderOptions.BitmapScalingMode="Fant"
                   Stretch="Uniform"
                   Focusable="False"
                   FocusVisualStyle="{x:Null}"
                   Height="50"
                   MaxWidth="180"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=CustomSourceIcon, Path=Visibility}" Value="Collapsed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <Image x:Name="CustomPlatformIcon"
                   Source="{Binding Text, ElementName=CustomPlatformIconPath, IsAsync=True}"
                   RenderOptions.BitmapScalingMode="Fant"
                   Stretch="Uniform"
                   Focusable="False"
                   FocusVisualStyle="{x:Null}"
                   Height="50"
                   MaxWidth="180"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=CustomSourceIcon, Path=Visibility}" Value="Collapsed"/>
                                    <Condition Binding="{Binding ElementName=ThemeSourceIcon, Path=Visibility}" Value="Collapsed"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding ElementName=CustomSourceIconFolderPath, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <Image x:Name="ThemePlatformIcon"
                   Source="{ThemeFileBinding Platforms[0].Name, PathFormat='Icons/Source/{0}.png', FallbackValue={x:Null}}"
                   RenderOptions.BitmapScalingMode="Fant"
                   Stretch="Uniform"
                   Focusable="False"
                   FocusVisualStyle="{x:Null}"
                   Height="50"
                   MaxWidth="180"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=CustomSourceIcon, Path=Visibility}" Value="Collapsed"/>
                                    <Condition Binding="{Binding ElementName=ThemeSourceIcon, Path=Visibility}" Value="Collapsed"/>
                                    <Condition Binding="{Binding ElementName=CustomPlatformIcon, Path=Visibility}" Value="Collapsed"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
