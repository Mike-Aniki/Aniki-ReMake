    <!-- ========================================================== ADDONS UPDATE WINDOW - FOOTER BUTTONS ========================================================== -->

    <Style x:Key="Aniki_AddonsUpdateButtonStyle" TargetType="ButtonEx">
        <Setter Property="Height" Value="55"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Margin" Value="10,0,10,0"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontMain}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">

                    <Grid Background="Transparent"
                          SnapsToDevicePixels="True">

                        <!-- Normal subtle background -->
                        <Border x:Name="NormalBackground"
                                CornerRadius="7"
                                Background="#08000000"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                Opacity="0.65"/>

                        <!-- Focus background -->
                        <Border x:Name="FocusBackground"
                                CornerRadius="7"
                                Background="{DynamicResource ButtonBackgroundFocus}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed"/>

                        <!-- Animated focus flash -->
                        <Border x:Name="FlashMenuBorder"
                                CornerRadius="7"
                                Style="{DynamicResource AnimatedFlashMenu}"
                                Tag="False"
                                Visibility="Collapsed"/>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                          TextElement.FontFamily="{DynamicResource FontMain}"
                                          TextElement.FontSize="18"
                                          TextElement.FontWeight="SemiBold"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="NormalBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NormalBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.82"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== ADDONS UPDATE WINDOW - UPDATE ITEM CARD ========================================================== -->

    <Style x:Key="Aniki_AddonsUpdateCheckBoxStyle" TargetType="CheckBoxEx">
        <Setter Property="MinHeight" Value="90"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">

                    <Grid Background="Transparent"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True">

                        <!-- Normal card -->
                        <Border x:Name="NormalBackground"
                                CornerRadius="7"
                                Background="#14000000"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"/>

                        <!-- Focus card -->
                        <Border x:Name="FocusBackground"
                                CornerRadius="7"
                                Background="{DynamicResource ButtonBackgroundFocus}"
                                BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed"/>

                        <!-- Animated focus flash -->
                        <Border x:Name="FlashMenuBorder"
                                CornerRadius="7"
                                Style="{DynamicResource AnimatedFlashMenu}"
                                Tag="False"
                                Visibility="Collapsed"/>

                        <Grid Margin="16,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>

                            <!-- Original Playnite content: addon name + version -->
                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                              TextElement.FontFamily="{DynamicResource FontMain}"/>

                            <!-- Checkbox visual -->
                            <Border Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource TextBrush}"
                                    Background="#12000000"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Opacity="0.82">

                                <TextBlock x:Name="CheckGlyph"
                                           Text="&#xE73E;"
                                           FontFamily="{DynamicResource FontIcons}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>

                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="NormalBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NormalBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusBackground" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

