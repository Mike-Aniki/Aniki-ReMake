    <!-- ========================= AVATAR STYLE ========================= -->

    <!-- Avatar Steam de l'utilisateur -->
    <ControlTemplate x:Key="SteamSelfAvatarTemplate" TargetType="{x:Type Control}">

        <Grid>
            <!-- Avatar intégré sélectionné dans les options du thème -->
            <Border x:Name="BuiltInAvatar"
                    Style="{DynamicResource SelectedAvatarBorderStyle}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- Avatar Extra Metadata -->
            <Image x:Name="ExtraMetadataAvatar"
                   Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                   Visibility="Visible"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="Fant"
                   IsHitTestVisible="False"/>

            <!-- Avatar Steam -->
            <Image x:Name="SteamAvatar"
                   Source="{PluginSettings Plugin=AnikiHelper, Path=SelfAvatar}"
                   Visibility="Collapsed"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="Fant"
                   IsHitTestVisible="False"/>
        </Grid>

        <ControlTemplate.Triggers>

            <!-- Extra Metadata absent : avatar intégré -->
            <DataTrigger Binding="{Binding ElementName=ExtraMetadataAvatar, Path=Source}" Value="{x:Null}">
                <Setter TargetName="BuiltInAvatar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ExtraMetadataAvatar" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>

            <!-- Steam activé et disponible : priorité absolue -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[UseSteamAvatar]}" Value="True"/>
                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfAvatarAvailable}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="BuiltInAvatar" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ExtraMetadataAvatar" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="SteamAvatar" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
