    <!-- Dual button: main action + hold action under it -->
    <Style x:Key="ButtonBottomMenuDual" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="18,0,18,0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- ICON: native Playnite InputHint first, Tag fallback second -->
                            <Grid Width="40"
                                  Height="40"
                                  Margin="0,0,8,0">

                                <!-- Playnite/custom style can set InputHint dynamically -->
                                <ContentControl x:Name="InputHintIcon"
                                                Width="40"
                                                Height="40"
                                                Focusable="False"
                                                ContentTemplate="{TemplateBinding InputHint}" />

                                <!-- Fallback for your custom Tag system -->
                                <Image x:Name="IconImg"
                                       Width="40"
                                       Height="40"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Source="{DynamicResource ImageButtonY-GenericDark}"
                                       Visibility="Collapsed" />
                            </Grid>

                            <!-- Texts -->
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center">

                                <!-- Main action -->
                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ButtonIconLightBrush}"
                                           Text="{TemplateBinding Content}" />

                                <!-- Long press action -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,1,0,0"
                                            Opacity="0.65">

                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ButtonIconLightBrush}"
                                               Text="{DynamicResource LOCHold}" />

                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ButtonIconLightBrush}"
                                               Text=": " />

                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ButtonIconLightBrush}"
                                               Text="{TemplateBinding CommandParameter}" />

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- If InputHint is null, use the old Tag-based image system.
                        If InputHint is set, it wins. This lets Playnite's native swap update icons. -->
                        <Trigger Property="InputHint" Value="{x:Null}">
                            <Setter TargetName="InputHintIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                        </Trigger>


                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonA-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonB-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonX-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonY-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonStart-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonBack-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonLS-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonRS-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Dpad">
                            <Setter TargetName="IconImg" Property="Source" Value="{DynamicResource ImageButtonDpad-GenericDark}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- Semantic tags for Play / Details. Useful if the button is not managed by Playnite code. -->
            <Trigger Property="Tag" Value="PlayAction">
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptX}" />
            </Trigger>
            <Trigger Property="Tag" Value="DetailsAction">
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptA}" />
            </Trigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="PlayAction" />
                    <Condition Binding="{Settings Fullscreen.SwapStartDetailsAction}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptA}" />
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="DetailsAction" />
                    <Condition Binding="{Settings Fullscreen.SwapStartDetailsAction}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptX}" />
            </MultiDataTrigger>

            <!-- Semantic tags for Confirm / Cancel. -->
            <Trigger Property="Tag" Value="ConfirmAction">
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptA}" />
            </Trigger>
            <Trigger Property="Tag" Value="CancelAction">
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptB}" />
            </Trigger>

            <!-- Native A/B swap. Also works for simple Tag="A" / Tag="B" buttons. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="A" />
                    <Condition Binding="{Settings Fullscreen.SwapConfirmCancelButtons}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptB}" />
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="B" />
                    <Condition Binding="{Settings Fullscreen.SwapConfirmCancelButtons}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptA}" />
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="ConfirmAction" />
                    <Condition Binding="{Settings Fullscreen.SwapConfirmCancelButtons}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptB}" />
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="CancelAction" />
                    <Condition Binding="{Settings Fullscreen.SwapConfirmCancelButtons}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="InputHint" Value="{DynamicResource ButtonPromptA}" />
            </MultiDataTrigger>
        </Style.Triggers>

    </Style>


    <!-- Native Playnite prompt resources overridden with Aniki custom images.
    Playnite sets ButtonEx.InputHint to these resources and updates them when X/A is swapped. -->
