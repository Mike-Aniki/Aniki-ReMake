<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Définition du style pour les boutons du menu inférieur -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Image x:Name="IconImg"
                                   Width="40"
                                   Height="40"
                                   Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Source="{DynamicResource ImageButtonA-GenericDark}" />

                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ButtonIconLightBrush}">
                                <ContentPresenter/>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonA-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonB-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonX-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonY-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonStart-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonBack-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonLS-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonRS-GenericDark}" />
                        </Trigger>



                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonBottomMenuDark" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Image x:Name="IconImg"
                                   Width="40"
                                   Height="40"
                                   Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Source="{DynamicResource ImageButtonA-GenericDark}" />

                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ButtonIconDarkBrush}">
                                <ContentPresenter/>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonA-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonB-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonX-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonY-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonStart-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonBack-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonLS-GenericDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonRS-GenericDark}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic Dark -->
    <BitmapImage x:Key="ImageButtonA-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-A.png'}" />
    <BitmapImage x:Key="ImageButtonB-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-B.png'}" />
    <BitmapImage x:Key="ImageButtonX-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-X.png'}" />
    <BitmapImage x:Key="ImageButtonY-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-Y.png'}" />
    <BitmapImage x:Key="ImageButtonStart-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-Start.png'}" />
    <BitmapImage x:Key="ImageButtonBack-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-Back.png'}" />
    <BitmapImage x:Key="ImageButtonLS-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-LS.png'}" />
    <BitmapImage x:Key="ImageButtonRS-GenericDark" UriSource="{ThemeFile 'Images/Buttons/Controller/Generic/Generic Dark/Button-RS.png'}" />



</ResourceDictionary>
