                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Image Width="46"
                                   Height="40"
