    <BitmapImage x:Key="ImageButtonStart-RogAlly" UriSource="{ThemeFile 'Images/Buttons/Controller/RogAlly/Button-Start.png'}" />
    <BitmapImage x:Key="ImageButtonBack-RogAlly" UriSource="{ThemeFile 'Images/Buttons/Controller/RogAlly/Button-Back.png'}" />
    <BitmapImage x:Key="ImageButtonLS-RogAlly" UriSource="{ThemeFile 'Images/Buttons/Controller/RogAlly/Button-LS.png'}" />
    <BitmapImage x:Key="ImageButtonRS-RogAlly" UriSource="{ThemeFile 'Images/Buttons/Controller/RogAlly/Button-RS.png'}" />
