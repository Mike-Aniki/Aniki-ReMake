<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Définition du style pour les boutons du menu inférieur -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- ICON (default = A) -->
                            <Image x:Name="IconImg"
                                   Width="40"
                                   Height="40"
                                   Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Source="{DynamicResource ImageButtonA-XboxDark}" />

                            <!-- TEXT -->
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource ButtonIconLightBrush}">
                                <ContentPresenter />
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonA-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonB-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonX-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonY-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonStart-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonBack-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonLS-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonRS-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Dpad">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonDpad-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="L1">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonL1-XboxDark}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="R1">
                            <Setter TargetName="IconImg" Property="Source"
                                    Value="{DynamicResource ImageButtonR1-XboxDark}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

