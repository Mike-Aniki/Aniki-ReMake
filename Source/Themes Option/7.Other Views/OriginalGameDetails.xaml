<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">

                    <Grid Background="#00000000"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          Focusable="True"
                          ClipToBounds="True"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle" >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition x:Name="DetailsRow" Height="*" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_ButtonContext}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:0" From="0" To="1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" From="1" To="0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameStatus, Path=Visibility}" Value="Visible">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=OpenPlayniteButton}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=PART_ElemGameStatus, Path=Visibility}" Value="Collapsed">
                                        <Setter Property="Focusable" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}" Value="True">
                                        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=NowPlayingButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>


                        <Border x:Name="Overlay" Grid.RowSpan="3" Grid.ColumnSpan="3" RenderOptions.BitmapScalingMode="Fant">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Panel.ZIndex" Value="-48"/>
                                    <Setter Property="Background" Value="{DynamicResource ShadeBackgroundDetailsRemix}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" Duration="0:0:1" To="1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border x:Name="OverlayBottom" Grid.RowSpan="3" Grid.ColumnSpan="3" RenderOptions.BitmapScalingMode="Fant">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Panel.ZIndex" Value="-48"/>
                                    <Setter Property="Background" Value="{DynamicResource ShadeBottom}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" Duration="0:0:1" To="1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid x:Name="SourceNoBar"
                              Panel.ZIndex="-45"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="60,18,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoSource]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ContentControl Content="{Binding}"
                                            Focusable="False"
                                            FocusVisualStyle="{x:Null}"
                                            ContentTemplate="{StaticResource AnikiSourceIconFallbackTemplate}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                        </Grid>



                        <!-- Avatar and PlayniteAchievements when the interface bar is hidden -->
                        <Grid x:Name="AvatarTrophiesNoBar"
                              Panel.ZIndex="-44"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,18,60,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource AnikiPlayniteAchievementsSummaryTemplate}"
                                                Tag="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                IsTabStop="False"/>

                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource AnikiUserAvatarTemplate}"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                IsTabStop="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- Interface Bar -->

                        <Grid x:Name="InterfaceBar" Panel.ZIndex="-45">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.RowSpan" Value="3"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Grid.Style>

                            <!-- BAR -->
                            <Border x:Name="TopBar" Height="80" >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoBarMode]}" Value="True">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible" />
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopButtonAlwaysVisible]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0" Duration="0:0:0"
                                                                             From="0" To="0"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.5" Duration="0:0:0.2"
                                                                             From="0" To="1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                BeginTime="0:0:0.5" Duration="0:0:0.6"
                                                                From="-90" To="0"
                                                                AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible" />
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                </MultiDataTrigger.Setters>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0" Duration="0:0:0"
                                                                             From="0" To="0"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.5" Duration="0:0:0.2"
                                                                             From="0" To="1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                BeginTime="0:0:0.5" Duration="0:0:0.6"
                                                                From="80" To="0"
                                                                AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="Stop">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                Duration="0:0:0.25"
                                                                From="0" To="80"
                                                                AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                Duration="0:0:0.25"
                                                                From="1" To="0.98"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             BeginTime="0:0:0.05" Duration="0:0:0.2"
                                                                             From="1" To="0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid x:Name="BottomGlass" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80">

                                    <!-- Fond verre -->
                                    <Border CornerRadius="0"
                                            Opacity="{DynamicResource OpacityBarDetail}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Par défaut -->
                                                <Setter Property="Background" Value="{DynamicResource TopBar}" />

                                                <Style.Triggers>
                                                    <!-- Si l’option est True => BottomBar -->
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BottomBar}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Reflet vertical discret -->
                                    <Border CornerRadius="0" IsHitTestVisible="False" Background="{DynamicResource GlassMainBrush}" Opacity="{DynamicResource OpacityBarDetail}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                    <!-- Liseré interne -->
                                    <Border CornerRadius="0"
                                            Opacity="{DynamicResource OpacityBarDetail}"
                                            Margin="1"
                                            BorderBrush="{DynamicResource GlassInnerLineBrush}"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Hairline -->
                                    <Border HorizontalAlignment="Stretch" Height="1.5"
                                            Background="{DynamicResource MenuBorderBrush}" Opacity="{DynamicResource OpacityBarDetail}"
                                            CornerRadius="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TopOrBottomBar]}" Value="True">
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Height="80">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="900"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- Avatar / PlayniteAchievements -->
                                        <Grid HorizontalAlignment="Right" Grid.Column="2" Margin="0,0,20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ContentControl x:Name="Avatar"
                                                            Grid.Column="2"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource AnikiUserAvatarTemplate}"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            IsTabStop="False"/>

                                            <ContentControl x:Name="Trophee_PA"
                                                            Grid.Column="1"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource AnikiPlayniteAchievementsSummaryTemplate}"
                                                            Tag="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            IsTabStop="False"/>
                                        </Grid>

                                        <!-- Image de Source -->
                                        <Border x:Name="SourceIconBorder"
                                                HorizontalAlignment="Left"
                                                Margin="20,0,0,0"
                                                Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoSource]}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <ContentControl Content="{Binding}"
                                                            Focusable="False"
                                                            FocusVisualStyle="{x:Null}"
                                                            ContentTemplate="{StaticResource AnikiSourceIconFallbackTemplate}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,40,0"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!--Grid Panel Details-->

                        <Grid x:Name="GameDetailsStack"
                              Grid.Row="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              RenderTransformOrigin="0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Margin" Value="80,40,0,0"/>
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <TranslateTransform X="0" Y="0"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>



                                    <Style.Triggers>




                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" BeginTime="0:0:0" Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationPanel]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" BeginTime="0:0:0" Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AnimationPanel]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>

                                            <MultiDataTrigger.EnterActions>
                                                <RemoveStoryboard BeginStoryboardName="SB_Out"/>
                                                <BeginStoryboard x:Name="SB_In" HandoffBehavior="SnapshotAndReplace">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                            From="-400" BeginTime="0:0:1" Duration="0:0:1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" BeginTime="0:0:1" Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                            <DataTrigger.EnterActions>
                                                <RemoveStoryboard BeginStoryboardName="SB_In"/>
                                                <BeginStoryboard x:Name="SB_Out" HandoffBehavior="SnapshotAndReplace">
                                                    <Storyboard FillBehavior="Stop">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                            To="-400" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0" Duration="0:0:0.20"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=LogoTrigger, Path=Opacity}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!--StackPanel Panel Details-->



                            <StackPanel Orientation="Vertical">

                                <!-- Logo -->

                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" CacheMode="BitmapCache">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="MaxWidth" Value="600"/>
                                            <Setter Property="MaxHeight" Value="250"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoLogo]}" Value="True">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,0"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoLogo]}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginStatus Plugin=ExtraMetadataLoader_705fdbca-e1fc-4004-b839-1d040b8b4429, Status=Installed}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- INFOS -->
                                <Grid Margin="0,20,0,0"
                                      MaxWidth="800"
                                      HorizontalAlignment="Left"
                                      SnapsToDevicePixels="True">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Dev + Year -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Critic -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Community -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Time played -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Last activity -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Size -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Completed -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Trophée -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Current players -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Dev + Year (on garde exactement tes bindings/converter) -->
                                    <Grid Grid.Row="0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReleaseYear}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoYear]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>




                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Row="0" Grid.Column="0">

                                            <TextBlock
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                Text="{Binding Developers[0], Converter={StaticResource ListToStringConverter}}"
                                                VerticalAlignment="Center"
                                                FontSize="24"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   Text="{Binding ReleaseYear, Converter={StaticResource ListToStringConverter}}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   FontSize="22"
                                                   Margin="0,10,0,0"/>

                                    </Grid>

                                    <!-- Critic score -->
                                    <Grid Grid.Row="1">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoStar]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.CriticScore}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Row="0" Grid.Column="0">

                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text="{DynamicResource LOCCriticScore}"
                                                       Opacity="0.8" FontSize="24"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   Text="{Binding CriticScore}"
                                                   FontSize="22"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>


                                    </Grid>

                                    <!-- Time played -->
                                    <Grid Grid.Row="2">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoTime]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCTimePlayed}"
                                                       Style="{StaticResource TextBlockDetailStyle}"
                                                       Opacity="0.8"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   x:Name="PlayedTime"
                                                   Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   Margin="0,10,0,0"
                                                   FontSize="22"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Last activity -->
                                    <Grid Grid.Row="3">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoActivity]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=Played, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">
                                            <TextBlock
                                                Text="{DynamicResource LOCLastPlayedLabel}"
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   x:Name="Played"
                                                   FontSize="22"
                                                   Text="{Binding LastActivity, StringFormat='{}{0:dd MMM yyyy}'}"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Size -->
                                    <Grid Grid.Row="4" >
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoSize]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=Siz, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">
                                            <TextBlock
                                                Text="{DynamicResource LOCInstallSizeLabel}"
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   x:Name="Siz"
                                                   FontSize="22"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal}"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Completed -->
                                    <Grid Grid.Row="5">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[Alternativ]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoCompletion]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=Completed, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">
                                            <TextBlock
                                                Text="{DynamicResource LOCCompletionStatus}"
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="Completed"
                                                   Text="{Binding CompletionStatus, Converter={StaticResource ListToStringConverter}}"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   FontSize="22"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Trophée -->
                                    <Grid Grid.Row="6">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoTrophyDetails]}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">
                                            <TextBlock
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource LOCAchievements}"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="0,10,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                            <TextBlock Margin="2,0,2,0"
                                                       FontSize="22"
                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}"
                                                       Style="{DynamicResource TextBlockAltDetailStyle}" />
                                            <TextBlock Margin="2,0,2,0"
                                                       Text="/"
                                                       FontSize="22"
                                                       Style="{DynamicResource TextBlockAltDetailStyle}" />
                                            <TextBlock Margin="2,0,2,0"
                                                       FontSize="22"
                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}"
                                                       Style="{DynamicResource TextBlockAltDetailStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Current players -->
                                    <Grid Grid.Row="7">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamCurrentPlayersAvailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[NoPlayerDetails]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">
                                            <TextBlock
                                                Text="{DynamicResource LOCPlayerInGame}"
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{PluginSettings Plugin=AnikiHelper, Path=SteamCurrentPlayersString}"
                                                   Style="{StaticResource TextBlockAltDetailStyle}"
                                                   FontSize="22"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- SteamFriendsWhoPlayed -->
                                    <Grid Grid.Row="8" FocusVisualStyle="{x:Null}" Focusable="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsWhoPlayedAvailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,5,0"
                                                    Grid.Column="0">

                                            <TextBlock
                                                Text="{DynamicResource LOCFriendswhoplayed}"
                                                Style="{StaticResource TextBlockDetailStyle}"
                                                Opacity="0.8"
                                                FontSize="24"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                       Text=" : "
                                                       FontSize="24"
                                                       Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" Orientation="Horizontal">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsWhoPlayedCurrentGameVisible}"
                                                          Focusable="False"

                                                          FocusVisualStyle="{x:Null}"
                                                          >
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="36"
                                                              Height="36"
                                                              Margin="-13,0,0,0"
                                                              ToolTip="{Binding name}">

                                                            <Ellipse Width="28"
                                                                     Height="28"
                                                                     Stroke="{DynamicResource TextBrush}"
                                                                     StrokeThickness="1">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding avatar}"
                                                                                RenderOptions.BitmapScalingMode="Fant"
                                                                                Stretch="UniformToFill"/>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Margin="6,0,0,0"
                                                    Padding="7,2"
                                                    MinWidth="32"
                                                    Height="28"
                                                    CornerRadius="14"
                                                    VerticalAlignment="Center"
                                                    Background="#24000000"
                                                    BorderBrush="{DynamicResource TextBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsWhoPlayedHasMore}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsWhoPlayedRemainingText}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                </Grid>

                                <!--Game Button-->
                                <Grid x:Name="GameButtons" IsEnabled="True" >
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="0,10,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border BorderBrush="Transparent" BorderThickness="3">
                                        <StackPanel HorizontalAlignment="Left" Margin="0,10,0,0" Orientation="Horizontal" >


                                            <Grid x:Name="MainButton" Height="50" Grid.Row="1" MinWidth="200" Margin="0,0,10,0" HorizontalAlignment="Stretch">


                                                <!-- Keep old button for graceful fallback to vanilla as needed -->
                                                <ButtonEx x:Name="PART_ButtonContext"
                                                          MinWidth="200"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Center">
                                                    <ButtonEx.Style>
                                                        <Style BasedOn="{StaticResource ButtonContext}" TargetType="ButtonEx">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}"
                                                                    Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>
                                                <!-- Custom button that has one command but can change button text as needed -->
                                                <ButtonEx x:Name="NowPlayingButton"
                                                          MinWidth="200"
                                                          HorizontalContentAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          Command="{PluginSettings Plugin=NowPlaying,
                                                          Path=InstallOrPlayOrOpenDialog}">
                                                    <ButtonEx.Style>
                                                        <Style BasedOn="{StaticResource GameDetailsNowPlayingButtonInGameOptions}" TargetType="ButtonEx">
                                                            <Setter Property="Content" Value="{DynamicResource LOCPlayGame}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}"
                                                                             Value="False">
                                                                    <!-- Hide button if not installed -->
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                                                                    <Setter Property="Content" Value="{DynamicResource LOCInstallGame}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.IsInstalling}" Value="True">
                                                                    <Setter Property="Content" Value="{DynamicResource LOCSetupRunning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.IsLaunching}" Value="True">
                                                                    <Setter Property="Content" Value="{DynamicResource LOCGameLaunching}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.IsRunning}" Value="True">
                                                                    <Setter Property="Content" Value="Now Playing" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.IsUninstalling}" Value="True">
                                                                    <Setter Property="Content" Value="{DynamicResource LOCUninstalling}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ButtonEx.Style>
                                                </ButtonEx>

                                            </Grid>

                                            <ButtonEx x:Name="DuplicateHiderVersionsButton"
                                                      Height="50"
                                                      Width="50"
                                                      Margin="0,0,10,0"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenDuplicateHiderVersionsWindowCommand}"
                                                      FocusVisualStyle="{x:Null}">

                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginStatus Plugin=felixkmh_DuplicateHider_Plugin, Status=Installed}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=HasDuplicateHiderVersions}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>

                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>

                                                <TextBlock Text="&#xF1CB;" FontSize="21" FontFamily="{DynamicResource FontIcons}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </ButtonEx>

                                            <ButtonEx x:Name="PlayniteAchievementButton"
                                                      Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenGameAchievementWindow}"
                                                      Height="50"
                                                      Width="50"
                                                      Margin="0,0,10,0"
                                                      Grid.Row="1"
                                                      Tag="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                                <ButtonEx.Triggers>
                                                    <EventTrigger RoutedEvent="ButtonBase.Click">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames
                                                                    Storyboard.TargetName="OpenViewSound"
                                                                    Storyboard.TargetProperty="LoadedBehavior">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ButtonEx.Triggers>
                                                <TextBlock Text="&#xedd7;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontFamily="{DynamicResource FontIcoFont}"/>
                                            </ButtonEx>


                                            <ButtonEx x:Name="DlcButton"
                                                      Height="50"
                                                      Width="50"
                                                      Margin="0,0,10,0"
                                                      Grid.Row="1"
                                                      Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[CheckDLCWindowStyle]}"
                                                      Tag="{PluginSettings Plugin=CheckDlc, Path=HasData, FallbackValue=False}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource GameOptionScaleStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
