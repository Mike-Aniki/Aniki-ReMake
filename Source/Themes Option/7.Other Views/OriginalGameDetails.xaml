                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="Margin" Value="-2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=TrailerPlay, Path=IsKeyboardFocusWithin}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="Margin" Value="-2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=Id, Path=Opacity}" Value="1">
