                                </ControlTemplate>

                                <Style x:Key="AchievementListItemContainerStyle" TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template" Value="{StaticResource AchievementListItemTemplate}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Style>

                                <Style x:Key="AchievementListBaseStyle" TargetType="ListView">
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Local"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>

                                <!-- CATEGORY SUMMARY LIST -->
                                <Style x:Key="CategorySummaryListItemContainerStyle" TargetType="ListViewItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <DataTemplate x:Key="CategorySummaryItemTemplate">
                                    <ButtonEx Height="160"
                                              Margin="0,3,0,20"
                                              Padding="0"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              FocusVisualStyle="{x:Null}"
                                              Command="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicAchievementsCategoryLabelFilterCommand}"
                                              CommandParameter="{Binding Name}">

                                        <ButtonEx.Template>
                                            <ControlTemplate TargetType="ButtonEx">
                                                <Grid>
                                                    <Border x:Name="CategoryMainBorder"
                                                            CornerRadius="18"
                                                            Background="{DynamicResource SuccessMainCardBackground}"
                                                            BorderBrush="#18FFFFFF"
                                                            BorderThickness="1.5"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Border x:Name="CategoryFocusOverlay"
                                                                    CornerRadius="18"
                                                                    Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                                    Opacity="0"
                                                                    IsHitTestVisible="False"/>

                                                            <Border CornerRadius="18"
                                                                    Background="{DynamicResource BackgroundItem}"
                                                                    Opacity="0.92"
                                                                    IsHitTestVisible="False"/>

                                                            <Grid Margin="14,12,18,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="290"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="190"/>
                                                                    <ColumnDefinition Width="280"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Bannière -->
                                                                <Border Grid.Column="0"
                                                                        Width="270"
                                                                        Height="120"
                                                                        Margin="6,0,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="10"
                                                                        Background="#25000000"
                                                                        ClipToBounds="True">
                                                                    <Image Source="{Binding CoverImagePath}"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1"
                                                                            Margin="10,0,28,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               HorizontalAlignment="Left"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="Wrap"
                                                                               MaxWidth="650">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessMainTextColorCardBrush}"/>
                                                                                <Setter Property="Opacity" Value="0.88"/>
                                                                                <Setter Property="FontSize" Value="26"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ButtonEx}}" Value="True">
                                                                                        <Setter Property="Opacity" Value="1"/>
                                                                                        <Setter Property="FontSize" Value="28"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <Border Background="{DynamicResource BadgeTrophÃ©eBrush}"
                                                                            Margin="0,10,0,0"
                                                                            Padding="14,4"
                                                                            CornerRadius="13"
                                                                            HorizontalAlignment="Left"
                                                                            BorderBrush="#18FFFFFF"
                                                                            BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding UnlockedCount}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="18"
                                                                                       FontWeight="SemiBold"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                            <TextBlock Text=" / "
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="18"
                                                                                       FontWeight="SemiBold"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                            <TextBlock Text="{Binding AchievementCount}"
                                                                                       Foreground="{DynamicResource SuccessMainTextColorBadgeBrush}"
                                                                                       FontSize="18"
                                                                                       FontWeight="SemiBold"
                                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                            Margin="0,0,28,0"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Image Source="{ThemeFile 'Images/platinum.png'}"
                                                                               Width="34"
                                                                               Height="34"
                                                                               Margin="0,0,8,0"
                                                                               VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding IsCompleted}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsBaseCategory}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                                                                   Foreground="{DynamicResource SuccessMainTextColorCardBrush}"
                                                                                   FontSize="24"
                                                                                   FontWeight="SemiBold"
                                                                                   VerticalAlignment="Center"
                                                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                    </StackPanel>

                                                                    <ProgressBar Value="{Binding Progress}"
                                                                                 Height="10"
                                                                                 Width="180"
                                                                                 Minimum="0"
                                                                                 Maximum="100"
                                                                                 Foreground="{DynamicResource ProgressLightBrush}"
                                                                                 Background="{DynamicResource ProgressBackgroundBrush}"
                                                                                 BorderBrush="Transparent"
                                                                                 Margin="0,8,0,0"
                                                                                 HorizontalAlignment="Right"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="3"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,14,0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                                                        <Image Source="{ThemeFile 'Images/Or.png'}" Width="34" Height="34" RenderOptions.BitmapScalingMode="Fant"/>
                                                                        <TextBlock Text="{Binding GoldCount}" Margin="6,0,0,0" MinWidth="24" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource SuccessMainTextColorCardBrush}" Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                                                        <Image Source="{ThemeFile 'Images/Argent.png'}" Width="34" Height="34" RenderOptions.BitmapScalingMode="Fant"/>
                                                                        <TextBlock Text="{Binding SilverCount}" Margin="6,0,0,0" MinWidth="24" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource SuccessMainTextColorCardBrush}" Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Source="{ThemeFile 'Images/Bronze.png'}" Width="34" Height="34" RenderOptions.BitmapScalingMode="Fant"/>
                                                                        <TextBlock Text="{Binding BronzeCount}" Margin="6,0,0,0" MinWidth="24" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource SuccessMainTextColorCardBrush}" Style="{DynamicResource TextBlockBaseStyle}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="CategoryMainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        <Setter TargetName="CategoryMainBorder" Property="BorderThickness" Value="2.5"/>
                                                        <Setter TargetName="CategoryFocusOverlay" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CategoryFocusOverlay" Property="Opacity" Value="0.65"/>
                                                        <Setter TargetName="CategoryMainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CategoryMainBorder" Property="Opacity" Value="0.80"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ButtonEx.Template>
                                    </ButtonEx>
                                </DataTemplate>

                            </Grid.Resources>

                            <!-- CATEGORY VIEW: visible only when the game has at least two category labels and no category is selected. -->
                            <Grid x:Name="CategorySummaryView">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasCategorySummaries}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsCategoryLabelFilterKey}" Value="All"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <TextBlock Margin="0,0,0,0"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Left"
                                           Text="{DynamicResource LOC_PA_Category}"
                                           FontSize="28"
                                           Style="{DynamicResource TextBlockBaseStyle}"/>

                                <Rectangle Fill="{DynamicResource TextBrush}" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0"/>

                                <ListView x:Name="DynamicCategorySummaryList"
                                          Margin="10,60,0,10"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FocusVisualStyle="{x:Null}"
                                          Focusable="True"
                                          pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                          KeyboardNavigation.DirectionalNavigation="Contained"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ItemContainerStyle="{StaticResource CategorySummaryListItemContainerStyle}"
                                          ItemTemplate="{StaticResource CategorySummaryItemTemplate}"
                                          ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicCategorySummaries}"/>
                            </Grid>

                            <!-- ACHIEVEMENT VIEW: direct for games without categories, or filtered after selecting a category. -->
                            <Grid x:Name="FilteredAchievementsView">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasCategorySummaries}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsCategoryLabelFilterKey}" Value="All"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">

                                    <TextBlock Text="{DynamicResource LOCSortby}" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20" />

                                    <TextBlock Text=" : " HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20"/>

                                    <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="20" >
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="Newest">
                                                        <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="Oldest">
                                                        <Setter Property="Text" Value="{DynamicResource LOCOldest}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="RarityAsc">
                                                        <Setter Property="Text" Value="{DynamicResource LOCRarityAsc}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="RarityDesc">
                                                        <Setter Property="Text" Value="{DynamicResource LOCRarityDesc}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophySort]}" Value="DefaultOrder">
                                                        <Setter Property="Text" Value="{DynamicResource LOCDefault}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text=" ● " VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="18"/>


                                    <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                               FontSize="20" >
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="All">
                                                        <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="Locked">
                                                        <Setter Property="Text" Value="{DynamicResource LOCLockedOnly}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrophyFilter]}" Value="Unlocked">
                                                        <Setter Property="Text" Value="{DynamicResource LOCUnlockedOnly}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>


                                <Rectangle Fill="{DynamicResource TextBrush}" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0" />

                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0">

                                    <CheckBoxEx x:Name="TrophiesMenuToggle"
                                                Content="&#xefb0;"
                                                pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                FontFamily="{DynamicResource FontIcoFont}"
                                                Command="{PluginSettings Plugin=AnikiHelper, Path=OpenChildWindow[AchievementsDetailsOptionsWindow]}"
                                                FontSize="22">
                                        <CheckBoxEx.Style>
                                            <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}">
                                                <Style.Triggers>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBoxEx.Style>
                                    </CheckBoxEx>

                                    <CheckBoxEx x:Name="BackToCategoryButton"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Command="{PluginSettings Plugin=PlayniteAchievements, Path=SetDynamicAchievementsCategoryLabelFilterCommand}"
                                                CommandParameter="All">
                                        <CheckBoxEx.Style>
                                            <Style TargetType="CheckBoxEx" BasedOn="{StaticResource CategorieBack}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasCategorySummaries}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsCategoryLabelFilterKey}" Value="All">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBoxEx.Style>
                                    </CheckBoxEx>

                                </StackPanel>

                                <!-- DYNAMIC ACHIEVEMENTS LIST -->
                                <ListView x:Name="DynamicAchievementList"
                                          Margin="10,60,0,10"
                                          ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                          ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievements}">
                                    <ListView.Style>
                                        <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </Style>
                                    </ListView.Style>
                                </ListView>

                            </Grid>

                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.4" RenderingBias="Performance"/>
                            </Grid.Effect>

                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" >
                            <TextBlock Text="{DynamicResource LocTotalTrophiesUnlocked}"  Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,5,10" />
                            <TextBlock Text=" : " Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,5,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,0,10" />
                            <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="2,50,2,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,0,10" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,0">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="A"
                                          Content="{DynamicResource LOCButtonPrompt_Select}" />

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="CancelAction"
                                          Content="{DynamicResource LOCBackLabel}" />
                            </StackPanel>


                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728">
                            <Setter Property="Margin" Value="-140,80,30,80" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- PlayniteAchivement Options Panel -->
    <Style x:Key="AchievementsDetailsOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">


                        <Border x:Name="TrophiesMenu"
                                Grid.RowSpan="2"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="0"
                                                  ShadowDepth="2"
                                                  BlurRadius="10"
                                                  Opacity="0.35" RenderingBias="Performance"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource BackgroundAHBrush}">

                                    <Border Background="#12000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- TITRE -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LOCTrophiesOptions}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- separator -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="#22FFFFFF"/>

                                <!-- CONTENT -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <!-- SECTION: Sorting (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx pbeh:FocusBahaviors.FocusBinding="True"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsSortKey, Mode=TwoWay}"
                                                    Margin="0,10,0,15"
                                                    Height="56">

                                            <ComboBoxItem Content="{DynamicResource LOCDefault}" Tag="Default"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Name}" Tag="Name"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_UnlockTime}" Tag="UnlockTime"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Rarity}" Tag="Rarity"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Status}" Tag="Status"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Progress}" Tag="Progress"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Trophy}" Tag="TrophyType"/>
                                            <ComboBoxItem Content="{DynamicResource LOC_PA_Category}" Tag="CategoryType"/>

                                        </ComboBoxEx>

                                        <TextBlock Text="{DynamicResource LOCDirection}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="20"
                                                   Opacity="0.70"
                                                   Margin="0,5,0,5"/>

                                        <ComboBoxEx Margin="0,5,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsSortDirectionOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsSortDirectionKey, Mode=TwoWay}" />

                                        <!-- SECTION: Show (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx Margin="0,10,0,15"
                                                    Height="56"
                                                    ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsFilterOptions}"
                                                    DisplayMemberPath="Label"
                                                    SelectedValuePath="Key"
                                                    SelectedValue="{PluginSettings Plugin=PlayniteAchievements, Path=DynamicAchievementsFilterKey, Mode=TwoWay}" />

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Hidden toggle (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCShowHiddenAchievements}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <CheckBoxEx x:Name="ShowHiddenToggle"
                                                        Content="{DynamicResource LOCShowHiddenAchievements}"
                                                        IsChecked="{PluginSettings Plugin=AnikiHelper, Path=Options[ShowHiddenAchievements], Mode=TwoWay}"/>
                                        </StackPanel>

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Refresh (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCRefreshTrophies}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,20,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <ButtonEx Height="50"
                                                      HorizontalContentAlignment="Stretch"
                                                      Content="{DynamicResource LOCRefreshTrophies}"
                                                      Command="{PluginSettings Plugin=PlayniteAchievements, Path=SingleGameRefreshCommand}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Grid.Column="0"
                                                  Tag="Dpad"
                                                  Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                      Tag="A"
                                                      Content="{DynamicResource LOCButtonPrompt_Select}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--DLC-->
    <Style x:Key="CheckDLCWindowStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25"/>

                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="24"
                                                         To="0"
                                                         Duration="0:0:0.35">

                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="125"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>

                        <!-- ================================================= -->
                        <!-- BACKGROUND -->
                        <!-- ================================================= -->

                        <Border Grid.RowSpan="3"
                                IsHitTestVisible="False">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">

                                    <GradientStop Color="#10000000"
                                                  Offset="0"/>

                                    <GradientStop Color="#00000000"
                                                  Offset="0.35"/>

                                    <GradientStop Color="#30000000"
                                                  Offset="1"/>

                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Decorative upper glow -->
                        <Border Grid.RowSpan="2"
                                Height="460"
                                VerticalAlignment="Top"
                                Opacity="0.12"
                                IsHitTestVisible="False">

                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0"
                                                     GradientOrigin="0.5,0"
                                                     RadiusX="0.65"
                                                     RadiusY="0.8">

                                    <GradientStop Color="#FFFFFFFF"
                                                  Offset="0"/>

                                    <GradientStop Color="#00FFFFFF"
                                                  Offset="1"/>

                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- ================================================= -->
                        <!-- HEADER -->
                        <!-- ================================================= -->

                        <Border Grid.Row="0"
                                Height="90"
                                Margin="80,24,80,0"
                                VerticalAlignment="Top"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{DynamicResource HeaderMenu}"
                                BorderBrush="{DynamicResource BorderListNewsBrush}"
                                BorderThickness="1">

                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="5"
                                                  BlurRadius="18"
                                                  Direction="90"
                                                  Opacity="0.4"
                                                  Color="Black"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1"
                                      Margin="28,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{DynamicResource LOCDownloadableContent}"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                                        <TextBlock Text="{DynamicResource LOCDLCList}"
                                                   Margin="1,3,0,0"
                                                   FontSize="17"
                                                   Opacity="0.65"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                                    </StackPanel>

                                    <!-- DLC counter -->
                                    <Border Grid.Column="1"
                                            MinWidth="100"
                                            Padding="18,9"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource CardNewsBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardNewsBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="{Binding ElementName=ListDlcAll,
                                                       Path=Items.Count}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                            <TextBlock Text=" DLC"
                                                       Margin="3,0,0,0"
                                                       FontSize="16"
                                                       Opacity="0.7"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ================================================= -->
                        <!-- MAIN CONTENT -->
                        <!-- ================================================= -->

                        <Grid Grid.Row="1"
                              Margin="80,20,80,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="700"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ============================================= -->
                            <!-- LEFT PANEL : DLC LIST -->
                            <!-- ============================================= -->

                            <Border Grid.Column="0"
                                    CornerRadius="{DynamicResource Corner}">

                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="5"
                                                      BlurRadius="18"
                                                      Direction="90"
                                                      Opacity="0.45"
                                                      Color="Black"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>

                                <Border.Style>
                                    <Style TargetType="Border">

                                        <Setter Property="Background"
                                                Value="{DynamicResource BackgroundListNewsBrush}"/>

                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource BorderListNewsBrush}"/>

                                        <Setter Property="BorderThickness"
                                                Value="1"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ElementName=ListDlcAll,
                                                         Path=IsKeyboardFocusWithin}"
                                                         Value="True">

                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource FocusBorderListNews}"/>

                                                <Setter Property="BorderThickness"
                                                        Value="3"/>

                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="64"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List title -->
                                    <Border Grid.Row="0"
                                            CornerRadius="{DynamicResource Corner}"
                                            Background="{DynamicResource HeaderMenu}">

                                        <Grid Margin="22,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCDLCList}"
                                                       FontSize="25"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                            <Border Grid.Column="1"
                                                    Padding="12,5"
                                                    VerticalAlignment="Center"
                                                    Background="#22000000"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="14">

                                                <TextBlock Text="{Binding ElementName=ListDlcAll,
                                                           Path=Items.Count,
                                                           StringFormat={}{0} DLC}"
                                                           FontSize="15"
                                                           Opacity="0.8"
                                                           Style="{DynamicResource TextBlockBaseStyle}"/>

                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- DLC list -->
                                    <ListView x:Name="ListDlcAll"
                                              Grid.Row="1"
                                              Margin="12"
                                              ItemsSource="{PluginSettings Plugin=CheckDlc, Path=ListDlcs}"
                                              SelectedIndex="-1"
                                              IsSynchronizedWithCurrentItem="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              BorderBrush="Transparent"
                                              FocusVisualStyle="{x:Null}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="False"
                                              VirtualizingPanel.IsVirtualizing="False"
                                              HorizontalContentAlignment="Stretch"
                                              KeyboardNavigation.DirectionalNavigation="Continue"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              pbeh:FocusBahaviors.FocusBinding="True"
                                              pbeh:FocusBahaviors.OnVisibilityFocus="True">

                                        <ListView.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <Int32AnimationUsingKeyFrames Storyboard.TargetProperty="SelectedIndex">

                                                            <DiscreteInt32KeyFrame KeyTime="0:0:0.05"
                                                                                   Value="0"/>

                                                        </Int32AnimationUsingKeyFrames>

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ListView.Triggers>

                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <!-- List item container -->
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">

                                                <Setter Property="Focusable"
                                                        Value="True"/>

                                                <Setter Property="FocusVisualStyle"
                                                        Value="{x:Null}"/>

                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Stretch"/>

                                                <Setter Property="Margin"
                                                        Value="0,0,0,12"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="ListViewItem">

                                                            <Grid>

                                                                <Border x:Name="CardBorder"
                                                                        Background="{DynamicResource CardNewsBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource CardNewsBorderBrush}"
                                                                        BorderThickness="2"
                                                                        CornerRadius="{DynamicResource Corner}">

                                                                    <Border.Effect>
                                                                        <DropShadowEffect ShadowDepth="0"
                                                                                          BlurRadius="8"
                                                                                          Opacity="0.22"
                                                                                          Color="Black"
                                                                                          RenderingBias="Performance"/>
                                                                    </Border.Effect>

                                                                    <ContentPresenter/>

                                                                </Border>

                                                                <!-- Focus accent -->
                                                                <Border x:Name="FocusAccent"
                                                                        Width="5"
                                                                        Margin="0,16,0,16"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource FocusCardNewsBorder}"
                                                                        CornerRadius="0,4,4,0"
                                                                        Opacity="0"/>

                                                            </Grid>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsKeyboardFocusWithin"
                                                                         Value="True">

                                                                    <Setter TargetName="CardBorder"
                                                                            Property="BorderBrush"
                                                                            Value="{DynamicResource FocusCardNewsBorder}"/>

                                                                    <Setter TargetName="CardBorder"
                                                                            Property="Background"
                                                                            Value="{DynamicResource FocusCardNewsBackgroundBrush}"/>

                                                                    <Setter TargetName="CardBorder"
                                                                            Property="BorderThickness"
                                                                            Value="3"/>

                                                                    <Setter TargetName="FocusAccent"
                                                                            Property="Opacity"
                                                                            Value="1"/>

                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>

                                            </Style>
                                        </ListView.ItemContainerStyle>

                                        <!-- DLC card -->
                                        <ListView.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Height="126"
                                                      Margin="14,10">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- DLC image -->
                                                    <Border Grid.Column="0"
                                                            CornerRadius="{DynamicResource Corner}"
                                                            Background="#16000000"
                                                            BorderBrush="#22000000"
                                                            BorderThickness="1"
                                                            ClipToBounds="True">

                                                        <Grid Background="#12000000">

                                                            <Image Source="{Binding Image}"
                                                                   Margin="8"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        </Grid>
                                                    </Border>

                                                    <!-- DLC information -->
                                                    <Grid Grid.Column="2"
                                                          Margin="0,3">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="19"
                                                                   FontWeight="SemiBold"
                                                                   MaxHeight="50"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        <Grid Grid.Row="2">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Status badges -->
                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Bottom">

                                                                <!-- Owned -->
                                                                <Border Padding="10,4"
                                                                        Margin="0,0,7,0"
                                                                        Background="#5536B36B"
                                                                        CornerRadius="12">

                                                                    <Border.Style>
                                                                        <Style TargetType="Border">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding IsOwned}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <TextBlock Text="{DynamicResource LOCCheckDlcOwned}"
                                                                               FontSize="14"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"/>

                                                                </Border>

                                                                <!-- Free -->
                                                                <Border Padding="10,4"
                                                                        Margin="0,0,7,0"
                                                                        Background="#553A86FF"
                                                                        CornerRadius="12">

                                                                    <Border.Style>
                                                                        <Style TargetType="Border">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding IsFree}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding IsOwned}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <TextBlock Text="{DynamicResource LOCCheckDlcFree}"
                                                                               FontSize="14"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"/>

                                                                </Border>

                                                                <!-- Discount -->
                                                                <Border Padding="10,4"
                                                                        Background="#55C48B18"
                                                                        CornerRadius="12">

                                                                    <Border.Style>
                                                                        <Style TargetType="Border">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding IsDiscount}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding PriceBase}"
                                                                                             Value="">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding IsOwned}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <TextBlock Text="{DynamicResource LOCDiscount}"
                                                                               FontSize="14"
                                                                               Style="{DynamicResource TextBlockBaseStyle}"/>

                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Price -->
                                                            <StackPanel Grid.Column="1"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Bottom">

                                                                <TextBlock HorizontalAlignment="Right"
                                                                           FontSize="23"
                                                                           FontWeight="SemiBold">

                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock"
                                                                               BasedOn="{StaticResource TextBlockBaseStyle}">

                                                                            <Setter Property="Text"
                                                                                    Value="{Binding Price}"/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding Price}"
                                                                                             Value="0">

                                                                                    <Setter Property="Text"
                                                                                            Value=""/>

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding Price}"
                                                                                             Value="">

                                                                                    <Setter Property="Text"
                                                                                            Value=""/>

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding IsOwned}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>

                                                                </TextBlock>

                                                                <TextBlock Margin="0,2,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="14"
                                                                           Opacity="0.65"
                                                                           TextDecorations="Strikethrough">

                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock"
                                                                               BasedOn="{StaticResource TextBlockBaseStyle}">

                                                                            <Setter Property="Text"
                                                                                    Value="{Binding PriceBase}"/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger Binding="{Binding IsDiscount}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible"/>

                                                                                    <Setter Property="Text"
                                                                                            Value="{Binding PriceBase}"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding IsDiscount}"
                                                                                             Value="False">

                                                                                    <Setter Property="Text"
                                                                                            Value=""/>

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding PriceBase}"
                                                                                             Value="">

                                                                                    <Setter Property="Text"
                                                                                            Value=""/>

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                                <DataTrigger Binding="{Binding IsOwned}"
                                                                                             Value="True">

                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>

                                                                </TextBlock>
                                                            </StackPanel>

                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>

                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- ============================================= -->
                            <!-- RIGHT PANEL : DLC DETAILS -->
                            <!-- ============================================= -->

                            <Border Grid.Column="2"
                                    CornerRadius="{DynamicResource Corner}"
                                    DataContext="{Binding SelectedItem, ElementName=ListDlcAll}">

                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="5"
                                                      BlurRadius="18"
                                                      Direction="90"
                                                      Opacity="0.45"
                                                      Color="Black"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>

                                <Border.Style>
                                    <Style TargetType="Border">

                                        <Setter Property="Background"
                                                Value="{DynamicResource BackgroundListNewsBrush}"/>

                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource BorderListNewsBrush}"/>

                                        <Setter Property="BorderThickness"
                                                Value="1"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ElementName=DlcDescContentScroll,
                                                         Path=IsKeyboardFocusWithin}"
                                                         Value="True">

                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource FocusBorderListNews}"/>

                                                <Setter Property="BorderThickness"
                                                        Value="3"/>

                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="64"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Detail header -->
                                    <Border Grid.Row="0"
                                            CornerRadius="{DynamicResource Corner}"
                                            Background="{DynamicResource HeaderMenu}">

                                        <Grid Margin="24,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCDownloadableContent}"
                                                       FontSize="25"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                            <Border Grid.Column="1"
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource FocusBorderListNews}"
                                                    CornerRadius="4"/>

                                        </Grid>
                                    </Border>

                                    <!-- Details body -->
                                    <Grid Grid.Row="1"
                                          Margin="26,24,26,22">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="285"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top details -->
                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Large DLC image -->
                                            <Border Grid.Column="0"
                                                    CornerRadius="{DynamicResource Corner}"
                                                    Background="#16000000"
                                                    BorderBrush="#22000000"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">

                                                <Grid Background="#12000000">

                                                    <Image Source="{Binding Image}"
                                                           Margin="12"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                </Grid>
                                            </Border>

                                            <!-- Information -->
                                            <Grid Grid.Column="2">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Name -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Name}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           MaxHeight="125"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource TextBlockBaseStyle}"/>

                                                <!-- Status and price -->
                                                <Grid Grid.Row="2"
                                                      Margin="0,18,0,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Large badges -->
                                                    <WrapPanel Grid.Column="0"
                                                               VerticalAlignment="Bottom">

                                                        <!-- Owned -->
                                                        <Border Padding="14,7"
                                                                Margin="0,0,9,0"
                                                                Background="#5536B36B"
                                                                CornerRadius="15">

                                                            <Border.Style>
                                                                <Style TargetType="Border">

                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsOwned}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <TextBlock Text="{DynamicResource LOCCheckDlcOwned}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        </Border>

                                                        <!-- Free -->
                                                        <Border Padding="14,7"
                                                                Margin="0,0,9,0"
                                                                Background="#553A86FF"
                                                                CornerRadius="15">

                                                            <Border.Style>
                                                                <Style TargetType="Border">

                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsFree}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsOwned}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <TextBlock Text="{DynamicResource LOCCheckDlcFree}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        </Border>

                                                        <!-- Discount -->
                                                        <Border Padding="14,7"
                                                                Background="#55C48B18"
                                                                CornerRadius="15">

                                                            <Border.Style>
                                                                <Style TargetType="Border">

                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsDiscount}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding PriceBase}"
                                                                                     Value="">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsOwned}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <TextBlock Text="{DynamicResource LOCDiscount}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        </Border>

                                                    </WrapPanel>

                                                    <!-- Large price -->
                                                    <StackPanel Grid.Column="1"
                                                                Margin="20,0,0,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom">

                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="38"
                                                                   FontWeight="SemiBold">

                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource TextBlockBaseStyle}">

                                                                    <Setter Property="Text"
                                                                            Value="{Binding Price}"/>

                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding Price}"
                                                                                     Value="0">

                                                                            <Setter Property="Text"
                                                                                    Value=""/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding Price}"
                                                                                     Value="">

                                                                            <Setter Property="Text"
                                                                                    Value=""/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsOwned}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>

                                                        </TextBlock>

                                                        <TextBlock Margin="0,3,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="20"
                                                                   Opacity="0.65"
                                                                   TextDecorations="Strikethrough">

                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource TextBlockBaseStyle}">

                                                                    <Setter Property="Text"
                                                                            Value="{Binding PriceBase}"/>

                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsDiscount}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>

                                                                            <Setter Property="Text"
                                                                                    Value="{Binding PriceBase}"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsDiscount}"
                                                                                     Value="False">

                                                                            <Setter Property="Text"
                                                                                    Value=""/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding PriceBase}"
                                                                                     Value="">

                                                                            <Setter Property="Text"
                                                                                    Value=""/>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsOwned}"
                                                                                     Value="True">

                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>

                                                        </TextBlock>
                                                    </StackPanel>

                                                </Grid>
                                            </Grid>
                                        </Grid>

                                        <!-- Separator -->
                                        <Rectangle Grid.Row="1"
                                                   Height="1"
                                                   Fill="{DynamicResource SeparatorBrush}"
                                                   Opacity="0.45"/>

                                        <!-- DLC description -->
                                        <Border Grid.Row="3"
                                                x:Name="BorderNews"
                                                Focusable="False"
                                                CornerRadius="12"
                                                HorizontalAlignment="Stretch">

                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,1"
                                                                     EndPoint="0,0">

                                                    <GradientStop Color="#00FFFFFF"
                                                                  Offset="0"/>

                                                    <GradientStop Color="#FF000000"
                                                                  Offset="0.22"/>

                                                </LinearGradientBrush>
                                            </Border.OpacityMask>

                                            <ScrollViewerEx x:Name="DlcDescContentScroll"
                                                            Focusable="True"
                                                            IsTabStop="True"
                                                            FocusVisualStyle="{x:Null}"
                                                            PanningMode="VerticalOnly"
                                                            ScrollViewer.CanContentScroll="False"
                                                            VerticalScrollBarVisibility="Auto">

                                                <HtmlTextView x:Name="DlcDescription"
                                                              HtmlText="{Binding Description}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColorNewsDesc}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              HtmlFontSize="20"
                                                              Focusable="False"
                                                              IsTabStop="False"/>

                                            </ScrollViewerEx>
                                        </Border>

                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================= -->
                        <!-- BOTTOM CONTROLLER BAR -->
                        <!-- ================================================= -->

                        <Grid Grid.Row="2"
                              Height="80"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">

                            <Border Height="1"
                                    VerticalAlignment="Top"
                                    Margin="80,0"
                                    Background="{DynamicResource SeparatorBrush}"
                                    Opacity="0.25"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,28,0"
                                        Effect="{DynamicResource SoftTextShadow}">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}"/>

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="CancelAction"
                                          Command="{Binding CloseCommand}"
                                          Content="{DynamicResource LOCBackLabel}"/>

                            </StackPanel>
                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost,
                                     Path=ActualWidth}"
                                     Value="1728">

                            <Setter Property="Margin"
                                    Value="-140,80,30,80"/>

                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}"
                         Value="dsp1610">

                <Setter Property="Margin"
                        Value="0,-60,0,-60"/>

            </DataTrigger>

            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=AspectRatio}"
                         Value="dsp219">

                <Setter Property="Margin"
                        Value="-320,0,-320,0"/>

            </DataTrigger>

        </Style.Triggers>
    </Style>

    <Style x:Key="DuplicateHiderVersionsWindowStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">

                    <Grid KeyboardNavigation.TabNavigation="Contained"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.ControlTabNavigation="Contained">

                        <Grid.Resources>

                            <!-- Button style local pour les lignes DuplicateHider -->
                            <Style x:Key="DuplicateHiderVersionButtonStyle"
                                   BasedOn="{StaticResource {x:Type ButtonEx}}"
                                   TargetType="ButtonEx">

                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Height" Value="70"/>
                                <Setter Property="Width" Value="560"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="{TemplateBinding Background}">

                                                <Border x:Name="MainBackground"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        Visibility="Collapsed"
                                                        Background="{DynamicResource ButtonBackgroundFocus}"/>

                                                <Border x:Name="MainBorder"
                                                        Margin="0"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                        BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                                        BorderThickness="3"
                                                        CornerRadius="{DynamicResource Corner}"
                                                        Visibility="Collapsed"/>

                                                <!-- Important : ContentPresenter direct, pas dans un TextBlock -->
                                                <ContentPresenter Margin="22,0"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  RecognizesAccessKey="True"/>

                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" TargetName="MainBorder"/>
                                                    <Setter Property="Visibility" Value="Visible" TargetName="MainBackground"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" TargetName="MainBorder"/>
                                                    <Setter Property="Visibility" Value="Visible" TargetName="MainBackground"/>
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <!-- La version actuelle reste visible mais pas sélectionnable -->
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Badge Current -->
                            <Style x:Key="DuplicateHiderCurrentBadgeStyle" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="CornerRadius" Value="15"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                        </Grid.Resources>

                        <!-- Fond assombri -->
                        <Border Background="{DynamicResource SecondaryViewBackground}"
                                Opacity="0.34"/>

                        <Border Width="760"
                                MaxHeight="520"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="26"
                                CornerRadius="{DynamicResource Corner}"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="2">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Select game version"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,28"/>

                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{PluginSettings Plugin=AnikiHelper, Path=DuplicateHiderGameVersions}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              HorizontalAlignment="Center">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <ButtonEx Style="{StaticResource DuplicateHiderVersionButtonStyle}"
                                                      Command="{Binding SelectCommand}"
                                                      Tag="{Binding GameId}">

                                                <!-- 3 colonnes :
                                                gauche = espace fantôme
                                                centre = icône + label vraiment centré
                                                droite = badge Current -->
                                                <Grid HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="125"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="125"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Centre réel du bouton -->
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">

                                                        <Image Source="{Binding Icon}"
                                                               Width="30"
                                                               Height="30"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,16,0"
                                                               RenderOptions.BitmapScalingMode="Fant"/>

                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   MaxWidth="260"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Badge à droite, dans sa propre colonne -->
                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource DuplicateHiderCurrentBadgeStyle}">

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">

                                                            <TextBlock Text="✓"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>

                                                            <TextBlock Text="Current"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                </Grid>
                                            </ButtonEx>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,22,0,0">

                                    <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                              Tag="CancelAction"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=CloseTopWindowCommand}"
                                              Content="{DynamicResource LOCBackLabel}"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>