                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>

                                                            <!-- PA priority -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- Contenu PA (mêmes images) -->
                                                <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                                                    <Image Source="{ThemeFile 'Images/platinum.png'}" RenderOptions.BitmapScalingMode="Fant" />
                                                </Border>
                                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDetailStyle}">
                                                            <Setter Property="Text" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                                                    <Setter Property="Text" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                                                    <Image Source="{ThemeFile 'Images/Or.png'}" RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border>
                                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                                           Text="{PluginSettings Plugin=PlayniteAchievements, Path=RareAndUltraRare.Unlocked, StringFormat={}{0}}"
                                                           Style="{StaticResource TextBlockDetailStyle}" FontSize="20"/>

                                                <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                                                    <Image Height="55" Source="{ThemeFile 'Images/Argent.png'}" RenderOptions.BitmapScalingMode="Fant"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                                           Text="{PluginSettings Plugin=PlayniteAchievements, Path=Uncommon.Unlocked, StringFormat={}{0}}"
                                                           Style="{StaticResource TextBlockDetailStyle}" FontSize="20"/>

                                                <Border Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" ClipToBounds="True">
                                                    <Image Source="{ThemeFile 'Images/Bronze.png'}" RenderOptions.BitmapScalingMode="Fant"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                                           Text="{PluginSettings Plugin=PlayniteAchievements, Path=Common.Unlocked, StringFormat={}{0}}"
                                                           Style="{StaticResource TextBlockDetailStyle}" FontSize="20"/>

                                                <StackPanel.Effect>
                                                    <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="2"
                                                                      RenderingBias="Performance" Opacity="0.8"/>
                                                </StackPanel.Effect>
                                            </StackPanel>

                                        </Grid>

                                        <!-- Logo -->
                                        <Grid HorizontalAlignment="Center" Grid.Column="1">
                                            <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" CacheMode="BitmapCache">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="MaxWidth" Value="500"/>
                                                        <Setter Property="MaxHeight" Value="80"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Margin" Value="0,5,0,5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoLogo]}" Value="True">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,0"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoLogo]}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Image de Source -->
                                        <Border x:Name="SourceIconBorder" HorizontalAlignment="Left" Margin="20,0,0,0" Grid.Column="0" Opacity="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoSource]}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image x:Name="SourceIcons" Source="{ThemeFileBinding Source.Name, PathFormat='Icons/Source/{0}.png'}"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxHeight="70"
                                                       MaxWidth="180"
                                                       Margin="0,0,40,0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image x:Name="PlateformIcons" Source="{ThemeFileBinding Platforms[0].Name, PathFormat='Icons/Source/{0}.png'}"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxHeight="70"
                                                       MaxWidth="180"
                                                       Margin="0,0,40,0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=SourceIcons, Path=Source}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="0"
                                Height="1000" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Panel.ZIndex="-45"
                                Opacity="0.2"
                                Grid.RowSpan="5"
                                Grid.ColumnSpan="5">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <!-- 0% → totalement opaque -->
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>

                                    <!-- 70% → encore opaque (départ du fade) -->
                                    <GradientStop Color="#FFFFFFFF" Offset="0.30"/>

                                    <!-- 100% → totalement transparent -->
                                    <GradientStop Color="#00FFFFFF" Offset="0.60"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>

                            <FadeImage Source="{Binding Game.BackgroundImage}"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       Visibility="Visible">
                                <FadeImage.Style>
                                    <Style TargetType="FadeImage">
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[SteamBanner]}" Value="True">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </FadeImage.Style>
                            </FadeImage>

                        </Border>

                        <!--Grid Panel Details-->

                        <Grid x:Name="GameDetailsThreeColumnsLayout"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="35,30,35,0"
                              Panel.ZIndex="5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="400"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="290"/>
                            </Grid.RowDefinitions>

                            <!-- ===================== -->
                            <!-- LEFT COLUMN - BUTTONS -->
                            <!-- ===================== -->

                            <Border Grid.Column="0"
                                    Grid.RowSpan="2"
                                    Margin="0,0,20,0"
                                    Padding="18,20,18,20"
                                    CornerRadius="18"
                                    Background="{DynamicResource ListBackgroundBrush}"
                                    BorderBrush="{DynamicResource ListBorder}"
                                    BorderThickness="1">



                                <StackPanel x:Name="LeftButtonsColumn"
                                            Orientation="Vertical">



                                    <Grid x:Name="MainButton" Height="62" MinWidth="210" Margin="0,0,0,14" HorizontalAlignment="Stretch">


                                        <!-- Keep old button for graceful fallback to vanilla as needed -->
                                        <ButtonEx x:Name="PART_ButtonContext"
                                                  Height="62"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center">
                                            <ButtonEx.Style>
                                                <Style BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}" TargetType="ButtonEx">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}"
                                                            Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>
                                        <!-- Custom button that has one command but can change button text as needed -->
                                        <ButtonEx x:Name="NowPlayingButton"
                                                  Height="62"
                                                  HorizontalContentAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Command="{PluginSettings Plugin=NowPlaying,
                                                  Path=InstallOrPlayOrOpenDialog}">
                                            <ButtonEx.Style>
                                                <Style BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}" TargetType="ButtonEx">
                                                    <Setter Property="Content" Value="{DynamicResource LOCPlayGame}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}"
                                                                     Value="False">
                                                            <!-- Hide button if not installed -->
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                                                            <Setter Property="Content" Value="{DynamicResource LOCInstallGame}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.IsInstalling}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource LOCSetupRunning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.IsLaunching}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource LOCGameLaunching}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.IsRunning}" Value="True">
                                                            <Setter Property="Content" Value="Now Playing" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.IsUninstalling}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource LOCUninstalling}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                        </ButtonEx>

                                    </Grid>

                                    <ButtonEx x:Name="SuccessButton"
                                              Command="{PluginSettings Plugin=SSHelper, Path=OpenGameAchievementWindow}"
                                              Content="SuccessStory"
                                              Height="62"
                                              MinWidth="210"
                                              Margin="0,0,0,14"
                                              Tag="{PluginSettings Plugin=SuccessStory, Path=HasData, FallbackValue=False}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginStatus Plugin=playnite-successstory-plugin, Status=Installed}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=SuccessStory, Path=HasData, FallbackValue=False}" Value="True"/>
                                                            <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                    </ButtonEx>

                                    <ButtonEx x:Name="PlayniteAchievementButton"
                                              Content="Achievements"
                                              Height="62"
                                              MinWidth="210"
                                              Margin="0,0,0,14"
                                              Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenGameAchievementWindow}"
                                              Tag="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                    </ButtonEx>

                                    <ButtonEx x:Name="DlcButton"
                                              Height="62"
                                              MinWidth="210"
                                              Margin="0,0,0,14"
                                              Content="DLC"
                                              Command="{PluginSettings Plugin=ThemeOptions, Path=OpenWindow[CheckDLCWindowStyle]}"
                                              Tag="{PluginSettings Plugin=CheckDlc, Path=HasData, FallbackValue=False}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                    </ButtonEx>

                                    <ButtonEx x:Name="ScreenshotsButton"
                                              Height="62"
                                              MinWidth="210"
                                              Margin="0,0,0,14"
                                              Content="Screenshots"
                                              Command="{PluginSettings Plugin=AnikiHelper, Path=OpenWindow[ScreenShotsThumbsWindowStyle]}"
                                              Tag="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=False}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource GameDetailsGameOptionsButtonAlt}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                    </ButtonEx>

                                    <CheckBoxEx x:Name="TrailerPlay"
                                                Height="62"
                                                MinWidth="210"
                                                Margin="0,0,0,14"
                                                Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPlayCommand}">
                                        <CheckBoxEx.Style>
                                            <Style TargetType="CheckBoxEx" BasedOn="{StaticResource CheckBoxAlt}">
                                                <Setter Property="Content" Value="Play Trailer"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="{StaticResource True}">
                                                        <Setter Property="Content" Value="Stop Trailer"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.ControlVisibility}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBoxEx.Style>
                                    </CheckBoxEx>

                                    <CheckBoxEx x:Name="TrailerMute"
                                                Height="62"
                                                MinWidth="210"
                                                Margin="0,0,0,14"
                                                Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoMuteCommand}"
                                                FocusVisualStyle="{x:Null}">
                                        <CheckBoxEx.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxAlt}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Content" Value="Mute Trailer" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted}" Value="True">
                                                        <Setter Property="Content" Value="Play sound trailer" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.ControlVisibility}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBoxEx.Style>
                                    </CheckBoxEx>

