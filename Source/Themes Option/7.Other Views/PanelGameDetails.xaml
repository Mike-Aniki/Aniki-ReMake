                                                MinWidth="210"
                                                Margin="0,0,0,14"
                                                FocusVisualStyle="{x:Null}">
                                        <CheckBoxEx.Style>
                                            <Style TargetType="CheckBoxEx" BasedOn="{StaticResource CheckBoxAlt}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsChecked" Value="False"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=ScreenshotUtilities, Path=CurrentScreenshotGroups.ScreenshotCount}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{PluginStatus Plugin=ScreenshotUtilities_485d682f-73e9-4d54-b16f-b8dd49e88f90, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBoxEx.Style>
                                        <CheckBoxEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </CheckBoxEx.Triggers>
                                    </CheckBoxEx>

                                    <ButtonEx x:Name="PART_ButtonOptions"
                                              Height="62"
                                              MinWidth="210"
                                              Content="Options"
                                              Style="{StaticResource GameDetailsGameOptionsButtonAlt}"
                                              Margin="0,0,0,14">
                                        <ButtonEx.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="OpenViewSound"
                                                            Storyboard.TargetProperty="LoadedBehavior">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static MediaState.Stop}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static MediaState.Play}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ButtonEx.Triggers>
                                    </ButtonEx>





                                </StackPanel>
                            </Border>

                            <!-- =============================== -->
                            <!-- CENTER COLUMN - SINGLE PANEL    -->
                            <!-- =============================== -->

                            <Border Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Margin="0,0,20,0"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Effect="{DynamicResource SoftTextShadow}"
                                    ClipToBounds="True">


                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition>
                                            <RowDefinition.Style>
                                                <Style TargetType="RowDefinition">
                                                    <Setter Property="Height" Value="580"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}"
                                                                     Value="dsp1610">
                                                            <Setter Property="Height" Value="470"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RowDefinition.Style>
                                        </RowDefinition>

                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- ===================== -->
                                    <!-- TOP VISUAL AREA       -->
                                    <!-- ===================== -->
                                    <Border Background="#16000000"
                                            CornerRadius="18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ListDetailsBorder}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Grid.Row="0">

                                            <!-- full video mask/border -->
                                            <Border x:Name="HeroRoundedMask"
                                                    CornerRadius="18"
                                                    Background="Black"
                                                    BorderBrush="{DynamicResource NoFocusBorderButtonBrush}"
                                                    BorderThickness="0"
                                                    IsHitTestVisible="False"/>



                                            <!-- IMAGE BACKGROUND -->
                                            <FadeImage x:Name="HeroBackgroundImage"
                                                       Source="{Binding Game.BackgroundImage}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="Fant" >
                                                <FadeImage.Style>
                                                    <Style TargetType="FadeImage">
                                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <VisualBrush Visual="{Binding ElementName=HeroRoundedMask}" Stretch="Fill"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[SteamBanner]}" Value="True">
                                                                <Setter Property="Stretch" Value="Uniform"/>
                                                            </DataTrigger>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="{StaticResource True}"/>
                                                                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrailerOnDetailsView]}" Value="True"/>
                                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Visibility}" Value="Visible"/>
                                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Visibility}" Value="Visible"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </FadeImage.Style>
                                            </FadeImage>

                                            <!-- FULL BACKGROUND TRAILER -->
                                            <Grid x:Name="TrailerContainer"
                                                  FocusVisualStyle="{x:Null}"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Grid.RenderTransform>
                                                <Grid.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=HeroRoundedMask}"
                                                                 Stretch="Fill"/>
                                                </Grid.OpacityMask>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>

                                                            <!-- Auto trailer ON -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrailerOnDetailsView]}" Value="True"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True"/>
                                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                                </MultiDataTrigger.Conditions>

                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0"
                                                                                             To="1"
                                                                                             BeginTime="0:0:1.2"
                                                                                             Duration="0:0:0.8">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1"
                                                                                             To="0"
                                                                                             Duration="0:0:0">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.ExitActions>

                                                            </MultiDataTrigger>

                                                            <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="{StaticResource False}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>



                                                            <!-- Hide trailer if window inactive -->
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <ContentControl x:Name="Sounds_MusicControl"
                                                                Visibility="Collapsed"/>

                                                <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrailerOnDetailsView]}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True"/>
                                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>

                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>



                                                <!-- media buttons over full trailer -->
                                                <StackPanel x:Name="MediaButtons"
                                                            FocusVisualStyle="{x:Null}"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Vertical"
                                                            Margin="0,0,0,0">

                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <CheckBoxEx x:Name="TrailerZoom"
                                                                    Grid.Row="0"
                                                                    IsChecked="{StaticResource MiniTrailer}"
                                                                    Width="50"
                                                                    Visibility="Collapsed"
                                                                    Focusable="False"
                                                                    Margin="15,15,30,0"
                                                                    Style="{DynamicResource TrailerZoomToggle}" />



                                                        <CheckBoxEx x:Name="TrailerMuteZoom"
                                                                    Grid.Row="2"
                                                                    Width="50"
                                                                    Margin="15,15,30,0"
                                                                    Visibility="Collapsed"
                                                                    Focusable="False"
                                                                    Style="{DynamicResource TrailerMuteZoomToggle}"
                                                                    Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoMuteCommand}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Time Trailer -->
                                                <StackPanel VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,15,8"
                                                            Opacity="0.80"
                                                            Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.ControlVisibility}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.ControlVisibility}" Value="Hidden">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowTrailerTime]}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.PlaybackTimeProgress}"
                                                               FontSize="18"
                                                               Foreground="White"
                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                    <TextBlock Text=" / "
                                                               Foreground="White"
                                                               FontSize="18"
                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                    <TextBlock Text="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.PlaybackTimeTotal}"
                                                               FontSize="18"
                                                               Foreground="White"
                                                               Style="{DynamicResource TextBlockBaseStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                    <!-- ===================== -->
                                    <!-- BOTTOM DESCRIPTION    -->
                                    <!-- ===================== -->
                                    <Border Margin="0,10,0,0"
                                            Background="{DynamicResource ListDetailsBackgroundBrush}"
                                            CornerRadius="18"
                                            Grid.Row="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ListDetailsBorder}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="24,10,24,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>



                                            <TextBlock Grid.Row="0"
                                                       Text="Description"
                                                       Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.95"/>

                                            <ScrollViewerEx Grid.Row="2"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            FocusVisualStyle="{x:Null}">

                                                <HtmlTextView HtmlText="{Binding Description}"
                                                              HtmlFontSize="22"
                                                              HtmlFontFamily="Bahnschrift"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              FocusVisualStyle="{x:Null}" />
                                            </ScrollViewerEx>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ====================== -->
                            <!-- RIGHT COLUMN - INFOS   -->
                            <!-- ====================== -->

                            <Border Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Padding="22,20,22,20"
                                    CornerRadius="18"
                                    Focusable="False"
                                    Background="{DynamicResource ListBackgroundBrush}"
                                    BorderBrush="{DynamicResource ListBorder}"
                                    BorderThickness="1">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ===================== -->
                                    <!-- SECTION 1 : INFOS JEU -->
                                    <!-- ===================== -->

                                    <StackPanel Grid.Row="0">

                                        <TextBlock Text="{DynamicResource LOCGameInfo}"
                                                   Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                   FontSize="26"
                                                   Margin="0,0,0,18"/>

                                        <!-- Time played -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCPlayTime}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- Last activity -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCLastLaunch}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LastActivity, StringFormat='{}{0:dd MMM yyyy}'}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- Release date -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ReleaseDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- Install size -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCInstallSize}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding InstallSize, Converter={StaticResource NullableUlongBytesSizeToStringConverter}}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- Critic Score -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCCriticScore}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CriticScore}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- Community Score -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCCommunityScore}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CommunityScore}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                        <!-- User Score -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.UserScore}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.UserScore}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCUserScore}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Game.UserScore}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"
                                                       Margin="0,10,0,0"/>
                                        </Grid>

                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Height="1"
                                            Background="#553B2A1F"
                                            VerticalAlignment="Center"/>

                                    <!-- ========================== -->
                                    <!-- SECTION 2 : PROFIL DU JEU -->
                                    <!-- ========================== -->

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{DynamicResource LOCGameProfile}"
                                                   Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                   FontSize="26"
                                                   Margin="0,0,0,16"/>

                                        <!-- Catégorie en pill -->
                                        <Grid Grid.Row="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.Categories[0]}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Categories[0]}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <WrapPanel Orientation="Horizontal"
                                                       VerticalAlignment="Center">

                                                <Border Padding="14,7" Margin="0,0,10,0"
                                                        CornerRadius="12"
                                                        Background="#9B6E564B">
                                                    <TextBlock Text="{Binding Game.Categories[0], TargetNullValue='', FallbackValue=''}"
                                                               Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                               FontSize="18"/>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game.Categories[0]}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Categories[0]}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Padding="14,7"
                                                        CornerRadius="12"
                                                        Background="#9B6E564B">
                                                    <TextBlock Text="{Binding Game.Categories[1], TargetNullValue='', FallbackValue=''}"
                                                               Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                               FontSize="18"/>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game.Categories[1]}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Categories[1]}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </WrapPanel>
                                        </Grid>

                                        <!-- Genres -->
                                        <ItemsControl Grid.Row="2"
                                                      Focusable="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      Margin="0,14,0,0"
                                                      ItemsSource="{Binding Genres}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,10,10"
                                                            Padding="12,6"
                                                            CornerRadius="10"
                                                            Background="#8C6B4A37">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                                   FontSize="18"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>


                                        <!-- HLTB badges -->
                                        <WrapPanel Grid.Row="3"
                                                   VerticalAlignment="Top"
                                                   Margin="0,6,0,0"
                                                   x:Name="HltbStack">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat}" Value="--"/>
                                                                <Condition Binding="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat}" Value="--"/>
                                                                <Condition Binding="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat}" Value="--"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoHLTBDetails]}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>

                                            <Border Margin="0,0,10,10"
                                                    Padding="12,7"
                                                    CornerRadius="10"
                                                    Background="#2E496D">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource LOCHLTBMain}"
                                                               Style="{StaticResource TextBlockDetailStyle}"
                                                               Opacity="0.85"
                                                               FontSize="16"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat}"
                                                               Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                               FontSize="18"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,0,10,10"
                                                    Padding="12,7"
                                                    CornerRadius="10"
                                                    Background="#35567C">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource LOCHLTBExtra}"
                                                               Style="{StaticResource TextBlockDetailStyle}"
                                                               Opacity="0.85"
                                                               FontSize="16"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat}"
                                                               Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                               FontSize="18"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,0,10,10"
                                                    Padding="12,7"
                                                    CornerRadius="10"
                                                    Background="#3E658D">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource LOCHLTBCompletionist}"
                                                               Style="{StaticResource TextBlockDetailStyle}"
                                                               Opacity="0.85"
                                                               FontSize="16"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat}"
                                                               Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                               FontSize="18"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Features -->
                                        <ItemsControl x:Name="Features"
                                                      Grid.Row="4"
                                                      Margin="0,6,0,2"
                                                      ItemsSource="{Binding Game.Features}"
                                                      Focusable="False"
                                                      FocusVisualStyle="{x:Null}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[FeaturesSteam]}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Left"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Width="40"
                                                           Height="40"
                                                           Margin="0,0,8,8"
                                                           Opacity="0.9"
                                                           Stretch="Uniform"
                                                           Source="{ThemeFileBinding Name, PathFormat='Icons/Features/{0}.png'}"
                                                           RenderOptions.BitmapScalingMode="Fant">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </Grid>

                                    <Border Grid.Row="3"
                                            Height="1"
                                            Background="#553B2A1F"
                                            VerticalAlignment="Center"/>

                                    <!-- =================== -->
                                    <!-- SECTION 3 : STATUT  -->
                                    <!-- =================== -->

                                    <StackPanel Grid.Row="4"
                                                VerticalAlignment="Bottom">

                                        <TextBlock Text="{DynamicResource LOCStatus}"
                                                   Style="{DynamicResource TextBlockBoldBaseStyle}"
                                                   FontSize="26"
                                                   Margin="0,0,0,16"/>

                                        <!-- Source -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source.Name}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source.Name}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCSource}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Source.Name}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"/>
                                        </Grid>

                                        <!-- Platform -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Platforms[0].Name}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platforms[0].Name}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCPlatform}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Platforms[0].Name, TargetNullValue='', FallbackValue=''}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"/>
                                        </Grid>

                                        <!-- Completion -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompletionStatus}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CompletionStatus}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,5,0" Grid.Column="0">
                                                <TextBlock Text="{DynamicResource LOCCompletion}"
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CompletionStatus}"
                                                       Style="{StaticResource TextBlockAltDetailStyle}"
                                                       FontSize="22"/>
                                        </Grid>

                                        <!-- InGames -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamCurrentPlayersAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[NoPlayerDetails]}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,5,0" Grid.Column="0">

                                                <!-- Label "in game" -->
                                                <TextBlock Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"
                                                           Text="{DynamicResource LOCPlayerInGame}"/>
                                                <TextBlock Text=" : "
                                                           Style="{StaticResource TextBlockDetailStyle}"
                                                           Opacity="0.8"
                                                           FontSize="24"/>

                                                <!-- Nombre de joueurs (depuis AnikiHelper) -->
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource TextBlockAltDetailStyle}"
                                                           FontSize="22"
                                                           Text="{PluginSettings Plugin=AnikiHelper, Path=SteamCurrentPlayersString}"/>


                                            </StackPanel>
                                        </Grid>


                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>






                        <!--Panel Update-->

                        <Grid x:Name="PanelUpdateGrid" Grid.RowSpan="3" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="1100" Panel.ZIndex="50" FocusVisualStyle="{x:Null}" RenderTransformOrigin="1,0"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.ControlTabNavigation="None"
                              Focusable="False">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <TranslateTransform x:Name="PanelUpdateRightTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PORTE de sortie (à gauche) -->
                                <ToggleButtonEx x:Name="UpdatePanelExit"
                                                Grid.Column="0"
                                                Width="60"
                                                Height="60"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                pbeh:FocusBahaviors.FocusBinding="{Binding ElementName=PanelUpdateGrid, Path=IsVisible}"
                                                IsChecked="{Binding ElementName=UpdatePanelToggle, Path=IsChecked, Mode=TwoWay}"
                                                KeyboardNavigation.DirectionalNavigation="Continue"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                TabIndex="99"
                                                Style="{StaticResource UpdatePanelExitButtonStyle}" />



                                <Grid Grid.Column="1">
                                    <!-- Fond verre fumé -->
                                    <Border Background="{DynamicResource OverlayMenu}"
                                            CornerRadius="16,0,0,16"
                                            Opacity="0.9"/>

                                    <!-- Reflet vertical discret -->
                                    <Border CornerRadius="16,0,0,16" Background="{DynamicResource GlassMainBrush}" IsHitTestVisible="False" />

                                    <!-- Liseré interne fin -->
                                    <Border CornerRadius="16,0,0,16"
                                            BorderBrush="{DynamicResource GlassInnerLineBrush}"
                                            Margin="1"
                                            BorderThickness="1,1,0,1"
                                            IsHitTestVisible="False"/>

                                    <Border Background="Transparent" CornerRadius="16,0,0,16" Padding="28,24,28,24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ContenuUpdateScroll, Path=IsKeyboardFocusWithin}" Value="True">
                                                        <Setter Property="BorderThickness" Value="2,2,0,2"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=ContenuUpdateScroll, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="BorderThickness" Value="2,2,0,2"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                                        </Border.Effect>
                                        <Border.CacheMode>
                                            <BitmapCache RenderAtScale="1"/>
                                        </Border.CacheMode>


                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Margin="0,2,0,10"
                                                       Text="{DynamicResource LOCLatestUpdate}"
                                                       Style="{StaticResource InfoValueStyle}"
                                                       FontSize="26" />
                                            <!-- Titre de la news -->
                                            <TextBlock Margin="0,2,0,5"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=SteamUpdateTitle}"
                                                       Style="{StaticResource InfoValueStyle}"
                                                       FontSize="26" />

                                            <!-- Date -->
                                            <TextBlock
                                                Text="{PluginSettings Plugin=AnikiHelper, Path=SteamUpdateDate}"
                                                Style="{StaticResource InfoValueStyle}"
                                                Opacity="0.7"
                                                Margin="0,2,0,10" />

                                            <!-- Contenu HTML dans ton HtmlTextView -->
                                            <ScrollViewerEx x:Name="ContenuUpdateScroll"
                                                            TabIndex="0"
                                                            FocusVisualStyle="{x:Null}"
                                                            KeyboardNavigation.TabNavigation="None"
                                                            PanningMode="VerticalOnly"
                                                            ScrollViewer.CanContentScroll="False"
                                                            VerticalAlignment="Top"
                                                            MaxHeight="650"
                                                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ScrollViewerEx.Style>
                                                    <Style TargetType="ScrollViewerEx">
                                                        <!-- Par défaut : pas focusable -->
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                        <Style.Triggers>
                                                            <!-- Quand le panneau est ouvert -->
                                                            <DataTrigger Binding="{Binding ElementName=UpdatePanelToggle, Path=IsChecked}" Value="True">
                                                                <Setter Property="Focusable" Value="True"/>
                                                                <Setter Property="IsTabStop" Value="True"/>
                                                            </DataTrigger>

                                                            <!-- Quand il se ferme (immédiat) -->
                                                            <DataTrigger Binding="{Binding ElementName=UpdatePanelToggle, Path=IsChecked}" Value="False">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="IsTabStop" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ScrollViewerEx.Style>

                                                <HtmlTextView x:Name="ContenuUpdate"
                                                              HtmlText="{PluginSettings Plugin=AnikiHelper, Path=SteamUpdateHtml}"
                                                              HtmlFontFamily="Bahnschrift"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              HtmlFontSize="{DynamicResource FontSize}" />
                                            </ScrollViewerEx>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=UpdatePanelToggle, Path=IsChecked}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                         From="1100" To="0" Duration="0:0:0.22"
                                                                         AccelerationRatio="0.05" DecelerationRatio="0.95"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- PANNEAU SCREENSHOT UTILITIES -->
                        <Grid x:Name="ScreenshotUtilitiesGrid"
                              Grid.RowSpan="3"
                              Grid.ColumnSpan="3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Width="1100"
                              Panel.ZIndex="50"
                              FocusVisualStyle="{x:Null}"
                              RenderTransformOrigin="1,0"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.ControlTabNavigation="None"
                              Focusable="False">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <TranslateTransform x:Name="ScreenshotUtilitiesRightTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PORTE de sortie (à gauche) -->
                                <ToggleButtonEx x:Name="ScreenshotUtilitiesGridExit"
                                                Grid.Column="0"
                                                Width="60"
                                                Height="60"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                pbeh:FocusBahaviors.FocusBinding="{Binding ElementName=ScreenshotUtilitiesGrid, Path=IsVisible}"
                                                IsChecked="{Binding ElementName=ScreenshotUtilitiesToggle, Path=IsChecked, Mode=TwoWay}"
                                                KeyboardNavigation.DirectionalNavigation="Continue"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                TabIndex="99"
                                                Style="{StaticResource UpdatePanelExitButtonStyle}" />



                                <Grid Grid.Column="1">
                                    <!-- Fond verre fumé -->
                                    <Border Background="{DynamicResource OverlayMenu}"
                                            CornerRadius="16,0,0,16"
                                            Opacity="1"/>

                                    <!-- Reflet vertical discret -->
                                    <Border CornerRadius="16,0,0,16"
                                            Background="{DynamicResource GlassMainBrush}"
                                            IsHitTestVisible="False" />

                                    <!-- Liseré interne fin -->
                                    <Border CornerRadius="16,0,0,16"
                                            BorderBrush="{DynamicResource GlassInnerLineBrush}"
                                            Margin="1"
                                            BorderThickness="1,1,0,1"
                                            IsHitTestVisible="False"/>

                                    <Border Background="Transparent"
                                            CornerRadius="16,0,0,16"
                                            Padding="28,24,28,24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <!-- Focus clavier dans le ScrollViewer -->
                                                    <DataTrigger Binding="{Binding ElementName=ScreenshotUtilitiesScrollViewer, Path=IsKeyboardFocusWithin}"
                                                                 Value="True">
                                                        <Setter Property="BorderThickness" Value="2,2,0,2"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    </DataTrigger>

                                                    <!-- Survol de la zone de screenshots -->
                                                    <DataTrigger Binding="{Binding ElementName=ScreenshotUtilitiesItemsControl, Path=IsMouseOver}"
                                                                 Value="True">
                                                        <Setter Property="BorderThickness" Value="2,2,0,2"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14"
                                                              ShadowDepth="0"
                                                              Opacity="0.45"/>
                                        </Border.Effect>
                                        <Border.CacheMode>
                                            <BitmapCache RenderAtScale="1"/>
                                        </Border.CacheMode>


                                        <!-- CONTENU DU PANNEAU -->
                                        <Grid MaxWidth="1000" HorizontalAlignment="Center">


                                            <StackPanel>

                                                <!-- Titre -->
                                                <TextBlock Text="Store screenshots"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Margin="0,0,0,16" />

                                                <!-- LISTE DES GROUPES AVEC VIEWER + MINIATURES -->
                                                <ItemsControl x:Name="ScreenshotUtilitiesItemsControl" Focusable="False"
                                                              ItemsSource="{PluginSettings Plugin=ScreenshotUtilities, Path=CurrentScreenshotGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,32">

                                                                <!-- Nom du groupe (Steam, etc.) -->
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="22"
                                                                           FontWeight="SemiBold"
                                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                                           Margin="0,0,0,8" />

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- IMAGE PRINCIPALE -->
                                                                    <Image x:Name="StoreMainImage"
                                                                           Source="{Binding SelectedScreenshot.DisplayPath}"
                                                                           Height="560"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           SnapsToDevicePixels="True"
                                                                           RenderOptions.BitmapScalingMode="HighQuality" />


                                                                    <!-- BARRE DE MINIATURES NAVIGABLE -->
                                                                    <ListBox x:Name="StoreThumbList" Margin="0,10,0,0"
                                                                             Grid.Row="1"
                                                                             ItemsSource="{Binding Screenshots}"
                                                                             SelectedItem="{Binding SelectedScreenshot, Mode=TwoWay}"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             FocusVisualStyle="{x:Null}"
                                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                             ScrollViewer.CanContentScroll="True"
                                                                             KeyboardNavigation.DirectionalNavigation="Once"
                                                                             KeyboardNavigation.TabNavigation="Once"
                                                                             KeyboardNavigation.ControlTabNavigation="Once">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>

                                                                        <!-- MINIATURES -->
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border x:Name="ThumbCard"
                                                                                        CornerRadius="2"
                                                                                        RenderTransformOrigin="0.5,0.5">
                                                                                    <Border.RenderTransform>
                                                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                                    </Border.RenderTransform>

                                                                                    <Image Source="{Binding DisplayThumbnail}"
                                                                                           Width="220"
                                                                                           Height="124"
                                                                                           Stretch="UniformToFill"
                                                                                           SnapsToDevicePixels="True"
                                                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                                                </Border>

                                                                                <!-- Effets focus / sélection -->
                                                                                <DataTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                                                 Value="True">
                                                                                        <Setter TargetName="ThumbCard"
                                                                                                Property="BorderBrush"
                                                                                                Value="{DynamicResource FocusGameBorderBrush}" />
                                                                                        <Setter TargetName="ThumbCard"
                                                                                                Property="BorderThickness"
                                                                                                Value="3" />

                                                                                    </DataTrigger>

                                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                                                                                 Value="True">
                                                                                        <Setter TargetName="ThumbCard"
                                                                                                Property="BorderBrush"
                                                                                                Value="{DynamicResource FocusGameBorderBrush}" />
                                                                                        <Setter TargetName="ThumbCard"
                                                                                                Property="BorderThickness"
                                                                                                Value="3" />
                                                                                    </DataTrigger>
                                                                                </DataTemplate.Triggers>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>

                                                                        <!-- Style global des items -->
                                                                        <ListBox.ItemContainerStyle>
                                                                            <Style TargetType="ListBoxItem">
                                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                                                <Setter Property="Padding" Value="0" />
                                                                                <Setter Property="Margin" Value="0" />
                                                                                <Setter Property="Margin" Value="10,0,10,0" />
                                                                                <Setter Property="Background" Value="Transparent" />
                                                                                <Setter Property="BorderThickness" Value="0" />
                                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                            </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                    </ListBox>



                                                                </Grid>

                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- Animation ouverture / fermeture -->
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=ScreenshotUtilitiesToggle, Path=IsChecked}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1"
                                                                         Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                         From="1100" To="0"
                                                                         Duration="0:0:0.22"
                                                                         AccelerationRatio="0.05"
                                                                         DecelerationRatio="0.95"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>

                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>


                        <!--Trigger-->

                        <Grid Grid.Row="0" Height="10" Width="10" Focusable="False" >
                            <TextBlock x:Name="LogoTrigger" Text="{Binding Game.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0" />
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" From="0" To="1" BeginTime="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="Id" Text="{Binding Game.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0" />
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.1" From="0" To="1" BeginTime="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="TrailerTrigger" Text="{Binding Game.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrailerOnDetailsView]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:0" To="1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Trailer -->

                        <Border x:Name="TrailerBackgroundFix"
                                Grid.Row="0"
                                Grid.RowSpan="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Background="Black"
                                Panel.ZIndex="-49"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrailerOnDetailsView]}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728"/>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MiniTrailer]}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.3" To="1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>



                        <!-- ThemeOptions Command -->

                        <ContentControl x:Name="ThemeOptions_Command" />



                        <!-- Sound -->

                        <MediaElement x:Name="CloseGameSound" Source="{ThemeFile 'audio/Noti.wav'}" Volume="{Settings Fullscreen.InterfaceVolume}" MediaElementBehaviors.Repeat="False" >
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ElementName=GameClosingPanel, Path=Visibility}" Value="Visible">
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <MediaElement x:Name="EnterGameDetailsChime" Source="{ThemeFile 'audio/EnterGameDetails.wav'}" Volume="{Settings Fullscreen.InterfaceVolume}" MediaElementBehaviors.Repeat="False" >
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <MediaElement x:Name="ExitGameDetailsChime" Source="{ThemeFile 'audio/ExitGameDetails.wav'}" Volume="{Settings Fullscreen.InterfaceVolume}" MediaElementBehaviors.Repeat="False" >
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <TextBlock x:Name="MusicTrigger" Text="{Binding Game.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.1" From="0" To="1" BeginTime="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>

                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock x:Name="MusicPath" Tag="{DynamicResource ExtraMetadataPath}" Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
                                                <Binding Source="\ExtraMetadata\games\"/>
                                                <Binding Path="Game.Id"/>
                                                <Binding Source="\Music.mp3" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <MediaElement x:Name="OpenViewSound"
                                      Source="{ThemeFile 'audio/OpenAdditionalView.wav'}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Close"
                                      Visibility="Collapsed"
                                      Volume="{Settings Fullscreen.InterfaceVolume}"
                                      IsMuted="False"/>

                        <MediaElement x:Name="MusicSource" MediaElementBehaviors.Repeat="True" Tag="{DynamicResource UseAbsoluteExtraMetadataPath}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="Volume" Value="0"/>
                                    <Setter Property="MediaElement.Source" Value="{Binding ElementName=MusicPath, Path=Text}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{SettingsBinding Fullscreen.IsMusicMuted}" Value="False"/>
                                                <Condition Binding="{Binding ElementName=MusicTrigger, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Volume" BeginTime="0:0:0.5" Duration="0:0:2" To="1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Volume" Duration="0:0:1.5" To="0" FillBehavior="Stop"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{SettingsBinding Fullscreen.IsMusicMuted}" Value="False"/>
                                                <Condition Binding="{Binding ElementName=MusicTrigger, Path=Opacity}" Value="1"/>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Volume" BeginTime="0:0:0.5" Duration="0:0:2" To="1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Volume" Duration="0:0:1.5" To="0" FillBehavior="Stop"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Volume" Value="0" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=MusicTrigger, Path=Opacity}" Value="0">
                                            <Setter Property="MediaElement.Source" Value="" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{SettingsBinding Fullscreen.IsMusicMuted}" Value="True">
                                            <Setter Property="MediaElement.Source" Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                    </Grid>

                    <!-- Visibilité des elements quand trailer joue-->

                    <ControlTemplate.Triggers>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=Vid, Path=Visibility}" Value="Visible"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Tag" Value="True" TargetName="Sounds_MusicControl" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                <Condition Binding="{Binding ElementName=TrailerContainer, Path=Visibility}" Value="Visible"/>
                                <Condition Binding="{Binding ElementName=TrailerMute, Path=IsChecked}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Tag" Value="True" TargetName="Sounds_MusicControl" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>


                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible"/>
                                <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Visibility}" Value="Collapsed"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Tag" Value="False" TargetName="Sounds_MusicControl" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=TrailerZoom, Path=IsChecked}" Value="True"/>
                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MiniTrailer]}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Margin" Value="0,0,0,0" TargetName="TrailerContainer"/>
                                <Setter Property="Height" Value="Auto" TargetName="TrailerContainer"/>
                                <Setter Property="MaxWidth" Value="2161" TargetName="TrailerContainer"/>
                                <Setter Property="Width" Value="Auto" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.Row" Value="0" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.RowSpan" Value="3" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.Column" Value="0" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.ColumnSpan" Value="3" TargetName="TrailerContainer"/>
                                <Setter Property="VerticalAlignment" Value="Stretch" TargetName="TrailerContainer"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="TrailerContainer"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="Avatar"/>
                                <Setter Property="Visibility" Value="Visible" TargetName="TrailerMuteZoom"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="Trophee_SS"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="Trophee_PA"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="SourceIconBorder"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="InterfaceBar"/>
                                <Setter Property="VerticalAlignment" Value="Center" TargetName="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound"/>
                                <Setter Property="HorizontalAlignment" Value="Center" TargetName="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound"/>
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=TrailerZoom, Path=IsChecked}" Value="True"/>
                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[MiniTrailer]}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Margin" Value="0,0,0,0" TargetName="TrailerContainer"/>
                                <Setter Property="Height" Value="Auto" TargetName="TrailerContainer"/>
                                <Setter Property="MaxWidth" Value="2161" TargetName="TrailerContainer"/>
                                <Setter Property="Width" Value="Auto" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.Row" Value="0" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.RowSpan" Value="3" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.Column" Value="0" TargetName="TrailerContainer"/>
                                <Setter Property="Grid.ColumnSpan" Value="3" TargetName="TrailerContainer"/>
                                <Setter Property="VerticalAlignment" Value="Stretch" TargetName="TrailerContainer"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="TrailerContainer"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="TrailerZoom"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="TrailerPlay"/>
                                <Setter Property="Visibility" Value="Visible" TargetName="InterfaceBar"/>
                                <Setter Property="VerticalAlignment" Value="Center" TargetName="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound"/>
                                <Setter Property="HorizontalAlignment" Value="Center" TargetName="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound"/>
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="{StaticResource True}">
                            <Setter Property="Command" Value="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPauseCommand}" TargetName="TrailerPlay"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=TrailerMute, Path=Visibility}" Value="Collapsed">
                            <Setter Property="Margin" Value="15,15,15,15" TargetName="TrailerPlay"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="0">
                            <Setter Property="IsChecked" Value="False" TargetName="TrailerZoom"/>
                        </DataTrigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--PlayniteAchievement-->
    <Style x:Key="GameAchievementsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.FocusedElement="{Binding ElementName=TrophiesMenuToggle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Opacity="0"
                          Background="{DynamicResource SecondaryViewBackground}">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-20" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>


                        <FadeImage Source="{Binding SelectedGame.BackgroundImage}" Margin="0,-150,0,0"
                                   HorizontalContentAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Height="1000"
                                   Stretch="UniformToFill"
                                   Opacity="0.7">
                            <FadeImage.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Black" Offset="0.0" />
                                    <GradientStop Color="Transparent" Offset="0.5" />
                                </LinearGradientBrush>
                            </FadeImage.OpacityMask>
                        </FadeImage>

                        <!-- Bandeau supérieur du panneau de trophées -->
                        <Border Background="Transparent" Margin="0,20,0,0"
                                BorderThickness="0,0,0,0"
                                BorderBrush="{DynamicResource OverlayMenu}"
                                Height="250"
                                VerticalAlignment="Top">

                            <Grid Margin="100,0,100,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Colonne gauche : Cover -->
                                <Border Grid.Column="0"
                                        MaxWidth="200"
                                        MaxHeight="200"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        Background="{DynamicResource OverlayMenu}">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0"
                                                          BlurRadius="10"
                                                          Opacity="0.4"
                                                          Color="Black" />
                                    </Border.Effect>
                                    <Viewbox MaxWidth="200"
                                             MaxHeight="210"
                                             Stretch="Uniform">
                                        <Grid Width="{Settings GridItemWidth}"
                                              Height="{Settings GridItemHeight}">
                                            <Image Source="{PluginSettings Plugin=PlayniteAchievements, Path=SelectedGameCoverPath}"
                                                   Stretch="{Settings CoverArtStretch}"
                                                   StretchDirection="Both"
                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <!-- Colonne centre : Titre + barre progression -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGame.DisplayName}"
                                               HorizontalAlignment="Center"
                                               FontSize="50"
                                               TextWrapping="Wrap"
                                               TextTrimming="WordEllipsis"
                                               MaxWidth="1500">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel >
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Name="LogoPath" Tag="{DynamicResource ExtraMetadataPath}" Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
                                                                <Binding Source="\ExtraMetadata\games\"/>
                                                                <Binding Path="SelectedGame.Id"/>
                                                                <Binding Source="\logo.png" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Name="LogoImage" Width="450" MaxHeight="125" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                                               VerticalAlignment="Top" HorizontalAlignment="Center"
                                               Tag="{DynamicResource UseAbsoluteExtraMetadataPath}" >
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                            <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                            <Setter Property="ItemsControl.Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>


                                    <ProgressBar Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}"
                                                 Background="{DynamicResource TextBrush}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="10"
                                                 Width="500"
                                                 Style="{DynamicResource ProgressBarCustom}"
                                                 Margin="0,20,0,0"
                                                 Foreground="#FFCD31" />

                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="30"
                                               Text="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, StringFormat={}{0}%}" />
                                </StackPanel>

                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,280,150,0">
                            <!-- Rangées de trophées -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Platine -->
                                <Image Source="{ThemeFile 'Images/platinum.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock FontWeight="Light" FontSize="26">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" Value="100">
                                                    <Setter Property="Text" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=IsCompleted}" Value="True">
                                                    <Setter Property="Text" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Or -->
                                <Image Source="{ThemeFile 'Images/Or.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=RareAndUltraRare.Unlocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Argent -->
                                <Image Source="{ThemeFile 'Images/Argent.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Uncommon.Unlocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Bronze -->
                                <Image Source="{ThemeFile 'Images/Bronze.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Common.Unlocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="AchievementList" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="1600" KeyboardNavigation.DirectionalNavigation="Cycle" pbeh:FocusBahaviors.FocusBinding="True" >
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,50"/>
                                    <Setter Property="Height" Value="750"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                                            <Setter Property="Height" Value="870"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.Resources>

                                <ControlTemplate x:Key="AchievementListItemTemplate" TargetType="ListViewItem">
                                    <Grid Height="120"
                                          Width="1400"
                                          Margin="0,8,0,8"
                                          HorizontalAlignment="Center"
                                          SnapsToDevicePixels="True">

                                        <Border x:Name="MainBorder"
                                                CornerRadius="14"
                                                Background="{DynamicResource SuccessMainCardBackground}"
                                                BorderThickness="1.5"
                                                BorderBrush="#18FFFFFF"
                                                SnapsToDevicePixels="True">

                                            <Grid>
                                                <!-- focus fill derrière -->
                                                <Border x:Name="FocusOverlay"
                                                        CornerRadius="14"
                                                        Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>

                                                <!-- fond -->
                                                <Border CornerRadius="14"
                                                        Opacity="0.92" Background="{DynamicResource BackgroundItem}" />

                                                <!-- masque -->
                                                <Border x:Name="mask"
                                                        CornerRadius="14"
                                                        Background="Black"
                                                        Opacity="0"/>

                                                <Grid>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Height="120"
                                                                  Width="120"
                                                                  VerticalAlignment="Center">
                                                                <Grid.OpacityMask>
                                                                    <VisualBrush Stretch="Fill">
                                                                        <VisualBrush.Visual>
                                                                            <Border Width="120"
                                                                                    Height="120"
                                                                                    Background="Black"
                                                                                    CornerRadius="14,0,0,14"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Grid.OpacityMask>


                                                                <Grid>
                                                                    <!-- Real icon -->
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                                        <Setter Property="Opacity" Value="0.25"/>
                                                                                    </DataTrigger>

                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- Lock overlay -->
                                                                    <Image Source="{ThemeFile 'Images/Buttons/locked.png'}"
                                                                           Opacity="0.8"
                                                                           Height="60"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Stretch="Uniform">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- Hidden placeholder -->
                                                                    <Image Source="{ThemeFile 'Images/TrophyHidden.png'}"
                                                                           Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                            <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                            <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="1350" Height="120" Margin="30,5,0,0">
                                                        <Grid VerticalAlignment="Top" Margin="100,0,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Ligne 1 : Nom -->
                                                            <TextBlock x:Name="Name"
                                                                       Grid.Row="0"
                                                                       Margin="0,5,0,5"
                                                                       HorizontalAlignment="Left"
                                                                       MaxWidth="1150"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="23">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                    <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Opacity" Value="0.75"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock x:Name="Desc"
                                                                       Margin="0,5,0,5"
                                                                       Grid.Row="1"
                                                                       MaxWidth="1200"
                                                                       TextTrimming="WordEllipsis"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Top"
                                                                       HorizontalAlignment="Left"
                                                                       FontSize="20">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Text" Value="{Binding Description}" />
                                                                        <Setter Property="Opacity" Value="0.85"/>
                                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                    <Condition Binding="{Binding Unlocked}" Value="False"/>
                                                                                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowHiddenAchievements]}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Opacity" Value="0.6"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>





                                                            <!-- Ligne 3 : % + joueurs -->
                                                            <StackPanel Grid.Row="2"
                                                                        Orientation="Horizontal"
                                                                        Margin="0,5,0,0"
                                                                        VerticalAlignment="Bottom">
                                                                <TextBlock x:Name="Perc"
                                                                           Text="{Binding Percent, Path=Percent, StringFormat={}{0:F0}%}"
                                                                           FontSize="17"
                                                                           Opacity="0.9"
                                                                           Style="{DynamicResource TextBlockDetailStyle}" />
                                                                <TextBlock x:Name="Player"
                                                                           Margin="5,0,0,0"
                                                                           Text="{DynamicResource LOCPlayershaveachievement}"
                                                                           FontSize="16"
                                                                           Opacity="0.9"
                                                                           Style="{DynamicResource TextBlockDetailStyle}" />
                                                            </StackPanel>
                                                        </Grid>



                                                        <StackPanel Margin="0,15,80,0"
                                                                    Orientation="Vertical"
                                                                    HorizontalAlignment="Right"
                                                                    Opacity="0.85"
                                                                    VerticalAlignment="Center">

                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ProgressNum}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProgressDenom}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProgressDenom}" Value="1">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <!-- Progress bar: background track + fill -->
                                                            <Grid Width="160" Height="10" VerticalAlignment="Center">
                                                                <!-- Track -->
                                                                <Border CornerRadius="6"
                                                                        Background="{DynamicResource ProgressBackgroundBrush}"
                                                                        Height="8"
                                                                        VerticalAlignment="Center"/>

                                                                <!-- Fill -->
                                                                <ProgressBar Value="{Binding ProgressNum, FallbackValue=0}"
                                                                             Minimum="0"
                                                                             Maximum="{Binding ProgressDenom, FallbackValue=1}"
                                                                             Height="8"
                                                                             BorderThickness="0"
                                                                             Foreground="{DynamicResource ProgressBrush}"
                                                                             Background="Transparent"
                                                                             VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- Compact counter -->
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                                       Opacity="0.95">
                                                                <Run Text="{Binding ProgressNum}" />
                                                                <Run Text="/" />
                                                                <Run Text="{Binding ProgressDenom}" />
                                                            </TextBlock>

                                                        </StackPanel>



                                                        <StackPanel Margin="0,10,55,0" Orientation="Vertical" HorizontalAlignment="Right" Opacity="0.7" VerticalAlignment="Center">


                                                            <TextBlock x:Name="Clock1" Visibility="Visible" Margin="0,0,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{Binding DateUnlocked, StringFormat='{}{0:HH:mm}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}" />
                                                            <TextBlock x:Name="Clock2" Visibility="Collapsed" Margin="0,0,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{Binding DateUnlocked, StringFormat='{}{0:t}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}" />
                                                            <TextBlock  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,3,2" Text="{Binding DateUnlocked, StringFormat='{}{0:d MMM yyyy}'}" FontSize="20" Style="{DynamicResource TextBlockBaseStyle}"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Margin="0,10,0,10"
                                                                Padding="10,2"
                                                                CornerRadius="10"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="#26000000"
                                                                BorderBrush="#22FFFFFF"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CategoryType}" Value="Default">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CategoryType}" Value="Base">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock
                                                                Text="{Binding CategoryType}"
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Opacity="0.95">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CategoryType}" Value="Default">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding CategoryType}" Value="Base">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>


                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Width="55" >
                                                            <Image x:Name="Bronze" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Bronze.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Visible"/>
                                                            <Image x:Name="Argent"  Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Argent.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed" />
                                                            <Image x:Name="Or"  Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Or.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                            <Image x:Name="Saphir" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/Saphir.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                            <Image x:Name="Completed" Margin="10,10,5,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                   Source="{ThemeFile 'Images/platinum.png'}" Height="45" RenderOptions.BitmapScalingMode="Fant" Visibility="Collapsed"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="PercentLogic" Text="{Binding GamerScore}" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </Grid>




                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2.5"/>
                                            <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>

                                            <Setter TargetName="Name" Property="FontSize" Value="25"/>
                                            <Setter TargetName="Desc" Property="Opacity" Value="0.8"/>
                                            <Setter TargetName="Desc" Property="FontSize" Value="22"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="UltraRare"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Rare"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Uncommon"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapstone}" Value="False"/>
                                                <Condition Binding="{Binding Rarity}" Value="Common"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Completed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LocalClock]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Clock2" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Clock1" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>

                                <Style x:Key="AchievementListItemContainerStyle" TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template" Value="{StaticResource AchievementListItemTemplate}"/>
                                    <Setter Property="Visibility" Value="Visible"/>

                                    <Style.Triggers>
                                        <!-- Filtre: Unlocked only -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Unlocked"/>
                                                <Condition Binding="{Binding Unlocked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <!-- MODE LOCKED -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Locked"/>
                                                <Condition Binding="{Binding Unlocked}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>


                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="AchievementListBaseStyle" TargetType="ListView">
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Local"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>

                            </Grid.Resources>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">

                                <TextBlock Text="{DynamicResource LOCSortby}" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20" />

                                <TextBlock Text=" : " HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="20"/>

                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" FontSize="20" >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Newest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCNewest}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Oldest">
                                                    <Setter Property="Text" Value="{DynamicResource LOCOldest}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityAsc">
                                                    <Setter Property="Text" Value="{DynamicResource LOCRarityAsc}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityDesc">
                                                    <Setter Property="Text" Value="{DynamicResource LOCRarityDesc}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="DefaultOrder">
                                                    <Setter Property="Text" Value="{DynamicResource LOCDefault}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text=" ● " VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource TextBrush}" FontSize="18"/>


                                <TextBlock Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"
                                           FontSize="20" >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="All">
                                                    <Setter Property="Text" Value="{DynamicResource LOCAll}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Locked">
                                                    <Setter Property="Text" Value="{DynamicResource LOCLockedOnly}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Unlocked">
                                                    <Setter Property="Text" Value="{DynamicResource LOCUnlockedOnly}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>


                            <Rectangle Fill="{DynamicResource TextBrush}" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0" />

                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0">

                                <CheckBoxEx x:Name="TrophiesMenuToggle"
                                            Content="&#xefb0;"
                                            pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                            FontFamily="{DynamicResource FontIcoFont}"
                                            Command="{PluginSettings Plugin=AnikiHelper, Path=OpenChildWindow[AchievementsDetailsOptionsWindow]}"
                                            FontSize="22">
                                    <CheckBoxEx.Style>
                                        <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}">
                                            <Style.Triggers>

                                            </Style.Triggers>
                                        </Style>
                                    </CheckBoxEx.Style>

                                </CheckBoxEx>

                            </Grid>

                            <!-- NEWEST (défaut) -->
                            <ListView x:Name="AchievementListNewest"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementsNewestFirst}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Oldest">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityAsc">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityDesc">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="DefaultOrder">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <!-- OLDEST -->
                            <ListView x:Name="AchievementListOldest"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementsOldestFirst}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Oldest">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <!-- RARITY ASC-->
                            <ListView x:Name="AchievementListRarityAsc"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementsRarityAsc}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityAsc">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <!-- RARITY DESC-->
                            <ListView x:Name="AchievementListRarityDesc"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementsRarityDesc}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="RarityDesc">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <!-- DEFAULT ORDER-->
                            <ListView x:Name="AchievementListDefaultOrder"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementDefaultOrder}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="DefaultOrder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>





                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.4" />
                            </Grid.Effect>

                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" >
                            <TextBlock Text="{DynamicResource LocTotalTrophiesUnlocked}"  Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,5,10" />
                            <TextBlock Text=" : " Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,5,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,0,10" />
                            <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="2,50,2,10" />
                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,0,10" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,0">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="B"
                                          Content="{DynamicResource LOCBackLabel}" />
                            </StackPanel>


                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728">
                            <Setter Property="Margin" Value="-140,80,30,80" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- PlayniteAchivement Options Panel -->
    <Style x:Key="AchievementsDetailsOptionsWindow" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#AA000000">


                        <Border x:Name="TrophiesMenu"
                                Grid.RowSpan="2"
                                Panel.ZIndex="2"
                                Width="560"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BackgroundMenu}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="0,0,2,0"
                                CornerRadius="0"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle">

                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="-60" To="0"
                                                             Duration="0:0:0.40">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  Direction="0"
                                                  ShadowDepth="2"
                                                  BlurRadius="10"
                                                  Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0"
                                        Padding="0"
                                        Background="{DynamicResource BackgroundAHBrush}">

                                    <Border Background="#12000000"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="0,0,0,1"
                                            Padding="26,24,26,20">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- TITRE -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LOCTrophiesOptions}"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Foreground="{DynamicResource TextHighlightBrush}"
                                                           FontSize="32"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- separator -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="#22FFFFFF"/>

                                <!-- CONTENT -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="26,18,26,18"
                                              Focusable="False"
                                              IsTabStop="False">

                                    <StackPanel Margin="30,20,26,30">

                                        <!-- SECTION: Sorting (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCSortby}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx pbeh:FocusBahaviors.FocusBinding="True"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort], Mode=TwoWay, TargetNullValue=Newest}"
                                                    Margin="0,10,0,15"
                                                    Height="56">
                                            <ComboBoxItem Content="{DynamicResource LOCNewest}" Tag="Newest"/>
                                            <ComboBoxItem Content="{DynamicResource LOCOldest}" Tag="Oldest"/>
                                            <ComboBoxItem Content="{DynamicResource LOCRarityAsc}" Tag="RarityAsc"/>
                                            <ComboBoxItem Content="{DynamicResource LOCRarityDesc}" Tag="RarityDesc"/>
                                            <ComboBoxItem Content="{DynamicResource LOCDefault}" Tag="DefaultOrder"/>
                                        </ComboBoxEx>

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Show (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <ComboBoxEx SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter], Mode=TwoWay, TargetNullValue=All}"
                                                    Margin="0,10,0,15"
                                                    Height="46">
                                            <ComboBoxItem Content="{DynamicResource LOCAll}" Tag="All"/>
                                            <ComboBoxItem Content="{DynamicResource LOCUnlockedOnly}" Tag="Unlocked"/>
                                            <ComboBoxItem Content="{DynamicResource LOCLockedOnly}" Tag="Locked"/>
                                        </ComboBoxEx>

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Hidden toggle (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCShowHiddenAchievements}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,15,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <CheckBoxEx x:Name="ShowHiddenToggle"
                                                        Content="{DynamicResource LOCShowHiddenAchievements}"
                                                        IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowHiddenAchievements], Mode=TwoWay}"/>
                                        </StackPanel>

                                        <Border Height="1" Background="#22FFFFFF" Margin="0,18,0,16"/>

                                        <!-- SECTION: Refresh (TES OPTIONS details) -->
                                        <TextBlock Text="{DynamicResource LOCRefreshTrophies}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.70"
                                                   Margin="0,20,0,10"/>

                                        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
                                            <ButtonEx Height="50"
                                                      HorizontalContentAlignment="Stretch"
                                                      Content="{DynamicResource LOCRefreshTrophies}"
                                                      Command="{PluginSettings Plugin=PlayniteAchievements, Path=SingleGameRefreshCommand}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>

                                <!-- FOOTER -->
                                <Border Grid.Row="2"
                                        Padding="26,12,26,12"
                                        Background="#0E000000">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                  Grid.Column="0"
                                                  Tag="Dpad"
                                                  Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                                      Tag="A"
                                                      Content="{DynamicResource LOCButtonPrompt_Select}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--SuccessStory-->

    <Style x:Key="GameAchievementsWindowStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.FocusedElement="{Binding ElementName=TrophiesMenuToggle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Opacity="0"
                          Background="{DynamicResource SecondaryViewBackground}">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-20" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>


                        <FadeImage Source="{Binding SelectedGame.BackgroundImage}" Margin="0,-150,0,0"
                                   HorizontalContentAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Height="1000"
                                   Stretch="UniformToFill"
                                   Opacity="0.7">
                            <FadeImage.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Black" Offset="0.0" />
                                    <GradientStop Color="Transparent" Offset="0.5" />
                                </LinearGradientBrush>
                            </FadeImage.OpacityMask>
                        </FadeImage>

                        <!-- Bandeau supérieur du panneau de trophées -->
                        <Border Background="Transparent" Margin="0,20,0,0"
                                BorderThickness="0,0,0,0"
                                BorderBrush="{DynamicResource OverlayMenu}"
                                Height="250"
                                VerticalAlignment="Top">

                            <Grid Margin="100,0,100,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>



                                <!-- Colonne gauche : Cover -->
                                <Border Grid.Column="0"
                                        MaxWidth="200"
                                        MaxHeight="200"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        Background="{DynamicResource OverlayMenu}">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0"
                                                          BlurRadius="10"
                                                          Opacity="0.4"
                                                          Color="Black" />
                                    </Border.Effect>
                                    <Viewbox MaxWidth="200"
                                             MaxHeight="210"
                                             Stretch="Uniform">
                                        <Grid Width="{Settings GridItemWidth}"
                                              Height="{Settings GridItemHeight}">
                                            <Image Source="{Binding SelectedGame.CoverImageObjectCached}"
                                                   Stretch="{Settings CoverArtStretch}"
                                                   StretchDirection="Both"
                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <!-- Colonne centre : Titre + barre progression -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGame.DisplayName}"
                                               HorizontalAlignment="Center"
                                               FontSize="50"
                                               TextWrapping="Wrap"
                                               TextTrimming="WordEllipsis"
                                               MaxWidth="1500">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel >
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LogoTrophy]}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Name="LogoPath" Tag="{DynamicResource ExtraMetadataPath}" Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
                                                                <Binding Source="\ExtraMetadata\games\"/>
                                                                <Binding Path="SelectedGame.Id"/>
                                                                <Binding Source="\logo.png" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Name="LogoImage" Width="450" MaxHeight="125" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                                               VerticalAlignment="Top" HorizontalAlignment="Center"
                                               Tag="{DynamicResource UseAbsoluteExtraMetadataPath}" >
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                            <Setter Property="Source" Value="{Binding ElementName=LogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                            <Setter Property="ItemsControl.Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>


                                    <ProgressBar Value="{PluginSettings Plugin=SuccessStory, Path=Percent}"
                                                 Background="{DynamicResource TextBrush}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="10"
                                                 Width="500"
                                                 Style="{DynamicResource ProgressBarCustom}"
                                                 Margin="0,20,0,0"
                                                 Foreground="#FFCD31" />

                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="30"
                                               Text="{PluginSettings Plugin=SuccessStory, Path=Percent, StringFormat={}{0}%}" />
                                </StackPanel>

                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,280,150,0">
                            <!-- Rangées de trophées -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Platine -->
                                <Image Source="{ThemeFile 'Images/platinum.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock FontWeight="Light" FontSize="26">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Text" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=SuccessStory, Path=Percent}" Value="100">
                                                    <Setter Property="Text" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Or -->
                                <Image Source="{ThemeFile 'Images/Or.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Rare.UnLocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <!-- Argent -->
                                <Image Source="{ThemeFile 'Images/Argent.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=NoCommon.UnLocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Bronze -->
                                <Image Source="{ThemeFile 'Images/Bronze.png'}" Width="40" Height="40" Margin="0,0,6,0"/>
                                <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Common.UnLocked, StringFormat={}{0}}" FontWeight="Light" FontSize="26" Style="{DynamicResource TextBlockBaseStyle}" />
                            </StackPanel>
                        </StackPanel>


                        <Grid x:Name="AchievementList" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="1600" KeyboardNavigation.DirectionalNavigation="Cycle" pbeh:FocusBahaviors.FocusBinding="True" >
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,50"/>
                                    <Setter Property="Height" Value="750"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                                            <Setter Property="Height" Value="870"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.Resources>

                                <ControlTemplate x:Key="AchievementListItemTemplate" TargetType="ListViewItem">
                                    <Border Background="Transparent"
                                            BorderBrush="Transparent"
                                            CornerRadius="14">
                                        <Grid Height="120"
                                              Width="1400"
                                              Margin="0,8,0,8">

                                            <!-- focus fill derrière -->
                                            <Border x:Name="FocusOverlay"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource FocusSuccessCardBackgroundBrush}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>

                                            <!-- fond principal de carte -->
                                            <Border x:Name="MainBorder"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource SuccessDetailsCardBackground}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="#18FFFFFF"/>

                                            <!-- légère teinte -->
                                            <Border CornerRadius="14"
                                                    Opacity="0.92"
                                                    IsHitTestVisible="False"
                                                    Background="{DynamicResource BackgroundItem}" />

                                            <Grid>
                                                <!-- IMAGE -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Height="120"
                                                              Width="120"
                                                              VerticalAlignment="Center">

                                                            <!-- masque arrondi uniquement pour l’image -->
                                                            <Border x:Name="ImageMask"
                                                                    CornerRadius="14,0,0,14"
                                                                    Background="White"/>

                                                            <Grid>
                                                                <Grid.OpacityMask>
                                                                    <VisualBrush Visual="{Binding ElementName=ImageMask}" />
                                                                </Grid.OpacityMask>

                                                                <Border Background="Black"/>

                                                                <!-- Real icon -->
                                                                <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUnlock}" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.25"/>
                                                                                </DataTrigger>

                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>

                                                                <!-- Lock overlay -->
                                                                <Image Source="{ThemeFile 'Images/Buttons/locked.png'}"
                                                                       Opacity="0.8"
                                                                       Height="60"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       Stretch="Uniform">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                                                        <Condition Binding="{Binding IsHidden}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>

                                                                <!-- Hidden placeholder -->
                                                                <Image Source="{ThemeFile 'Images/TrophyHidden.png'}"
                                                                       Stretch="UniformToFill">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- CONTENU -->
                                                <Grid VerticalAlignment="Bottom"
                                                      HorizontalAlignment="Left"
                                                      Width="1350"
                                                      Height="120"
                                                      Margin="30,5,0,0">

                                                    <Grid VerticalAlignment="Top" Margin="100,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Nom -->
                                                        <TextBlock x:Name="Name"
                                                                   Grid.Row="0"
                                                                   Margin="0,5,0,5"
                                                                   HorizontalAlignment="Left"
                                                                   MaxWidth="1150"
                                                                   Text="{Binding Name}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="23">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Opacity" Value="0.75"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Description -->
                                                        <TextBlock x:Name="Desc"
                                                                   Grid.Row="1"
                                                                   Margin="0,5,0,5"
                                                                   MaxWidth="1200"
                                                                   TextTrimming="WordEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Top"
                                                                   HorizontalAlignment="Left"
                                                                   FontSize="20">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Text" Value="{Binding Description}" />
                                                                    <Setter Property="Opacity" Value="0.85"/>
                                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                                                <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <BlurEffect Radius="16" KernelType="Gaussian"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Opacity" Value="0.6"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- % + joueurs -->
                                                        <StackPanel Grid.Row="2"
                                                                    Orientation="Horizontal"
                                                                    Margin="0,5,0,0"
                                                                    VerticalAlignment="Bottom">
                                                            <TextBlock x:Name="Perc"
                                                                       Text="{Binding Percent, Path=Percent, StringFormat={}{0:F0}%}"
                                                                       FontSize="17"
                                                                       Opacity="0.9"
                                                                       Style="{DynamicResource TextBlockDetailStyle}" />
                                                            <TextBlock x:Name="Player"
                                                                       Margin="5,0,0,0"
                                                                       Text="{DynamicResource LOCPlayershaveachievement}"
                                                                       FontSize="16"
                                                                       Opacity="0.9"
                                                                       Style="{DynamicResource TextBlockDetailStyle}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Date -->
                                                    <StackPanel Margin="0,10,55,0"
                                                                Orientation="Vertical"
                                                                HorizontalAlignment="Right"
                                                                Opacity="0.7"
                                                                VerticalAlignment="Center">

                                                        <TextBlock x:Name="Clock1"
                                                                   Visibility="Visible"
                                                                   Margin="0,0,3,0"
                                                                   VerticalAlignment="Top"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding DateUnlocked, StringFormat='{}{0:HH:mm}'}"
                                                                   FontSize="20"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" />

                                                        <TextBlock x:Name="Clock2"
                                                                   Visibility="Collapsed"
                                                                   Margin="0,0,3,0"
                                                                   VerticalAlignment="Top"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding DateUnlocked, StringFormat='{}{0:t}'}"
                                                                   FontSize="20"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" />

                                                        <TextBlock VerticalAlignment="Top"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,3,2"
                                                                   Text="{Binding DateUnlocked, StringFormat='{}{0:d MMM yyyy}'}"
                                                                   FontSize="20"
                                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                                    </StackPanel>

                                                    <!-- icône trophée -->
                                                    <StackPanel HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Width="55">
                                                        <Image x:Name="Bronze"
                                                               Margin="10,10,5,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Source="{ThemeFile 'Images/Bronze.png'}"
                                                               Height="45"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Visibility="Visible"/>

                                                        <Image x:Name="Argent"
                                                               Margin="10,10,5,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Source="{ThemeFile 'Images/Argent.png'}"
                                                               Height="45"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Visibility="Collapsed" />

                                                        <Image x:Name="Or"
                                                               Margin="10,10,5,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Source="{ThemeFile 'Images/Or.png'}"
                                                               Height="45"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Visibility="Collapsed"/>

                                                        <Image x:Name="Saphir"
                                                               Margin="10,10,5,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               Source="{ThemeFile 'Images/Saphir.png'}"
                                                               Height="45"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Visibility="Collapsed"/>
                                                    </StackPanel>

                                                    <TextBlock x:Name="PercentLogic"
                                                               Text="{Binding GamerScore}"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                            </Grid>

                                            <!-- border focus -->
                                            <Border x:Name="BorderFocus"
                                                    Opacity="0.95"
                                                    BorderThickness="2"
                                                    Visibility="Collapsed"
                                                    CornerRadius="14"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusSuccessCardBorder}"/>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="BorderFocus" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Name" Property="FontSize" Value="25"/>
                                            <Setter TargetName="Desc" Property="Opacity" Value="0.8"/>
                                            <Setter TargetName="Desc" Property="FontSize" Value="22"/>
                                            <Setter TargetName="FocusOverlay" Property="Opacity" Value="0.9"/>
                                        </Trigger>

                                        <!-- OR -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="180"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="90"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="50"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="25"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <!-- ARGENT -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="30"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PercentLogic, Path=Text}" Value="10"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Saphir" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Or" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Argent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Bronze" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <!-- horloge locale -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[LocalClock]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Clock2" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Clock1" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>

                                <Style x:Key="AchievementListItemContainerStyle" TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template" Value="{StaticResource AchievementListItemTemplate}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- Filtre: Unlocked only -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Unlocked"/>
                                                <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <!-- MODE LOCKED -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Locked"/>
                                                <Condition Binding="{Binding IsUnlock}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <!-- Hidden toggle OFF: cacher hidden+locked -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHidden}" Value="True"/>
                                                <Condition Binding="{Binding IsUnlock}" Value="False"/>
                                                <Condition Binding="{Binding IsChecked, ElementName=ShowHiddenToggle}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="AchievementListBaseStyle" TargetType="ListView">
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Local"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}" Value="Visible">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Opacity" Value="0.15"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>

                            </Grid.Resources>

                            <TextBlock Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                       FontSize="32" Typography.Capitals="AllSmallCaps">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Locked">
                                                <Setter Property="Text" Value="{DynamicResource LocLockedAchievements}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter]}" Value="Unlocked">
                                                <Setter Property="Text" Value="{DynamicResource LocUnlockedAchievements}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-30,-10,0,0">

                                <CheckBoxEx x:Name="TrophiesMenuToggle"
                                            Content="&#xefb0;"
                                            pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                            FontFamily="{DynamicResource FontIcoFont}"
                                            FontSize="22">
                                    <CheckBoxEx.Style>
                                        <Style TargetType="CheckBoxEx" BasedOn="{StaticResource SuccessSorting}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=TrophiesMenu, Path=Visibility}"
                                                             Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </CheckBoxEx.Style>

                                </CheckBoxEx>

                            </Grid>

                            <Border x:Name="TrophiesMenu"
                                    Grid.RowSpan="2"
                                    Panel.ZIndex="2"
                                    Width="520"
                                    Padding="18"
                                    Margin="30,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource OverlayMenu}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    KeyboardNavigation.TabNavigation="Cycle"
                                    KeyboardNavigation.ControlTabNavigation="Cycle"
                                    BorderThickness="2"
                                    CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TrophiesMenuToggle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Title -->
                                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Trophies options" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHighlightBrush}" FontSize="26" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <CheckBoxEx x:Name="CloseTrophiesMenu" Grid.Column="1" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,0,0" Style="{DynamicResource CheckBoxClose}" IsChecked="{Binding IsChecked, ElementName=TrophiesMenuToggle, Mode=TwoWay}">
                                            <CheckBoxEx.Content>
                                                <TextBlock Text="&#xec4f;" FontFamily="{DynamicResource FontIcoFont}" Foreground="{DynamicResource TextBrush}" FontSize="25" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            </CheckBoxEx.Content>
                                        </CheckBoxEx>
                                    </Grid>


                                    <!-- Separator -->
                                    <Rectangle Fill="{DynamicResource TextBrush}" Height="2" Opacity="0.40" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,5,0,5" />
                                    <!-- Sort -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource LOCSortby}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85"/>

                                        <ComboBoxEx Grid.Column="1"
                                                    pbeh:FocusBahaviors.FocusBinding="True"
                                                    pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                    SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort], Mode=TwoWay}"
                                                    Width="260">
                                            <ComboBoxItem Content="{DynamicResource LOCNewest}" Tag="Newest"/>
                                            <ComboBoxItem Content="{DynamicResource LOCOldest}" Tag="Oldest"/>
                                        </ComboBoxEx>
                                    </Grid>
                                    <!-- Separator -->
                                    <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.40" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,5,0,5" />
                                    <!-- Show -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource LOCShow}"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85"/>

                                        <ComboBoxEx Grid.Column="1"
                                                    SelectedValuePath="Tag"
                                                    SelectedValue="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophyFilter], Mode=TwoWay}"
                                                    Width="260">

                                            <ComboBoxItem Content="{DynamicResource LOCAll}" Tag="All"/>
                                            <ComboBoxItem Content="{DynamicResource LOCUnlockedOnly}" Tag="Unlocked"/>
                                            <ComboBoxItem Content="{DynamicResource LOCLockedOnly}" Tag="Locked"/>
                                        </ComboBoxEx>
                                    </Grid>
                                    <!-- Separator -->
                                    <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.40" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,5,0,5" />
                                    <!-- Hidden toggle -->
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,10">
                                        <CheckBoxEx x:Name="ShowHiddenToggle" Content="{DynamicResource LOCShowHiddenAchievements}" IsChecked="False"/>
                                    </StackPanel>
                                    <!-- Separator -->
                                    <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.40" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,5,0,5" />
                                    <!-- Refresh -->
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                        <ButtonEx Content="{DynamicResource LOCRefreshTrophies}"
                                                  Command="{PluginSettings Plugin=AnikiHelper, Path=RefreshSuccessStoryCommand}"/>

                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Rectangle Fill="{DynamicResource TextBrush}" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0" />

                            <!-- NEWEST (défaut) -->
                            <ListView x:Name="AchievementListNewest"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=SuccessStory, Path=ListAchUnlockDateDesc}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Newest">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <!-- OLDEST -->
                            <ListView x:Name="AchievementListOldest"
                                      Margin="10,60,0,10"
                                      ItemContainerStyle="{StaticResource AchievementListItemContainerStyle}"
                                      ItemsSource="{PluginSettings Plugin=SuccessStory, Path=ListAchUnlockDateAsc}">
                                <ListView.Style>
                                    <Style TargetType="ListView" BasedOn="{StaticResource AchievementListBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TrophySort]}" Value="Oldest">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                            </ListView>

                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.4" />
                            </Grid.Effect>

                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" >
                            <TextBlock Text="{DynamicResource LocTotalTrophiesUnlocked}"  Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,5,10" />
                            <TextBlock Text=" : " Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,5,10" />
                            <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Unlocked, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}"  FontSize="28"  Margin="0,50,0,10" />
                            <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="2,50,2,10" />
                            <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Total, FallbackValue='-'}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="28" Margin="0,50,0,10" />
                        </StackPanel>
                        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="B" Command="{Binding CloseCommand}"
                                          Content="{DynamicResource LOCBackLabel}" />

                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728">
                            <Setter Property="Margin" Value="-140,80,30,80" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--DLC-->
    <Style x:Key="CheckDLCWindowStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{DynamicResource SecondaryViewBackground}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-20" To="0"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="280"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <!-- Background -->
                        <FadeImage Source="{Binding SelectedGame.BackgroundImage}"
                                   Margin="0,-120,0,0"
                                   HorizontalContentAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Height="1000"
                                   Stretch="UniformToFill"
                                   Opacity="0.22" />

                        <!-- Top shade -->
                        <Border Grid.Row="0"
                                VerticalAlignment="Bottom"
                                Height="120">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- HEADER -->
                        <Border Grid.Row="0" Margin="0,20,0,0"
                                BorderThickness="0,0,0,0"
                                BorderBrush="{DynamicResource TopBar}"
                                Height="250"
                                VerticalAlignment="Top">

                            <Grid Margin="100,0,100,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Border Grid.Column="0" HorizontalAlignment="Left"
                                            Height="200"
                                            Margin="0,20,0,0"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource FocusGameBorderBrush}"
                                            Background="{DynamicResource OverlayMenu}">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="0"
                                                              BlurRadius="10"
                                                              Opacity="0.4"
                                                              Color="Black" />
                                        </Border.Effect>
                                        <Image Source="{Binding SelectedGame.CoverImageObjectCached}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               ClipToBounds="True"
                                               SnapsToDevicePixels="True"
                                               Height="200" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Vertical"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCDownloadableContent}"
                                                   HorizontalAlignment="Left"
                                                   FontSize="24"
                                                   Opacity="0.8"
                                                   Typography.Capitals="AllSmallCaps"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="WordEllipsis"
                                                   MaxWidth="1500"
                                                   Style="{DynamicResource TextBlockBaseStyle}" />

                                        <TextBlock Text="{Binding SelectedGame.DisplayName}"
                                                   HorizontalAlignment="Left"
                                                   FontSize="50"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="WordEllipsis"
                                                   MaxWidth="1000"
                                                   Style="{DynamicResource TextBlockBaseStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,290,0,0" Background="{DynamicResource SecondaryViewBackground}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="5"
                                                  BlurRadius="15"
                                                  Direction="90"
                                                  Opacity="0.8"
                                                  Color="Black" />
                            </Border.Effect>
                        </Border>

                        <!-- CONTENT -->
                        <Grid Grid.Row="1" VerticalAlignment="Center"
                              Margin="100,20,100,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="760"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT : DLC LIST -->
                            <Border Grid.Column="0" Height="700"
                                    CornerRadius="18">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="5"
                                                      BlurRadius="15"
                                                      Direction="90"
                                                      Opacity="0.45"
                                                      Color="Black"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundListNewsBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderListNewsBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ListDlcAll, Path=IsKeyboardFocusWithin}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderListNews}"/>
                                                <Setter Property="BorderThickness" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- list header -->
                                    <Border Grid.Row="0" CornerRadius="18,18,0,0"
                                            Background="{DynamicResource HeaderMenu}">
                                        <Grid Margin="20,0,20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="DLC List"
                                                       FontSize="26"
                                                       Style="{DynamicResource TextBlockBaseStyle}" />

                                            <!-- compteur -->
                                            <Border Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Padding="12,4"
                                                    Background="#22000000"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                <TextBlock FontSize="16"
                                                           Opacity="0.9"
                                                           Style="{DynamicResource TextBlockBaseStyle}"
                                                           Text="{Binding ElementName=ListDlcAll, Path=Items.Count, StringFormat={}{0} DLC}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- list -->
                                    <ListView x:Name="ListDlcAll"
                                              Grid.Row="1"
                                              Margin="10,10,10,10"
                                              ItemsSource="{PluginSettings Plugin=CheckDlc, Path=ListDlcs}"
                                              SelectedIndex="-1"
                                              IsSynchronizedWithCurrentItem="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              BorderBrush="Transparent"
                                              FocusVisualStyle="{x:Null}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="False"
                                              VirtualizingPanel.IsVirtualizing="False"
                                              HorizontalContentAlignment="Stretch"
                                              KeyboardNavigation.DirectionalNavigation="Continue"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              pbeh:FocusBahaviors.FocusBinding="True"
                                              pbeh:FocusBahaviors.OnVisibilityFocus="True">

                                        <ListView.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <Int32AnimationUsingKeyFrames Storyboard.TargetProperty="SelectedIndex">
                                                            <DiscreteInt32KeyFrame KeyTime="0:0:0.05" Value="0"/>
                                                        </Int32AnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ListView.Triggers>

                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Focusable" Value="True"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Margin" Value="0,0,0,14"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border x:Name="CardBorder"
                                                                    Background="{DynamicResource CardNewsBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource CardNewsBorderBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="{DynamicResource Corner}"
                                                                    Padding="0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect ShadowDepth="0"
                                                                                      BlurRadius="6"
                                                                                      Opacity="0.20"
                                                                                      Color="Black"/>
                                                                </Border.Effect>

                                                                <ContentPresenter/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource FocusCardNewsBorder}"/>
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource FocusCardNewsBackgroundBrush}"/>
                                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="3"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>

                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="120" Margin="14,10,14,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- IMAGE -->
                                                    <Border Grid.Column="0"
                                                            Margin="0,0,14,0"
                                                            CornerRadius="{DynamicResource Corner}"
                                                            Background="#16000000"
                                                            BorderBrush="#22000000"
                                                            BorderThickness="1"
                                                            ClipToBounds="True">
                                                        <Grid Background="#12000000">
                                                            <Image Source="{Binding Image}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- RIGHT SIDE -->
                                                    <Grid Grid.Column="1" Margin="0,4,0,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- TITLE -->
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="19"
                                                                   MaxHeight="48"
                                                                   Margin="0,0,0,6"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{DynamicResource TextBlockBaseStyle}" />

                                                        <Grid Grid.Row="1"/>

                                                        <!-- BOTTOM ROW -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- BADGES -->
                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Bottom">

                                                                <!-- OWNED -->
                                                                <Border Padding="10,3"
                                                                        Margin="0,0,8,0"
                                                                        Background="#5536B36B"
                                                                        CornerRadius="12">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{DynamicResource LOCCheckDlcOwned}"
                                                                               FontSize="15"
                                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                                </Border>

                                                                <!-- FREE -->
                                                                <Border Padding="10,3"
                                                                        Margin="0,0,8,0"
                                                                        Background="#553A86FF"
                                                                        CornerRadius="12">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFree}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{DynamicResource LOCCheckDlcFree}"
                                                                               FontSize="15"
                                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                                </Border>

                                                                <!-- DISCOUNT -->
                                                                <Border Padding="10,3"
                                                                        Background="#55C48B18"
                                                                        CornerRadius="12">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDiscount}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PriceBase}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Discount"
                                                                               FontSize="15"
                                                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- PRICE -->
                                                            <StackPanel Grid.Column="1"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Bottom">

                                                                <TextBlock HorizontalAlignment="Right"
                                                                           FontSize="24"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Text" Value="{Binding Price}" />
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Price}" Value="0">
                                                                                    <Setter Property="Text" Value="" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Price}" Value="">
                                                                                    <Setter Property="Text" Value="" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock Margin="0,2,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="15"
                                                                           Opacity="0.68"
                                                                           TextDecorations="Strikethrough">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                            <Setter Property="Text" Value="{Binding PriceBase}" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDiscount}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Setter Property="Text" Value="{Binding PriceBase}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDiscount}" Value="False">
                                                                                    <Setter Property="Text" Value="" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding PriceBase}" Value="">
                                                                                    <Setter Property="Text" Value="" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- RIGHT : DETAILS -->
                            <Border Grid.Column="2" Height="700"
                                    CornerRadius="{DynamicResource Corner}"
                                    DataContext="{Binding SelectedItem, ElementName=ListDlcAll}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="5"
                                                      BlurRadius="15"
                                                      Direction="90"
                                                      Opacity="0.45"
                                                      Color="Black"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundListNewsBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderListNewsBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=DlcDescContentScroll, Path=IsKeyboardFocusWithin}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderListNews}"/>
                                                <Setter Property="BorderThickness" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid Margin="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="270"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top detail block -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="440"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- IMAGE -->
                                        <Border Grid.Column="0"
                                                CornerRadius="{DynamicResource Corner}"
                                                Background="#16000000"
                                                BorderBrush="#22000000"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid Background="#12000000">
                                                <Image Source="{Binding Image}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="10"/>
                                            </Grid>
                                        </Border>

                                        <!-- RIGHT INFO -->
                                        <Grid Grid.Column="2"
                                              VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <!-- zone qui prend toute la hauteur du visuel -->
                                                <RowDefinition Height="*"/>
                                                <!-- séparateur -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- CONTENU ALIGNÉ SUR LA HAUTEUR DE L'IMAGE -->
                                            <Grid Grid.Row="0"
                                                  VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <!-- titre prend toute la place libre -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- badges + prix restent en bas -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- TITLE -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Name}"
                                                           FontSize="30"
                                                           MaxHeight="110"
                                                           Margin="0,0,0,0"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                                <!-- BADGE + PRICE LINE -->
                                                <Grid Grid.Row="1"
                                                      Margin="0,12,0,0"
                                                      VerticalAlignment="Bottom">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- badges left -->
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Bottom">

                                                        <Border Padding="10,4"
                                                                Margin="0,0,8,0"
                                                                Background="#5536B36B"
                                                                CornerRadius="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{DynamicResource LOCCheckDlcOwned}"
                                                                       FontSize="18"
                                                                       Style="{DynamicResource TextBlockBaseStyle}" />
                                                        </Border>

                                                        <Border Padding="10,4"
                                                                Margin="0,0,8,0"
                                                                Background="#553A86FF"
                                                                CornerRadius="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFree}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{DynamicResource LOCCheckDlcFree}"
                                                                       FontSize="18"
                                                                       Style="{DynamicResource TextBlockBaseStyle}" />
                                                        </Border>

                                                        <Border Padding="10,4"
                                                                Background="#55C48B18"
                                                                CornerRadius="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDiscount}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PriceBase}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Discount"
                                                                       FontSize="18"
                                                                       Style="{DynamicResource TextBlockBaseStyle}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- price right -->
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom">

                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="34"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Text" Value="{Binding Price}" />
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Price}" Value="0">
                                                                            <Setter Property="Text" Value="" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Price}" Value="">
                                                                            <Setter Property="Text" Value="" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Margin="0,2,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="20"
                                                                   Opacity="0.68"
                                                                   TextDecorations="Strikethrough">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Text" Value="{Binding PriceBase}" />
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDiscount}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Setter Property="Text" Value="{Binding PriceBase}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDiscount}" Value="False">
                                                                            <Setter Property="Text" Value="" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PriceBase}" Value="">
                                                                            <Setter Property="Text" Value="" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- divider -->
                                            <Rectangle Grid.Row="1"
                                                       Margin="0,14,0,0"
                                                       Height="1"
                                                       VerticalAlignment="Top"
                                                       Fill="{DynamicResource SeparatorBrush}"
                                                       Opacity="0.45"/>
                                        </Grid>
                                    </Grid>



                                    <!-- spacer -->
                                    <Grid Grid.Row="2"/>

                                    <!-- description -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BorderNews" Grid.Row="1" Grid.Column="1" Margin="10,20,0,0" Focusable="False" CornerRadius="12" HorizontalAlignment="Stretch">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FF000000" Offset="0.5"/>
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>

                                            <ScrollViewerEx x:Name="DlcDescContentScroll"
                                                            Focusable="True"
                                                            IsTabStop="True"
                                                            FocusVisualStyle="{x:Null}"
                                                            PanningMode="VerticalOnly"
                                                            ScrollViewer.CanContentScroll="False"
                                                            VerticalScrollBarVisibility="Auto">
                                                <HtmlTextView x:Name="DlcDescription"
                                                              HtmlText="{Binding Description}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColorNewsDesc}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              HtmlFontSize="20"
                                                              Focusable="False"
                                                              IsTabStop="False" />
                                            </ScrollViewerEx>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom" Effect="{DynamicResource SoftTextShadow}" HorizontalAlignment="Right" Margin="0,0,20,10">

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="Dpad"
                                          Content="{DynamicResource LOCButtonPrompt_Navigate}" />

                                <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                                          Tag="B" Command="{Binding CloseCommand}"
                                          Content="{DynamicResource LOCBackLabel}" />

                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=ActualWidth}" Value="1728">
                            <Setter Property="Margin" Value="-140,80,30,80" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp1610">
                <Setter Property="Margin" Value="0,-60,0,-60"/>
            </DataTrigger>
            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=AspectRatio}" Value="dsp219">
                <Setter Property="Margin" Value="-320,0,-320,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>