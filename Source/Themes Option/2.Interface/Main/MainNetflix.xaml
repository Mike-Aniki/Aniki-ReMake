                        <!-- WELCOME Hub -->
                        <Grid x:Name="HubRoot" Tag="{PluginSettings Plugin=AnikiHelper, Path=HubCurrentPageTag}" Margin="0,0,0,10" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HubRootScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="HubRootShift" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Grid x:Name="HubTopBarBackground" VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="0" Height="80" Panel.ZIndex="1" FocusVisualStyle="{x:Null}">


                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Opacity" Value="0.9"/>
                                        <Setter Property="Margin" Value="0,0,0,0"/>

                                        <Style.Triggers>

                                            <!-- PAGE 1 + pas de focus + Performance OFF + auto-hide ON -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocusWithin}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AutoHideTopButtonBar]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,-120,0,0" Duration="0:0:0.45">
                                                                <ThicknessAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseIn"/>
                                                                </ThicknessAnimation.EasingFunction>
                                                            </ThicknessAnimation>

                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.45">
                                                                <ThicknessAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseOut"/>
                                                                </ThicknessAnimation.EasingFunction>
                                                            </ThicknessAnimation>

                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <!-- auto-hide OFF => toujours visible -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AutoHideTopButtonBar]}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Opacity" Value="0.9"/>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </MultiDataTrigger>

                                            <!-- Performance mode => toujours visible -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Opacity" Value="0.9"/>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid>


                                    <!-- Fond verre -->
                                    <Border CornerRadius="0" Background="{DynamicResource TopBar}" Opacity="{DynamicResource OpacityBar}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                    <!-- Reflet vertical discret -->
                                    <Border Opacity="{DynamicResource OpacityBar}" CornerRadius="0" IsHitTestVisible="False" Background="{DynamicResource GlassMainBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                    <!-- Hairline -->
                                    <Border HorizontalAlignment="Stretch" Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorTopBarBrush}" Opacity="{DynamicResource OpacityBar}" CornerRadius="0"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
