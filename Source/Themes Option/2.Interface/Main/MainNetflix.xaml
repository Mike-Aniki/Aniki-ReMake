                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:2" Duration="0:0:0.20"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="600" To="0" BeginTime="0:0:2" Duration="0:0:0.35" AccelerationRatio="0.3" DecelerationRatio="0.7"/>

                                                        <!-- Battement continu X pendant toute la notification -->
                                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:2" Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>

