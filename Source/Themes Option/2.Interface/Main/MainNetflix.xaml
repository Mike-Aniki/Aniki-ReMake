                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowLock}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- LOG OUT USER -->
                                            <ButtonEx x:Name="LogoutCommand" Tag="" Content="{DynamicResource LOCMenuLogoutUser}" Command="{Binding Data.MainMenu.LogoutUserCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
