                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiWindowOpen}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="LoadedBehavior" Value="Pause"/>
                                        </MultiDataTrigger>

