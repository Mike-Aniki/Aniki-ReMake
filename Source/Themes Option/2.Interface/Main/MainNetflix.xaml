    <!-- Netflix cards use native GridItemWidth / GridItemHeight. -->
    <!-- Netflix cards use the normal Aniki item styles. -->
    <DataTemplate x:Key="AnikiNetflixGameCardTemplate">
        <!-- Each Netflix slot is 1/8 row width; cover keeps native ratio. -->
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="Transparent">

            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top">
                <Grid Width="{Settings GridItemWidth}"
                      Height="{Settings GridItemHeight}"
                      Background="Transparent">

                    <ctrl:GameListItem Style="{DynamicResource ListGameItemTemplate}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       DataContext="{Binding}"/>
                </Grid>
            </Viewbox>

            <!-- Netflix rows hide game names; native cover badges remain. -->

        </Grid>
    </DataTemplate>

    <!-- Fondu d’entrée de la piste. -->
    <Storyboard x:Key="ThemeMusicFadeIn" FillBehavior="HoldEnd">
        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="LoadedBehavior">
            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static media:MediaState.Play}"/>
        </ObjectAnimationUsingKeyFrames>

        <DoubleAnimation Storyboard.TargetProperty="Volume" From="0" Duration="0:0:1.2">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Fondu de sortie, puis pause à volume nul. -->
    <Storyboard x:Key="ThemeMusicFadeOutPause" FillBehavior="HoldEnd">
        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="LoadedBehavior">
            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static media:MediaState.Play}"/>
            <DiscreteObjectKeyFrame KeyTime="0:0:1.2" Value="{x:Static media:MediaState.Pause}"/>
        </ObjectAnimationUsingKeyFrames>

        <DoubleAnimation Storyboard.TargetProperty="Volume" To="0" Duration="0:0:1.2">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Stop Hub soundtrack while Setup closes. -->
    <Storyboard x:Key="FirstSetupMusicFadeOutStop" FillBehavior="Stop">
        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="LoadedBehavior">
            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static media:MediaState.Play}"/>
            <DiscreteObjectKeyFrame KeyTime="0:0:0.38" Value="{x:Static media:MediaState.Stop}"/>
        </ObjectAnimationUsingKeyFrames>
        <DoubleAnimation Storyboard.TargetProperty="Volume" To="0" Duration="0:0:0.38">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

