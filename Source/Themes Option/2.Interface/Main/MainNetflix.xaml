                                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.00" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.25" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:4.55" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.30" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.55" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:6.85" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.60" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:8.85" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:9.15" Value="1"/>

                                                            <SplineDoubleKeyFrame KeyTime="0:0:10.90" Value="1"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.15" Value="1.035"/>
                                                            <SplineDoubleKeyFrame KeyTime="0:0:11.45" Value="1"/>
                                                        </DoubleAnimationUsingKeyFrames>

