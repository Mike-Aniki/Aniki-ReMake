                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=SleepCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=HibernateCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=RestartCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=ShutdownCommand, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
