                                                                </Setter>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- image user masquée en rond -->
                                                    <Grid Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid.OpacityMask>
                                                            <VisualBrush Visual="{Binding ElementName=AvatarMaskHeader}"/>
                                                        </Grid.OpacityMask>

                                                        <Control x:Name="UserAvatarHeader" Tag="{Binding ElementName=ProfilePicturePathHeader, Path=Text}" Width="56" Height="56" Template="{StaticResource SteamSelfAvatarTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"/>
                                                    </Grid>

                                                    <!-- contour rond -->
                                                    <Border Width="56" Height="56" CornerRadius="28" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.4" Background="#14000000" IsHitTestVisible="False" Panel.ZIndex="5"/>
                                                </Grid>

                                                <!-- TEXTS -->
                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Nom -->
                                                    <TextBlock x:Name="UserNameHeader" Grid.Row="0" Text="{DynamicResource UserName}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Statut -->
                                                    <StackPanel x:Name="UserStatusRow" Grid.Row="1" Orientation="Horizontal" Margin="0,-3,0,0" VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{PluginStatus Plugin=AnikiHelper_96a983a3-3f13-4dce-a474-4052b718bb52, Status=Installed}" Value="True"/>
                                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsStatusVisibility}" Value="Visible"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <!-- DOT -->
                                                        <Border x:Name="UserStatusDot" Width="10" Height="10" CornerRadius="4.5" Margin="0,0,5,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#B0000000">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.96"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="online">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="offline">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="away">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="busy">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="notrunning">
                                                                            <Setter Property="Background" Value="#5A7D9A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <!-- TEXT -->
                                                        <TextBlock x:Name="UserStatusHeader" FontSize="16" Opacity="0.9" Style="{DynamicResource TextBlockBaseStyle}" VerticalAlignment="Center" Text="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsStatusButtonText}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </ButtonEx>
