                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnMainView]}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                Focusable="False"
                                                                IsHitTestVisible="False">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True"/>
                                                                        <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnMainView]}" Value="True"/>
                                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=TrailerTrigger, Path=Opacity}" Value="1"/>
                                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[TrailerOnMainView]}" Value="True"/>
                                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable}" Value="True"/>
                                                                        <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>


                            <Grid x:Name="NetflixPageRoot"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="3"
                                  Background="Transparent"
                                  Panel.ZIndex="0">
                                <!-- Keep Netflix UI collapsed until startup bindings resolve. -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ViewHost, Path=Visibility}" Value="Visible"/>
                                                    <Condition Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Collapsed"/>
                                                    <Condition Binding="{Binding ElementName=WelcomeControl, Path=Visibility}" Value="Collapsed"/>
                                                    <Condition Binding="{Binding ElementName=WrongColumns, Path=Visibility}" Value="Collapsed"/>
                                                    <Condition Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Collapsed"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="500"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="NetflixHeroBlock"
                                          Height="500"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top"
                                          ClipToBounds="False"
                                          Focusable="False"
                                          IsHitTestVisible="False">


                                    <StackPanel x:Name="NetflixHeroContent"
                                                Width="710"
                                                Margin="58,32,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Panel.ZIndex="12"
                                                Focusable="False"
                                                IsHitTestVisible="False">

                                        <Grid x:Name="LogoVisual" Height="165" HorizontalAlignment="Left">
                                            <TextBlock x:Name="MainLogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                        <Binding Path="SelectedGame.Id"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <Image x:Name="MainLogoImage"
                                                   Source="{Binding ElementName=MainLogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant"
                                                   MaxWidth="585"
                                                   MaxHeight="160"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=MainLogoImage, Path=Source}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- Delay text fallback while the ExtraMetadata logo resolves. -->
                                            <TextBlock Text="{Binding SelectedGame.DisplayName}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="48"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="650"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Opacity="0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=MainLogoImage, Path=Source}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="NetflixFallbackTitleDelay">
                                                                        <Storyboard BeginTime="0:0:0.45">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             To="1"
                                                                                             Duration="0:0:0.10"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="NetflixFallbackTitleDelay"/>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             To="0"
                                                                                             Duration="0:0:0"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Compact Hero metadata based on CompactGameInfoBar. -->
                                        <WrapPanel x:Name="NetflixHeroCompactInfo"
                                                   Width="700"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Opacity="0.92">

                                            <!-- GENRE -->
                                            <StackPanel x:Name="NetflixHeroInfoGenre" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Genres[0]}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE8EC;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.Genres[0]}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.Genres[1]}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" Opacity="0.78" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- RELEASE DATE -->
                                            <StackPanel x:Name="NetflixHeroInfoRelease" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.ReleaseDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE787;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource ReleaseDateToStringConverter}}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- CRITIC SCORE -->
                                            <StackPanel x:Name="NetflixHeroInfoCritic" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.CriticScore}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE735;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.CriticScore}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- ACHIEVEMENTS -->
                                            <StackPanel x:Name="NetflixHeroInfoAchievements" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginStatus Plugin=PlayniteAchievements, Status=Installed}" Value="True"/>
                                                                    <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xe903;" FontFamily="{DynamicResource FontIcomoon}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}/{1}  ({2}%)">
                                                            <Binding Path="Text" ElementName="NetflixHeroAchievementsUnlocked"/>
                                                            <Binding Path="Text" ElementName="NetflixHeroAchievementsTotal"/>
                                                            <Binding Path="Text" ElementName="NetflixHeroAchievementsPercent"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock x:Name="NetflixHeroAchievementsUnlocked" Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Visibility="Collapsed"/>
                                                <TextBlock x:Name="NetflixHeroAchievementsTotal" Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Visibility="Collapsed"/>
                                                <TextBlock x:Name="NetflixHeroAchievementsPercent" Text="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, FallbackValue='-'}" Visibility="Collapsed"/>
                                            </StackPanel>

                                            <!-- PLAYTIME -->
                                            <StackPanel x:Name="NetflixHeroInfoPlaytime" Orientation="Horizontal" Margin="0,0,18,8" Tag="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- INSTALL SIZE -->
                                            <StackPanel x:Name="NetflixHeroInfoInstallSize" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xe904;" FontFamily="{DynamicResource FontIcomoon}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <TextBlock Text="{PluginSettings Plugin=AnikiHelper, Path=SelectedGameInstallSizeNoDecimal}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- FAVORITE -->
                                            <StackPanel x:Name="NetflixHeroInfoFavorite" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Favorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xEB51;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.9" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource LOCGameFavoriteTitle}" Margin="7,0,0,0" Style="{StaticResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- AGE RATINGS -->
                                            <StackPanel x:Name="NetflixHeroInfoAge" Orientation="Horizontal" Margin="0,0,18,8" Tag="{Binding SelectedGame.AgeRatings, Converter={StaticResource ListToStringConverter}}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ItemsControlEx ItemsSource="{Binding SelectedGame.AgeRatings}" IsTabStop="False" IsEnabled="False" Focusable="False" VerticalAlignment="Center">
                                                    <ItemsControlEx.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControlEx.ItemsPanel>
                                                    <ItemsControlEx.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Height="22" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True" Source="{ThemeFileBinding Name, PathFormat='Icons/AgeRating/Alt/{0}.png'}">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </DataTemplate>
                                                    </ItemsControlEx.ItemTemplate>
                                                </ItemsControlEx>
                                            </StackPanel>

                                            <!-- SOURCE / PLATFORM -->
                                            <StackPanel x:Name="NetflixHeroInfoSource" Orientation="Horizontal" Margin="0,0,18,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}"/>
                                                                    <Condition Binding="{Binding SelectedGame.Platforms[0].Name}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource TextBlockBaseStyle}" FontSize="17" Opacity="0.82" VerticalAlignment="Center"/>
                                                <Grid Margin="7,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedGame.Source.Name}" FontSize="16" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SelectedGame.Platforms[0].Name}" FontSize="16" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Platforms[0].Name}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedGame.Platforms[0].Name}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>

                                            <!-- FEATURES: same existing option as the normal compact bar. -->
                                            <ItemsControl x:Name="NetflixHeroInfoFeatures" Margin="0,0,10,8" ItemsSource="{Binding SelectedGame.Features}" Focusable="False" VerticalAlignment="Center">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[FeaturesSteamMain]}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Width="22" Height="22" Margin="0,0,6,0" Opacity="0.86" Stretch="Uniform" Source="{ThemeFileBinding Name, PathFormat='Icons/Features/{0}.png'}" RenderOptions.BitmapScalingMode="Fant">
                                                            <Image.Style>
                                                                <Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>

                                        <!-- Keep description clear of the first row. -->
                                        <Grid Width="680" Height="132" Margin="0,4,0,0" HorizontalAlignment="Left" Focusable="False" ClipToBounds="True">
                                            <Grid.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.72"/>
                                                    <GradientStop Color="#E8FFFFFF" Offset="0.82"/>
                                                    <GradientStop Color="#A8FFFFFF" Offset="0.90"/>
                                                    <GradientStop Color="#48FFFFFF" Offset="0.97"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Grid.OpacityMask>
                                            <HtmlTextView HtmlText="{Binding SelectedGame.Description}"
                                                          Height="132"
                                                          MaxHeight="132"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          IsHitTestVisible="False"
                                                          HtmlFontSize="16"
                                                          HtmlFontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI Variable Display Semibold, Segoe UI Semibold, Segoe UI"
                                                          HtmlForeground="{DynamicResource TextColor}"
                                                          LinkForeground="{DynamicResource GlyphColor}"
                                                          FocusVisualStyle="{x:Null}"/>
                                        </Grid>
                                    </StackPanel>
                                    </Grid>



                                <!-- Only the lower viewport scrolls. -->
                                <ScrollViewer x:Name="NetflixRowsScroller"
                                              Grid.Row="1"
                                              Margin="0,-28,0,0"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Background="Transparent">
                                <ContentControl x:Name="AnikiHelper_MainRows"
                                                                                    Margin="43,0,0,56"
                                                                                    HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    VerticalContentAlignment="Top"
                                                                                    Focusable="False"/>
                                </ScrollViewer>
                            </Grid>

                            <!-- Hidden Playnite list kept for native game-list infrastructure. -->
                            <Grid x:Name="NetflixTechnicalParts"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="3"
                                  Width="1"
                                  Height="1"
                                  Opacity="0"
                                  Visibility="Visible"
                                  IsHitTestVisible="False"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Panel.ZIndex="-1000">
                                <ListBoxEx x:Name="PART_ListGameItems"
                                           Width="1"
                                           Height="1"
                                           MinWidth="1"
                                           MinHeight="1"
                                           Opacity="0"
                                           Visibility="Visible"
                                           Focusable="True"
                                           IsHitTestVisible="False"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           FocusVisualStyle="{x:Null}"/>

                                <!-- Hidden native Details action triggered by Aniki Helper. -->
                                <ButtonEx x:Name="PART_ButtonDetails"
                                          Width="1"
                                          Height="1"
                                          Opacity="0"
                                          Visibility="Visible"
                                          Focusable="False"
                                          IsHitTestVisible="False"
                                          FocusVisualStyle="{x:Null}"
                                          Tag="DetailsAction"
                                          Content="{DynamicResource LOCSettingsGameDetailsLabel}"/>

                                <!-- Compatibility markers used by shared Aniki triggers. -->
                                <CheckBoxEx x:Name="ChangeViewButton" IsChecked="False" Visibility="Collapsed" Focusable="False"/>
                                <Grid x:Name="DetailedListView" Visibility="Collapsed" Focusable="False"/>
                                <Grid x:Name="ListGame" Visibility="Collapsed" Focusable="False"/>
                            </Grid>

                            <!-- End PART_ViewHost -->
                        </Grid>

                        <!-- Notification -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="10" Width="10" Focusable="False">
                            <TextBlock x:Name="Id" Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0" To="0"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.01" From="0" To="1" BeginTime="0:0:0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock x:Name="Trigger" Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}" Foreground="Transparent">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
