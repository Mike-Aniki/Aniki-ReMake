                            <ContentControl Style="{DynamicResource ConnexionVideo}" Tag="{Binding ElementName=AcceuilSettings, Path=IsVisible}"/>

                            <!-- Rare Mode / Lucky video override -->
                            <ContentControl x:Name="LuckyLoginVideoOverrideStyle1" Focusable="False" IsHitTestVisible="False" Panel.ZIndex="0" Tag="{Binding ElementName=AcceuilSettings, Path=IsVisible}">
