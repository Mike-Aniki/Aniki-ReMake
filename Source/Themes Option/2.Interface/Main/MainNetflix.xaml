                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>

                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MediaElement.Style>
                                                            </MediaElement>
                                                        </ControlTemplate>
                                                    </Setter.Value>
