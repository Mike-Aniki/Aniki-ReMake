                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowSuspend}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- HIBERNATE SYSTEM -->
                                            <ButtonEx x:Name="HibernateCommand" Tag="" Content="{DynamicResource LOCMenuHibernateSystem}" Command="{Binding Data.MainMenu.HibernateSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
