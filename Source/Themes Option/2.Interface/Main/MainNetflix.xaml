                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- RESTART SYSTEM -->
                                            <ButtonEx x:Name="RestartCommand" Tag="" Content="{DynamicResource LOCMenuRestartSystem}" Command="{Binding Data.MainMenu.RestartSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowRestart}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- SHUTDOWN SYSTEM -->
                                            <ButtonEx x:Name="ShutdownCommand" Tag="" Content="{DynamicResource LOCMenuShutdownSystem}" Command="{Binding Data.MainMenu.ShutdownSystemCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
