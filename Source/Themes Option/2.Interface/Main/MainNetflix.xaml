                                        </StackPanel>
                                    </ScrollViewer>


                                    <!-- SEPARATOR -->
                                    <Border Grid.Row="3" Height="1" Margin="22,0" Background="#20FFFFFF"/>


                                    <!-- FOOTER -->
                                    <Grid Grid.Row="4" Height="58" Margin="22,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource LOCPower}" FontSize="13" FontWeight="Bold" Style="{DynamicResource TextBlockBaseStyle}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                            <ButtonEx Style="{DynamicResource ButtonBottomMenuDark}" Tag="CancelAction" Content="{DynamicResource LOCBackLabel}" Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}" CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]"/>

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Grid>


                        <Grid>
                            <ContentControl x:Name="UPS_MusicControl">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Tag" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>



                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=LocalTrailer, Path=Volume}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=TrailerVideoLoadedFlag, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=LocalTrailer, Path=Volume}" Value="0"/>
                                                    <Condition Binding="{Binding ElementName=TrailerVideoLoadedFlag, Path=IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="False"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>


                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubClosing}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="False"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- Pause UPS dans les fenêtres Aniki, sauf en Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>

                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- Pause UPS when another Windows app is foreground. -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="False">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <!-- Standalone Video Player always has audio priority. -->
                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="True">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <!-- Pause UPS avec le navigateur Web, sauf en Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWebBrowserOpen}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <!-- ScreenSaver soundtrack has priority over UPS, except Radio Mode. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>



                            <ContentControl x:Name="Sounds_MusicControl">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Tag" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="True"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerContainer, Path=Opacity}" Value="1"/>
                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Tag" Value="False"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsWelcomeHubOpen}" Value="True">
                                                <Setter Property="Tag" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>


                        <!-- Sound -->


                        <!-- ScreenSaver ambient soundtrack. Theme/UPS music is paused while this is active. -->
                        <MediaElement x:Name="ScreenSaverOST"
                                      Source="{PluginSettings Plugin=AnikiHelper, Path=SoundPackScreenSaverOstPath}"
                                      Volume="{Settings Fullscreen.BackgroundVolume}"
                                      MediaElementBehaviors.Repeat="True">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <!-- ========================================================== MUSIQUE DES FENÊTRES SECONDAIRES — MODE NORMAL ========================================================== -->

                        <MediaElement x:Name="SecondaryViewsOSTNormal" Source="{PluginSettings Plugin=AnikiHelper, Path=SoundPackSecondaryViewsOstPath}" Volume="{Settings Fullscreen.BackgroundVolume}" MediaElementBehaviors.Repeat="True">

                            <MediaElement.Style>
                                <Style TargetType="MediaElement">

                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Jouer uniquement en mode normal -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsMediaGalleryVideoPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="False"/>

                                            
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>


                                        <!-- Radio Mode prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- Arrêter complètement la musique normale en Lucky Mode -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- ========================================================== MUSIQUE DES FENÊTRES SECONDAIRES — LUCKY STYLE 1 ========================================================== -->

                        <MediaElement x:Name="SecondaryViewsOSTLuckyStyle1" Source="{ThemeFile 'audio/Lucky/SecondaryViewsOST.mp3'}" Volume="{Settings Fullscreen.BackgroundVolume}" MediaElementBehaviors.Repeat="True">

                            <MediaElement.Style>
                                <Style TargetType="MediaElement">

                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Jouer uniquement en Lucky Style 1 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsMediaGalleryVideoPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="True"/>

                                            
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>

                                        <!-- Radio Mode prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- Arrêter complètement si le Style 1 n'est pas actif -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="False">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- ========================================================== MUSIQUE DES FENÊTRES SECONDAIRES — LUCKY STYLE 2 ========================================================== -->

                        <MediaElement x:Name="SecondaryViewsOSTLuckyStyle2" Source="{ThemeFile 'audio/Lucky/SecondaryViewsOST2.mp3'}" Volume="{Settings Fullscreen.BackgroundVolume}" MediaElementBehaviors.Repeat="True">

                            <MediaElement.Style>
                                <Style TargetType="MediaElement">

                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Jouer uniquement en Lucky Style 2 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsSecondaryMusicWindowOpen}" Value="True"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsMediaGalleryVideoPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsAnikiVideoPlayerPlaying}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="False"/>

                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="True"/>

                                            
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsPlayniteApplicationActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeIn}"/>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace" Storyboard="{StaticResource ThemeMusicFadeOutPause}"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>


                                        <!-- Radio Mode prioritaire -->
                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=RadioModeEnabled, FallbackValue=False}" Value="True">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                        <!-- Arrêter complètement si le Style 2 n'est pas actif -->
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="False">

                                            <Setter Property="LoadedBehavior" Value="Stop"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- Normal login OST -->
                        <MediaElement x:Name="AcceuilOpen" Source="{PluginSettings Plugin=AnikiHelper, Path=SoundPackLoginOstPath}" MediaElementBehaviors.Repeat="True" Volume="{Settings Fullscreen.BackgroundVolume}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Play normal OST only when Lucky Mode is NOT active -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="False"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- Lucky / Rare Mode Login OST - Style 1 -->
                        <MediaElement x:Name="AcceuilOpenLuckyStyle1" Source="{ThemeFile 'audio/Lucky/LoginOST.mp3'}" MediaElementBehaviors.Repeat="True" Volume="{Settings Fullscreen.BackgroundVolume}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Play Lucky Style 1 OST only when Lucky Style 1 is active -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle1}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>


                        <!-- Lucky / Rare Mode Login OST - Style 2 -->
                        <MediaElement x:Name="AcceuilOpenLuckyStyle2" Source="{ThemeFile 'audio/Lucky/LoginOST2.mp3'}" MediaElementBehaviors.Repeat="True" Volume="{Settings Fullscreen.BackgroundVolume}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual"/>
                                    <Setter Property="UnloadedBehavior" Value="Close"/>

                                    <Style.Triggers>

                                        <!-- Play Lucky Style 2 OST only when Lucky Style 2 is active -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Visible"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="LoadedBehavior" Value="Play"/>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=AcceuilSettings, Path=Visibility}" Value="Collapsed">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyStyle2}" Value="False">
                                            <Setter Property="LoadedBehavior" Value="Close"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsScreenSaverAmbientMusicActive}" Value="True">
                                            <Setter Property="LoadedBehavior" Value="Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <!-- Lucky / Rare Mode Notification Sound - Style 1 -->
                        <MediaElement x:Name="LuckyMessageSoundStyle1" Source="{ThemeFile 'audio/Lucky/Noti.wav'}" Volume="{Settings Fullscreen.InterfaceVolume}" MediaElementBehaviors.Repeat="False">
                            <MediaElement.Style>
