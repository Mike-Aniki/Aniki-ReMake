                                        <!-- contenu texte -->
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,34,0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                <Grid HorizontalAlignment="Center">
                                                    <!-- Normal login title -->
                                                    <TextBlock Text="{DynamicResource LOCWelcomeBack}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
