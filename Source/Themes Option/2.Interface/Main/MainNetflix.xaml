                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Rare mode login title -->
                                                    <TextBlock Text="{DynamicResource LOCLuckyDayActivated}" HorizontalAlignment="Center" Foreground="{DynamicResource TextHighlightBrush}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <TextBlock Text="{DynamicResource UserName}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="36" FontWeight="SemiBold" Style="{DynamicResource TextBlockBaseStyle}"/>

                                                <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
                                                    <!-- Normal login subtitle -->
                                                    <TextBlock Text="{DynamicResource LOCGoodToSee}" HorizontalAlignment="Center" FontSize="16" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Rare mode login subtitle -->
                                                    <TextBlock Text="{DynamicResource LOCLuckyDayActivated2}" HorizontalAlignment="Center" FontSize="16" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=IsLuckyDay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                            </StackPanel>
                                        </Grid>


                                        <!-- AVATAR OVERLAP -->
                                        <Grid Width="250" Height="250" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-120,0,0,0" Panel.ZIndex="5">

                                            <Grid Width="201" Height="201" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">

                                                <!-- masque rond -->
                                                <Border x:Name="AvatarMask" Width="201" Height="201" Background="Black" CornerRadius="101"/>

                                                <!-- image user masquée en rond -->
                                                <Grid Width="201" Height="201" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.OpacityMask>
                                                        <VisualBrush Visual="{Binding ElementName=AvatarMask}"/>
                                                    </Grid.OpacityMask>

                                                    <TextBlock x:Name="ProfilePicturePathLogin" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text">
                                                                    <Setter.Value>
                                                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Control x:Name="UserAvatarLogin" Tag="{Binding ElementName=ProfilePicturePathLogin, Path=Text}" Width="201" Height="201" Template="{StaticResource SteamSelfAvatarTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"/>
                                                </Grid>

                                                <!-- contour rond -->
                                                <Border Width="201" Height="201" CornerRadius="101" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="2" Background="#23000000" IsHitTestVisible="False" Panel.ZIndex="5"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,-300" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="2" Opacity="1" RenderingBias="Performance"/>
                                    </Grid.Effect>



                                    <!-- glow discret -->
                                    <Border x:Name="PressAToContinueGlow" Padding="18,8,18,8" CornerRadius="18" Background="#66FFFFFF" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>

                                                <Style.Triggers>
                                                    <Trigger Property="IsVisible" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard x:Name="PressAToContinuePulse_SB">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.80" Duration="0:0:1.5"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>

                                                        <Trigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="PressAToContinuePulse_SB"/>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border x:Name="BackgroundButton" Padding="16,4,16,4" CornerRadius="18" Background="{DynamicResource BottomBar}" Opacity="0.6" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">

                                    </Border>

                                    <!-- capsule -->
                                    <Border Padding="16,4,16,4" CornerRadius="18" BorderBrush="{DynamicResource FocusGameBorderBrush}" BorderThickness="1.5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCPress}" FontSize="22" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"/>

                                            <ButtonEx Margin="-18,0,-20,0" Style="{DynamicResource ButtonBottomMenu}" Tag="A" Opacity="1"/>

                                            <TextBlock Text="{DynamicResource LOCCcontinue}" Margin="0,0,0,0" FontSize="22" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- FOOTER -->
                                <TextBlock Text="Aniki ReMake v3.4.3 Beta" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" FontSize="16" Opacity="0.30" Foreground="White" Style="{DynamicResource TextBlockBaseStyle}"/>
                            </Grid>


                            <StackPanel KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.ControlTabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" Margin="0,0,0,370" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0">

                                <ToggleButtonEx x:Name="Acceuil" Focusable="True" pbeh:FocusBahaviors.OnVisibilityFocus="True" VerticalAlignment="Center" Margin="20,0,20,0" Width="280" Style="{DynamicResource AcceuilChangeToggle}" Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}" CommandParameter="[Setter ElementName=LockScreen, Property=IsChecked, Value=False]">

                                    <ToggleButtonEx.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <MediaTimeline Source="{ThemeFile 'audio/Connexion.mp3'}" Storyboard.TargetName="ConnexionClick"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ToggleButtonEx.Triggers>

                                    <ToggleButtonEx.Content>
                                        <Grid>
                                            <Border RenderOptions.BitmapScalingMode="Fant" CornerRadius="{DynamicResource Corner}" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Height" Value="60"/>
                                                                <Setter Property="Width" Value="60"/>
                                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </ToggleButtonEx.Content>
                                </ToggleButtonEx>
                            </StackPanel>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[AcceuilOrNot]}" Value="False"/>
                                                <Condition Binding="{Binding ElementName=LockScreen, Path=IsChecked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=LockScreen, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="1"/>

                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1" Duration="0:0:0.25"/>

                                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1" Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=TOMissing, Path=Visibility}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ElementName=Acceuil, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>


                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- Power ControlCenter -->
                        <Grid x:Name="Power" Panel.ZIndex="50" Focusable="True" Background="#99000000" KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.ControlTabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" FocusManager.FocusedElement="{Binding ElementName=ExitCommand}">

                            <Grid.InputBindings>
                                <pin:GameControllerInputBinding Button="B" Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}" CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]"/>

                                <KeyBinding Key="Esc" Command="{Binding Data.ChangeProperty, Source={StaticResource ANIKIHELPER_Commands}}" CommandParameter="[Setter ElementName=ButtonPower, Property=IsChecked, Value=True]"/>
                            </Grid.InputBindings>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ButtonPower, Path=IsChecked}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.Resources>

                                <!-- ========================================================== POWER MENU BUTTON STYLE ========================================================== -->
                                <Style x:Key="PowerMenuButtonStyle" TargetType="ButtonEx">
                                    <Setter Property="Height" Value="68"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="IsTabStop" Value="True"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ButtonEx">

                                                <Grid Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">

                                                    <!-- NORMAL BACKGROUND -->
                                                    <Border x:Name="NormalBackground" CornerRadius="7" Background="#10000000" BorderBrush="#12FFFFFF" BorderThickness="1"/>

                                                    <!-- FOCUS BACKGROUND -->
                                                    <Border x:Name="MainBackground" CornerRadius="7" Background="{DynamicResource ButtonBackgroundFocus}" Visibility="Collapsed"/>

                                                    <!-- FOCUS BORDER -->
                                                    <Border x:Name="MainBorder" BorderThickness="2" CornerRadius="7" BorderBrush="{DynamicResource FocusGameBorderBrush}" Visibility="Collapsed"/>

                                                    <!-- FLASH FX -->
                                                    <Border x:Name="FlashMenuBorder" CornerRadius="7" Style="{DynamicResource AnimatedFlashMenu}" Tag="False" Visibility="Collapsed"/>

                                                    <ContentPresenter Margin="18,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                                                </Grid>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="NormalBackground" Property="Background" Value="#26000000"/>
                                                    </Trigger>

                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Grid.Resources>


                            <!-- MAIN PANEL -->
                            <Grid x:Name="PowerPanel" Width="520" HorizontalAlignment="Left" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.ControlTabNavigation="Contained">
                                <Grid.Resources>
                                    <Style x:Key="PowerButtonStyle" TargetType="ButtonEx">
                                        <Setter Property="Height" Value="72"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Focusable" Value="True"/>
                                        <Setter Property="IsTabStop" Value="True"/>
                                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ButtonEx">

                                                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">

                                                        <!-- FOCUS BACKGROUND -->
                                                        <Border x:Name="MainBackground" Margin="0" CornerRadius="4" Background="{DynamicResource ButtonBackgroundFocus}" Visibility="Collapsed"/>

                                                        <!-- FOCUS BORDER -->
                                                        <Border x:Name="MainBorder" Margin="0" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource FocusGameBorderBrush}" Visibility="Collapsed"/>

                                                        <!-- FLASH FX -->
                                                        <Border x:Name="FlashMenuBorder" Margin="0" CornerRadius="4" Style="{DynamicResource AnimatedFlashMenu}" Tag="False" Visibility="Collapsed"/>

                                                        <!-- CONTENT -->
                                                        <Grid Margin="18,0">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- ICON -->
                                                            <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="{StaticResource FontIcons}" FontSize="25" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True"/>

                                                            <!-- LABEL -->
                                                            <ContentPresenter Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" TextElement.FontFamily="{DynamicResource FontMain}" TextElement.FontSize="22" TextElement.FontWeight="SemiBold" TextElement.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>

                                                            <!-- CHEVRON / EMPTY SLOT -->
                                                            <TextBlock Grid.Column="2" Text="" FontFamily="{DynamicResource FontIcons}" FontSize="16" Opacity="0" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        </Grid>

                                                    </Grid>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </Trigger>

                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MainBackground" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FlashMenuBorder" Property="Tag" Value="True"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>

                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-60" To="0" Duration="0:0:0.30">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <!-- PANEL BACKGROUND -->
                                <Border Background="{DynamicResource OverlayMenu}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,1,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="#000000" RenderingBias="Performance"/>
                                    </Border.Effect>
                                </Border>

                                <!-- GLASS OVERLAY -->
                                <Border Background="{DynamicResource GlassMainBrush}" IsHitTestVisible="False" Opacity="0.55"/>


                                <!-- INNER CONTENT -->
                                <Grid Margin="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#33000000" Grid.Row="0"/>
                                    <Border Background="#33000000" Grid.Row="4"/>


                                    <!-- HEADER -->
                                    <Grid Grid.Row="0" Height="96" Margin="22,10,22,10">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="54" Height="54" CornerRadius="27" Background="#14000000" BorderBrush="#24FFFFFF" BorderThickness="1" VerticalAlignment="Center">

                                            <TextBlock Text="" FontFamily="{DynamicResource FontIcons}" Foreground="{DynamicResource TextHighlightBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="16,0,0,0">

                                            <TextBlock Text="{DynamicResource LOCPowerControlCenter}" Style="{DynamicResource TextBlockBaseStyle}" Foreground="{DynamicResource TextHighlightBrush}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{DynamicResource LOCPowerControlCenter}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="16" FontWeight="SemiBold" Opacity="0.65" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                    </Grid>


                                    <!-- SEPARATOR -->
                                    <Border Grid.Row="1" Height="1" Margin="22,0" Background="#20FFFFFF"/>


                                    <!-- BUTTONS -->
                                    <ScrollViewer Grid.Row="2" Margin="16,14,16,14" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">

                                        <StackPanel Orientation="Vertical" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">

                                            <!-- EXIT PLAYNITE -->
                                            <ButtonEx x:Name="ExitCommand" pbeh:FocusBahaviors.OnVisibilityFocus="True" Tag="" Content="{DynamicResource LOCExitPlaynite}" Command="{Binding Data.MainMenu.ExitCommand, Source={StaticResource ANIKIHELPER_Commands}}" Style="{StaticResource PowerButtonStyle}"/>

                                            <!-- MINIMIZE -->
                                            <ButtonEx x:Name="MinimizeCommand" Tag="" Content="{DynamicResource LOCMinimize}" Command="{Binding Data.MainMenu.MinimizeCommand, Source={StaticResource ANIKIHELPER_Commands}}">
                                                <ButtonEx.Style>
                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource PowerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings Fullscreen.MainMenuShowMinimize}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ButtonEx.Style>
                                            </ButtonEx>

                                            <!-- DESKTOP MODE -->
                                            <ButtonEx x:Name="DesktopCommand" Tag="" Content="{DynamicResource LOCBackToDesktopMode}" Command="{Binding SwitchToDesktopCommand}" Style="{StaticResource PowerButtonStyle}"/>

                                            <!-- SEPARATOR -->
                                            <Border Height="1" Margin="22,5,22,5" Background="#20FFFFFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=LockCommand, Path=Visibility}" Value="Collapsed"/>
                                                                    <Condition Binding="{Binding ElementName=LogoutCommand, Path=Visibility}" Value="Collapsed"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- LOCK SYSTEM -->
