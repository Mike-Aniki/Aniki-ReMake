<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Style de l'item. Le focus visuel est maintenant dessine dans ListGameItemTemplate.xaml
         afin de pouvoir suivre la largeur reelle de PART_ImageCover. -->
    <Style x:Key="ListGameItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <CubicEase x:Key="EaseOutSoft" EasingMode="EaseOut"/>
                        <QuadraticEase x:Key="EaseOutFast" EasingMode="EaseOut"/>

                        <Storyboard x:Key="SB_ToNone">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.14"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.14"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_ToFocus">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.035" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.035" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_ToHover">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.02" Duration="0:0:0.12"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.02" Duration="0:0:0.12"
                                             EasingFunction="{StaticResource EaseOutFast}"/>
                        </Storyboard>

                        <Storyboard x:Key="SB_ToFocusHover">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.045" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.045" Duration="0:0:0.16"
                                             EasingFunction="{StaticResource EaseOutSoft}"/>
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <Grid x:Name="ListBoxGrid"
                          RenderTransformOrigin="0.5,0.5"
                          Margin="{Settings FullscreenItemSpacingMargin}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="FocusTransform" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <ContentPresenter x:Name="ItemContent">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Margin" Value="0,-10,0,-20"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <Border x:Name="GameTitleBackground"
                                CornerRadius="{DynamicResource Corner}"
                                Margin="0"
                                BorderThickness="0"
                                Background="{DynamicResource GameTitleBrush}"
                                Opacity="0.6"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed" />

                        <Border x:Name="NonFocus"
                                Opacity="0"
                                CornerRadius="{DynamicResource Corner}"
                                Margin="0"
                                BorderThickness="0"
                                Background="#7000" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Le contour de focus est gere dans ListGameItemTemplate.xaml.
                             On conserve ici le ZIndex et les animations de zoom. -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GameTitleBackground" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GameTitleBackground" />
                        </Trigger>

                        <!-- Etat 1 : Focus + Hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                <BeginStoryboard x:Name="BS_FocusHover"
                                                 Storyboard="{StaticResource SB_ToFocusHover}"
                                                 HandoffBehavior="SnapshotAndReplace"/>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>

                        <!-- Etat 2 : Focus seul -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                <BeginStoryboard x:Name="BS_Focus"
                                                 Storyboard="{StaticResource SB_ToFocus}"
                                                 HandoffBehavior="SnapshotAndReplace"/>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>

                        <!-- Etat 3 : Hover seul -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="BS_None"/>
                                <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                <BeginStoryboard x:Name="BS_Hover"
                                                 Storyboard="{StaticResource SB_ToHover}"
                                                 HandoffBehavior="SnapshotAndReplace"/>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>

                        <!-- Etat 4 : Ni focus ni hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode]}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="BS_Hover"/>
                                <RemoveStoryboard BeginStoryboardName="BS_Focus"/>
                                <RemoveStoryboard BeginStoryboardName="BS_FocusHover"/>
                                <BeginStoryboard x:Name="BS_None"
                                                 Storyboard="{StaticResource SB_ToNone}"
                                                 HandoffBehavior="SnapshotAndReplace"/>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatineLogicStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="{Settings FullscreenItemSpacingMargin}"
                          RenderTransformOrigin="0.5,0.5"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Completed">
                            <Setter Property="IsSelected" Value="True"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
