<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp">



    <!-- Control Center identity block. -->
    <DataTemplate x:Key="AnikiControlCenterIdentityTemplate">
        <Grid Margin="20,0,0,5"
              Effect="{DynamicResource SoftTextShadow}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->
                <Grid Width="56"
                      Height="56"
                      VerticalAlignment="Center">

                    <!-- masque rond -->
                    <Border x:Name="AvatarMaskControlCenter"
                            Width="56"
                            Height="56"
                            Background="Black"
                            CornerRadius="28"/>



                    <!-- path image avatar -->
                    <TextBlock x:Name="ProfilePicturePathControlCenter"
                               Tag="{Api Paths.ConfigurationPath}"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\Themes\Common\ProfilePicture.png">
                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- image user masquée en rond -->
                    <Grid Width="56"
                          Height="56"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=AvatarMaskControlCenter}" />
                        </Grid.OpacityMask>

                        <Control x:Name="UserAvatarControlCenter"
                                 Tag="{Binding ElementName=ProfilePicturePathControlCenter, Path=Text}"
                                 Width="56"
                                 Height="56"
                                 Template="{StaticResource SteamSelfAvatarTemplate}"
                                 Focusable="False"
                                 IsTabStop="False"
                                 IsHitTestVisible="False"/>
                    </Grid>

                    <!-- contour rond -->
                    <Border Width="56"
                            Height="56"
                            CornerRadius="28"
                            BorderBrush="{DynamicResource TextBrush}"
                            BorderThickness="1.4"
                            Background="#14000000"
                            IsHitTestVisible="False"
                            Panel.ZIndex="5"/>
                </Grid>

                <!-- TEXTS -->
                <Grid Grid.Column="2"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nom -->
                    <TextBlock x:Name="UserNameControlCenter"
                               Grid.Row="0"
                               Text="{DynamicResource UserName}"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Statut -->
                    <StackPanel x:Name="UserStatusControlCenterRow"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,-3,0,0"
                                VerticalAlignment="Center">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SteamFriendsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- DOT -->
                        <Border x:Name="UserStatusControlCenterDot"
                                Width="10"
                                Height="10"
                                CornerRadius="4.5"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                BorderBrush="#B0000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                    <Setter Property="Opacity" Value="0.96"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="online">
                                            <Setter Property="Background" Value="{DynamicResource StatusOnlineBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="offline">
                                            <Setter Property="Background" Value="{DynamicResource StatusOfflineBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="away">
                                            <Setter Property="Background" Value="{DynamicResource StatusAwayBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="busy">
                                            <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="ingame">
                                            <Setter Property="Background" Value="{DynamicResource StatusInGameBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=SelfState}" Value="notrunning">
                                            <Setter Property="Background" Value="#5A7D9A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- TEXT -->
                        <TextBlock x:Name="UserStatusControlCenter"
                                   FontSize="16"
                                   Opacity="0.9"
                                   Style="{DynamicResource TextBlockBaseStyle}"
                                   VerticalAlignment="Center"
                                   Text="{PluginSettings Plugin=AnikiHelper, Path=SelfStateLoc}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Controller hint for the Control Center overlay. -->
    <DataTemplate x:Key="AnikiControlCenterBottomHintTemplate">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Height="110"
              Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Effect="{DynamicResource SoftTextShadow}"
                        HorizontalAlignment="Right"
                        Margin="0,0,26,18">
                <ctrl:ButtonEx Style="{DynamicResource ButtonBottomMenuDark}"
                               Tag="B"
                               Content="{DynamicResource LOCBackLabel}"
                               FontSize="19"
                               MinWidth="120"
                               Height="44"
                               Padding="10,0,10,0"
                               Focusable="False"
                               IsTabStop="False"
                               IsHitTestVisible="False" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Used by Aniki Helper in-game / Control Center overlay. -->
    <Style x:Key="AnikiControlCenterTopButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Background="Transparent">

                        <Border x:Name="HoverBackground"
                                CornerRadius="9"
                                Background="#00000000"
                                Opacity="0" />

                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          Opacity="0.82"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />

                        <Border x:Name="FocusBorder"
                                Height="3"
                                Width="78"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,1"
                                CornerRadius="2"
                                Background="{TemplateBinding BorderBrush}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.35" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.96" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ContentHost" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverBackground" Property="Background" Value="#22000000" />
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>