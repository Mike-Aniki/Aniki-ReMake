    <Style x:Key="IconStartAcceuil" TargetType="ButtonEx" BasedOn="{StaticResource ButtonBottomMenu}">
        <Setter Property="InputHint" Value="{DynamicResource ButtonPromptStart}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <!-- Conteneur du bouton -->
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">
                        <!-- Contenu du bouton -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Affichage de l'indication de saisie -->
                            <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                            Height="45" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Focusable="False"/>
                            <!-- Texte du bouton -->
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="25"
                                       VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonBottomMenuDual" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="18,0,18,0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Button icon -->
                            <Image x:Name="IconImg"
                                   Width="40"
                                   Height="40"
                                   Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Style="{DynamicResource IconYButton}" />

                            <!-- Text block -->
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center">

                                <!-- Main action -->
                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ButtonIconLightBrush}"
                                           Text="{TemplateBinding Content}" />

                                <!-- Hold action -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,1,0,0"
                                            Opacity="0.65">

                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ButtonIconLightBrush}"
                                               Text="Hold: " />

                                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ButtonIconLightBrush}"
                                               Text="{TemplateBinding CommandParameter}" />

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconYButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconStartButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconAButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconBButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconXButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconBackButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconLeftStickButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconRightStickButton}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================== Icon Styles (Image Source switch par plateforme) Default fallback = Xbox (si setting inconnu) ========================================================== -->

    <!-- A -->
    <Style x:Key="IconAButton" TargetType="Image">
        <Setter Property="Source" Value="{DynamicResource ImageButtonA-Xbox}" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings Fullscreen.ButtonPrompts}" Value="Xbox">
