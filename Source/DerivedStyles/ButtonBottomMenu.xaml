<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Définition du style pour les boutons du menu inférieur -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            Margin="20,0,20,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- ICON (default = B) -->
                            <Grid Width="40"
                                  Height="40"
                                  Margin="0,0,5,0">

                                <Image x:Name="IconImg"
                                       Width="40"
                                       Height="40"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Style="{DynamicResource IconBButton}" />

                                <ContentControl x:Name="BumperHint"
                                                Width="40"
                                                Height="40"
                                                Focusable="False"
                                                Visibility="Collapsed" />

                            </Grid>

                            <!-- TEXT -->
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ButtonIconLightBrush}">
                                <ContentPresenter />
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="A">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconAButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="B">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconBButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="X">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconXButton}" />
                        </Trigger>

                        <!-- Play = X par défaut -->
                        <Trigger Property="Tag" Value="PlayAction">
                            <Setter TargetName="IconImg"
                                    Property="Style"
                                    Value="{DynamicResource IconXButton}" />
                        </Trigger>

                        <!-- Details = A par défaut -->
                        <Trigger Property="Tag" Value="DetailsAction">
                            <Setter TargetName="IconImg"
                                    Property="Style"
                                    Value="{DynamicResource IconAButton}" />
                        </Trigger>

                        <!-- Quand Playnite inverse A et X : Play = A -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Value="PlayAction" />
                                <Condition Binding="{Settings Fullscreen.SwapStartDetailsAction}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="IconImg"
                                    Property="Style"
                                    Value="{DynamicResource IconAButton}" />
                        </MultiDataTrigger>

                        <!-- Quand Playnite inverse A et X : Details = X -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Value="DetailsAction" />
                                <Condition Binding="{Settings Fullscreen.SwapStartDetailsAction}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="IconImg"
                                    Property="Style"
                                    Value="{DynamicResource IconXButton}" />
                        </MultiDataTrigger>

                        <Trigger Property="Tag" Value="Y">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconYButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Start">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconStartButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Back">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconBackButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="Dpad">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconDpadButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="LS">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconLeftStickButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="RS">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImg" Property="Style" Value="{DynamicResource IconRightStickButton}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="L1">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="ContentTemplate" Value="{DynamicResource ButtonPromptLeftBumper}" />
                        </Trigger>

                        <Trigger Property="Tag" Value="R1">
                            <Setter TargetName="IconImg" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BumperHint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BumperHint" Property="ContentTemplate" Value="{DynamicResource ButtonPromptRightBumper}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

