<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:ctrl="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
                    mc:Ignorable="d">



    <!-- Définition du style pour les éléments de la liste de jeux -->
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <!-- Définition des propriétés par défaut -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <!-- Définition du modèle de contrôle -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">

                    <Grid ClipToBounds="False">
                        <!-- Ombre -->


                        <Border CornerRadius="{DynamicResource Corner}" ClipToBounds="True">

                            <Grid>
                                <Grid x:Name="CoverWithBannerRoot" ClipToBounds="False">

                                    <Grid.RowDefinitions>
                                        <!-- Bannière -->
                                        <RowDefinition Height="30"/>
                                        <!-- Cover -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- BANNIÈRE TOP -->
                                    <Border x:Name="TopBanner"
                                            Grid.Row="0"
                                            Panel.ZIndex="3"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource Corner}"
                                            ClipToBounds="True"
                                            IsHitTestVisible="False">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>

                                            <!-- Custom banner folders defined in Aniki Helper.
                                            Expected structure:
                                            CustomBannerAboveCoverFolder/Steam.png
                                            CustomBannerOnCoverFolder/Steam.png -->
                                            <TextBlock x:Name="CustomBannerAboveCoverFolderPath"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=CustomBannerAboveCoverFolder}"
                                                       Visibility="Collapsed"/>

                                            <TextBlock x:Name="CustomBannerOnCoverFolderPath"
                                                       Text="{PluginSettings Plugin=AnikiHelper, Path=CustomBannerOnCoverFolder}"
                                                       Visibility="Collapsed"/>

                                            <TextBlock x:Name="CustomSourceHorizontalBannerPath"
                                                       Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomBannerAboveCoverFolderPath"/>
                                                        <Binding Path="Game.Source.Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock x:Name="CustomPlatformHorizontalBannerPath"
                                                       Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomBannerAboveCoverFolderPath"/>
                                                        <Binding Path="Game.Platforms[0].Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock x:Name="CustomSourceOnCoverBannerPath"
                                                       Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomBannerOnCoverFolderPath"/>
                                                        <Binding Path="Game.Source.Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock x:Name="CustomPlatformOnCoverBannerPath"
                                                       Visibility="Collapsed">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}.png">
                                                        <Binding Path="Text" ElementName="CustomBannerOnCoverFolderPath"/>
                                                        <Binding Path="Game.Platforms[0].Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- ABOVE COVER MODE -->
                                            <Grid x:Name="HorizontalBannerContent">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Custom source banner -->
                                                <Image x:Name="CustomSourceHorizontal"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{Binding Text, ElementName=CustomSourceHorizontalBannerPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=CustomBannerAboveCoverFolderPath, Path=Text}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Default theme source banner -->
                                                <Image x:Name="SourceHorizontal"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Banner/Horizontal/{0}.png', FallbackValue={x:Null}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=CustomPlatformHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Custom platform banner, used only if source banner is unavailable -->
                                                <Image x:Name="CustomPlatformHorizontal"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{Binding Text, ElementName=CustomPlatformHorizontalBannerPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding ElementName=CustomBannerAboveCoverFolderPath, Path=Text}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Default theme platform banner -->
                                                <Image x:Name="PlatformHorizontal"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Banner/Horizontal/{0}.png', FallbackValue={x:Null}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=SourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=CustomPlatformHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>


                                            <!-- ON COVER MODE -->
                                            <Grid x:Name="OnCoverBannerContent">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Custom source on-cover banner -->
                                                <Image x:Name="CustomSourceOnCover"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left"
                                                       Source="{Binding Text, ElementName=CustomSourceOnCoverBannerPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=CustomBannerOnCoverFolderPath, Path=Text}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Default theme source on-cover banner -->
                                                <Image x:Name="SourceOnCover"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left"
                                                       Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Banner/OnCover/{0}.png', FallbackValue={x:Null}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=CustomPlatformOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Custom platform on-cover banner, used only if source banner is unavailable -->
                                                <Image x:Name="CustomPlatformOnCover"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left"
                                                       Source="{Binding Text, ElementName=CustomPlatformOnCoverBannerPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding ElementName=CustomBannerOnCoverFolderPath, Path=Text}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Default theme platform on-cover banner -->
                                                <Image x:Name="PlatformOnCover"
                                                       RenderOptions.BitmapScalingMode="Fant"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left"
                                                       Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Banner/OnCover/{0}.png', FallbackValue={x:Null}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=SourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding ElementName=CustomPlatformOnCover, Path=Visibility}" Value="Collapsed"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                    <!-- COVER -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.RowSpan" Value="2"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Grid.Row" Value="1"/>
                                                        <Setter Property="Grid.RowSpan" Value="1"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="Mask"
                                                Background="#181A1E"
                                                BorderThickness="0"
                                                CornerRadius="{DynamicResource Corner}"
                                                IsHitTestVisible="False"/>

                                        <Image x:Name="PART_ImageCover"
                                               RenderOptions.BitmapScalingMode="Linear"
                                               StretchDirection="Both"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Stretch="{Settings CoverArtStretch}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginStatus Plugin=playnite-backgroundchanger-plugin, Status=Installed}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataCover}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableCoverImage}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Canvas x:Name="Playing" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Polygon Points="0,0 50,0 0,50" Fill="{DynamicResource GlyphBrush}" Opacity="0.2"/>
                                        </Canvas>

                                        <Border x:Name="BorderDarken"
                                                Background="Black"
                                                IsHitTestVisible="False"
                                                Panel.ZIndex="1"
                                                CornerRadius="{DynamicResource Corner}"
                                                Visibility="Collapsed"
                                                Opacity="0.55">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Margin" Value="0,-30,0,0"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                        </Border>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="Collapsed"
                                                   Style="{DynamicResource TextBlockBaseStyle}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Top"
                                                   TextAlignment="Center"
                                                   Padding="0"
                                                   Background="{DynamicResource ControlBackgroundDarkBrush}"/>

                                        <Grid x:Name="BackgroundChanger">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginStatus Plugin=playnite-backgroundchanger-plugin, Status=Installed}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableCoverImage}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataCover}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <ContentControl x:Name="BackgroundChanger_PluginCoverImage"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            ClipToBounds="True">

                                                <ContentControl.Resources>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Stretch" Value="{Settings CoverArtStretch}"/>
                                                        <Setter Property="StretchDirection" Value="Both"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="Linear"/>
                                                    </Style>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Grid Panel.ZIndex="2" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CompletionStatusOnOff]}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock x:Name="CompletionStatus"
                                               Text="{Binding CompletionStatus}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="22"
                                               FontFamily="Segoe UI SemiBold"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Bottom"
                                               TextAlignment="Center"
                                               Padding="0"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,-1"
                                               Width="Auto">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Background" Value="{DynamicResource ColorBottomBarOtherViewBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text.Length, ElementName=CompletionStatus}" Value="0">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </Grid>

                                <!-- SOURCE / PLATFORM LOGO BADGE ON COVER
                                Looks for: ThemeFolder/Icons/Logo/Steam.png
                                Priority: Source logo first, then first Platform logo. -->
                                <Grid x:Name="CoverLogoBadge"
                                      Panel.ZIndex="4"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Width="30"
                                      Height="30">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Margin" Value="0,0,8,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverLogoBadge]}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Image x:Name="CoverSourceLogoBadge"
                                           RenderOptions.BitmapScalingMode="Fant"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Logo/{0}.png', FallbackValue={x:Null}}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <Image x:Name="CoverPlatformLogoBadge"
                                           RenderOptions.BitmapScalingMode="Fant"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Logo/{0}.png', FallbackValue={x:Null}}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=CoverSourceLogoBadge, Path=Visibility}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>


                                <!--IconGamePass-->
                                <Grid Panel.ZIndex="2" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="False"/>
                                                        <Condition Binding="{Binding Game.Source.Name}" Value="Xbox Game Pass"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverLogoBadge]}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Image x:Name="GamePassIcon" RenderOptions.BitmapScalingMode="Fant" MaxHeight="22" Margin="5,5,0,0"
                                           VerticalAlignment="Top" HorizontalAlignment="Left"
                                           Source="{ThemeFile 'Images/GamePass.png'}"/>
                                </Grid>


                                <!--Back To Game-->
                                <ContentControl x:Name="BackToGame_Control" FocusVisualStyle="{x:Null}" Focusable="False"/>
                                <TextBlock x:Name="GameIsRunningBadge"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Background="{DynamicResource BackgroundMenu}"
                                           Text="{DynamicResource LOCGameRunning}"
                                           VerticalAlignment="Top"
                                           TextAlignment="Center"
                                           Margin="0,0,0,15"
                                           Padding="0,0,0,5"
                                           FontSize="23"
                                           HorizontalAlignment="Stretch"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource TextBlockBaseStyle}" />

                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Mask}" RenderOptions.BitmapScalingMode="Fant" Stretch="Fill"/>
                                </Grid.OpacityMask>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding ElementName=BackToGame_Control, Path=Content.IsRunning}" Value="True" >
                            <Setter Property="Text" Value="{DynamicResource LOCBackToGame}" TargetName="GameIsRunningBadge" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedGame.Source.Name}" Value="GG.deals Wishlist">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BorderDarken" />
                        </DataTrigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DetailedListItemTemplate">
        <ctrl:GameListItem FocusVisualStyle="{x:Null}">
            <ctrl:GameListItem.Template>
                <ControlTemplate TargetType="{x:Type ctrl:GameListItem}">
                    <Grid Height="88">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover -->

                        <Viewbox Width="80"
                                 Stretch="Uniform">
                            <Grid Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <Image x:Name="PART_ImageCover"
                                       Stretch="{Settings CoverArtStretch}"
                                       StretchDirection="Both"
                                       RenderOptions.BitmapScalingMode="Fant"/>
                            </Grid>
                        </Viewbox>


                        <!-- Infos -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource TextBlockBoldBaseStyle}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="14"
                                       Opacity="0.72"/>
                        </StackPanel>

                        <TextBlock Text="&#xef08;"
                                   FontFamily="{StaticResource FontIcoFont}"
                                   FontSize="24"
                                   Opacity="0.8"
                                   Foreground="{DynamicResource TextBrush}"
                                   Grid.Column="3"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Center"
                                   Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Opacity" Value="0.72"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ctrl:GameListItem.Template>
        </ctrl:GameListItem>
    </DataTemplate>

    <Style x:Key="DetailedListItemContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="#14000000"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="16"
                            Padding="12,10">

                        <Grid>
                            <Border x:Name="AccentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Margin="-2,8,0,8"
                                    CornerRadius="3"
                                    Background="{DynamicResource FocusGameBorderBrush}"
                                    Opacity="0"/>

                            <ContentPresenter Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter TargetName="Root" Property="Background" Value="#30FFFFFF"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
