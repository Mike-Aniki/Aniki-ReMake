<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:ctrl="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
                    mc:Ignorable="d">

    <!-- Reflet lent et discret -->
    <Style x:Key="AnimatedFlashCover" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
                    <GradientStop Color="{DynamicResource CoverFlash_Transparent}" Offset="0"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Transparent}" Offset="0.28"/>
                    <GradientStop Color="{DynamicResource CoverFlash_VerySoft}" Offset="0.38"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Soft}" Offset="0.44"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Core}" Offset="0.50"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Tail}" Offset="0.56"/>
                    <GradientStop Color="{DynamicResource CoverFlash_VerySoft}" Offset="0.66"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Transparent}" Offset="0.78"/>
                    <GradientStop Color="{DynamicResource CoverFlash_Transparent}" Offset="1"/>
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform X="-1.40"/>
                    </LinearGradientBrush.RelativeTransform>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Visibility}" Value="Visible"/>
                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverReflection], FallbackValue=False}" Value="True"/>
                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode], FallbackValue=False}" Value="False"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFastNavigating, FallbackValue=False}" Value="False"/>
                </MultiDataTrigger.Conditions>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StartCoverPremiumFlash" HandoffBehavior="SnapshotAndReplace">
                        <Storyboard BeginTime="0:0:2.00" Duration="0:0:10.50" RepeatBehavior="2x" FillBehavior="Stop" Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="Background.(Brush.RelativeTransform).(TranslateTransform.X)" From="-1.40" To="1.40" BeginTime="0:0:0" Duration="0:0:2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:1.55" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="StartCoverPremiumFlash"/>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Définition du style pour les éléments de la liste de jeux -->
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <!-- Définition des propriétés par défaut -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <!-- Définition du modèle de contrôle -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">

                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="CoverPremiumFlashTemplate">
                            <Border Style="{StaticResource AnimatedFlashCover}"
                                    Tag="True"
                                    CornerRadius="{DynamicResource Corner}"
                                    IsHitTestVisible="False"/>
                        </DataTemplate>

                        <DataTemplate x:Key="HorizontalBannerContentTemplate">
                            <Grid>
                                <TextBlock x:Name="CustomBannerAboveCoverFolderPath"
                                           Text="{PluginSettings Plugin=AnikiHelper, Path=CustomBannerAboveCoverFolder}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="CustomSourceHorizontalBannerPath"
                                           Visibility="Collapsed">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}.png">
                                            <Binding Path="Text" ElementName="CustomBannerAboveCoverFolderPath"/>
                                            <Binding Path="Game.Source.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock x:Name="CustomPlatformHorizontalBannerPath"
                                           Visibility="Collapsed">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}.png">
                                            <Binding Path="Text" ElementName="CustomBannerAboveCoverFolderPath"/>
                                            <Binding Path="Game.Platforms[0].Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <Image x:Name="CustomSourceHorizontal"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Text, ElementName=CustomSourceHorizontalBannerPath, IsAsync=True}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[StretchBanner]}" Value="True">
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CustomBannerAboveCoverFolderPath, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="SourceHorizontal"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Banner/Horizontal/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=CustomPlatformHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="CustomPlatformHorizontal"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Text, ElementName=CustomPlatformHorizontalBannerPath, IsAsync=True}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[StretchBanner]}" Value="True">
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CustomBannerAboveCoverFolderPath, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="PlatformHorizontal"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Banner/Horizontal/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=SourceHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=CustomPlatformHorizontal, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="OnCoverBannerContentTemplate">
                            <Grid>
                                <TextBlock x:Name="CustomBannerOnCoverFolderPath"
                                           Text="{PluginSettings Plugin=AnikiHelper, Path=CustomBannerOnCoverFolder}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="CustomSourceOnCoverBannerPath"
                                           Visibility="Collapsed">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}.png">
                                            <Binding Path="Text" ElementName="CustomBannerOnCoverFolderPath"/>
                                            <Binding Path="Game.Source.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock x:Name="CustomPlatformOnCoverBannerPath"
                                           Visibility="Collapsed">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}.png">
                                            <Binding Path="Text" ElementName="CustomBannerOnCoverFolderPath"/>
                                            <Binding Path="Game.Platforms[0].Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <Image x:Name="CustomSourceOnCover"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Source="{Binding Text, ElementName=CustomSourceOnCoverBannerPath, IsAsync=True}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[StretchBanner]}" Value="True">
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CustomBannerOnCoverFolderPath, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="SourceOnCover"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Banner/OnCover/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=CustomPlatformOnCover, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="CustomPlatformOnCover"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Source="{Binding Text, ElementName=CustomPlatformOnCoverBannerPath, IsAsync=True}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[StretchBanner]}" Value="True">
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=CustomBannerOnCoverFolderPath, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="PlatformOnCover"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Banner/OnCover/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CustomSourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=SourceOnCover, Path=Visibility}" Value="Collapsed"/>
                                                        <Condition Binding="{Binding ElementName=CustomPlatformOnCover, Path=Visibility}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="CoverLogoBadgeTemplate">
                            <Grid>
                                <Image x:Name="CoverSourceLogoBadge"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Logo/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Image x:Name="CoverPlatformLogoBadge"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Icons/Logo/{0}.png', FallbackValue={x:Null}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CoverSourceLogoBadge, Path=Visibility}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="GamePassIconTemplate">
                            <Image x:Name="GamePassIcon"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   MaxHeight="22"
                                   Margin="8,8,0,0"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Source="{ThemeFile 'Images/GamePass.png'}"/>
                        </DataTemplate>
                        <DataTemplate x:Key="AboveCoverBannerHostTemplate">
                            <Border Background="Transparent"
                                    CornerRadius="{DynamicResource Corner}"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource HorizontalBannerContentTemplate}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsHitTestVisible="False"/>
                            </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="OverlayBannerHostTemplate">
                            <Border Background="Transparent"
                                    CornerRadius="{DynamicResource Corner}"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource OnCoverBannerContentTemplate}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsHitTestVisible="False"/>
                            </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="CompletionStatusTemplate">
                            <Grid IsHitTestVisible="False">
                                <TextBlock Text="{Binding CompletionStatus}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="22"
                                           FontFamily="Segoe UI SemiBold"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Bottom"
                                           TextAlignment="Center"
                                           Padding="0"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,-1"
                                           Width="Auto">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Background" Value="{DynamicResource ColorBottomBarOtherViewBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text.Length}" Value="0">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="GameRunningBadgeTemplate">
                            <TextBlock Background="{DynamicResource BackgroundMenu}"
                                       Text="{DynamicResource LOCGameRunning}"
                                       VerticalAlignment="Top"
                                       TextAlignment="Center"
                                       Margin="0,0,0,15"
                                       Padding="0,0,0,5"
                                       FontSize="23"
                                       HorizontalAlignment="Stretch"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource TextBlockBaseStyle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Text" Value="{DynamicResource LOCGameRunning}"/>
                                        <Style.Triggers>
                                            <!-- Content is BackToGame_Control.Content.IsRunning -->
                                            <DataTrigger Binding="{Binding}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource LOCBackToGame}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>

                        <DataTemplate x:Key="UninstalledDarkenTemplate">
                            <Border Background="Black"
                                    IsHitTestVisible="False"
                                    CornerRadius="{DynamicResource Corner}"
                                    Opacity="0.55">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Margin" Value="0,-30,0,0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="GGDealsWishlistTintTemplate">
                            <Border Background="Black"
                                    IsHitTestVisible="False"
                                    CornerRadius="{DynamicResource Corner}"
                                    Opacity="0.20">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                    <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Margin" Value="0,-30,0,0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>

                    </ControlTemplate.Resources>

                    <Grid ClipToBounds="False">
                        <!-- Ombre -->


                        <Border CornerRadius="{DynamicResource Corner}" ClipToBounds="True">

                            <Grid>
                                <Grid x:Name="CoverWithBannerRoot" ClipToBounds="False">

                                    <Grid.RowDefinitions>
                                        <!-- Bannière -->
                                        <RowDefinition Height="30"/>
                                        <!-- Cover -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- BANNIÈRE TOP
                                         Step 4B: lazy host. When PlatformBanner is disabled,
                                         the Border/Grid/images of the banner are not instantiated. -->
                                    <ContentControl x:Name="TopBanner"
                                                    Grid.Row="0"
                                                    Panel.ZIndex="3"
                                                    Content="{Binding}"
                                                    IsHitTestVisible="False"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="ContentTemplate" Value="{x:Null}"/>

                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="ContentTemplate" Value="{StaticResource AboveCoverBannerHostTemplate}"/>
                                                    </MultiDataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="ContentTemplate" Value="{StaticResource OverlayBannerHostTemplate}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <!-- COVER -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.RowSpan" Value="2"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="True"/>
                                                            <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBannerOverlay]}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Grid.Row" Value="1"/>
                                                        <Setter Property="Grid.RowSpan" Value="1"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="Mask"
                                                Background="#181A1E"
                                                BorderThickness="0"
                                                CornerRadius="{DynamicResource Corner}"
                                                IsHitTestVisible="False"/>

                                        <Image x:Name="PART_ImageCover"
                                               RenderOptions.BitmapScalingMode="Linear"
                                               StretchDirection="Both"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Stretch="{Settings CoverArtStretch}"/>


                                        <!-- ImageRotater -->

                                        <ContentControl x:Name="ImageRotater_Cover"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ClipToBounds="True"
                                                        IsHitTestVisible="False"/>

                                        <!-- Step 4E: lazy darkening overlay.
                                             When "Darken uninstalled games" doesn't apply, the black
                                             Border is not instantiated for this cover. -->
                                        <ContentControl x:Name="BorderDarken"
                                                        Content="{Binding}"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"/>

                                        <!-- GG.deals wishlist overlay: lighter than the standard
                                             uninstalled darken layer, only to help the cart icon stand out. -->
                                        <ContentControl x:Name="GGDealsWishlistTint"
                                                        Content="{Binding}"
                                                        Panel.ZIndex="1"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"/>

                                        <!-- BackgroundChanger -->
                                        <ContentControl x:Name="BackgroundChanger_PluginCoverImage"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ClipToBounds="True"
                                                        IsHitTestVisible="False"/>

                                        <!-- Reflet sur la cover focus
                                             Step 4A: the reflection visual tree is created only for the
                                             focused cover, after rapid navigation has settled. -->
                                        <ContentControl x:Name="CoverPremiumFlash"
                                                        Content="{Binding}"
                                                        Panel.ZIndex="3"
                                                        IsHitTestVisible="False"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverReflection], FallbackValue=False}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PerformanceMode], FallbackValue=False}" Value="False"/>
                                                                <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=IsFastNavigating, FallbackValue=False}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource CoverPremiumFlashTemplate}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>

                                    </Grid>
                                </Grid>

                                <!-- Completion status
                                     Step 4C: when the option is disabled, the TextBlock and its
                                     bindings are not instantiated for every cover. -->
                                <ContentControl x:Name="CompletionStatusHost"
                                                Content="{Binding}"
                                                Panel.ZIndex="2"
                                                IsHitTestVisible="False"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CompletionStatusOnOff]}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CompletionStatusTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <ContentControl x:Name="CoverLogoBadge"
                                                Content="{Binding}"
                                                Panel.ZIndex="4"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Width="30"
                                                Height="30">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Margin" Value="0,0,8,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverLogoBadge]}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CoverLogoBadgeTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>


                                <!-- IconGamePass -->
                                <ContentControl Content="{Binding}"
                                                Panel.ZIndex="2"
                                                IsHitTestVisible="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[PlatformBanner]}" Value="False"/>
                                                        <Condition Binding="{Binding Game.Source.Name}" Value="Xbox Game Pass"/>
                                                        <Condition Binding="{PluginSettings Plugin=AnikiHelper, Path=Options[CoverLogoBadge]}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource GamePassIconTemplate}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>


                                <!-- Back To Game -->
                                <ContentControl x:Name="BackToGame_Control" FocusVisualStyle="{x:Null}" Focusable="False"/>

                                <!-- Step 4D: the running badge TextBlock is created only for
                                     an actually running game. The injected BackToGame control
                                     remains untouched. -->
                                <ContentControl x:Name="GameIsRunningBadgeHost"
                                                Content="{Binding ElementName=BackToGame_Control, Path=Content.IsRunning, FallbackValue=False}"
                                                IsHitTestVisible="False"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource GameRunningBadgeTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Mask}" RenderOptions.BitmapScalingMode="Fant" Stretch="Fill"/>
                                </Grid.OpacityMask>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                            <Setter Property="ContentTemplate" Value="{StaticResource UninstalledDarkenTemplate}" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Game.Source.Name}" Value="GG.deals Wishlist">
                            <!-- Disable the stronger "uninstalled game" darken for GG.deals items -->
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BorderDarken" />
                            <Setter Property="ContentTemplate" Value="{x:Null}" TargetName="BorderDarken" />

                            <!-- Enable a lighter tint instead -->
                            <Setter Property="Visibility" Value="Visible" TargetName="GGDealsWishlistTint" />
                            <Setter Property="ContentTemplate" Value="{StaticResource GGDealsWishlistTintTemplate}" TargetName="GGDealsWishlistTint" />
                        </DataTrigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DetailedListItemTemplate">
        <ctrl:GameListItem FocusVisualStyle="{x:Null}">
            <ctrl:GameListItem.Template>
                <ControlTemplate TargetType="{x:Type ctrl:GameListItem}">
                    <Grid Height="88">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover -->

                        <Viewbox Width="80"
                                 Stretch="Uniform">
                            <Grid Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <Image x:Name="PART_ImageCover"
                                       Stretch="{Settings CoverArtStretch}"
                                       StretchDirection="Both"
                                       RenderOptions.BitmapScalingMode="Fant"/>
                            </Grid>
                        </Viewbox>


                        <!-- Infos -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource TextBlockBoldBaseStyle}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="14"
                                       Opacity="0.72"/>
                        </StackPanel>

                        <TextBlock FontSize="24"
                                   Opacity="0.8"
                                   Foreground="{DynamicResource TextBrush}"
                                   Grid.Column="3"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Center"
                                   Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Text" Value="&#xef08;"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontIcoFont}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Game.Source.Name}" Value="GG.deals Wishlist">
                                            <Setter Property="Text" Value="&#xE7BF;"/>
                                            <Setter Property="FontFamily" Value="{StaticResource FontIcons}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Opacity" Value="0.72"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ctrl:GameListItem.Template>
        </ctrl:GameListItem>
    </DataTemplate>

    <Style x:Key="DetailedListItemContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Opacity" Value="0.86"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="#14000000"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="16"
                            Padding="12,10">

                        <Grid>
                            <Border x:Name="AccentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Margin="-2,8,0,8"
                                    CornerRadius="3"
                                    Background="{DynamicResource FocusGameBorderBrush}"
                                    Opacity="0"/>

                            <ContentPresenter Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter TargetName="Root" Property="Background" Value="#30FFFFFF"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
