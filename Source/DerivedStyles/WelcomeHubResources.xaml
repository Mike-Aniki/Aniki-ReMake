<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pc="clr-namespace:Playnite.Controls;assembly=Playnite"
                    mc:Ignorable="d">



    <Style x:Key="HubCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource HubBannerBackgroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <!-- Focus zoom -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ButtonEx}}"
                         Value="True">

                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.035"
                                             Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.035"
                                             Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>

                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>

                <Setter Property="BorderBrush" Value="{DynamicResource FocusGameBorderBrush}" />
                <Setter Property="BorderThickness" Value="3" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopBarIndicatorVisualStyle" TargetType="Border">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="Padding" Value="0,0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Voile commun des artworks du Hub. -->
    <SolidColorBrush x:Key="HubCardImageDimBrush" Color="#52000000"/>

    <!-- Conteneur image en haut de la carte -->
    <Style x:Key="HubCardImageContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20,20,20,20" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="#00000000" />
    </Style>

    <!-- Bandeau bas commun à toutes les cartes -->
    <Style x:Key="HubBottomBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HubCardBottomBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="0,0,20,20" />
        <Setter Property="Height" Value="79" />
        <Setter Property="Padding" Value="20,5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubCardBottomBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>



    <!-- Quick CheckBox -->
    <Style x:Key="WelcomeHubQuickButtonStyleCheckBoxEx" TargetType="CheckBoxEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    <Grid x:Name="Root"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">

                        <Border x:Name="HoverBackground"
                                CornerRadius="9"
                                Background="#00000000"
                                Opacity="0" />

                        <!-- contenu -->
                        <TextBlock x:Name="TextContent"
                                   Style="{DynamicResource ButtonTextBlockBaseStyle}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter x:Name="ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              Opacity="0.8"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </TextBlock>

                        <!-- trait dessous -->
                        <Border x:Name="FocusBorder"
                                Height="3"
                                Width="78"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,1"
                                CornerRadius="2"
                                Background="{DynamicResource FocusGameBorderBrush}"
                                Opacity="0" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverBackground" Property="Background" Value="#00000000" />
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.96" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="ContentHost" Property="Opacity" Value="1" />
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverBackground" Property="Background" Value="#22000000" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Achievement Memory -->
    <DataTemplate x:Key="HubAchievementMemoryItemTemplate">
        <ButtonEx Width="700"
                  Height="370"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Command="{PluginSettings Plugin=AnikiHelper, Path=OpenGameDetailsCommand}"
                  CommandParameter="{Binding GameId}"
                  Style="{StaticResource HubCardFocusButtonStyle}">

            <Border CornerRadius="20"
                    Style="{DynamicResource HubCardBorderStyle}">

                <Grid ClipToBounds="True">

                    <Border x:Name="AchievementMemoryMask"
                            Background="Black"
                            CornerRadius="20"/>

                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=AchievementMemoryMask}"/>
                        </Grid.OpacityMask>

                        <Border Background="#181A1E"/>

                        <!-- Game background -->
                        <Image Source="{Binding GameBackgroundPath}"
                               Stretch="UniformToFill"
                               Opacity="1"
                               RenderOptions.BitmapScalingMode="Fant"/>

                        <!-- Shared Hub artwork dim -->
                        <Border Background="{DynamicResource HubCardImageDimBrush}" IsHitTestVisible="False"/>

                        <!-- Top game title area -->
                        <Border VerticalAlignment="Top"
                                Height="95"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D8000000" Offset="0"/>
                                    <GradientStop Color="#77000000" Offset="0.65"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel VerticalAlignment="Top"
                                    Margin="22,18,22,0">

                            <TextBlock Text="{Binding GameName}"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       MaxWidth="600"
                                       MaxHeight="58"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">

                                <Border CornerRadius="7"
                                        Padding="8,2"
                                        Background="#66000000"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="{Binding UnlockDateString}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border CornerRadius="7"
                                        Padding="8,2"
                                        Background="#66000000"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <TextBlock Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                <Setter Property="Text" Value="{Binding Rarity}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rarity}" Value="Common">
                                                        <Setter Property="Text" Value="{DynamicResource LOCTrophyBronzeShort}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                                                        <Setter Property="Text" Value="{DynamicResource LOCTrophySilverShort}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                                                        <Setter Property="Text" Value="{DynamicResource LOCTrophyGoldShort}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rarity}" Value="VeryRare">
                                                        <Setter Property="Text" Value="{DynamicResource LOCTrophyGoldShort}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                                                        <Setter Property="Text" Value="{DynamicResource LOCTrophyGoldShort}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border CornerRadius="7"
                                        Padding="8,2"
                                        Background="#66000000"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PercentString}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding PercentString}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Rarity trophy image -->
                        <Grid Width="52"
                              Height="52"
                              Margin="0,18,18,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Opacity="0.95">

                            <Image Source="{ThemeFile 'Images/Bronze.png'}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rarity}" Value="Common">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Image Source="{ThemeFile 'Images/Argent.png'}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Image Source="{ThemeFile 'Images/Or.png'}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="Fant">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rarity}" Value="VeryRare">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>

                        <!-- Bottom gradient -->
                        <Border VerticalAlignment="Bottom"
                                Height="150"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#99000000" Offset="0.42"/>
                                    <GradientStop Color="#F0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border VerticalAlignment="Bottom"
                                Height="83"
                                CornerRadius="0,0,20,20"
                                Background="{DynamicResource HubCardBottomBackgroundBrush}"
                                Opacity="0.82" />


                        <!-- Bottom trophy banner -->
                        <Border VerticalAlignment="Bottom"
                                Height="83"
                                CornerRadius="0,0,20,20"
                                Padding="20,5"
                                SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource HubCardBottomBorderBrush}"
                                BorderThickness="0,2,0,0">



                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Trophy icon inside banner -->
                                <Border Grid.Column="0"
                                        Width="58"
                                        Height="58"
                                        CornerRadius="10"
                                        Background="#44000000"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">

                                    <Image Source="{Binding IconPath}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="Fant"/>
                                </Border>

                                <!-- Trophy text -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">

                                    <TextBlock Text="{Binding Title}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,5,0,0"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Opacity="0.74"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>


                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ButtonEx>
    </DataTemplate>

    <!-- Screenshot -->
    <DataTemplate x:Key="HubLatestCaptureItemTemplate">
        <ButtonEx Width="700"
                  Height="370"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Command="{PluginSettings Plugin=AnikiHelper, Path=OpenScreenshotsForMediaItemCommand}"
                  CommandParameter="{Binding}"
                  Style="{StaticResource HubCardFocusButtonStyle}">

            <Border CornerRadius="20"
                    Style="{DynamicResource HubCardBorderStyle}">

                <Grid ClipToBounds="True">

                    <Border x:Name="LatestCaptureImageMask"
                            Background="Black"
                            CornerRadius="20"/>

                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=LatestCaptureImageMask}"/>
                        </Grid.OpacityMask>

                        <Border Background="#181A1E"/>

                        <Image Source="{Binding DisplayThumbnailPath}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="Fant">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUsableThumbnail}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUsableThumbnail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border Background="#181A1E"/>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="32">

                                <TextBlock Text="{DynamicResource LOCMediaGalleryVideoPreviewUnavailable}"
                                           Margin="0,-80,0,0"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Opacity="0.62"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="620"/>
                            </StackPanel>
                        </Grid>


                        <Rectangle x:Name="HubVideoDim"
                                   Fill="#46000000"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="20"/>

                        <Image x:Name="HubPlayBadge"
                               Source="{ThemeFile 'Images/VideoLogo.png'}"
                               Width="82"
                               Height="82"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="Fant"
                               Panel.ZIndex="21"/>

                        <Border x:Name="HubVideoDurationBadge"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="18,18,0,0"
                                Padding="9,3"
                                Background="#C8000000"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                Panel.ZIndex="22">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{DynamicResource LOCMediaDuration}"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource TextBlockDetailStyle}"/>

                                <TextBlock Text="{Binding DisplayDurationString}"
                                           Margin="5,0,0,0"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource TextBlockDetailStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border VerticalAlignment="Bottom"
                                Height="130"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#77000000" Offset="0.42"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border VerticalAlignment="Bottom"
                                Height="74"
                                CornerRadius="0,0,20,20"
                                Background="{DynamicResource HubCardBottomBackgroundBrush}"
                                Opacity="0.82" />

                        <!-- Bottom banner -->
                        <Border VerticalAlignment="Bottom"
                                Height="74"
                                CornerRadius="0,0,20,20"
                                Padding="18,4"
                                SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource HubCardBottomBorderBrush}"
                                BorderThickness="0,2,0,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="{Binding GameName}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding CaptureDateString}"
                                           Margin="0,5,0,0"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Foreground="{DynamicResource TextHubBannerCardBottomBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Opacity="0.68"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </ButtonEx>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                <Setter TargetName="HubVideoDim" Property="Visibility" Value="Visible"/>
                <Setter TargetName="HubPlayBadge" Property="Visibility" Value="Visible"/>
                <Setter TargetName="HubVideoDurationBadge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Trophées : derniers succès SS -->
    <DataTemplate x:Key="HubTrophyRecentTemplate">
        <Border Background="{DynamicResource HubAchievementsBackgroundBrush}"
                CornerRadius="12"
                Width="400"
                Padding="10,8"
                Margin="10,5,10,5"
                BorderBrush="{DynamicResource HubAchievementsBorderBrush}"
                BorderThickness="1">

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icône -->
                <Border Grid.Column="0"
                        Width="66" Height="66"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource HubAchievementsIconBorderBrush}"
                        Background="{DynamicResource HubAchievementsIconBackgroundBrush}"
                        VerticalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <Image Margin="2"
                           Stretch="UniformToFill"
                           Source="{Binding IconPath}"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>

                <!-- Texte -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}"
                               FontSize="18"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHubNameAchievementBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Jeu -->
                    <TextBlock Grid.Row="1"
                               Margin="0,2,0,0"
                               Text="{Binding Game}"
                               FontSize="16"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="Regular"
                               Foreground="{DynamicResource TextHubGameAchievementBrush}"
                               Opacity="0.90"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Date -->
                    <TextBlock Grid.Row="2"
                               Margin="0,6,0,0"
                               Text="{Binding UnlockedStringv}"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="Regular"
                               FontSize="14"
                               Foreground="{DynamicResource TextHubDateAchievementBrush}"
                               Opacity="0.75"
                               VerticalAlignment="Bottom"/>
                </Grid>

            </Grid>
        </Border>
    </DataTemplate>

    <!-- Trophées : plus rares SS -->
    <DataTemplate x:Key="HubTrophyRareTemplate">
        <Border Background="{DynamicResource HubAchievementsBackgroundBrush}"
                CornerRadius="12"
                Width="400"
                Padding="10,8"
                Margin="10,5,10,5"
                BorderBrush="{DynamicResource HubAchievementsBorderBrush}"
                BorderThickness="1">

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icône -->
                <Border Grid.Column="0"
                        Width="66" Height="66"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource HubAchievementsIconBorderBrush}"
                        Background="{DynamicResource HubAchievementsIconBackgroundBrush}"
                        VerticalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <Image Margin="2"
                           Stretch="UniformToFill"
                           Source="{Binding IconPath}"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>

                <!-- Texte -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}"
                               FontSize="18"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHubNameAchievementBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Jeu -->
                    <TextBlock Grid.Row="1"
                               Margin="0,2,0,0"
                               Text="{Binding Game}"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="Regular"
                               FontSize="16"
                               Foreground="{DynamicResource TextHubGameAchievementBrush}"
                               Opacity="0.90"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- % -->
                    <TextBlock Grid.Row="2"
                               Margin="0,6,0,0"
                               Text="{Binding PercentString, StringFormat={}{0:F0}%}"
                               FontSize="14"
                               Style="{DynamicResource TextBlockBaseStyle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextHubPercentAchievementBrush}"
                               Opacity="0.85"
                               VerticalAlignment="Bottom"/>
                </Grid>

            </Grid>
        </Border>
    </DataTemplate>


    <!-- Trophées : derniers succès PA -->
    <DataTemplate x:Key="HubTrophyRecentTemplatePA">
        <ButtonEx Command="{Binding OpenAchievementWindow}"
