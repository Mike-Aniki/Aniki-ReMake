                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Titre -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding DisplayName}"
                                   FontSize="18"
                                   Style="{DynamicResource TextBlockBaseStyle}"
                                   FontWeight="SemiBold"
