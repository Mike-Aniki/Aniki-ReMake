                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Jeu -->
                        <TextBlock Grid.Row="1"
                                   Margin="0,2,0,0"
                                   Text="{Binding Game}"
                                   FontSize="16"
                                   Style="{DynamicResource TextBlockBaseStyle}"
                                   FontWeight="Regular"
                                   Foreground="{DynamicResource TextHubGameAchievementBrush}"
                                   Opacity="0.90"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Date (en bas) -->
                        <TextBlock Grid.Row="2"
                                   Margin="0,6,0,0"
                                   Text="{Binding DateUnlocked}"
                                   Style="{DynamicResource TextBlockBaseStyle}"
                                   FontWeight="Regular"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextHubDateAchievementBrush}"
                                   Opacity="0.75"
                                   VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Rank -->
                    <Border Grid.Column="2"
                            Width="35"
                            Height="35"
                            CornerRadius="19"
                            Background="#66000000"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            Margin="0,-5,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextHubBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                    <Setter Property="Text" Value="#1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                            <Setter Property="Text" Value="#1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                            <Setter Property="Text" Value="#2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="2">
                                            <Setter Property="Text" Value="#3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="3">
                                            <Setter Property="Text" Value="#4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="4">
                                            <Setter Property="Text" Value="#5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="5">
                                            <Setter Property="Text" Value="#6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="6">
                                            <Setter Property="Text" Value="#7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="7">
                                            <Setter Property="Text" Value="#8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="8">
                                            <Setter Property="Text" Value="#9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="9">
                                            <Setter Property="Text" Value="#10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>


                </Grid>
            </Border>
        </ButtonEx>
    </DataTemplate>

