                            Background="{DynamicResource HubAchievementsIconBackgroundBrush}"
                            VerticalAlignment="Center">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
